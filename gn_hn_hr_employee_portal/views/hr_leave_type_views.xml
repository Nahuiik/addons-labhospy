<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_leave_type_view_form_gn_employee_portal" model="ir.ui.view">
        <field name="name">hr.leave.type.form.inherit.gn.employee.portal</field>
        <field name="model">hr.leave.type</field>
        <field name="inherit_id" ref="hr_holidays.edit_holiday_status_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='time_type']" position="after">
                <field name="gn_for_employee_portal" widget="boolean_toggle"/>
            </xpath>
        </field>
    </record>
</odoo>
