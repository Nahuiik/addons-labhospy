<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_gn_hr_document_policy_tree" model="ir.ui.view">
        <field name="name">gn.hr.document.policy.tree</field>
        <field name="model">gn.hr.document.policy</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="version"/>
                <field name="required_for_portal"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="view_gn_hr_document_policy_form" model="ir.ui.view">
        <field name="name">gn.hr.document.policy.form</field>
        <field name="model">gn.hr.document.policy</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="version"/>
                            <field name="required_for_portal"/>
                            <field name="active"/>
                            <field name="sequence"/>
                        </group>
                    </group>
                    <group>
                        <field name="content" widget="html"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_gn_hr_document_acceptance_tree" model="ir.ui.view">
        <field name="name">gn.hr.document.acceptance.tree</field>
        <field name="model">gn.hr.document.acceptance</field>
        <field name="arch" type="xml">
            <list>
                <field name="employee_id"/>
                <field name="policy_id"/>
                <field name="accepted_on"/>
                <field name="accepted_by"/>
                <field name="ip"/>
            </list>
        </field>
    </record>
    <record id="action_gn_hr_document_policy" model="ir.actions.act_window">
        <field name="name">Políticas de documento</field>
        <field name="res_model">gn.hr.document.policy</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p>Defina políticas que los empleados deben aceptar desde el portal.</p>
        </field>
    </record>
    <record id="action_gn_hr_document_acceptance" model="ir.actions.act_window">
        <field name="name">Aceptaciones de políticas</field>
        <field name="res_model">gn.hr.document.acceptance</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
