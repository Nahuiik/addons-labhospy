<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="gn_hr_portal_audit_log_view_tree" model="ir.ui.view">
        <field name="name">gn.hr.portal.audit.log.tree</field>
        <field name="model">gn.hr.portal.audit.log</field>
        <field name="arch" type="xml">
            <list string="Auditoría portal" create="0" edit="0" delete="0">
                <field name="timestamp"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
                <field name="user_id"/>
                <field name="employee_id"/>
                <field name="action"/>
                <field name="model"/>
                <field name="res_id"/>
                <field name="ip"/>
            </list>
        </field>
    </record>

    <record id="gn_hr_portal_audit_log_action" model="ir.actions.act_window">
        <field name="name">Auditoría del portal</field>
        <field name="res_model">gn.hr.portal.audit.log</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem id="menu_gn_hr_portal_audit_log"
        name="Auditoría portal"
        parent="hr.menu_human_resources_configuration"
        action="gn_hr_portal_audit_log_action"
        sequence="60"
        groups="hr.group_hr_manager"/>
</odoo>
