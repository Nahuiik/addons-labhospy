<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="0">
        <!-- Categoría para portal de empleados Honduras -->
        <record id="module_category_employee_portal" model="ir.module.category">
            <field name="name">Portal de Empleados</field>
            <field name="description">Acceso al portal de autoservicio para empleados</field>
            <field name="sequence">15</field>
        </record>

        <!-- Privilegio para portal de empleados -->
        <record id="privilege_employee_portal" model="res.groups.privilege">
            <field name="name">Portal de Empleados</field>
            <field name="sequence">15</field>
            <field name="category_id" ref="gn_hn_hr_employee_portal.module_category_employee_portal"/>
        </record>

        <!-- Grupo de usuarios portal de empleados -->
        <record id="group_employee_portal_user" model="res.groups">
            <field name="name">Usuario Portal Empleado</field>
            <field name="privilege_id" ref="gn_hn_hr_employee_portal.privilege_employee_portal"/>
            <field name="implied_ids" eval="[(4, ref('base.group_portal'))]"/>
            <field name="comment">Acceso al portal de autoservicio para empleados (perfil, constancias, ausencias, etc.)</field>
        </record>
    </data>
</odoo>
