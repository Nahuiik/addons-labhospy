        <!-- Ventas -->
        <record id="filter_sale_order_today" model="ir.filters">
            <field name="name">Hoy</field>
            <field name="model_id">sale.order</field>
            <field name="sequence">1</field>
            <field name="domain"><![CDATA[
[
    ('date_order', '>=', '__TODAY__'),
    ('date_order', '<', '__TOMORROW__')
]
            ]]></field>
            <field name="context">{}</field>
        </record>
