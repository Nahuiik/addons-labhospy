<odoo>
  <template id="report_libro_ventas_invoice_view">
    <t t-call="web.html_container">
      <t t-call="web.external_layout">
        <t t-foreach="docs" t-as="o">
          <div class="page">
            <style>
                  .zoneProduct{
                     padding: 0px 0px;
                     font-size: 11px;
                     margin-top:15px;
                     margin-bottom:15px;
                   }
               th {
                    font-weight: normal;    
                    padding: 1px 5px;
                }
                    .zoneProduct td,  .zoneProduct th{
                       font-size:10px;
                    }
                    .tableVentas #idate{
                       width:50px;
                    }
                    .tableVentas #iclient{
                       width:120px;
                    }
                    .tableVentas #irtn{
                       width:100px;
                    }
                    .tableVentas #icai{
                       width:140px;
                    }
                    .tableVentas #ifactura{
                       width:120px;
                    }
                    .tableVentas #isubtotal{
                       width:80px;
                    }
                    .tableVentas #iisv{
                       width:80px;
                    }
                    .tableVentas #itotal{
                       width:80px;
                    }

            </style>
            <!-- <awc t-if="res_company.id==1 "> -->
            <div class="col-xs-12">
                <h5 style="margin-bottom:0px;">
                    <strong>Libro de Ventas</strong>
                </h5>
                <h6 style="margin-top:1px;">
                    <strong>Expresado en Lempiras</strong>
                </h6>
            </div>
            <div class="row" style="margin-top:15px;">
              

              <div class="col-xs-12 text-right">
                <table style="width:100%; border:0px;">
                  <tr>
                    <td style="width:25%;">
                      <strong>Fecha de Inicio:</strong>
                    </td>
                    <td class="text-left" style="width:25%;">
                      <span t-field="o.start_date"/>
                    </td>
                    <td style="width:25%;">
                      <strong>Fecha Final:</strong>
                    </td>
                    <td class="text-left" style="width:25%;">
                      <span t-field="o.end_date"/>
                    </td>
                  </tr>
                  
                  <hr/>
                  <tr>
                    <td style="width:25%;">
                      <strong>Total Ventas:</strong>
                    </td>
                    <td class="text-left" style="width:25%;">
                      <span t-field="o.total_incoming" t-field-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: &quot;o.currency_id&quot;}"/>
                    </td>
                    <td style="width:25%;">
                      <strong>Ventas Gravadas:</strong>
                    </td>
                    <td class="text-left" style="width:25%;">
                      <span t-field="o.total_gravado" t-field-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: &quot;o.currency_id&quot;}"/>
                    </td>
                  </tr>
                  <tr>
                    <td style="width:25%;">
                      <strong/>
                    </td>
                    <td class="text-left" style="width:25%;">

                    </td>
                    <td style="width:25%;">
                      <strong>Ventas Exentas:</strong>
                    </td>
                    <td class="text-left" style="width:25%;">
                      <span t-field="o.total_exento" t-field-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: &quot;o.currency_id&quot;}"/>
                    </td>
                  </tr>
                  <tr>
                    <td style="width:25%;">
                      <strong/>
                    </td>
                    <td class="text-left" style="width:25%;">

                    </td>
                    <td style="width:25%;">
                      <strong>Ventas Exonerado:</strong>
                    </td>
                    <td class="text-left" style="width:25%;">
                      <span t-field="o.total_exonerate" t-field-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: &quot;o.currency_id&quot;}"/>
                    </td>
                  </tr>
                  <tr>
                    <td style="width:25%;">
                      <strong/>
                    </td>
                    <td class="text-left" style="width:25%;">

                    </td>
                    <td style="width:25%;">
                      <strong>Total de Impuestos:</strong>
                    </td>
                    <td class="text-left" style="width:25%;">
                      <span t-field="o.total_impuesto" t-field-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: &quot;o.currency_id&quot;}"/>
                    </td>
                  </tr>
                  
                </table>

              </div>
            </div>
            <hr style="margin-top:0px;margin-bottom:5px;"/>
            <div class="row ">
              <div class="col-xs-12">
                <div class="zoneProduct">
                  <table class="table table-condensed table-bordered tableVentas">
                    <thead>
                      <tr class="active">
                        <th id="idate">
                          <strong>Fecha</strong>
                        </th>
                        <th id="iclient">
                          <strong>Cliente</strong>
                        </th>
                        <th id="irtn">
                          <strong>RTN</strong>
                        </th>
                        <th id="icai">
                          <strong>Código CAI</strong>
                        </th>
                        <th id="ifactura">
                          <strong>Número de Factura</strong>
                        </th>
                        <th id="isubtotal">
                          <strong>Sub Total</strong>
                        </th>
                        <th id="iisv">
                          <strong>Impuesto</strong>
                        </th>
                        <th id="itotal">
                          <strong>Total</strong>
                        </th>
                      </tr>
                    </thead>
                    <tbody class="invoice_tbody">
                      <t t-foreach="docs" t-as="o">
                        <tr t-foreach="o.out_invoice_ids" t-as="line">
                          <td>
                            <span t-field="line.invoice_date"/>
                          </td>
                          <td>
                            <span t-field="line.partner_id"/>
                          </td>
                          <td>
                            <span t-field="line.partner_id.rtn"/>
                          </td>
                          <td>
                            <span t-field="line.invoice_id.cai_invoice"/>
                          </td>
                          <td>
                            <span t-field="line.invoice_id.name"/>
                          </td>
                          <td>
                            <span t-field="line.subtotal" t-field-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: &quot;o.currency_id&quot;}"/>
                          </td>
                          <td>
                            <span t-field="line.isv" t-field-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: &quot;o.currency_id&quot;}"/>
                          </td>
                          <td>
                            <span t-field="line.total_amount" t-field-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: &quot;o.currency_id&quot;}"/>
                          </td>
                        </tr>
                      </t>
                    </tbody>
                  </table>
                </div>
              </div>
            </div>
            <!-- </awc> -->

          </div>
        </t>
      </t>
    </t>
  </template>
</odoo>
