<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Configurar HNL como moneda predeterminada para Honduras -->
        <record id="base.HNL" model="res.currency">
            <field name="active" eval="True"/>
            <field name="position">before</field>
            <field name="currency_unit_label">Lempiras</field>
            <field name="currency_subunit_label">Centavos</field>
        </record>

        <!-- Establecer HNL como moneda predeterminada para empresas en Honduras -->
        <record id="base.main_company" model="res.company">
            <field name="currency_id" ref="base.HNL"/>
        </record>

        <!-- Configurar el país de Honduras para usar HNL por defecto -->
        <record id="base.hn" model="res.country">
            <field name="currency_id" ref="base.HNL"/>
        </record>
    </data>
</odoo>