<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_hn_backfill_cai_compras_wizard" model="ir.actions.act_window">
        <field name="name">Rellenar CAI facturas compras</field>
        <field name="res_model">hn.backfill.cai.compras.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="view_hn_backfill_cai_compras_wizard_form" model="ir.ui.view">
        <field name="name">hn.backfill.cai.compras.wizard.form</field>
        <field name="model">hn.backfill.cai.compras.wizard</field>
        <field name="arch" type="xml">
            <form string="Rellenar CAI compras">
                <group>
                    <field name="company_ids" widget="many2many_tags"/>
                    <field name="invoice_date_from"/>
                    <field name="invoice_date_to"/>
                </group>
                <p><em>Omite facturas marcadas como importación. Usa CAI del campo contable anterior, el CAI del proveedor (un solo CAI) o la tabla de CAIs por prefijo/número y fecha si el proveedor admite varios.</em></p>
                <footer>
                    <button name="action_run_backfill"
                            string="Ejecutar"
                            type="object"
                            class="btn-primary"/>
                    <button special="cancel" string="Cerrar" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <menuitem id="menu_hn_backfill_cai_compras"
              name="Rellenar CAI compras (histórico)"
              parent="menu_hn_libros_root"
              action="action_hn_backfill_cai_compras_wizard"
              sequence="25"
              groups="account.group_account_invoice"/>

    <record id="action_server_move_backfill_cai_compras" model="ir.actions.server">
        <field name="name">Rellenar CAI compras</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = records.l10n_hn_action_backfill_cai_shot_compras_selected()</field>
    </record>

</odoo>
