<odoo>
        <record id="view_order_form" model="ir.ui.view">
                <field name="name">sale.order.form</field>
                <field name="model">sale.order</field>
                <field name="inherit_id" ref="sale.view_order_form"/>
                <field name="arch" type="xml">
                        <xpath expr="/form/sheet" position="before">
                                <div role="alert">
                    <div
                        class="alert alert-warning"
                        role="alert"
                        invisible="not (overdue_invoice_count &gt; 0 and overdue_invoice_amount &gt; 0)"
                    >
                      The invoicing partner
                                            <field
                            name="commercial_partner_invoicing_id"/> has
                                            <field name="overdue_invoice_count" />
                                            <button
                            string="overdue invoice(s)"
                            type="object"
                            name="jump_to_overdue_invoices"
                            class="oe_link"
                        />for a total residual of
                                            <field name="overdue_invoice_amount" />
                    </div>
                                </div>
                        </xpath>
                        <field name="currency_id" position="after">
                                <field name="company_currency_id" invisible="1" />
            </field>
                </field>
        </record>
</odoo>
