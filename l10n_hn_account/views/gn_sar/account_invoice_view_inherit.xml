<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <record model="ir.ui.view" id="view_move_form_tax">
        <field name="name">account.move</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <field name="tax_totals" position="before">
                <field name="exonerate_amount" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="exempt_sale_amount" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="amount_tax_18_per" invisible="1" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="taxed_sales" invisible="1"/>
                <field name="tax_18_per" invisible="1"/>
            </field>
            <xpath expr="//page[last()]" position="before">
                <page string="Orden de Compra" invisible="move_type != 'out_invoice' or debit_origin_id">
                    <group>
                        <field name="purchase_order_number"/>
                        <field name="add_invoice_attachment"/>
                        <field name="purchase_order_attachment" invisible="add_invoice_attachment == False"/>
                    </group>
                </page>
            </xpath>
            <xpath expr="//page[last()]" position="after">
                <page string="Extra Fields">
                    <group col="2">
                        <group string="Exonerated fields" invisible="move_type != 'out_invoice'">
                            <field name="exempt_purchase_no"/>
                            <field name="reg_of_sag"/>
                            <field name="constancy_exonerated_record"/>
                        </group>
                        <group string="Electronic billing">
                            <field name="cai_expires_shot"/>
                            <field name="min_number_shot"/>
                            <field name="max_number_shot"/>
                            <field name="cai_invoice"/>
                            <field name="cai_shot" invisible="1"/>
                        </group>
                    </group>
                </page>
            </xpath>
            <field name="invoice_vendor_bill_id" position="after">
                <field name="is_of_import" invisible="move_type not in ('in_invoice', 'in_refund', 'in_receipt')"/>
                <field name="cai_shot_compras" string="CAI" readonly="1" force_save="1"
                       invisible="move_type not in ('in_invoice', 'in_refund', 'in_receipt')"/>
            </field>
            <xpath expr="//div[hasclass('text-warning')]" position="before">
                <div style="height:45px;padding-top:10px;padding-left:10px;background-color:#D9EDF7" invisible="show_message == False">
                    <field name="show_message" invisible="1"/>
                    <span class="text-left" invisible="check_open_bill &lt; 1 or move_type != 'in_invoice'">
                        <strong>Advertencia!</strong>
                        Este proveedor tiene
                        <field name="check_open_bill"/>
                        facturas abiertas.
                    </span>
                    <span class="text-left" invisible="check_open_invoice &lt; 1 or move_type != 'out_invoice'">
                        <strong>Advertencia!</strong>
                        Este cliente tiene
                        <field name="check_open_invoice"/>
                        facturas abiertas.
                    </span>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
