<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="ir_actions_report_inherit" model="ir.ui.view">
        <field name="name">ir.actions.report.view.inherit</field>
        <field name="model">ir.actions.report</field>
        <field name="inherit_id" ref="base.act_report_xml_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook/page[@name='security']" position="before">
                <page name="print" string="Print">
                <label for="print_report_options" string="Print Report Options"/>
                    <field name="print_report_options" />
                </page>
            </xpath>
        </field>
    </record>

</odoo>
