<odoo>

    <record id="banks_reports_wizard_form" model="ir.ui.view">
        <field name="name">dbanks.reports.wizard</field>
        <field name="model">banks.reports</field>
        <field name="arch" type="xml">
            <form string="Banks Reports">
                <group col="4">
                    <field name="start_date"/>
                    <field name="end_date"/>
                    <field name="transaction_type"/>
                </group>
                <footer>
                    <button string="Generate" class="btn-primary" name="action_print_report" type="object"/>
                    <button special="cancel" class="oe_link" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_banks_reports" model="ir.actions.act_window">
        <field name="name">Banks Reports</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">banks.reports</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
    
    <menuitem id="menu_banks_reports"
          parent="menu_main_banks"
          name="Reports"
          sequence="101"/>
    
    <menuitem id="menuitem_bank_reports"
            action="action_banks_reports"
            parent="menu_banks_reports"
            name="Banks Report"
            sequence="1"/>

</odoo>