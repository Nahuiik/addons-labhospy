<odoo>
	 <record id="bank_account_transfer_view" model="ir.ui.view">
		<field name="name">bank.account.transfer.form</field>
		<field name="model">bank.transfer</field>
		<field name="arch" type="xml">
			 
			 <form string="Bank Transfer">
				<header>
					<button name="action_validate" string="Validate"
						type="object" class="btn-primary"
						invisible="state != 'draft'" />
					<button name="action_print_journal_entry" string="Imprimir asiento contable" type="object" class="btn-secondary" invisible="not move_id"/>
					<button name="action_cancel" string="Cancel" type="object"
						class="btn-primary"
						groups="gn_banks.banks_cancel_documents"
						invisible="state != 'validated'" />
					<button name="action_set_to_draft" string="Set To Draft"
						type="object" class="btn-primary"
						invisible="state != 'cancel'"/>
					<field name="state" widget="statusbar"
						statusbar_visible="draft,validated" />
				</header>
				<sheet>
					<widget name="web_ribbon" text="Borrador"  bg_color="bg-primary"
						invisible="state != 'draft'"/>
					<widget name="web_ribbon" text="Validado"
						invisible="state != 'validated'"/>
					<widget name="web_ribbon" text="Cancelado" bg_color="bg-danger"
						invisible="state != 'cancel'"/>

					<div class="oe_title">
						<h1 invisible="name != '/'">
							<field name="dummy_name" readonly="1"/>
						</h1>
						<h1 invisible="name == '/'">
							<field name="name" readonly='1' force_save="1"/>
						</h1>
					</div>
					<field name="error_msg" readonly='1' force_save="1"
						invisible="name == '/'" />

					<group name="main_information" col="2">
						<group>
							<field name="company_id" widget="selection"
								readonly="state != 'draft' and name != '/'"  />
							<field name="journal_id" readonly="state != 'draft' and name != '/'"
								domain="[('type', 'in', ['bank']), ('company_id', '=', company_id)]" />
							<field name="dest_journal_id" readonly="state != 'draft'"
								domain="[('type', 'in',['bank']),('company_id', '=', company_id)]" />
							<field name="total" readonly="state != 'draft'"/>
						</group>
						<group>
							<field name="date" readonly="state != 'draft'"/>
							<field name="currency_id"
								readonly="state != 'draft'" />
							<field name="show_currency_rate" invisible="1"/>
							<field name="description" readonly="state != 'draft'" />
							<field name="currency_rate" force_save="1" readonly="1"
								invisible="not show_currency_rate"/>
						</group>
					</group>
					<group>
						<group>
							<field name="move_id" readonly="1"/>
						</group>
						<group>
							<field name="move_type" />
						</group>
					</group>
				</sheet>
				
                <chatter/>
			</form>  
		</field>
	</record>
	
	<!-- bank transfer tree view -->
	<record model="ir.ui.view" id="bank_account_transfer_tree_view">
		<field name="name">bank.transfer.tree</field>
		<field name="model">bank.transfer</field>
		<field name="arch" type="xml">
			<list string="Bank Transfer">
				<field name="name" string="Number"/>
				<field name="dummy_name" string="Next Number" invisible="name != '/'" />
				<field name="journal_id" widget="selection"/>
				<field name="dest_journal_id" widget="selection" />
				<field name="date" />
				<field name="total" sum="total" />
				<field name="currency_id" />
				<!-- <field name="activity_ids" widget="list_activity" optional="show"/> -->
				<field name="state" widget="badge" decoration-success="state == 'validated'" decoration-info="state == 'draft'" decoration-danger="state == 'cancel'" />
				<field name="company_id" />
			</list>
		</field>
	</record>
	
	<record id="view_banks_transfer_search" model="ir.ui.view">
        <field name="name">bank.transfer.search</field>
        <field name="model">bank.transfer</field>
        <field name="arch" type="xml">
            <search string="Bank Transfer">
                <!--field name="name" filter_domain="['|', ('name','ilike',self), ('communication','ilike',self)]" string="Description"/-->
                <field name="name"/>
                <field name="company_id"/>
                <field name="date"/>
                <field name='description'/>
                <field name='journal_id'/>
                <field name='dest_journal_id'/>
                <separator/>
                <filter name="date" string="Date" date="date"/>
                <filter string="De Banco" name="De Banco" context="{'group_by': 'journal_id'}"/>
                <filter string="A Banco" name="A Banco" domain="[]" context="{'group_by': 'dest_journal_id'}"/>
                <filter string="Compañia" name="Compañia" domain="[]" context="{'group_by': 'company_id'}"/>
                <filter string="Moneda" name="Moneda" domain="[]" context="{'group_by': 'currency_id'}"/>
                <!--filter string="Currency" domain="[]" context="{'group_by': 'currency_id'}" groups="base.group_multi_currency"/>
                <filter string="Company" domain="[]" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/-->
            </search>
        </field>
    </record>
    
	<record id="action_bank_account_transfer" model="ir.actions.act_window">
		<field name="name">Bank Transfer</field>
		<field name="res_model">bank.transfer</field>
		<field name="view_mode">list,form</field>
		<field name="domain">[('move_type','=','transference_banks')]</field>
		<field name="context">{'default_move_type':'transference_banks'}</field>
		<field name="group_ids" eval="[(6, 0, [ref('gn_banks.banks_check_manager')])]"/>
		<field name="help" type="html">
			<p class="oe_view_nocontent_create">
				Click to record for bank transfer.
			</p>
		</field>
	</record>
	

	<menuitem
		id="menu_bank_account_transfer"
		action="action_bank_account_transfer"
		name="Bank Transfer"
		parent="menu_main_banks" sequence="30"
		groups="gn_banks.banks_check_manager" />
		
</odoo>
