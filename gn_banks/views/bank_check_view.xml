<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="bank_check_view" model="ir.ui.view">
        <field name="name">bank.check.form</field>
        <field name="model">bank.check</field>
        <field name="arch" type="xml">
            <form string="Check / Transfer">
                <header>
                    <button name="action_validate" string="Validate" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_print_journal_entry" string="Imprimir asiento contable" type="object" class="btn-secondary" invisible="not move_id"/>
                    <button name="action_cancel" string="Cancel" type="object" groups="gn_banks.banks_cancel_documents" class="btn-primary" invisible="state != 'validated'" />
                    <button name="%(action_wizard_crear_plantilla)d" type="action" string="Create Template"/>
                    <button name="action_set_to_draft" string="Set To Draft" type="object" class="btn-primary" invisible="state != 'cancel'" />
                    <field name="state" widget="statusbar" statusbar_visible="draft,validated" />
                </header>
                <sheet>
                    <widget name="web_ribbon" text="Borrador"  bg_color="bg-primary" invisible="state != 'draft'" />
                    <widget name="web_ribbon" text="Validado" invisible="state != 'validated'"/>
                    <widget name="web_ribbon" text="Cancelado" bg_color="bg-danger" invisible="state != 'cancel'" />

                    <div class="oe_title">
                        <h1 invisible="name != '/'">
                            <field name="dummy_name" readonly="1"/>
                        </h1>
                        <h1 invisible="name == '/'">
                            <field name="name" readonly='1' force_save="1"/>
                        </h1>
                    </div>
                    <field name="error_msg" readonly='1' force_save="1" invisible="name == '/'" />

                    <group>
                        <group>
                            <field name="company_id" widget="selection" readonly="(state != 'draft') and (name != '/')" />
                            <field name="journal_id" options="{'no_create': True}" domain="[('type', 'in', ['bank']), ('company_id', '=', company_id)]" readonly="state != 'draft'" />
                            <field name="total" readonly="state != 'draft'" />
                            <field name="partner_id" readonly="state != 'draft'" />
                            <field name="amount_in_words" readonly="1" />
                        </group>
                        <group>
                            <field name="date" readonly="state != 'draft'" />
                            <field name="currency_id" readonly="state != 'draft'" />
                            <field name="show_currency_rate" invisible="1"/>
                            <field name="move_type" required="1" readonly="state != 'draft' and name != '/'"/>
                            <field name="template_id" domain="[('move_type', 'in', ['check', 'transference'])]" readonly="state != 'draft'" />
                            <field name="currency_rate" force_save="1" readonly="1"
                                   invisible="not show_currency_rate"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="cheque_format"/>
                            <field name="is_for_payroll" readonly="state != 'draft'" />
                        </group>
                        <group>
                            <field name="description" readonly="state != 'draft'" />
                        </group>
                    </group>

                    <notebook>
                        <page string="Transaction Details">
                            <field name="check_lines" readonly="state != 'draft'">
                                <list editable="bottom" options="{'no_open': True}">
                                    <field name="account_id" options="{'no_create': True}" domain="[('company_ids', 'in', [parent.company_id]), ('active', '=', True)]"/>
                                    <field name="name" />
                                    <field name="partner_id" options="{'no_create': True}" />
                                    <field name="analytic_distribution" widget="analytic_distribution" options="{'can_delete': False}"/>
                                    <field name="amount" string="Importe" sum="Total"/>
                                    <field name="move_type" column_invisible="1" invisible="1" />
                                    <field name="move_type1" required="1"/>
                                </list>
                                <form string="Transaction Detail">
                                    <group>
                                        <group>
                                            <field name="account_id" options="{'no_create': True}" domain="[('company_ids', 'in', [parent.company_id]), ('active', '=', True)]"/>
                                            <field name="name"/>
                                            <field name="partner_id" options="{'no_create': True}" />
                                            <field name="amount" string="Importe" sum="Total"/>
                                            <field name="move_type" invisible="1"/>
                                            <field name="move_type1" required="1"/>
                                        </group>
                                        <group string="Analytic">
                                            <field name="analytic_distribution" widget="analytic_distribution" options="{'can_delete': False}"/>
                                        </group>
                                    </group>
                                </form>
                            </field>
                            <group>
                                <field name="amount_residual" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            </group>
                        </page>
                        <page string="Account Move" invisible="state != 'validated'">
                            <group>
                                <field name="move_id" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                
                <chatter/>
            </form>
        </field>
    </record>

    <record model="ir.ui.view" id="check_list_view">
        <field name="name">bank.check.list</field>
        <field name="model">bank.check</field>
        <field name="arch" type="xml">
            <list string="Check">
                <field name="name" string="Number"/>
                <field name="dummy_name" string="Next Number" invisible="name != '/'" />
                <field name="partner_id" />
                <field name="date"/>
                <field name="journal_id" widget="selection"/>
                <field name="total" sum="total" />
                <field name="currency_id" />
                <field name="state" widget="badge" decoration-success="state == 'validated'" decoration-info="state == 'draft'" decoration-danger="state == 'cancel'"/>
                <field name="company_id"/>
            </list>
        </field>
    </record>

    <record id="action_bank_check" model="ir.actions.act_window">
        <field name="name">Check</field>
        <field name="res_model">bank.check</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="check_list_view"/>
        <field name="domain">[('move_type','=','check')]</field>
        <field name="context">{'default_move_type':'check'}
        </field>
        <field name="group_ids" eval="[(6, 0, [ref('gn_banks.banks_check_user')])]"/>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Click to record for check.
            </p>
        </field>
    </record>

    <record id="action_bank_transference" model="ir.actions.act_window">
        <field name="name">Transference</field>
        <field name="res_model">bank.check</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="check_list_view"/>
        <field name="domain">[('move_type','=','transference')]</field>
        <field name="context">{'default_move_type':'transference'}
        </field>
        <field name="group_ids" eval="[(6, 0, [ref('gn_banks.banks_check_user')])]"/>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Click to record for check.
            </p>
        </field>
    </record>

    <menuitem id="menu_bank_check" action="action_bank_check" name="Cheques" parent="menu_main_banks" sequence="10"
              groups="gn_banks.banks_check_user"/>
    <menuitem id="menu_bank_transference" action="action_bank_transference" name="Transference" parent="menu_main_banks" sequence="20"
              groups="gn_banks.banks_check_user"/>
</odoo>
