<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="banks_deposit_print" model="ir.actions.report">
            <field name="name">Voucher</field>
            <field name="model">debit.credit</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">gn_banks.deposit_print</field>
            <field name="report_file">gn_banks.deposit_print</field>
            <field name="print_report_name">'Voucher'</field>
            <field name="binding_type">report</field>
        </record>
        <record id="banks_check_print" model="ir.actions.report">
            <field name="name">Print Check Voucher</field>
            <field name="model">bank.check</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">gn_banks.check_print</field>
            <field name="report_file">gn_banks.check_print</field>
            <field name="print_report_name">(object._get_report_base_filename())</field>
            <field name="binding_model_id" ref="model_bank_check"/>
            <field name="binding_type">report</field>
        </record>
        <record id="desktop_check_paper_format" model="report.paperformat">
            <field name="name">Desktop Check</field>
            <field name="default" eval="True"/>
            <field name="format">custom</field>
            <field name="page_height">215</field>
            <field name="page_width">215</field>
            <field name="orientation">Portrait</field>
            <field name="margin_top">11</field>
            <field name="margin_bottom">20</field>
            <field name="margin_left">7</field>
            <field name="margin_right">25</field>
            <field name="header_line" eval="False"/>
            <field name="header_spacing">35</field>
            <field name="dpi">90</field>
        </record>
        <record id="banks_desktop_voucher" model="ir.actions.report">
            <field name="name">Print Check Desktop</field>
            <field name="model">bank.check</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">gn_banks.desktop_voucher</field>
            <field name="report_file">gn_banks.desktop_voucher</field>
            <field name="print_report_name">(object._get_report_base_filename())</field>
            <field name="binding_model_id" ref="model_bank_check"/>
            <field name="binding_type">report</field>
        </record>
    </data>
</odoo>
