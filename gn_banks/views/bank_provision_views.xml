<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_bank_provision_tree" model="ir.ui.view">
        <field name="name">bank.provision.list</field>
        <field name="model">bank.provision</field>
        <field name="arch" type="xml">
            <list string="Provisiones" decoration-muted="state == 'cancel'">
                <field name="name"/>
                <field name="provision_kind" optional="show"/>
                <field name="dummy_name" string="Próximo" optional="show" invisible="state != 'draft' or name != '/'"/>
                <field name="date"/>
                <field name="journal_id"/>
                <field name="company_id"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'validated'"
                       decoration-info="state == 'draft'"
                       decoration-danger="state == 'cancel'"/>
            </list>
        </field>
    </record>

    <record id="view_bank_provision_form" model="ir.ui.view">
        <field name="name">bank.provision.form</field>
        <field name="model">bank.provision</field>
        <field name="arch" type="xml">
            <form string="Provisión / diferencial cambiario">
                <header>
                    <button name="action_load_fx_template_lines" string="Plantilla diferencial"
                            type="object" class="btn-secondary"
                            invisible="state != 'draft' or provision_kind != 'fx_differential'"
                            confirm="Se reemplazan las líneas actuales por la plantilla (liquidez del diario banco + cuenta resultado cambiario). ¿Continuar?"/>
                    <button name="action_validate" string="Validar"
                            type="object" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_cancel" string="Cancelar"
                            type="object" groups="gn_banks.banks_cancel_documents"
                            invisible="state != 'validated'"/>
                    <button name="action_set_to_draft" string="Volver a borrador"
                            type="object"
                            invisible="state != 'cancel'"/>
                    <button name="action_print_journal_entry" string="Imprimir asiento"
                            type="object" invisible="not move_id or state != 'validated'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,validated,cancel"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1 invisible="name != '/'">
                            <field name="dummy_name" readonly="1" class="text-muted"/>
                        </h1>
                        <h1 invisible="name == '/'">
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <field name="error_msg" readonly="1" invisible="state != 'draft' or not error_msg"/>
                    <div class="alert alert-info" role="alert" invisible="provision_kind != 'accrual'">
                        <p><strong>Devengo / provisión:</strong> el diario sugerido es el configurado en la compañía
                        «Diario devengo / provisiones (predeterminado)» o el misceláneo llamado «Provisiones»;
                        puede elegir otro diario <em>misceláneo</em> si lo necesita.</p>
                    </div>
                    <div class="alert alert-info" role="alert" invisible="provision_kind != 'fx_differential'">
                        <p><strong>Diferencial cambiario:</strong> el diario queda fijo al indicado en la compañía
                        («Diario diferencial cambiario (provisiones)» en <em>General Information</em>), o al diario
                        cuyo nombre es exactamente «Diferencia de cambio». Cree en ese diario la secuencia con tipo
                        «Diferencial cambiario (provisiones)». El botón «Plantilla diferencial» solo aplica si el diario
                        es de tipo <em>banco</em>; si es misceláneo, cargue las líneas a mano.</p>
                    </div>

                    <group>
                        <group>
                            <field name="company_id" readonly="state != 'draft'"/>
                            <field name="provision_kind" widget="radio" options="{'horizontal': true}"
                                   readonly="state != 'draft'"/>
                            <field name="journal_id"
                                   readonly="state != 'draft' or provision_kind == 'fx_differential'"
                                   domain="[('company_id', '=', company_id), '|', ('type', '=', 'bank'), ('type', '=', 'general')]"/>
                            <field name="date" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="currency_id" readonly="state != 'draft'"/>
                            <field name="move_id" readonly="1" invisible="not move_id"/>
                        </group>
                    </group>

                    <field name="description" readonly="state != 'draft'"
                           placeholder="Descripción visible en referencia del asiento"/>

                    <notebook>
                        <page string="Detalle">
                            <field name="line_ids" readonly="state != 'draft'">
                                <list editable="bottom" string="Movimiento contable equivalente">
                                    <field name="account_id"/>
                                    <field name="partner_id"/>
                                    <field name="name"/>
                                    <field name="debit" sum="debit_sum"/>
                                    <field name="credit" sum="credit_sum"/>
                                    <field name="analytic_distribution"
                                           widget="analytic_distribution"
                                           optional="hide"/>
                                    <field name="provision_id" column_invisible="1"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_bank_provision_search" model="ir.ui.view">
        <field name="name">bank.provision.search</field>
        <field name="model">bank.provision</field>
        <field name="arch" type="xml">
            <search string="Provisiones">
                <field name="name"/>
                <field name="description"/>
                <field name="journal_id"/>
                <filter name="validated" string="Validados" domain="[('state', '=', 'validated')]"/>
                <filter name="draft" string="Borrador" domain="[('state', '=', 'draft')]"/>
                <separator/>
                <filter name="kind_accrual" string="Devengo" domain="[('provision_kind', '=', 'accrual')]"/>
                <filter name="kind_fx" string="Diferencial cambiario" domain="[('provision_kind', '=', 'fx_differential')]"/>
            </search>
        </field>
    </record>

    <record id="action_bank_provision" model="ir.actions.act_window">
        <field name="name">Provisiones</field>
        <field name="res_model">bank.provision</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_bank_provision_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                <strong>Devengo:</strong> diario misceláneo y secuencia tipo «Provisiones».
                <strong>Diferencial cambiario:</strong> diario banco (o misceláneo) y secuencia tipo
                «Diferencial cambiario (provisiones)»; use «Plantilla diferencial» con diario banco.
            </p>
        </field>
    </record>

    <menuitem id="menu_bank_provision"
              name="Provisiones"
              parent="menu_sub_banks"
              action="action_bank_provision"
              sequence="40"
              groups="gn_banks.banks_debit_credit_user"/>

</odoo>
