<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_company_form_inherit_gn_banks_fx_journal" model="ir.ui.view">
        <field name="name">res.company.form.inherit.gn_banks.fx_journal</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="account.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='currency_id'][@id='company_currency']" position="after">
                <field name="banks_accrual_provision_journal_id"
                       options="{'no_create_edit': True}"
                       groups="account.group_account_manager"/>
                <field name="banks_fx_differential_journal_id"
                       options="{'no_create_edit': True}"
                       groups="account.group_account_manager"/>
            </xpath>
        </field>
    </record>
</odoo>
