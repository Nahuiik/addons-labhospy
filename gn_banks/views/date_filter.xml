			<separator/>
         	<filter string="Bank Debits Weekly" name="Bank Debits Weekly" icon="terp-accessories-archiver" domain="[]" context="{'group_by':'date:week'}"/>
			<filter string="Bank Debits Year" name="Bank Debits Year" icon="terp-accessories-archiver" domain="[]" context="{'group_by':'date:year'}"/>
			<filter string="Banco" name="Banco" domain="[]" context="{'group_by': 'journal_id'}"/>
			<filter string="Partner" name="Partner" domain="[]" context="{'group_by': 'partner_id'}"/>
			<filter string="Compañia" name="Compañia" domain="[]" context="{'group_by': 'company_id'}"/>
			<filter string="Moneda" name="Moneda" domain="[]" context="{'group_by': 'currency_id'}"/>
		</search>
     	</field>
	</record>
	
	

</odoo>