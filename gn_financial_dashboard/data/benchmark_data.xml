<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!--
        Benchmarks sectoriales por defecto. Valores tomados como
        referencias razonables (no auditadas) para que el módulo
        funcione "out of the box". El usuario puede ajustarlos en
        Contabilidad → Configuración → Tablero financiero → Benchmarks.
    -->

    <!-- ============ SECTOR: Hospital / Clínica privada ============ -->
    <record id="bench_hospital_gm" model="gn.financial.dashboard.benchmark">
        <field name="sector">hospital</field>
        <field name="sector_label">Hospital / Clínica privada</field>
        <field name="kpi_code">gross_margin_pct</field>
        <field name="target_value">45.0</field>
        <field name="min_value">35.0</field>
        <field name="direction">higher_better</field>
        <field name="source">Referencia genérica (sector salud).</field>
    </record>
    <record id="bench_hospital_om" model="gn.financial.dashboard.benchmark">
        <field name="sector">hospital</field>
        <field name="sector_label">Hospital / Clínica privada</field>
        <field name="kpi_code">operating_margin_pct</field>
        <field name="target_value">12.0</field>
        <field name="min_value">6.0</field>
        <field name="direction">higher_better</field>
    </record>
    <record id="bench_hospital_em" model="gn.financial.dashboard.benchmark">
        <field name="sector">hospital</field>
        <field name="sector_label">Hospital / Clínica privada</field>
        <field name="kpi_code">ebitda_margin_pct</field>
        <field name="target_value">18.0</field>
        <field name="min_value">10.0</field>
        <field name="direction">higher_better</field>
    </record>
    <record id="bench_hospital_cr" model="gn.financial.dashboard.benchmark">
        <field name="sector">hospital</field>
        <field name="sector_label">Hospital / Clínica privada</field>
        <field name="kpi_code">current_ratio</field>
        <field name="target_value">2.0</field>
        <field name="min_value">1.2</field>
        <field name="direction">higher_better</field>
    </record>
    <record id="bench_hospital_dso" model="gn.financial.dashboard.benchmark">
        <field name="sector">hospital</field>
        <field name="sector_label">Hospital / Clínica privada</field>
        <field name="kpi_code">dso_days</field>
        <field name="target_value">45.0</field>
        <field name="max_value">75.0</field>
        <field name="direction">lower_better</field>
    </record>
    <record id="bench_hospital_da" model="gn.financial.dashboard.benchmark">
        <field name="sector">hospital</field>
        <field name="sector_label">Hospital / Clínica privada</field>
        <field name="kpi_code">debt_to_assets</field>
        <field name="target_value">0.50</field>
        <field name="max_value">0.70</field>
        <field name="direction">lower_better</field>
    </record>

