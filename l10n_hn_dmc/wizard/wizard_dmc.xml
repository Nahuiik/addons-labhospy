<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="wizard_dmc_form_view" model="ir.ui.view">
        <field name="name">wizard.dmc.report.form</field>
        <field name="model">l10n_hn_dmc.wizard_dmc_report</field>
        <field name="arch" type="xml">
            <form string="Reporte DMC">
                <group>
                    <field name="date_from" string="Fecha de inicio"/>
                    <field name="date_to" string="Fecha final"/>
                </group>
                <footer>
                    <button name="print_report" type="object" string="Exportar Excel" class="btn-primary"/>
                    <button special="cancel" string="Cancelar" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="wizard_dmc_report_action" model="ir.actions.act_window">
        <field name="name">Reporte DMC</field>
        <field name="res_model">l10n_hn_dmc.wizard_dmc_report</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem
        id="dmc_report_menuitem"
        name="Reporte DMC (XLSX)"
        action="wizard_dmc_report_action"
        parent="l10n_hn_reports.menu_hn_reports_root"
        sequence="30"
    />

    <record id="dmc_report_xls" model="ir.actions.report">
        <field name="name">Reporte DMC XLS</field>
        <field name="model">account.move</field>
        <field name="report_type">xlsx</field>
        <field name="report_name">l10n_hn_dmc.dmc_report_xls</field>
        <field name="report_file">Reporte DMC</field>
    </record>
</odoo>
