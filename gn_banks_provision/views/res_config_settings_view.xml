<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="res_config_settings_view_form_banks_provision" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.banks.provision</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="gn_banks.res_config_settings_view_form_banks"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='gn_banks']" position="inside">
                <block title="Provisiones bancarias" name="banks_provision_settings">
                    <setting string="Diario devengo / provisiones"
                             help="Diario misceláneo sugerido para provisiones tipo devengo.">
                        <field name="banks_accrual_provision_journal_id"
                               options="{'no_create': True}"/>
                    </setting>
                    <setting string="Diario diferencial cambiario"
                             help="Diario único para documentos de diferencial cambiario.">
                        <field name="banks_fx_differential_journal_id"
                               options="{'no_create': True}"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
