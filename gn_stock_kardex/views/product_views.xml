<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Button on product.template form (main product view) -->
    <record id="product_template_form_kardex_button" model="ir.ui.view">
        <field name="name">product.template.form.kardex.button</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_stock_kardex"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-bar-chart"
                        invisible="not is_storable"
                        groups="stock.group_stock_user">
                           <span class="o_stat_text">Tarjeta Stock</span>
                       </button>
                   </xpath>
               </field>
           </record>

           <!-- Button on product.product form (variant view) -->
           <record id="product_product_form_kardex_button" model="ir.ui.view">
               <field name="name">product.product.form.kardex.button</field>
               <field name="model">product.product</field>
               <field name="inherit_id" ref="product.product_normal_form_view"/>
               <field name="arch" type="xml">
                   <xpath expr="//div[@name='button_box']" position="inside">
                       <button name="action_open_stock_kardex"
                               type="object"
                               class="oe_stat_button"
                               icon="fa-bar-chart"
                               invisible="not is_storable"
                               groups="stock.group_stock_user">
                           <span class="o_stat_text">Tarjeta Stock</span>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
