<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="gn_stock_kardex.KardexPreview">
        <div class="o_kx d-flex flex-column h-100">

            <!-- Loading / Error / Empty -->
            <t t-if="state.loading">
                <div class="text-center text-muted py-5 flex-grow-1 d-flex align-items-center justify-content-center">
                    <i class="fa fa-spinner fa-spin fa-2x me-2"/> Cargando…
                </div>
            </t>
            <t t-elif="state.error">
                <div class="p-3"><div class="alert alert-warning mb-0" t-esc="state.error"/></div>
            </t>
            <t t-elif="!state.data || !state.data.sections.length">
                <div class="p-4 text-center text-muted">No hay datos para los filtros seleccionados.</div>
            </t>
            <t t-else="">

                <!-- ╔══════════════════════════════════════════════╗ -->
                <!-- ║          SUMMARY VIEW (product list)         ║ -->
                <!-- ╚══════════════════════════════════════════════╝ -->
                <t t-if="state.viewMode === 'summary'">

                    <!-- Toolbar -->
                    <div class="o_kx_toolbar d-flex align-items-center justify-content-between px-3 py-2 bg-white border-bottom">
                        <div class="d-flex align-items-center gap-2">
                            <button type="button" class="btn btn-sm o_kx_btn_excel" t-on-click="exportXlsx">
                                <i class="fa fa-file-excel-o me-1"/> Excel
                            </button>
                            <button type="button" class="btn btn-sm o_kx_btn_pdf" t-on-click="exportPdf">
                                <i class="fa fa-file-pdf-o me-1"/> PDF
                            </button>
                            <span class="border-start mx-1" style="height:20px;"/>
                            <div class="d-flex align-items-center gap-1">
                                <i class="fa fa-search text-muted"/>
                                <input type="text" class="form-control form-control-sm o_kx_toolbar_search"
                                       placeholder="Buscar…"
                                       t-att-value="state.summarySearch"
                                       t-on-input="onSummarySearchInput"/>
                            </div>
                            <span class="border-start mx-1" style="height:20px;"/>
                            <div class="d-flex align-items-center gap-1">
                                <label class="mb-0 small text-muted text-nowrap" for="kx_group_by">
                                    <i class="fa fa-object-group me-1"/>Agrupar:
                                </label>
                                <select id="kx_group_by" class="form-select form-select-sm o_kx_group_select"
                                        t-on-change="onGroupByChange">
                                    <option value="none" t-att-selected="state.groupBy === 'none'">Sin agrupar</option>
                                    <option value="category" t-att-selected="state.groupBy === 'category'">Por categoría</option>
                                </select>
                            </div>
                            <span class="border-start mx-1" style="height:20px;"/>
                            <div class="form-check form-switch mb-0 d-flex align-items-center">
                                <input class="form-check-input" type="checkbox" id="kx_neg_filter"
                                       t-att-checked="state.onlyNegative"
                                       t-on-change="onNegativeFilterChange"/>
                                <label class="form-check-label small text-danger fw-semibold ms-1 text-nowrap" for="kx_neg_filter">
                                    <i class="fa fa-arrow-down me-1"/>Solo negativos
                                </label>
                            </div>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <span class="fw-semibold small" t-esc="state.data.company_name"/>
                            <t t-if="state.data.branch_name">
                                <span class="text-primary fw-semibold small">
                                    <i class="fa fa-building-o"/> <t t-esc="state.data.branch_name"/>
                                </span>
                            </t>
                            <span class="border-start mx-1" style="height:20px;"/>
                            <div class="d-flex align-items-center gap-1">
                                <i class="fa fa-calendar text-muted small"/>
                                <input type="date" class="form-control form-control-sm o_kx_date_input"
                                       t-att-value="params.date_from"
                                       t-on-change="(ev) => this.onDateChange('date_from', ev)"/>
                                <span class="text-muted small">—</span>
                                <input type="date" class="form-control form-control-sm o_kx_date_input"
                                       t-att-value="params.date_to"
                                       t-on-change="(ev) => this.onDateChange('date_to', ev)"/>
                            </div>
                            <span class="badge bg-secondary">
                                <t t-esc="getSummaryFilteredSections().length"/> productos
                            </span>
                            <button type="button" class="btn btn-sm btn-light border" t-on-click="openWizard">
                                <i class="fa fa-cog me-1"/> Filtros
                            </button>
                        </div>
                    </div>

                    <!-- Body: sidebar + table -->
                    <div class="d-flex flex-grow-1 overflow-hidden">

                        <!-- Left sidebar: ubicaciones (tags) + categorías -->
                        <div class="o_kx_sidebar border-end bg-white">
                            <div class="o_kx_sidebar_header">
                                <i class="fa fa-folder-o me-1"/> CATEGORÍA
                            </div>
                            <t t-if="state.locations.length > 0">
                                <div class="o_kx_sidebar_header o_kx_loc_below_cat">
                                    <i class="fa fa-map-marker me-1"/> UBICACIONES
                                </div>
                                <div class="o_kx_loc_tags_field px-2 pb-2">
                                    <div class="o_kx_loc_tags_inner">
                                        <t t-foreach="getSelectedLocationTags()" t-as="tag" t-key="tag.id">
                                            <span class="o_kx_loc_m2m_tag">
                                                <i t-att-class="tag.is_transit ? 'fa fa-exchange me-1' : 'fa fa-map-marker me-1'"/>
                                                <span class="o_kx_loc_tag_text" t-att-title="tag.title" t-esc="tag.short"/>
                                                <i class="fa fa-times o_kx_loc_tag_remove"
                                                   t-on-click.stop="() => this.onRemoveLocationTag(tag.id)"/>
                                            </span>
                                        </t>
                                        <t t-if="!state.selectedLocationIds.length">
                                            <span class="o_kx_loc_placeholder text-muted small">Todas las ubicaciones</span>
                                        </t>
                                    </div>
                                    <select class="form-select form-select-sm o_kx_loc_add_select mt-1"
                                            t-on-change="onAddLocationSelect">
                                        <option value="">+ Añadir ubicación…</option>
                                        <t t-foreach="getLocationsToAdd()" t-as="loc" t-key="loc.id">
                                            <option t-att-value="loc.id"
                                                    t-esc="loc.complete_name + (loc.is_transit ? ' (Tránsito)' : '')"/>
                                        </t>
                                    </select>
                                </div>
                            </t>
                            <div class="o_kx_sidebar_body">
                                <div t-att-class="'o_kx_cat_item' + (!state.selectedCategory ? ' active' : '')"
                                     t-on-click="() => this.onCategoryClick(null)">
                                    <span>Todas</span>
                                </div>
                                <t t-foreach="getCategories()" t-as="cat" t-key="cat.name">
                                    <div t-att-class="'o_kx_cat_item' + (state.selectedCategory === cat.name ? ' active' : '')"
                                         t-on-click="() => this.onCategoryClick(cat.name)">
                                        <span class="o_kx_cat_name" t-esc="cat.name"/>
                                        <span class="o_kx_cat_count" t-esc="cat.count"/>
                                    </div>
                                </t>
                            </div>
                        </div>

                        <!-- Right: table + pager -->
                        <div class="d-flex flex-column flex-grow-1 overflow-hidden">

                            <!-- ─── FLAT TABLE (no group) ─── -->
                            <t t-if="state.groupBy === 'none'">
                                <div class="flex-grow-1 overflow-auto">
                                    <table class="o_kx_summary_table">
                                        <thead>
                                            <tr>
                                                <th class="o_kx_st_product o_kx_sortable" t-on-click="() => this.onSortColumn('product_name')">
                                                    Producto <i t-att-class="getSortIcon('product_name')" style="font-size:11px"/>
                                                </th>
                                                <th class="text-end o_kx_sortable" t-on-click="() => this.onSortColumn('prev_qty')">
                                                    Saldo Inicial <i t-att-class="getSortIcon('prev_qty')" style="font-size:11px"/>
                                                </th>
                                                <th class="text-end o_kx_sortable" t-on-click="() => this.onSortColumn('in_qty')">
                                                    Entradas <i t-att-class="getSortIcon('in_qty')" style="font-size:11px"/>
                                                </th>
                                                <th class="text-end o_kx_sortable" t-on-click="() => this.onSortColumn('out_qty')">
                                                    Salidas <i t-att-class="getSortIcon('out_qty')" style="font-size:11px"/>
                                                </th>
                                                <th class="text-end o_kx_sortable" t-on-click="() => this.onSortColumn('final_qty')">
                                                    Saldo Final <i t-att-class="getSortIcon('final_qty')" style="font-size:11px"/>
                                                </th>
                                                <th class="text-end o_kx_sortable" t-on-click="() => this.onSortColumn('final_unit_cost')">
                                                    Costo Unit. <i t-att-class="getSortIcon('final_unit_cost')" style="font-size:11px"/>
                                                </th>
                                                <th class="text-end o_kx_sortable" t-on-click="() => this.onSortColumn('final_total')">
                                                    Total Final <i t-att-class="getSortIcon('final_total')" style="font-size:11px"/>
                                                </th>
                                                <th class="text-center" style="width:70px;"/>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-foreach="getSummaryVisibleSections()" t-as="sec" t-key="sec.product_id">
                                                <tr>
                                                    <td class="o_kx_st_product fw-semibold" t-esc="sec.product_name"/>
                                                    <td t-att-class="'text-end font-monospace' + negClass(sec.prev_balance.qty)" t-esc="fmt2(sec.prev_balance.qty)"/>
                                                    <td class="text-end font-monospace text-success" t-esc="fmt2(sec.totals.in_qty)"/>
                                                    <td class="text-end font-monospace text-danger" t-esc="fmt2(sec.totals.out_qty)"/>
                                                    <td t-att-class="'text-end font-monospace fw-bold' + negClass(sec.totals.final_qty)" t-esc="fmt2(sec.totals.final_qty)"/>
                                                    <td t-att-class="'text-end font-monospace' + negClass(sec.totals.final_unit_cost)" t-esc="fmt2(sec.totals.final_unit_cost)"/>
                                                    <td t-att-class="'text-end font-monospace fw-bold' + negClass(sec.totals.final_total)" t-esc="fmt2(sec.totals.final_total)"/>
                                                    <td class="text-center">
                                                        <a href="#" class="o_kx_more_link"
                                                           t-on-click.prevent="() => this.openDetail(sec)">
                                                            <i class="fa fa-eye me-1"/>Detalle
                                                        </a>
                                                    </td>
                                                </tr>
                                            </t>
                                        </tbody>
                                    </table>
                                </div>

                                <!-- Flat pagination -->
                                <div class="o_kx_pager d-flex align-items-center justify-content-between px-3 py-2 border-top bg-white small">
                                    <span class="text-muted">
                                        <t t-esc="getSummaryPageFrom()"/>-<t t-esc="getSummaryPageTo()"/>
                                        de <t t-esc="getSummaryFilteredSections().length"/> productos
                                    </span>
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="text-muted">
                                            Página <t t-esc="state.summaryPage"/> de <t t-esc="getSummaryTotalPages()"/>
                                        </span>
                                        <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-1"
                                                t-on-click="summaryPrevPage"
                                                t-att-disabled="state.summaryPage &lt;= 1">‹</button>
                                        <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-1"
                                                t-on-click="summaryNextPage"
                                                t-att-disabled="state.summaryPage >= getSummaryTotalPages()">›</button>
                                    </div>
                                </div>
                            </t>

                            <!-- ─── GROUPED BY CATEGORY ─── -->
                            <t t-if="state.groupBy === 'category'">
                                <div class="flex-grow-1 overflow-auto">
                                    <table class="o_kx_summary_table">
                                        <thead>
                                            <tr>
                                                <th class="o_kx_st_product">Producto</th>
                                                <th class="text-end">Saldo Inicial</th>
                                                <th class="text-end">Entradas</th>
                                                <th class="text-end">Salidas</th>
                                                <th class="text-end">Saldo Final</th>
                                                <th class="text-end">Costo Unit.</th>
                                                <th class="text-end">Total Final</th>
                                                <th class="text-center" style="width:70px;"/>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-foreach="getGroupedByCategory()" t-as="grp" t-key="grp.categ">
                                                <!-- Category header row -->
                                                <tr class="o_kx_group_header" t-on-click="() => this.toggleGroup(grp.categ)">
                                                    <td colspan="8">
                                                        <i t-att-class="'fa me-1 ' + (isGroupCollapsed(grp.categ) ? 'fa-caret-right' : 'fa-caret-down')"/>
                                                        <span class="fw-bold" t-esc="grp.categ"/>
                                                        <span class="text-muted ms-2">(<t t-esc="grp.sections.length"/> productos)</span>
                                                        <span class="float-end font-monospace small text-muted">
                                                            Total: <span class="fw-bold" t-esc="fmt2(grp.totals.closing_total)"/>
                                                        </span>
                                                    </td>
                                                </tr>
                                                <!-- Category products (collapsible) -->
                                                <t t-if="!isGroupCollapsed(grp.categ)">
                                                    <t t-foreach="grp.sections" t-as="sec" t-key="sec.product_id">
                                                        <tr class="o_kx_group_row">
                                                            <td class="o_kx_st_product ps-4 fw-semibold" t-esc="sec.product_name"/>
                                                            <td t-att-class="'text-end font-monospace' + negClass(sec.prev_balance.qty)" t-esc="fmt2(sec.prev_balance.qty)"/>
                                                            <td class="text-end font-monospace text-success" t-esc="fmt2(sec.totals.in_qty)"/>
                                                            <td class="text-end font-monospace text-danger" t-esc="fmt2(sec.totals.out_qty)"/>
                                                            <td t-att-class="'text-end font-monospace fw-bold' + negClass(sec.totals.final_qty)" t-esc="fmt2(sec.totals.final_qty)"/>
                                                            <td t-att-class="'text-end font-monospace' + negClass(sec.totals.final_unit_cost)" t-esc="fmt2(sec.totals.final_unit_cost)"/>
                                                            <td t-att-class="'text-end font-monospace fw-bold' + negClass(sec.totals.final_total)" t-esc="fmt2(sec.totals.final_total)"/>
                                                            <td class="text-center">
                                                                <a href="#" class="o_kx_more_link"
                                                                   t-on-click.prevent="() => this.openDetail(sec)">
                                                                    <i class="fa fa-eye me-1"/>Detalle
                                                                </a>
                                                            </td>
                                                        </tr>
                                                    </t>
                                                    <!-- Category subtotal row -->
                                                    <tr class="o_kx_group_subtotal">
                                                        <td class="ps-4 text-end fw-bold fst-italic">
                                                            Subtotal <t t-esc="grp.categ"/>
                                                        </td>
                                                        <td class="text-end font-monospace fw-bold" t-esc="fmt2(grp.totals.opening)"/>
                                                        <td class="text-end font-monospace fw-bold text-success" t-esc="fmt2(grp.totals.incoming)"/>
                                                        <td class="text-end font-monospace fw-bold text-danger" t-esc="fmt2(grp.totals.outgoing)"/>
                                                        <td class="text-end font-monospace fw-bold" t-esc="fmt2(grp.totals.closing_qty)"/>
                                                        <td/>
                                                        <td class="text-end font-monospace fw-bold" t-esc="fmt2(grp.totals.closing_total)"/>
                                                        <td/>
                                                    </tr>
                                                </t>
                                            </t>
                                        </tbody>
                                    </table>
                                </div>
                            </t>

                        </div>
                    </div>
                </t>

                <!-- ╔══════════════════════════════════════════════╗ -->
                <!-- ║          DETAIL VIEW (single product)        ║ -->
                <!-- ╚══════════════════════════════════════════════╝ -->
                <t t-if="state.viewMode === 'detail'">

                    <!-- Toolbar -->
                    <div class="o_kx_toolbar d-flex align-items-center justify-content-between px-3 py-2 bg-white border-bottom">
                        <div class="d-flex align-items-center gap-2">
                            <button type="button" class="btn btn-sm btn-light border" t-on-click="backToSummary">
                                <i class="fa fa-arrow-left me-1"/> Regresar
                            </button>
                            <span class="border-start mx-1" style="height:20px;"/>
                            <i class="fa fa-calendar text-muted small"/>
                            <input type="date" class="form-control form-control-sm o_kx_date_input"
                                   t-att-value="params.date_from"
                                   t-on-change="(ev) => this.onDateChange('date_from', ev)"/>
                            <span class="text-muted small">—</span>
                            <input type="date" class="form-control form-control-sm o_kx_date_input"
                                   t-att-value="params.date_to"
                                   t-on-change="(ev) => this.onDateChange('date_to', ev)"/>
                        </div>
                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-sm o_kx_btn_excel" t-on-click="exportXlsx">
                                <i class="fa fa-file-excel-o me-1"/> Excel
                            </button>
                            <button type="button" class="btn btn-sm o_kx_btn_pdf" t-on-click="exportPdf">
                                <i class="fa fa-file-pdf-o me-1"/> PDF
                            </button>
                        </div>
                    </div>

                    <!-- Product search -->
                    <div class="o_kx_product_selector d-flex align-items-center gap-2 px-3 py-2 bg-white border-bottom">
                        <i class="fa fa-search text-muted"/>
                        <div class="o_kx_search_wrap position-relative flex-grow-1" style="max-width: 550px;">
                            <input type="text" class="form-control form-control-sm"
                                   t-ref="searchInput"
                                   t-att-placeholder="getActiveProductName()"
                                   t-att-value="state.dropdownOpen ? state.searchTerm : ''"
                                   t-on-input="onSearchInput"
                                   t-on-focus="onSearchFocus"
                                   t-on-keydown="onSearchKeydown"/>
                            <div t-if="state.dropdownOpen" class="o_kx_dropdown">
                                <t t-foreach="getFilteredSections()" t-as="item" t-key="item.product_id">
                                    <div t-att-class="'o_kx_dropdown_item' + (item.product_id === getSection()?.product_id ? ' active' : '')"
                                         t-on-click.stop="() => this.selectProduct(item)"
                                         t-esc="item.product_name"/>
                                </t>
                                <div t-if="!getFilteredSections().length" class="o_kx_dropdown_empty">
                                    Sin resultados
                                </div>
                            </div>
                        </div>
                        <span class="text-muted small text-nowrap">
                            (<t t-esc="state.data.sections.length"/> productos)
                        </span>
                    </div>

                    <t t-if="getSection()">
                        <!-- Product info strip -->
                        <div class="o_kx_info d-flex align-items-stretch bg-white border-bottom">
                            <div class="d-flex align-items-center gap-3 px-3 py-2 flex-shrink-0">
                                <div class="o_kx_icon_box d-flex align-items-center justify-content-center">
                                    <i class="fa fa-th-list fa-lg"/>
                                </div>
                                <div>
                                    <div class="o_kx_module_title">VALORACIÓN POR MÉTODO PROMEDIO</div>
                                    <div class="o_kx_product_link" role="button" t-on-click="onProductClick"
                                         t-esc="getSection().product_name"/>
                                </div>
                            </div>
                            <div class="d-flex flex-column justify-content-center px-3 py-2 small border-start">
                                <div class="fw-semibold" t-esc="state.data.company_name"/>
                                <div t-if="state.data.branch_name" class="text-primary fw-semibold">
                                    <i class="fa fa-building-o me-1"/><t t-esc="state.data.branch_name"/>
                                </div>
                                <div>Desde: <span t-esc="state.data.date_from_display"/></div>
                                <div>Hasta: <span t-esc="state.data.date_to_display"/></div>
                                <div t-if="getSection().categ_name">Categoría: <span t-esc="getSection().categ_name"/></div>
                            </div>
                            <div class="o_kx_prev_box ms-auto flex-shrink-0">
                                <div class="o_kx_prev_header">SALDO ANTERIOR</div>
                                <table class="o_kx_prev_table">
                                    <thead><tr><th>Cant.</th><th>Costo</th><th>Total</th></tr></thead>
                                    <tbody><tr>
                                        <td t-esc="fmt4(getSection().prev_balance.qty)"/>
                                        <td t-esc="fmt2(getSection().prev_balance.unit_cost)"/>
                                        <td t-esc="fmt2(getSection().prev_balance.total_value)"/>
                                    </tr></tbody>
                                </table>
                            </div>
                        </div>

                        <!-- Data table -->
                        <div class="flex-grow-1 overflow-auto">
                            <table class="o_kx_table">
                                <thead>
                                    <tr class="o_kx_hdr1">
                                        <th rowspan="2">Fecha</th>
                                        <th rowspan="2">Referencia</th>
                                        <th rowspan="2">Origen</th>
                                        <th rowspan="2">Contacto</th>
                                        <th colspan="3" class="text-center o_kx_bl">Entradas</th>
                                        <th colspan="3" class="text-center o_kx_bl">Salidas</th>
                                        <th colspan="3" class="text-center o_kx_bl">Saldos</th>
                                    </tr>
                                    <tr class="o_kx_hdr2">
                                        <th class="text-end o_kx_bl">Cant.</th>
                                        <th class="text-end">Costo Unit.</th>
                                        <th class="text-end">Total</th>
                                        <th class="text-end o_kx_bl">Cant.</th>
                                        <th class="text-end">Costo Unit.</th>
                                        <th class="text-end">Total</th>
                                        <th class="text-end o_kx_bl">Cant.</th>
                                        <th class="text-end">Costo Unit.</th>
                                        <th class="text-end">Total</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="getVisibleLines()" t-as="line" t-key="line_index">
                                        <tr t-att-class="line.row_type === 'opening' ? 'o_kx_opening' : ''">
                                            <td class="text-nowrap" t-esc="line.datetime_display"/>
                                            <td>
                                                <t t-if="line.ref_action">
                                                    <a href="#" class="o_kx_ref_link"
                                                       t-on-click="(ev) => this.onRefClick(ev, line)"
                                                       t-esc="line.reference"/>
                                                </t>
                                                <t t-else=""><span t-esc="line.reference"/></t>
                                            </td>
                                            <td class="o_kx_origin" t-esc="line.origin"/>
                                            <td t-esc="line.partner_name"/>
                                            <td class="text-end font-monospace o_kx_bl" t-esc="fmt2(line.in_qty)"/>
                                            <td class="text-end font-monospace" t-esc="fmt2(line.in_unit_cost)"/>
                                            <td class="text-end font-monospace" t-esc="fmt2(line.in_total)"/>
                                            <td class="text-end font-monospace o_kx_bl" t-esc="fmt2(line.out_qty)"/>
                                            <td class="text-end font-monospace" t-esc="fmt2(line.out_unit_cost)"/>
                                            <td class="text-end font-monospace" t-esc="fmt2(line.out_total)"/>
                                            <td t-att-class="'text-end font-monospace fw-semibold o_kx_bl' + negClass(line.bal_qty)" t-esc="fmt2(line.bal_qty)"/>
                                            <td t-att-class="'text-end font-monospace fw-semibold' + negClass(line.bal_unit_cost)" t-esc="fmt2(line.bal_unit_cost)"/>
                                            <td t-att-class="'text-end font-monospace fw-semibold' + negClass(line.bal_total)" t-esc="fmt2(line.bal_total)"/>
                                        </tr>
                                    </t>
                                </tbody>
                                <tfoot t-if="getSection().totals">
                                    <tr class="o_kx_foot">
                                        <td colspan="4" class="text-end fw-bold">Total</td>
                                        <td class="text-end font-monospace fw-bold o_kx_bl" t-esc="fmt2(getSection().totals.in_qty)"/>
                                        <td class="text-end font-monospace">0.00</td>
                                        <td class="text-end font-monospace">0.00</td>
                                        <td class="text-end font-monospace fw-bold o_kx_bl" t-esc="fmt2(getSection().totals.out_qty)"/>
                                        <td class="text-end font-monospace">0.00</td>
                                        <td class="text-end font-monospace">0.00</td>
                                        <td t-att-class="'text-end font-monospace fw-bold o_kx_bl' + negClass(getSection().totals.final_qty)" t-esc="fmt2(getSection().totals.final_qty)"/>
                                        <td t-att-class="'text-end font-monospace fw-bold' + negClass(getSection().totals.final_unit_cost)" t-esc="fmt2(getSection().totals.final_unit_cost)"/>
                                        <td t-att-class="'text-end font-monospace fw-bold' + negClass(getSection().totals.final_total)" t-esc="fmt2(getSection().totals.final_total)"/>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>

                        <!-- Pagination -->
                        <div class="o_kx_pager d-flex align-items-center justify-content-between px-3 py-2 border-top bg-white small">
                            <span class="text-muted">
                                <t t-esc="getPageFrom()"/>-<t t-esc="getPageTo()"/>
                                de <t t-esc="getTotalLines()"/> registros
                            </span>
                            <div class="d-flex align-items-center gap-2">
                                <span class="text-muted">
                                    Página <t t-esc="state.currentPage"/> de <t t-esc="getTotalPages()"/>
                                </span>
                                <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-1"
                                        t-on-click="prevPage"
                                        t-att-disabled="state.currentPage &lt;= 1">‹</button>
                                <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-1"
                                        t-on-click="nextPage"
                                        t-att-disabled="state.currentPage >= getTotalPages()">›</button>
                            </div>
                        </div>
                    </t>
                </t>

            </t>
        </div>
    </t>
</templates>
