<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_kardex_template">
        <t t-call="web.html_container">
            <t t-set="title" t-value="'Kardex — Método Promedio'"/>
            <style>
                .kdx { font-family: Lato, "DejaVu Sans", Arial, sans-serif; font-size: 9px; }
                .kdx h2 { color: #212529; font-size: 14px; margin: 0 0 4px 0; }
                .kdx h3 { color: #5B2C6F; font-size: 11px; margin: 16px 0 6px 0; }
                .kdx .meta { color: #666; font-size: 9px; margin-bottom: 8px; }
                .kdx table { width: 100%; border-collapse: collapse; margin-top: 6px; }
                .kdx th { background: #5B2C6F; color: #fff; padding: 5px 4px; text-align: center; font-size: 8px; border: 1px solid #4A2360; }
                .kdx td { padding: 4px; border: 1px solid #ccc; font-size: 8px; }
                .kdx .num { text-align: right; font-variant-numeric: tabular-nums; }
                .kdx .row-ini { background: #f0e6f3; font-weight: 600; }
            </style>
            <div class="page kdx">
                <h2>Kardex — Valoración por Método Promedio</h2>
                <div class="meta">
                    <span><t t-esc="company.name"/></span><br/>
                    Desde: <t t-esc="date_from"/> — Hasta: <t t-esc="date_to"/>
                </div>

                <t t-if="not sections">
                    <p>No hay movimientos en el periodo para los productos seleccionados.</p>
                </t>

                <t t-foreach="sections" t-as="sec">
                    <h3>
                        <t t-esc="sec['product'].display_name"/>
                        <span style="font-weight:normal; color:#555;"> —
                            Ud.: <t t-esc="sec['uom']"/>
                        </span>
                    </h3>
                    <table>
                        <thead>
                            <tr>
                                <th>Fecha</th>
                                <th>Referencia</th>
                                <th>Detalle</th>
                                <th>Entrada</th>
                                <th>Salida</th>
                                <th>Valor mov.</th>
                                <th>Saldo cant.</th>
                                <th>Saldo valor</th>
                                <th>CMUP</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="sec['lines']" t-as="line">
                                <tr t-att-class="'row-ini' if line.get('es_inicio') else ''">
                                    <td><t t-esc="line['date']"/></td>
                                    <td><t t-esc="line['reference']"/></td>
                                    <td><t t-esc="line['description']"/></td>
                                    <td class="num"><t t-esc="'{:,.4f}'.format(line['qty_in'])"/></td>
                                    <td class="num"><t t-esc="'{:,.4f}'.format(line['qty_out'])"/></td>
                                    <td class="num"><t t-esc="'{:,.2f}'.format(line['value_move'])"/></td>
                                    <td class="num"><t t-esc="'{:,.4f}'.format(line['balance_qty'])"/></td>
                                    <td class="num"><t t-esc="'{:,.2f}'.format(line['balance_value'])"/></td>
                                    <td class="num"><t t-esc="'{:,.6f}'.format(line['unit_cost'])"/></td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </t>
            </div>
        </t>
    </template>
</odoo>
