<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_kardex_summary_template">
        <t t-call="web.html_container">
            <t t-set="title" t-value="'Reporte Resumen Kardex'"/>
            <style>
                .kds {
                    font-family: Lato, "DejaVu Sans", Arial, sans-serif;
                    font-size: 9px;
                    color: #212529;
                }
                .kds h1 {
                    font-size: 22px;
                    font-weight: 300;
                    text-align: center;
                    margin: 6px 0 10px 0;
                    color: #212529;
                }
                .kds .dates {
                    display: flex;
                    justify-content: space-between;
                    font-size: 10px;
                    margin-bottom: 12px;
                    color: #333;
                }
                .kds table {
                    width: 100%;
                    border-collapse: collapse;
                    margin-bottom: 0;
                }
                .kds th {
                    background: #5B2C6F;
                    color: #fff;
                    padding: 6px 8px;
                    text-align: center;
                    font-size: 8.5px;
                    font-weight: 700;
                    text-transform: uppercase;
                    letter-spacing: 0.3px;
                    border: 1px solid #4A2360;
                }
                .kds td {
                    padding: 5px 8px;
                    border: 1px solid #ccc;
                    font-size: 8.5px;
                }
                .kds .num { text-align: right; font-variant-numeric: tabular-nums; }
                .kds .cat-hdr td {
                    background: #f5f5f5;
                    font-weight: 700;
                    font-size: 9px;
                    border-bottom: 2px solid #5B2C6F;
                    padding: 6px 8px;
                    color: #333;
                }
                .kds .cat-total td {
                    background: #e8e4ed;
                    font-weight: 700;
                    font-size: 8.5px;
                    border-top: 2px solid #5B2C6F;
                }
                .kds tbody tr:nth-child(even):not(.cat-hdr):not(.cat-total) {
                    background: #fafafa;
                }
            </style>
            <div class="page kds">
                <h1>Reporte Resumen Kardex — Método Promedio</h1>
                <div class="dates">
                    <span>Fecha Inicio: <t t-esc="date_from"/> 00:00:00</span>
                    <span>Fecha Fin: <t t-esc="date_to"/> 23:59:59</span>
                </div>

                <t t-if="not categories">
                    <p>No hay movimientos en el periodo para los productos seleccionados.</p>
                </t>

                <t t-if="categories">
                    <table>
                        <thead>
                            <tr>
                                <th style="text-align:left; min-width:200px;">PRODUCTO</th>
                                <th>SALDO INICIAL</th>
                                <th>ENTRADAS</th>
                                <th>SALIDAS</th>
                                <th>SALDO FINAL</th>
                                <th>COSTO UNIT. FINAL</th>
                                <th>TOTAL FINAL</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="categories" t-as="cat">
                                <tr class="cat-hdr">
                                    <td colspan="7">
                                        Categoría: <t t-esc="cat['name']"/>
                                    </td>
                                </tr>
                                <t t-foreach="cat['rows']" t-as="r">
                                    <tr>
                                        <td><t t-esc="r['product'].display_name"/></td>
                                        <td class="num"><t t-esc="'{:,.2f}'.format(r['opening_qty'])"/></td>
                                        <td class="num"><t t-esc="'{:,.2f}'.format(r['incoming'])"/></td>
                                        <td class="num"><t t-esc="'{:,.2f}'.format(r['outgoing'])"/></td>
                                        <td class="num"><t t-esc="'{:,.2f}'.format(r['closing_qty'])"/></td>
                                        <td class="num"><t t-esc="'{:,.2f}'.format(r['closing_unit_cost'])"/></td>
                                        <td class="num"><t t-esc="'{:,.2f}'.format(r['closing_total'])"/></td>
                                    </tr>
                                </t>
                                <tr class="cat-total">
                                    <td style="text-align:right; font-weight:bold;">Total</td>
                                    <td class="num"><t t-esc="'{:,.2f}'.format(cat['opening'])"/></td>
                                    <td class="num"><t t-esc="'{:,.2f}'.format(cat['incoming'])"/></td>
                                    <td class="num"><t t-esc="'{:,.2f}'.format(cat['outgoing'])"/></td>
                                    <td class="num"><t t-esc="'{:,.2f}'.format(cat['closing_qty'])"/></td>
                                    <td class="num">-</td>
                                    <td class="num"><t t-esc="'{:,.2f}'.format(cat['closing_total'])"/></td>
                                </tr>
                                <tr><td colspan="7" style="border:none; padding:2px;"/></tr>
                            </t>
                        </tbody>
                    </table>
                </t>
            </div>
        </t>
    </template>
</odoo>
