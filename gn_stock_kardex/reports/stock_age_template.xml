<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_stock_age_template">
        <t t-call="web.html_container">
            <t t-set="title" t-value="'Reporte de Antigüedad de Stock'"/>
            <style>
                .sab {
                    font-family: Lato, "DejaVu Sans", Arial, sans-serif;
                    font-size: 8px;
                    color: #212529;
                }
                .sab h1 {
                    font-size: 18px;
                    font-weight: 300;
                    text-align: center;
                    margin: 4px 0 8px 0;
                }
                .sab .meta {
                    font-size: 9px;
                    margin-bottom: 10px;
                    color: #555;
                }
                .sab table {
                    width: 100%;
                    border-collapse: collapse;
                }
                .sab th {
                    background: #1a1a2e;
                    color: #fff;
                    padding: 4px 6px;
                    text-align: center;
                    font-size: 7.5px;
                    font-weight: 700;
                    border: 1px solid #333;
                }
                .sab td {
                    padding: 3px 5px;
                    border: 1px solid #ccc;
                    font-size: 7.5px;
                }
                .sab .num { text-align: right; font-variant-numeric: tabular-nums; }
                .sab tbody tr:nth-child(even) { background: #fafafa; }
            </style>
            <div class="page sab">
                <h1>Reporte de Antigüedad de Stock</h1>
                <div class="meta">
                    <strong>Compañía:</strong> <t t-esc="wizard.company_id.name"/>
                    <t t-if="wizard.warehouse_id">
                        | <strong>Almacén:</strong> <t t-esc="wizard.warehouse_id.name"/>
                    </t>
                    | <strong>Desglose:</strong> <t t-esc="wizard.breakdown_days"/> días
                </div>

                <t t-if="not rows">
                    <p>No hay datos de stock para los filtros seleccionados.</p>
                </t>

                <t t-if="rows">
                    <table>
                        <thead>
                            <tr>
                                <th rowspan="2" style="text-align:left; min-width:140px;">Producto</th>
                                <th rowspan="2" style="text-align:left;">Categoría</th>
                                <th rowspan="2">Stock Total</th>
                                <th rowspan="2">Valor Stock</th>
                                <t t-foreach="bracket_labels" t-as="bl">
                                    <th colspan="2"><t t-esc="bl"/></th>
                                </t>
                            </tr>
                            <tr>
                                <t t-foreach="bracket_labels" t-as="bl">
                                    <th>Stock</th>
                                    <th>Valor</th>
                                </t>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="rows" t-as="r">
                                <tr>
                                    <td><t t-esc="r['product_name']"/></td>
                                    <td><t t-esc="r['categ_name']"/></td>
                                    <td class="num"><t t-esc="'{:,.2f}'.format(r['total_stock'])"/></td>
                                    <td class="num"><t t-esc="'{:,.2f}'.format(r['stock_value'])"/></td>
                                    <t t-foreach="r['buckets']" t-as="bk">
                                        <td class="num"><t t-esc="'{:,.2f}'.format(bk['stock'])"/></td>
                                        <td class="num"><t t-esc="'{:,.2f}'.format(bk['value'])"/></td>
                                    </t>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </t>
            </div>
        </t>
    </template>
</odoo>
