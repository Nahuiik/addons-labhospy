<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_elearning_html_import_wizard_form" model="ir.ui.view">
        <field name="name">elearning.html.import.wizard.form</field>
        <field name="model">elearning.html.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Importar plantilla HTML">
                <sheet>
                    <group>
                        <field name="slide_id" readonly="1"/>
                    </group>
                    <group>
                        <field name="file_name" required="1"/>
                        <field name="upload_file" filename="file_name" required="1"/>
                    </group>
                    <p class="text-muted">
                        Sube un ZIP que contenga un archivo <b>index.html</b>, una carpeta <code>images/</code>
                        con recursos y opcionalmente <code>assets/</code> para CSS o JS. Peso máximo: 25 MB.
                    </p>
                </sheet>
                <footer>
                    <button
                        name="action_import_template"
                        string="Importar"
                        type="object"
                        class="btn-primary"
                    />
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
