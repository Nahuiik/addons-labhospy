<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_powerbi_sync_log_tree" model="ir.ui.view">
        <field name="name">powerbi.sync.log.tree</field>
        <field name="model">powerbi.sync.log</field>
        <field name="arch" type="xml">
            <list string="Logs de Sincronización">
                <field name="sync_datetime"/>
                <field name="table_id"/>
                <field name="model_id"/>
                <field name="res_id"/>
                <field name="operation"/>
                <field name="state" widget="badge" decoration-success="state == 'success'" decoration-danger="state == 'failed'"/>
            </list>
        </field>
    </record>

    <record id="view_powerbi_sync_log_search" model="ir.ui.view">
        <field name="name">powerbi.sync.log.search</field>
        <field name="model">powerbi.sync.log</field>
        <field name="arch" type="xml">
            <search string="Buscar Logs">
                <field name="table_id"/>
                <field name="model_id"/>
                <field name="res_id"/>
                <field name="operation"/>
                <field name="state"/>
                <filter string="Éxito" name="success" domain="[('state', '=', 'success')]"/>
                <filter string="Error" name="failed" domain="[('state', '=', 'failed')]"/>
            </search>
        </field>
    </record>

    <record id="action_powerbi_sync_log" model="ir.actions.act_window">
        <field name="name">Logs de Sincronización</field>
        <field name="res_model">powerbi.sync.log</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="view_powerbi_sync_log_search"/>
    </record>
</odoo>

