<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_powerbi_workspace_tree" model="ir.ui.view">
        <field name="name">powerbi.workspace.tree</field>
        <field name="model">powerbi.workspace</field>
        <field name="arch" type="xml">
            <list string="Workspaces Power BI">
                <field name="name"/>
                <field name="is_default" widget="boolean_toggle"/>
                <field name="user_id"/>
                <field name="dataset_count"/>
                <field name="connection_id"/>
            </list>
        </field>
    </record>

    <record id="view_powerbi_workspace_form" model="ir.ui.view">
        <field name="name">powerbi.workspace.form</field>
        <field name="model">powerbi.workspace</field>
        <field name="arch" type="xml">
            <form string="Workspace Power BI">
                <header>
                    <button name="action_sync_from_remote" string="Sincronizar desde Power BI" type="object" class="btn-primary"/>
                    <button name="action_export_to_powerbi" string="Exportar a Power BI" type="object"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="pbi_workspace_id"/>
                            <field name="is_default" widget="boolean_toggle"/>
                        </group>
                        <group>
                            <field name="connection_id"/>
                            <field name="user_id"/>
                            <field name="dataset_count"/>
                        </group>
                    </group>
                    <field name="dataset_ids" nolabel="1">
                        <list>
                            <field name="name"/>
                            <field name="type"/>
                            <field name="state" widget="badge"/>
                            <field name="table_count"/>
                        </list>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_powerbi_workspace" model="ir.actions.act_window">
        <field name="name">Workspaces Power BI</field>
        <field name="res_model">powerbi.workspace</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_connection_id': False}</field>
    </record>
</odoo>

