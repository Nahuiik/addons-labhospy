<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_powerbi_table_template_tree" model="ir.ui.view">
        <field name="name">powerbi.table.template.tree</field>
        <field name="model">powerbi.table.template</field>
        <field name="arch" type="xml">
            <list string="Plantillas de Tablas">
                <field name="name"/>
                <field name="model_id"/>
                <field name="is_public" widget="boolean_toggle"/>
                <field name="times_used"/>
                <field name="created_by"/>
            </list>
        </field>
    </record>

    <record id="view_powerbi_table_template_form" model="ir.ui.view">
        <field name="name">powerbi.table.template.form</field>
        <field name="model">powerbi.table.template</field>
        <field name="arch" type="xml">
            <form string="Plantilla de Tabla">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="model_id" options="{'no_create': True}"/>
                            <field name="is_public" widget="boolean_toggle"/>
                        </group>
                        <group>
                            <field name="created_by" readonly="1"/>
                            <field name="times_used" readonly="1"/>
                        </group>
                    </group>
                    <field name="description" placeholder="Descripción de la plantilla y su uso"/>
                    <field name="template_definition" readonly="1" nolabel="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_powerbi_table_template" model="ir.actions.act_window">
        <field name="name">Plantillas de Tablas</field>
        <field name="res_model">powerbi.table.template</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>

