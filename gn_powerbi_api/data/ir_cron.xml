<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Cron job para exportación automática -->
        <record id="ir_cron_powerbi_export_tables" model="ir.cron">
            <field name="name">Power BI: Exportar Tablas</field>
            <field name="model_id" ref="model_powerbi_table"/>
            <field name="state">code</field>
            <field name="code">model._cron_export_tables()</field>
            <field name="interval_number">15</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
            <field name="user_id" ref="base.user_root"/>
        </record>
    </data>
</odoo>

