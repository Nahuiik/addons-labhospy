<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Parámetros de configuración por defecto -->
        <record id="ir_config_parameter_powerbi_default_batch_size" model="ir.config_parameter">
            <field name="key">powerbi_default_batch_size</field>
            <field name="value">10000</field>
        </record>

        <record id="ir_config_parameter_powerbi_default_cron_mode" model="ir.config_parameter">
            <field name="key">powerbi_default_cron_mode</field>
            <field name="value">incremental</field>
        </record>

        <record id="ir_config_parameter_powerbi_use_write_date_default" model="ir.config_parameter">
            <field name="key">powerbi_use_write_date_default</field>
            <field name="value">True</field>
        </record>

        <record id="ir_config_parameter_powerbi_slow_export_threshold" model="ir.config_parameter">
            <field name="key">powerbi_slow_export_threshold</field>
            <field name="value">120</field>
        </record>

        <record id="ir_config_parameter_powerbi_low_record_threshold" model="ir.config_parameter">
            <field name="key">powerbi_low_record_threshold</field>
            <field name="value">10</field>
        </record>

        <record id="ir_config_parameter_powerbi_preview_limit" model="ir.config_parameter">
            <field name="key">powerbi_preview_limit</field>
            <field name="value">100</field>
        </record>

        <record id="ir_config_parameter_powerbi_token_expiration_buffer" model="ir.config_parameter">
            <field name="key">powerbi_token_expiration_buffer</field>
            <field name="value">300</field>
        </record>

        <record id="ir_config_parameter_powerbi_alert_window_hours" model="ir.config_parameter">
            <field name="key">powerbi_alert_window_hours</field>
            <field name="value">24</field>
        </record>

        <record id="ir_config_parameter_powerbi_enable_auto_alerts" model="ir.config_parameter">
            <field name="key">powerbi_enable_auto_alerts</field>
            <field name="value">True</field>
        </record>

        <record id="ir_config_parameter_powerbi_show_advanced_alerts" model="ir.config_parameter">
            <field name="key">powerbi_show_advanced_alerts</field>
            <field name="value">False</field>
        </record>
    </data>
</odoo>

