<odoo>

    <record id="view_move_form_inherit_analytic_invoice" model="ir.ui.view">
        <field name="name">account.move.form.inherit.gn.analytic.invoice</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">

            <!-- Plantilla de factura de proveedor: antes del notebook -->
            <xpath expr="//notebook" position="before">
                <group invisible="move_type not in ('in_invoice', 'in_refund') or state != 'draft'"
                       groups="analytic.group_analytic_accounting">
                    <group>
                        <label for="vendor_invoice_template_id"/>
                        <div>
                            <field name="vendor_invoice_template_id"
                                   string="Plantilla de Factura"
                                   class="oe_inline"/>
                            <field name="applied_vendor_invoice_template_id" invisible="1"/>
                            <button name="action_apply_invoice_template"
                                    type="object"
                                    string="→ Aplicar"
                                    class="oe_inline fa fa-arrow-right oe_link"
                                    invisible="not vendor_invoice_template_id or vendor_invoice_template_id == applied_vendor_invoice_template_id"/>
                        </div>
                    </group>
                </group>
            </xpath>

            <!-- Distribución analítica cabecera -->
            <xpath expr="//group[@id='header_right_group']" position="inside">
                <label for="header_analytic_dist_template_id"
                       invisible="move_type not in ('in_invoice', 'in_refund')"
                       groups="analytic.group_analytic_accounting"/>
                <div invisible="move_type not in ('in_invoice', 'in_refund')"
                     groups="analytic.group_analytic_accounting">
                    <field name="header_analytic_dist_template_id"
                           string="Plantilla Distribución"
                           readonly="state != 'draft'"
                           class="oe_inline"/>
                    <field name="applied_header_analytic_dist_template_id" invisible="1"/>
                    <button name="action_apply_analytic_distribution"
                            type="object"
                            string="→ Aplicar"
                            class="oe_inline fa fa-arrow-right oe_link"
                            invisible="not header_analytic_dist_template_id or state != 'draft' or header_analytic_dist_template_id == applied_header_analytic_dist_template_id"/>
                </div>
                <field name="header_analytic_distribution" invisible="1"/>
            </xpath>

            <!-- Plantilla de distribución por línea -->
            <xpath expr="//field[@name='invoice_line_ids']//field[@name='analytic_distribution']" position="before">
                <field name="analytic_dist_template_id"
                       string="Plantilla Dist."
                       optional="show"
                       groups="analytic.group_analytic_accounting"
                       column_invisible="parent.move_type not in ('in_invoice', 'in_refund')"
                       invisible="parent.move_type not in ('in_invoice', 'in_refund')"/>
            </xpath>

        </field>
    </record>

</odoo>
