<odoo>

    <record id="view_vendor_invoice_template_list" model="ir.ui.view">
        <field name="name">vendor.invoice.template.list</field>
        <field name="model">vendor.invoice.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="journal_id"/>
                <field name="analytic_distribution" widget="analytic_distribution"
                       options="{'business_domain': 'bill'}"/>
                <field name="company_id" optional="hide" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_vendor_invoice_template_form" model="ir.ui.view">
        <field name="name">vendor.invoice.template.form</field>
        <field name="model">vendor.invoice.template</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Nombre de la plantilla"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="journal_id"/>
                            <field name="currency_id" groups="base.group_multi_currency"/>
                        </group>
                        <group>
                            <field name="active"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="analytic_dist_template_id"/>
                            <field name="analytic_distribution" widget="analytic_distribution"
                                   options="{'business_domain': 'bill'}"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Líneas de Factura" name="lines">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="product_id"/>
                                    <field name="name"/>
                                    <field name="account_id"/>
                                    <field name="quantity"/>
                                    <field name="price_unit"/>
                                    <field name="tax_ids" widget="many2many_tags"/>
                                    <field name="analytic_dist_template_id" optional="show"/>
                                    <field name="analytic_distribution" widget="analytic_distribution"
                                           options="{'business_domain': 'bill'}" optional="show"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_vendor_invoice_template" model="ir.actions.act_window">
        <field name="name">Plantillas de Factura de Proveedor</field>
        <field name="res_model">vendor.invoice.template</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_vendor_invoice_template"
              name="Plantillas de Factura de Proveedor"
              parent="account.menu_analytic_accounting"
              action="action_vendor_invoice_template"
              sequence="31"/>

</odoo>
