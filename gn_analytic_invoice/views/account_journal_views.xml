<odoo>

    <record id="view_account_journal_form_inherit_analytic" model="ir.ui.view">
        <field name="name">account.journal.form.inherit.gn.analytic.invoice</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form"/>
        <field name="arch" type="xml">
            <field name="refund_sequence" position="before">
                <field name="analytic_precision" invisible="1"/>
                <field name="analytic_distribution"
                       widget="analytic_distribution"
                       options="{'business_domain': 'invoice'}"
                       invisible="type != 'sale'"
                       groups="analytic.group_analytic_accounting"/>
            </field>
        </field>
    </record>

</odoo>
