<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Agregar chatter al form view de tipos de activos -->
    <record id="view_account_asset_category_form_inherit_chatter" model="ir.ui.view">
        <field name="name">account.asset.category.form.inherit.chatter</field>
        <field name="model">account.asset.category</field>
        <field name="inherit_id" ref="bi_account_asset.view_account_asset_category_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="after">
                <chatter/>
            </xpath>
        </field>
    </record>

</odoo>
