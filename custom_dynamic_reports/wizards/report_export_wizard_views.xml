<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_dynamic_report_export_wizard" model="ir.ui.view">
        <field name="name">dynamic.report.export.wizard.form</field>
        <field name="model">dynamic.report.export.wizard</field>
        <field name="arch" type="xml">
            <form string="Export Report" create="false" edit="false">
                <group>
                    <field name="report_id" readonly="1"/>
                    <field name="export_format"/>
                </group>
                <footer>
                    <button string="Export" type="object" name="action_export" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
