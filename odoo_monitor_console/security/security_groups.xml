<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Categoría del módulo -->
        <record id="module_category_monitor_console" model="ir.module.category">
            <field name="name">Monitoreo Consola</field>
            <field name="description">Permisos para consola central de monitoreo</field>
            <field name="sequence">100</field>
        </record>

        <!-- Privilegio principal -->
        <record id="privilege_monitor_console" model="res.groups.privilege">
            <field name="name">Consola de Monitoreo</field>
            <field name="category_id" ref="module_category_monitor_console"/>
            <field name="sequence">10</field>
        </record>

        <!-- Grupo para usuarios de monitoreo (solo lectura) -->
        <record id="group_monitor_console_user" model="res.groups">
            <field name="name">Usuario</field>
            <field name="comment">Acceso de solo lectura a datos de monitoreo centralizado</field>
            <field name="privilege_id" ref="privilege_monitor_console"/>
            <field name="sequence">10</field>
        </record>

        <!-- Grupo para administradores de monitoreo -->
        <record id="group_monitor_console_admin" model="res.groups">
            <field name="name">Administrador</field>
            <field name="comment">Acceso completo a configuración y datos de monitoreo centralizado</field>
            <field name="privilege_id" ref="privilege_monitor_console"/>
            <field name="sequence">20</field>
            <field name="implied_ids" eval="[(4, ref('group_monitor_console_user'))]"/>
        </record>
    </data>
</odoo>

