<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Cron para sincronizar todas las instancias -->
        <record id="ir_cron_sync_instances" model="ir.cron">
            <field name="name">Sincronizar Instancias de Monitoreo</field>
            <field name="model_id" ref="model_monitor_instance"/>
            <field name="state">code</field>
            <field name="code">model.sync_all_instances()</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
            <field name="user_id" ref="base.user_root"/>
        </record>
    </data>
</odoo>

