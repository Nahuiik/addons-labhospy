<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista de lista para instancias -->
    <record id="view_monitor_instance_tree" model="ir.ui.view">
        <field name="name">monitor.instance.list</field>
        <field name="model">monitor.instance</field>
        <field name="arch" type="xml">
            <list string="Instancias" decoration-success="is_online == True" decoration-danger="is_online == False">
                <field name="name"/>
                <field name="url"/>
                <field name="version"/>
                <field name="db_name"/>
                <field name="is_online" widget="boolean_toggle"/>
                <field name="last_sync"/>
                <field name="last_sync_status" widget="badge" 
                       decoration-success="last_sync_status == 'success'"
                       decoration-danger="last_sync_status == 'error'"
                       decoration-muted="last_sync_status == 'never'"/>
                <field name="active" invisible="1"/>
            </list>
        </field>
    </record>

    <!-- Vista de formulario para instancias -->
    <record id="view_monitor_instance_form" model="ir.ui.view">
        <field name="name">monitor.instance.form</field>
        <field name="model">monitor.instance</field>
        <field name="arch" type="xml">
            <form string="Instancia Odoo">
                <header>
                    <button name="action_test_connection" string="Probar Conexión" type="object" class="oe_highlight"/>
                    <button name="sync_instance" string="Sincronizar Ahora" type="object" class="btn-primary"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="url"/>
                            <field name="token" password="True"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="version" readonly="1"/>
                            <field name="db_name" readonly="1"/>
                            <field name="hostname" readonly="1"/>
                            <field name="is_online" widget="boolean_toggle" readonly="1"/>
                            <field name="strategy"/>
                            <field name="sync_interval"/>
                        </group>
                    </group>
                    <group string="Estado de Sincronización">
                        <group>
                            <field name="last_sync" readonly="1"/>
                            <field name="last_sync_status" readonly="1" widget="badge"/>
                        </group>
                        <group>
                            <field name="last_sync_error" readonly="1" widget="text" nolabel="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vista de búsqueda -->
    <record id="view_monitor_instance_search" model="ir.ui.view">
        <field name="name">monitor.instance.search</field>
        <field name="model">monitor.instance</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="url"/>
                <field name="db_name"/>
                <filter string="Activas" name="active" domain="[('active', '=', True)]"/>
                <filter string="En Línea" name="online" domain="[('is_online', '=', True)]"/>
                <filter string="Con Error" name="error" domain="[('last_sync_status', '=', 'error')]"/>
                <separator/>
                <filter string="Sin Sincronizar" name="never_synced" domain="[('last_sync_status', '=', 'never')]"/>
            </search>
        </field>
    </record>

    <!-- Acción para vista de lista -->
    <record id="action_monitor_instance" model="ir.actions.act_window">
        <field name="name">Instancias Odoo</field>
        <field name="res_model">monitor.instance</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_monitor_instance_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No hay instancias configuradas aún
            </p>
            <p>
                Configure las instancias Odoo remotas que desea monitorear.
                Cada instancia debe tener instalado el módulo odoo_instance_agent.
            </p>
        </field>
    </record>

    <!-- Vista Kanban para dashboard -->
    <record id="view_monitor_instance_kanban" model="ir.ui.view">
        <field name="name">monitor.instance.kanban</field>
        <field name="model">monitor.instance</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_dashboard">
                <field name="name"/>
                <field name="is_online"/>
                <field name="last_sync"/>
                <field name="last_sync_status"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_content">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="name"/>
                                        </strong>
                                    </div>
                                </div>
                                <div class="o_kanban_record_body">
                                    <div>
                                        <span>Estado: </span>
                                        <field name="is_online" widget="boolean_toggle"/>
                                    </div>
                                    <div>
                                        <span>Última sync: </span><field name="last_sync"/>
                                    </div>
                                    <div>
                                        <field name="last_sync_status" widget="badge"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
</odoo>

