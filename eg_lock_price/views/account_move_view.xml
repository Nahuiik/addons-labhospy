<odoo>
    <record id="account_invoice_lock_price_form_view" model="ir.ui.view">
        <field name="name">account.invoice.lock.price.form.view</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='price_unit']" position="attributes">
                <attribute name="readonly">readonly_price</attribute>
            </xpath>
        </field>
    </record>
</odoo>
