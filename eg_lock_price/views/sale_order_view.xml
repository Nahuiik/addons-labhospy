<odoo>
    <record id="sale_order_lock_price_form_view" model="ir.ui.view">
        <field name="name">sale.order.lock.price.form.view</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list/field[@name='price_unit']" position="attributes">
                <attribute name="readonly">readonly_price</attribute>
            </xpath>
        </field>
    </record>
</odoo>
