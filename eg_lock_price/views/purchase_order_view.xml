<odoo>
    <record id="purchase_order_lock_price_form_view" model="ir.ui.view">
        <field name="name">purchase.order.lock.price.form.view</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list/field[@name='price_unit']" position="attributes">
                <attribute name="readonly">readonly_price</attribute>
            </xpath>
        </field>
    </record>
</odoo>
