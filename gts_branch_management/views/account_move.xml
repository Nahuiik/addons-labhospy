<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!--
        Duplicado de «Diario»: ver l10n_hn_account (vista que elimina el journal_id técnico
        invisible bajo sheet). No duplicar aquí para no chocar con el mismo xpath.
    -->

    <record id="view_account_invoice_branch_form" model="ir.ui.view">
        <field name="name">account.invoice.branch.inherited</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <field name="payment_reference" position="after">
                <field name="gts_no_exigir_sucursal" widget="boolean_toggle"/>
                <field name="branch_id" string="Sucursal"
                       options='{"no_open": True,"no_create": 1, "no_create_edit": 1}'
                       required="not gts_no_exigir_sucursal"/>
                <field name="comment" invisible="1"/>
            </field>
        </field>
    </record>

    <record id="view_account_move_line_form" model="ir.ui.view">
        <field name="name">account.move.form.branch.hidden</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='journal_div']/field[@name='journal_id']" position="after">
                <field name="responsable_branch" invisible="1"/>
                <field name="style" invisible="1" options='{"no_create": 1, "no_create_edit": 1}'/>
            </xpath>
        </field>
    </record>

    <record id="view_account_move_line_tree_branch" model="ir.ui.view">
        <field name="name">account.move.line.tree.branch</field>
        <field name="model">account.move.line</field>
        <field name="inherit_id" ref="account.view_move_line_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="branch_id" optional="show"
                       options='{"no_open": True, "no_create": 1, "no_create_edit": 1}'/>
            </xpath>
        </field>
    </record>
</odoo>
