<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Acciones de informes (OWL) -->
    <record id="general_ledger_action" model="ir.actions.client">
        <field name="name">Libro mayor</field>
        <field name="tag">bi_account_report</field>
        <field name="context">{'report_type': 'general_ledger'}</field>
    </record>

    <record id="partner_ledger_action" model="ir.actions.client">
        <field name="name">Libro mayor de la empresa</field>
        <field name="tag">bi_account_report</field>
        <field name="context">{'report_type': 'partner_ledger'}</field>
    </record>

    <record id="customer_statement_action" model="ir.actions.client">
        <field name="name">Estado de cuenta del cliente</field>
        <field name="tag">bi_account_report</field>
        <field name="context">{'report_type': 'partner_ledger', 'report_variant': 'customer_statement', 'filter_options': {'account_type_ids': ['trade_receivable']}}</field>
    </record>

    <record id="analytic_report_action" model="ir.actions.client">
        <field name="name">Reporte analítico</field>
        <field name="tag">bi_account_report</field>
        <field name="context">{'report_type': 'analytic_report'}</field>
    </record>

    <record id="trial_balance_action" model="ir.actions.client">
        <field name="name">Balance de comprobación</field>
        <field name="tag">bi_account_report</field>
        <field name="context">{'report_type': 'trial_balance'}</field>
    </record>

    <record id="partner_ageing_receivable_action" model="ir.actions.client">
        <field name="name">Cuenta por cobrar vencida</field>
        <field name="tag">bi_account_report</field>
        <field name="context">{'report_type': 'partner_ageing', 'filter_options': {'account_type': 'receivable', 'target_move': 'posted'}}</field>
    </record>

    <record id="partner_ageing_payable_action" model="ir.actions.client">
        <field name="name">Cuenta por pagar vencida</field>
        <field name="tag">bi_account_report</field>
        <field name="context">{'report_type': 'partner_ageing', 'filter_options': {'account_type': 'payable', 'target_move': 'posted'}}</field>
    </record>

    <!-- Compatibilidad: acción legacy combinada -->
    <record id="partner_ageing_report_action" model="ir.actions.client">
        <field name="name">Reporte de seguimiento</field>
        <field name="tag">bi_account_report</field>
        <field name="context">{'report_type': 'partner_ageing'}</field>
    </record>

    <record id="profit_and_loss_action" model="ir.actions.client">
        <field name="name">Estado de Resultados</field>
        <field name="tag">bi_account_report</field>
        <field name="context">{'report_type': 'profit_and_loss'}</field>
    </record>

    <record id="balance_sheet_action" model="ir.actions.client">
        <field name="name">Balance general</field>
        <field name="tag">bi_account_report</field>
        <field name="context">{'report_type': 'balance_sheet'}</field>
    </record>

    <record id="executive_summary_action" model="ir.actions.client">
        <field name="name">Resumen ejecutivo</field>
        <field name="tag">bi_account_report</field>
        <field name="context">{'report_type': 'executive_summary'}</field>
    </record>

    <record id="cash_flow_action" model="ir.actions.client">
        <field name="name">Estado de flujo de efectivo</field>
        <field name="tag">bi_account_report</field>
        <field name="context">{'report_type': 'cash_flow'}</field>
    </record>

    <record id="bank_reconciliation_action" model="ir.actions.client">
        <field name="name">Conciliación bancaria</field>
        <field name="tag">bi_account_report</field>
        <field name="context">{'report_type': 'bank_reconciliation'}</field>
    </record>

    <record id="tax_report_action" model="ir.actions.client">
        <field name="name">Reporte fiscal</field>
        <field name="tag">bi_account_report</field>
        <field name="context">{'report_type': 'tax_report'}</field>
    </record>

    <record id="tax_return_action" model="ir.actions.client">
        <field name="name">Declaración fiscal</field>
        <field name="tag">bi_account_report</field>
        <field name="context">{'report_type': 'tax_return'}</field>
    </record>

    <!-- Etiquetas de sección estilo Enterprise (español) -->
    <record id="account.menu_finance_reports" model="ir.ui.menu">
        <field name="name">Reportes</field>
    </record>
    <record id="account.account_reports_legal_statements_menu" model="ir.ui.menu">
        <field name="name">Reportes de estados de cuenta</field>
        <field name="sequence">1</field>
    </record>
    <record id="account.account_reports_partners_reports_menu" model="ir.ui.menu">
        <field name="name">Reportes del contacto</field>
        <field name="sequence">3</field>
    </record>
    <record id="account.account_reports_taxes_and_fiscal_menu" model="ir.ui.menu">
        <field name="name">Impuestos y finanzas</field>
        <field name="sequence">4</field>
    </record>
    <record id="account.account_reports_management_menu" model="ir.ui.menu">
        <field name="name">Gestión</field>
        <field name="sequence">5</field>
    </record>

    <!-- Libros contables (Enterprise: Ledgers) -->
    <menuitem id="menu_bi_accounting_ledgers"
              name="Libros contables"
              parent="account.menu_finance_reports"
              sequence="2"
              groups="account.group_account_readonly,account.group_account_invoice"/>

    <!-- Reportes de estados de cuenta -->
    <menuitem id="menu_balance_sheet"
              name="Balance general"
              parent="account.account_reports_legal_statements_menu"
              action="balance_sheet_action"
              sequence="1"
              groups="account.group_account_readonly,account.group_account_basic"/>
    <menuitem id="menu_profit_and_loss"
              name="Estado de Resultados"
              parent="account.account_reports_legal_statements_menu"
              action="profit_and_loss_action"
              sequence="2"
              groups="account.group_account_readonly,account.group_account_basic"/>
    <menuitem id="menu_cash_flow"
              name="Estado de flujo de efectivo"
              parent="account.account_reports_legal_statements_menu"
              action="cash_flow_action"
              sequence="3"
              groups="account.group_account_readonly,account.group_account_basic"/>

    <!-- Libros contables -->
    <menuitem id="menu_trial_balance"
              name="Balance de comprobación"
              parent="menu_bi_accounting_ledgers"
              action="trial_balance_action"
              sequence="1"
              groups="account.group_account_readonly,account.group_account_basic"/>
    <menuitem id="menu_general_ledger"
              name="Libro mayor"
              parent="menu_bi_accounting_ledgers"
              action="general_ledger_action"
              sequence="2"
              groups="account.group_account_readonly,account.group_account_basic"/>

    <!-- Reportes del contacto -->
    <menuitem id="menu_partner_ledger"
              name="Libro mayor de la empresa"
              parent="account.account_reports_partners_reports_menu"
              action="partner_ledger_action"
              sequence="1"
              groups="account.group_account_readonly,account.group_account_basic"/>
    <menuitem id="menu_customer_statement"
              name="Estado de cuenta del cliente"
              parent="account.account_reports_partners_reports_menu"
              action="customer_statement_action"
              sequence="2"
              groups="account.group_account_readonly,account.group_account_basic"/>
    <menuitem id="menu_aged_receivable"
              name="Cuenta por cobrar vencida"
              parent="account.account_reports_partners_reports_menu"
              action="partner_ageing_receivable_action"
              sequence="3"
              groups="account.group_account_readonly,account.group_account_basic"/>
    <menuitem id="menu_aged_payable"
              name="Cuenta por pagar vencida"
              parent="account.account_reports_partners_reports_menu"
              action="partner_ageing_payable_action"
              sequence="4"
              groups="account.group_account_readonly,account.group_account_basic"/>

    <!-- Impuestos y finanzas -->
    <menuitem id="menu_tax_return"
              name="Declaración fiscal"
              parent="account.account_reports_taxes_and_fiscal_menu"
              action="tax_return_action"
              sequence="1"
              groups="account.group_account_readonly,account.group_account_basic"/>
    <menuitem id="menu_tax_report"
              name="Reporte fiscal"
              parent="account.account_reports_taxes_and_fiscal_menu"
              action="tax_report_action"
              sequence="2"
              groups="account.group_account_readonly,account.group_account_basic"/>

    <!-- Gestión -->
    <menuitem id="menu_analytic_report"
              name="Reporte analítico"
              parent="account.account_reports_management_menu"
              action="analytic_report_action"
              sequence="2"
              groups="account.group_account_readonly"/>
    <menuitem id="menu_executive_summary"
              name="Resumen ejecutivo"
              parent="account.account_reports_management_menu"
              action="executive_summary_action"
              sequence="3"
              groups="account.group_account_readonly,account.group_account_basic"/>
    <menuitem id="menu_bank_reconciliation"
              name="Conciliación bancaria"
              parent="account.account_reports_management_menu"
              action="bank_reconciliation_action"
              sequence="4"
              groups="account.group_account_readonly"/>

    <!-- Ocultar contenedor plano legacy -->
    <record id="menu_financial_reports" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>
    <record id="menu_partner_ageing_report" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>
</odoo>
