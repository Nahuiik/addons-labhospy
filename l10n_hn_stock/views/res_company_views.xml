<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_inherit_l10n_hn_stock_journal" model="ir.ui.view">
        <field name="name">res.company.form.inherit.l10n.hn.stock.journal</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Inventario (contabilidad)" name="l10n_hn_stock_accounting" groups="account.group_account_readonly">
                    <group string="Valoración de inventario">
                        <field name="account_stock_journal_id" options="{'no_create': True}"/>
                        <field name="account_stock_valuation_id" options="{'no_create': True}"/>
                    </group>
                </page>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Consumo interno" name="l10n_hn_consume_settings" groups="stock.group_stock_manager">
                    <group string="Salidas por consumo">
                        <field
                            name="hn_consume_dest_location_id"
                            options="{'no_create': True}"
                            domain="[('usage', '=', 'inventory'), '|', ('company_id', '=', False), ('company_id', '=', id)]"
                        />
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
