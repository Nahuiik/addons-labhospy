<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_category_form_inherit_l10n_hn_stock_journal" model="ir.ui.view">
        <field name="name">product.category.form.inherit.l10n.hn.stock.journal</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="stock_account.view_category_property_form"/>
        <field name="arch" type="xml">
            <field name="property_stock_valuation_account_id" position="after">
                <field
                    name="property_stock_journal"
                    string="Diario de inventario"
                    options="{'no_create': True}"
                    invisible="property_valuation != 'real_time'"
                    groups="account.group_account_readonly,stock.group_stock_manager"
                />
            </field>
        </field>
    </record>
</odoo>
