<odoo>
    <data>
        <record id="module_category_honduras_stock" model="ir.module.category">
            <field name="name">Honduras Stock</field>
            <field name="description">Permisos específicos de Honduras Stock</field>
            <field name="sequence">100</field>
        </record>

        <record id="privilege_confirm_sale" model="res.groups.privilege">
            <field name="name">Confirmar venta</field>
            <field name="category_id" ref="l10n_hn_stock.module_category_honduras_stock"/>
            <field name="sequence">10</field>
        </record>

        <record id="privilege_edit_sale_price" model="res.groups.privilege">
            <field name="name">Editar precio venta</field>
            <field name="category_id" ref="l10n_hn_stock.module_category_honduras_stock"/>
            <field name="sequence">20</field>
        </record>

        <record id="privilege_edit_invoice_price" model="res.groups.privilege">
            <field name="name">Editar precio factura cliente</field>
            <field name="category_id" ref="l10n_hn_stock.module_category_honduras_stock"/>
            <field name="sequence">30</field>
        </record>

        <record id="privilege_view_costs" model="res.groups.privilege">
            <field name="name">Ver costos y márgenes</field>
            <field name="category_id" ref="l10n_hn_stock.module_category_honduras_stock"/>
            <field name="sequence">40</field>
        </record>

        <record id="privilege_sell_below_cost" model="res.groups.privilege">
            <field name="name">Vender por debajo del costo</field>
            <field name="category_id" ref="l10n_hn_stock.module_category_honduras_stock"/>
            <field name="sequence">40</field>
        </record>

        <record id="group_allow_edit_sale_price_quotation_user" model="res.groups">
            <field name="name">Usuario</field>
            <field name="privilege_id" ref="l10n_hn_stock.privilege_edit_sale_price"/>
        </record>

        <record id="group_allow_edit_sale_price_quotation" model="res.groups">
            <field name="name">Manager</field>
            <field name="privilege_id" ref="l10n_hn_stock.privilege_edit_sale_price"/>
            <field name="implied_ids" eval="[(4, ref('l10n_hn_stock.group_allow_edit_sale_price_quotation_user'))]"/>
        </record>

        <record id="group_allow_edit_sale_price_invoice_user" model="res.groups">
            <field name="name">Usuario</field>
            <field name="privilege_id" ref="l10n_hn_stock.privilege_edit_invoice_price"/>
        </record>

        <record id="group_allow_edit_sale_price_invoice" model="res.groups">
            <field name="name">Manager</field>
            <field name="privilege_id" ref="l10n_hn_stock.privilege_edit_invoice_price"/>
            <field name="implied_ids" eval="[(4, ref('l10n_hn_stock.group_allow_edit_sale_price_invoice_user'))]"/>
        </record>

        <record id="group_allow_confirm_sale_view_docs_user" model="res.groups">
            <field name="name">Usuario</field>
            <field name="privilege_id" ref="l10n_hn_stock.privilege_confirm_sale"/>
        </record>

        <record id="group_allow_confirm_sale_view_docs" model="res.groups">
            <field name="name">Manager</field>
            <field name="privilege_id" ref="l10n_hn_stock.privilege_confirm_sale"/>
            <field name="implied_ids" eval="[(4, ref('l10n_hn_stock.group_allow_confirm_sale_view_docs_user'))]"/>
        </record>

        <record id="group_view_costs_margins" model="res.groups">
            <field name="name">Ver costos y márgenes</field>
            <field name="privilege_id" ref="l10n_hn_stock.privilege_view_costs"/>
            <field name="comment">Permite ver costo estándar, márgenes en ventas y columnas de valoración. No habilita editar el costo; use también «Editar costo de producto».</field>
        </record>

        <record id="privilege_edit_product_cost" model="res.groups.privilege">
            <field name="name">Editar costo de producto</field>
            <field name="category_id" ref="l10n_hn_stock.module_category_honduras_stock"/>
            <field name="sequence">45</field>
        </record>

        <record id="group_edit_product_cost" model="res.groups">
            <field name="name">Editar costo de producto</field>
            <field name="privilege_id" ref="l10n_hn_stock.privilege_edit_product_cost"/>
            <field name="implied_ids" eval="[(4, ref('l10n_hn_stock.group_view_costs_margins'))]"/>
            <field name="comment">Además de ver costos, permite modificar el costo. Incluye permisos de lectura/escritura en lotes/series (requerido por Odoo al propagar el costo en productos trazables con valoración).</field>
        </record>

        <record id="group_allow_sell_below_cost" model="res.groups">
            <field name="name">Permitir vender debajo del costo</field>
            <field name="privilege_id" ref="l10n_hn_stock.privilege_sell_below_cost"/>
        </record>

        <record id="privilege_transfer_supervisor" model="res.groups.privilege">
            <field name="name">Supervisor de traslados entre tiendas</field>
            <field name="category_id" ref="l10n_hn_stock.module_category_honduras_stock"/>
            <field name="sequence">60</field>
        </record>

        <record id="group_transfer_supervisor" model="res.groups">
            <field name="name">Supervisor de traslados entre tiendas</field>
            <field name="privilege_id" ref="l10n_hn_stock.privilege_transfer_supervisor"/>
        </record>
    </data>
</odoo>


