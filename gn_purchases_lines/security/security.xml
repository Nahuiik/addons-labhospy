<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="0">
        <!-- Privilegio para importar líneas de compra -->
        <record id="privilege_import_purchase_lines" model="res.groups.privilege">
            <field name="name">Importar Líneas de Compra</field>
            <field name="category_id" ref="base.module_category_purchase"/>
        </record>

        <!-- Grupo de seguridad para importar líneas de compra -->
        <record id="group_import_purchase_lines" model="res.groups">
            <field name="name">Importar Líneas de Compra</field>
            <field name="privilege_id" ref="gn_purchases_lines.privilege_import_purchase_lines"/>
            <field name="implied_ids" eval="[(4, ref('purchase.group_purchase_user'))]"/>
        </record>
    </data>
</odoo>

