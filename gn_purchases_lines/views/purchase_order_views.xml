<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_purchase_order_form_inherit" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.import.lines</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_view_invoice']" position="before">
                <button name="action_import_lines"
                        string="Importar Líneas"
                        type="object"
                        class="btn-primary"
                        invisible="state not in ('draft', 'sent')"
                        groups="gn_purchases_lines.group_import_purchase_lines"/>
                <button name="action_clear_imported_lines"
                        string="Limpiar Líneas Importadas"
                        type="object"
                        class="btn-secondary"
                        confirm="Se eliminarán solo las líneas importadas. ¿Desea continuar?"
                        invisible="state not in ('draft', 'sent')"
                        groups="gn_purchases_lines.group_import_purchase_lines"/>
            </xpath>
        </field>
    </record>
</odoo>

