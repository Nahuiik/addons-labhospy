<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hn_libro_report_form" model="ir.ui.view">
        <field name="name">hn.libro.report.form</field>
        <field name="model">hn.libro.report</field>
        <field name="arch" type="xml">
            <form string="Libro compras / ventas">
                <group>
                    <field name="company_id" groups="base.group_multi_company"/>
                    <field name="tipo"/>
                    <field name="year"/>
                    <field name="month"/>
                    <field name="report_layout" widget="radio"/>
                </group>
                <group string="Filtros">
                    <field name="branch_ids" widget="many2many_tags"
                           domain="[('company_id', '=', company_id)]"/>
                    <field name="user_ids" widget="many2many_tags"
                           domain="[('company_ids', 'in', company_id), ('share', '=', False)]"/>
                </group>
                <group string="Opciones del resumen ejecutivo" invisible="report_layout != 'resumen'">
                    <field name="resumen_filtrar_documento_fiscal"/>
                    <field name="resumen_incluir_borradores_en_totales"/>
                </group>
                <footer>
                    <button name="action_print_pdf" type="object" string="Imprimir PDF" class="btn-primary"/>
                    <button name="action_print_html" type="object" string="Vista HTML" class="btn-secondary"/>
                    <button name="action_export_xlsx" type="object" string="Exportar XLSX" class="btn-secondary"/>
                    <button string="Cerrar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_hn_libro_report" model="ir.actions.act_window">
        <field name="name">Libro de compras / ventas</field>
        <field name="res_model">hn.libro.report</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
