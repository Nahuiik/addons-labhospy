<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hn_reporte_isv_wizard_form" model="ir.ui.view">
        <field name="name">hn.reporte.isv.wizard.form</field>
        <field name="model">hn.reporte.isv.wizard</field>
        <field name="arch" type="xml">
            <form string="Reporte ISV">
                <group>
                    <group>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="year"/>
                        <field name="credito_fiscal_periodo_anterior"/>
                    </group>
                    <group>
                        <field name="currency_id" invisible="1"/>
                        <field name="month"/>
                        <field name="impuesto_retenido_pos"/>
                    </group>
                </group>
                <footer>
                    <button name="action_print_pdf" type="object" string="Imprimir" class="btn-primary"/>
                    <button name="action_print_html" type="object" string="Vista HTML" class="btn-secondary"/>
                    <button name="action_export_xlsx" type="object" string="Exportar XLSX" class="btn-secondary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_hn_reporte_isv_wizard" model="ir.actions.act_window">
        <field name="name">Reporte ISV</field>
        <field name="res_model">hn.reporte.isv.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_hn_reporte_isv"
              name="Reporte ISV"
              parent="menu_hn_reports_root"
              action="action_hn_reporte_isv_dashboard"
              sequence="12"/>
</odoo>
