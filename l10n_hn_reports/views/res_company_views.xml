<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_hn_isv_closing" model="ir.ui.view">
        <field name="name">res.company.form.hn.isv.closing</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form/sheet/notebook" position="inside">
                <page string="Honduras — ISR" name="hn_isr_report" groups="account.group_account_manager">
                    <group>
                        <field name="hn_isr_report_account_ids" widget="many2many_tags"
                               domain="[('company_ids', 'parent_of', id)]"/>
                    </group>
                    <p class="text-muted">
                        Cuentas sugeridas para el informe
                        <strong>Impuesto sobre la renta — resumen</strong>
                        (deducciones, reservas, impuesto pagado o por pagar, etc.). Se pueden sobrescribir en el asistente.
                    </p>
                </page>
                <page string="Honduras — Cierre ISV" name="hn_isv_closing" groups="account.group_account_manager">
                    <group>
                        <field name="hn_isv_closing_journal_id"/>
                        <field name="hn_isv_closing_debit_account_id"/>
                        <field name="hn_isv_closing_credit_account_id"/>
                    </group>
                    <p class="text-muted">
                        Valores opcionales por defecto para el asistente
                        <strong>Cierre ISV (borrador)</strong>. Validar con el contador antes de publicar asientos.
                    </p>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
