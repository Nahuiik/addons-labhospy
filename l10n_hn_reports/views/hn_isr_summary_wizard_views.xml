<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hn_isr_summary_wizard_form" model="ir.ui.view">
        <field name="name">hn.isr.summary.wizard.form</field>
        <field name="model">hn.isr.summary.wizard</field>
        <field name="arch" type="xml">
            <form string="Resumen ISR">
                <group>
                    <field name="company_id" groups="base.group_multi_company"/>
                    <field name="year"/>
                    <field name="month"/>
                </group>
                <group string="Cuentas contables">
                    <field name="account_ids" widget="many2many_tags" nolabel="1"
                           placeholder="Vacío = usar cuentas por defecto de la compañía (ISR)"/>
                </group>
                <footer>
                    <button name="action_print_pdf" type="object" string="Imprimir PDF" class="btn-primary"/>
                    <button name="action_print_html" type="object" string="Vista HTML" class="btn-secondary"/>
                    <button name="action_export_xlsx" type="object" string="Exportar Excel" class="btn-secondary"/>
                    <button special="cancel" string="Cerrar" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_hn_isr_summary_wizard" model="ir.actions.act_window">
        <field name="name">Impuesto sobre la renta — resumen</field>
        <field name="res_model">hn.isr.summary.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_hn_isr_summary_wizard"
              name="Impuesto sobre la renta (resumen)"
              parent="menu_hn_reports_root"
              action="action_hn_isr_summary_wizard"
              sequence="25"/>
</odoo>
