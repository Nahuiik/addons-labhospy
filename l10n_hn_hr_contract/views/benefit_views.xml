<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="view_l10n_hn_contract_benefit_template_tree" model="ir.ui.view">
            <field name="name">l10n.hn.contract.benefit.template.tree</field>
            <field name="model">l10n.hn.contract.benefit.template</field>
            <field name="arch" type="xml">
                <list string="Beneficios" create="1" edit="1">
                    <field name="name"/>
                    <field name="code"/>
                    <field name="structure_type_id"/>
                    <field name="periodicity"/>
                    <field name="default_amount_employee" widget="monetary"/>
                    <field name="default_amount_company" widget="monetary"/>
                    <field name="include_in_payslip"/>
                    <field name="input_code"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                </list>
            </field>
        </record>

        <record id="view_l10n_hn_contract_benefit_template_form" model="ir.ui.view">
            <field name="name">l10n.hn.contract.benefit.template.form</field>
            <field name="model">l10n.hn.contract.benefit.template</field>
            <field name="arch" type="xml">
                <form string="Beneficio del contrato">
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="structure_type_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="periodicity"/>
                            <field name="default_amount_employee"/>
                            <field name="default_amount_company"/>
                            <field name="is_deduction"/>
                        </group>
                        <group>
                            <field name="include_in_payslip"/>
                            <field name="input_code"/>
                            <field name="amount_source"/>
                        </group>
                        <group>
                            <field name="description" colspan="4"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_l10n_hn_contract_benefit_templates" model="ir.actions.act_window">
            <field name="name">Beneficios de contrato</field>
            <field name="res_model">l10n.hn.contract.benefit.template</field>
            <field name="view_mode">list,form</field>
            <field name="context">{'default_company_id': company_id}</field>
        </record>

        <menuitem id="menu_l10n_hn_contract_benefit_root"
                  name="Beneficios de contrato"
                  parent="hr.menu_human_resources_configuration"
                  groups="l10n_hn_hr_contract.group_l10n_hn_hr_contract_manager"
                  action="action_l10n_hn_contract_benefit_templates"/>
    </data>
</odoo>


