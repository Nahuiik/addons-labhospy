<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="view_apply_benefit_template_wizard_form" model="ir.ui.view">
            <field name="name">l10n.hn.contract.template.wizard.form</field>
            <field name="model">l10n.hn.contract.template.wizard</field>
            <field name="arch" type="xml">
                <form string="Aplicar Plantilla de Beneficios">
                    <sheet>
                        <group>
                            <field name="contract_id" readonly="1"/>
                            <field name="structure_type_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="replace_existing"/>
                        </group>
                        <separator string="Seleccionar Plantillas"/>
                        <field name="template_ids" widget="many2many_tags" domain="[('structure_type_id', '=', structure_type_id)]" nolabel="1"/>
                    </sheet>
                    <footer>
                        <button name="action_apply_templates" string="Aplicar" type="object" class="btn-primary"/>
                        <button string="Cancelar" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_apply_benefit_template_wizard" model="ir.actions.act_window">
            <field name="name">Aplicar Plantilla de Beneficios</field>
            <field name="res_model">l10n.hn.contract.template.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>
    </data>
</odoo>

