<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- Acción para listar todos los contratos -->
        <record id="action_hr_contracts" model="ir.actions.act_window">
            <field name="name">Contratos</field>
            <field name="res_model">hr.version</field>
            <field name="view_mode">list,form,graph,pivot</field>
            <field name="domain">[('employee_id', '!=', False)]</field>
            <field name="context">{'search_default_running_contract': 1}</field>
            <field name="view_ids" eval="[(5, 0, 0),
                (0, 0, {'view_mode': 'list', 'view_id': ref('hr.hr_version_list_view')}),
                (0, 0, {'view_mode': 'form', 'view_id': ref('hr.hr_contract_template_form_view')}),
                (0, 0, {'view_mode': 'graph'}),
                (0, 0, {'view_mode': 'pivot'})
            ]"/>
            <field name="search_view_id" ref="hr.hr_version_search_view"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No hay contratos aún
                </p>
                <p>
                    Crea un nuevo contrato para un empleado o usa el widget de línea de tiempo en la ficha del empleado.
                </p>
            </field>
        </record>

        <!-- Menú de Contratos en el menú principal de Empleados -->
        <menuitem
            id="menu_hr_contracts"
            name="Contratos"
            action="action_hr_contracts"
            parent="hr.menu_hr_root"
            sequence="4"
            groups="hr.group_hr_user"/>
    </data>
</odoo>

