<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- Vista de lista mejorada para contratos (similar a Odoo 18) -->
        <record id="hr_version_list_view_l10n_hn_inherit" model="ir.ui.view">
            <field name="name">hr.version.list.l10n.hn.inherit</field>
            <field name="model">hr.version</field>
            <field name="inherit_id" ref="hr.hr_version_list_view"/>
            <field name="arch" type="xml">
                <!-- Hacer que los campos principales sean visibles por defecto -->
                <xpath expr="//field[@name='employee_id']" position="attributes">
                    <attribute name="optional">hide</attribute>
                </xpath>
                <xpath expr="//field[@name='wage']" position="attributes">
                    <attribute name="optional">show</attribute>
                </xpath>
                <xpath expr="//field[@name='structure_type_id']" position="attributes">
                    <attribute name="optional">show</attribute>
                </xpath>
                <xpath expr="//field[@name='job_id']" position="attributes">
                    <attribute name="optional">hide</attribute>
                </xpath>
                <!-- Agregar campos adicionales de Honduras -->
                <xpath expr="//field[@name='department_id']" position="after">
                    <field name="wage_with_holidays" widget="monetary" string="Salario con Vacaciones" optional="show" groups="hr.group_hr_manager"/>
                    <field name="final_yearly_costs" widget="monetary" string="Costo Anual" optional="show" groups="hr.group_hr_manager" readonly="1"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>

