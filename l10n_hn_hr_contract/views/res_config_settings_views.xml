<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="res_config_settings_view_form_l10n_hn_hr_contract" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.l10n.hn.hr.contract</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="hr.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//block[@id='contract_work_permit_expiration_notify']" position="after">
                    <block title="Contratos Honduras" string="Contratos Honduras">
                        <setting string="Días laborales por año">
                            <div class="d-flex">
                                <field name="hr_contract_work_days_per_year" class="w-25"/>
                                <span class="ms-2">días</span>
                            </div>
                        </setting>
                        <setting string="Asignar vacaciones automáticamente" help="Genera una asignación de vacaciones al confirmar el contrato.">
                            <div class="d-flex flex-column">
                                <field name="hr_contract_timeoff_auto_allocation"/>
                                <div class="d-flex align-items-center ms-4"
                                     modifiers="{'invisible': [('hr_contract_timeoff_auto_allocation', '=', False)]}">
                                    <field name="hr_contract_timeoff_auto_allocation_type_id"
                                           domain="[('requires_allocation', '=', True)]"/>
                                </div>
                            </div>
                        </setting>
                    </block>
                </xpath>
            </field>
        </record>
    </data>
</odoo>


