<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Stock Valuation Generate Entry Form View -->
    <record id="view_stock_valuation_generate_entry_form" model="ir.ui.view">
        <field name="name">stock.valuation.generate.entry.form</field>
        <field name="model">stock.valuation.generate.entry</field>
        <field name="arch" type="xml">
            <form string="Generate Accounting Entry">
                <group>
                    <group>
                        <field name="date" readonly="1"/>
                        <field name="company_id" readonly="1" options="{'no_create': True, 'no_create_edit': True}"/>
                        <field name="journal_id" options="{'no_create': True, 'no_create_edit': True}"/>
                    </group>
                    <group>
                        <field name="stock_variation" readonly="1" widget="monetary" 
                               options="{'currency_field': 'company_currency_id'}"/>
                        <field name="ending_stock" readonly="1" widget="monetary" 
                               options="{'currency_field': 'company_currency_id'}"/>
                    </group>
                </group>
                <group>
                    <group>
                        <field name="expense_account_id" options="{'no_create': True, 'no_create_edit': True}"/>
                    </group>
                    <group>
                        <field name="stock_account_id" options="{'no_create': True, 'no_create_edit': True}"/>
                    </group>
                </group>
                <group>
                    <field name="move_line_ids" nolabel="1">
                        <list>
                            <field name="account_id"/>
                            <field name="name"/>
                            <field name="debit" sum="Total"/>
                            <field name="credit" sum="Total"/>
                        </list>
                    </field>
                </group>
                <footer>
                    <button name="action_generate_entry" string="Generate Entry" type="object" 
                            class="btn-primary" icon="fa-file-text-o"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>

