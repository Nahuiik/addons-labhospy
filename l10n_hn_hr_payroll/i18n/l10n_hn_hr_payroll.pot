msgid ""
"<div style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"    <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"        Estimado(a),\n"
"    </p>\n"
"    <br/>\n"
"    <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"        Le informamos que el empleado <strong>{{ object.name }}</strong>\n"
"        ha completado su período de prueba de <strong>{{ ctx.get('trial_days', 45) }} días calendario</strong>.\n"
"    </p>\n"
"    <br/>\n"
"    <table style=\"border-collapse: collapse; font-size: 13px;\">\n"
"        <tr>\n"
"            <td style=\"padding: 4px 12px 4px 0; font-weight: bold;\">Empleado:</td>\n"
"            <td style=\"padding: 4px 0;\">{{ object.name }}</td>\n"
"        </tr>\n"
"        <tr>\n"
"            <td style=\"padding: 4px 12px 4px 0; font-weight: bold;\">DNI:</td>\n"
"            <td style=\"padding: 4px 0;\">{{ object.identification_id or 'N/A' }}</td>\n"
"        </tr>\n"
"        <tr>\n"
"            <td style=\"padding: 4px 12px 4px 0; font-weight: bold;\">Departamento:</td>\n"
"            <td style=\"padding: 4px 0;\">{{ object.department_id.name or 'N/A' }}</td>\n"
"        </tr>\n"
"        <tr>\n"
"            <td style=\"padding: 4px 12px 4px 0; font-weight: bold;\">Cargo:</td>\n"
"            <td style=\"padding: 4px 0;\">{{ object.job_id.name or 'N/A' }}</td>\n"
"        </tr>\n"
"        <tr>\n"
"            <td style=\"padding: 4px 12px 4px 0; font-weight: bold;\">Jefe Inmediato:</td>\n"
"            <td style=\"padding: 4px 0;\">{{ object.parent_id.name or 'N/A' }}</td>\n"
"        </tr>\n"
"        <tr>\n"
"            <td style=\"padding: 4px 12px 4px 0; font-weight: bold;\">Fecha de Ingreso:</td>\n"
"            <td style=\"padding: 4px 0;\">{{ object.contract_date_start or 'N/A' }}</td>\n"
"        </tr>\n"
"    </table>\n"
"    <br/>\n"
"    <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"        Por favor tome las acciones correspondientes según la política de la empresa.\n"
"    </p>\n"
"    <br/>\n"
"    <p style=\"margin: 0px; padding: 0px; font-size: 13px; color: #888;\">\n"
"        Este es un mensaje automático generado por el sistema de nómina.\n"
"    </p>\n"
"</div>\n"
