<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Cron mensual: día 1 de cada mes, crea auditorías del mes anterior -->
        <record id="ir_cron_create_monthly_payroll_audits" model="ir.cron">
            <field name="name">Honduras Payroll: Crear auditorías mensuales</field>
            <field name="model_id" ref="model_l10n_hn_payroll_audit_run"/>
            <field name="state">code</field>
            <field name="code">model._cron_create_monthly_audits()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">months</field>
            <field name="nextcall" eval="(DateTime.now() + relativedelta(day=1, months=1)).strftime('%Y-%m-%d 06:00:00')"/>
        </record>

        <!-- Cron anual: 1 de enero, crea auditorías del año anterior -->
        <record id="ir_cron_create_annual_payroll_audits" model="ir.cron">
            <field name="name">Honduras Payroll: Crear auditorías anuales</field>
            <field name="model_id" ref="model_l10n_hn_payroll_audit_run"/>
            <field name="state">code</field>
            <field name="code">model._cron_create_annual_audits()</field>
            <field name="interval_number">12</field>
            <field name="interval_type">months</field>
            <field name="nextcall" eval="(DateTime.now() + relativedelta(years=1)).strftime('%Y-01-01 06:00:00')"/>
        </record>
    </data>
</odoo>
