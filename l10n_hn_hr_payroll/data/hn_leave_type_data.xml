<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Tipo principal de vacaciones (campo gn_hr_vacation); categoría legal HN abajo -->
        <record id="leave_type_hn_vacation" model="hr.leave.type">
            <field name="name">Vacaciones anuales</field>
            <field name="sequence">10</field>
            <field name="requires_allocation">True</field>
            <field name="allows_negative" eval="True"/>
            <field name="max_allowed_negative" eval="30"/>
            <field name="request_unit">day</field>
            <field name="leave_validation_type">hr</field>
            <field name="allocation_validation_type">no_validation</field>
            <field name="employee_requests">True</field>
            <field name="country_id" ref="base.hn"/>
            <field name="gn_vacation_is_primary" eval="True"/>
            <field name="unpaid" eval="False"/>
            <field name="color">1</field>
            <field name="work_entry_type_id" ref="hr_work_entry.work_entry_type_legal_leave"/>
        </record>

        <!-- Licencia por Maternidad -->
        <record id="leave_type_hn_maternity" model="hr.leave.type">
            <field name="name">Licencia por Maternidad</field>
            <field name="sequence">20</field>
            <field name="requires_allocation">False</field>
            <field name="request_unit">day</field>
            <field name="leave_validation_type">hr</field>
            <field name="country_id" ref="base.hn"/>
            <field name="unpaid" eval="False"/>
            <field name="color">2</field>
            <field name="work_entry_type_id" ref="hr_work_entry.work_entry_type_legal_leave"/>
        </record>

        <!-- Licencia por Paternidad -->
        <record id="leave_type_hn_paternity" model="hr.leave.type">
