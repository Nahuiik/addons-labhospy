            <field name="requires_allocation">False</field>
            <field name="request_unit">day</field>
            <field name="leave_validation_type">manager</field>
            <field name="country_id" ref="base.hn"/>
            <field name="unpaid" eval="False"/>
            <field name="color">3</field>
            <field name="work_entry_type_id" ref="hr_work_entry.work_entry_type_legal_leave"/>
        </record>

