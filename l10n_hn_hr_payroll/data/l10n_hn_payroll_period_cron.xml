<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Día 1 de cada mes: crea (si faltan) la quincena 1 y 2 del mes en curso, HN -->
        <record id="ir_cron_l10n_hn_payroll_periods_monthly" model="ir.cron">
            <field name="name">Honduras Payroll: Crear quincenas del mes</field>
            <field name="model_id" ref="model_l10n_hn_payroll_period"/>
            <field name="state">code</field>
            <field name="code">model._cron_create_current_month_periods()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">months</field>
            <field name="nextcall" eval="(DateTime.now() + relativedelta(day=1, months=1)).strftime('%Y-%m-%d 06:00:00')"/>
        </record>
    </data>
</odoo>
