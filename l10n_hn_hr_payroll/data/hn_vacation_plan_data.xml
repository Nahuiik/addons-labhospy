<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Plan Legal Honduras: 1 año=10, 2 años=12, 3 años=15, 4+=20 días -->
        <record id="hn_vacation_plan_legal" model="gn.hn.vacation.plan">
            <field name="name">Legal Honduras</field>
            <field name="code">HN_LEGAL</field>
            <field name="leave_type_id" ref="leave_type_hn_vacation"/>
            <field name="is_temporary" eval="False"/>
            <field name="allow_proportional" eval="False"/>
            <field name="allow_monthly_proportional" eval="True"/>
            <field name="max_accumulation_periods">1</field>
        </record>
        <record id="hn_vacation_rule_1y" model="gn.hn.vacation.rule">
            <field name="plan_id" ref="hn_vacation_plan_legal"/>
            <field name="min_years">1</field>
            <field name="max_years">1</field>
            <field name="days_entitled">10</field>
            <field name="sequence">10</field>
        </record>
        <record id="hn_vacation_rule_2y" model="gn.hn.vacation.rule">
            <field name="plan_id" ref="hn_vacation_plan_legal"/>
            <field name="min_years">2</field>
            <field name="max_years">2</field>
            <field name="days_entitled">12</field>
            <field name="sequence">20</field>
        </record>
        <record id="hn_vacation_rule_3y" model="gn.hn.vacation.rule">
            <field name="plan_id" ref="hn_vacation_plan_legal"/>
            <field name="min_years">3</field>
            <field name="max_years">3</field>
            <field name="days_entitled">15</field>
            <field name="sequence">30</field>
        </record>
        <record id="hn_vacation_rule_4y" model="gn.hn.vacation.rule">
            <field name="plan_id" ref="hn_vacation_plan_legal"/>
            <field name="min_years">4</field>
            <field name="max_years">99</field>
            <field name="days_entitled">20</field>
            <field name="sequence">40</field>
        </record>

        <!-- Plan Temporal Honduras: 1 año=10 días, proporcional -->
        <record id="hn_vacation_plan_temporal" model="gn.hn.vacation.plan">
            <field name="name">Temporal Honduras</field>
            <field name="code">HN_TEMPORAL</field>
            <field name="leave_type_id" ref="leave_type_hn_vacation"/>
            <field name="is_temporary" eval="True"/>
            <field name="allow_proportional" eval="True"/>
            <field name="max_accumulation_periods">1</field>
        </record>
        <record id="hn_vacation_rule_temporal_1y" model="gn.hn.vacation.rule">
            <field name="plan_id" ref="hn_vacation_plan_temporal"/>
            <field name="min_years">1</field>
            <field name="max_years">99</field>
            <field name="days_entitled">10</field>
            <field name="sequence">10</field>
        </record>
    </data>
</odoo>
