<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Tipo de ausencia: Incapacidad IHSS (Honduras)
             Los días 1-3 calendario los paga el patrono; desde el día 4 IHSS paga subsidio.
             El work_entry_type_id por defecto es PAT; la generación de work entries
             asigna dinámicamente HN_INCAP_PAT o HN_INCAP_IHSS según el día del caso. -->
        <record id="leave_type_ihss_incapacity" model="hr.leave.type">
            <field name="name">Incapacidad (IHSS)</field>
            <field name="work_entry_type_id" ref="l10n_hn_hr_payroll.work_entry_type_hn_incap_pat"/>
            <field name="is_ihss_incapacity" eval="True"/>
            <field name="requires_allocation">no</field>
            <field name="request_unit">day</field>
        </record>
    </data>
</odoo>
