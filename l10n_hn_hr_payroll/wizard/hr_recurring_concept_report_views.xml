<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_recurring_concept_report_form" model="ir.ui.view">
        <field name="name">hr.employee.recurring.concept.report.form</field>
        <field name="model">hr.employee.recurring.concept.report</field>
        <field name="arch" type="xml">
            <form string="Reporte de Conceptos Recurrentes">
                <sheet>
                    <group>
                        <group>
                            <field name="company_id"/>
                            <field name="employee_ids" widget="many2many_tags"
                                   placeholder="Dejar vacío para incluir todos"/>
                            <field name="concept_type"/>
                            <field name="active_filter"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_export_excel" string="Exportar a Excel" type="object" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_hr_recurring_concept_report" model="ir.actions.act_window">
        <field name="name">Reporte Conceptos Recurrentes</field>
        <field name="res_model">hr.employee.recurring.concept.report</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
