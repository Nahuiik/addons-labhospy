<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_vecinal_income_import_wizard_form" model="ir.ui.view">
        <field name="name">l10n.hn.vecinal.income_import_wizard.form</field>
        <field name="model">l10n.hn.vecinal.income_import_wizard</field>
        <field name="arch" type="xml">
            <form string="Import Employee Income from CSV">
                <group>
                    <group>
                        <field name="company_id" options="{'no_create': True}"/>
                        <field name="year_base"/>
                    </group>
                    <group>
                        <field name="has_header"/>
                        <field name="delimiter"/>
                    </group>
                </group>
                
                <group>
                    <group>
                        <field name="employee_column"/>
                        <field name="income_column"/>
                    </group>
                </group>
                
                <group>
                    <field name="file" filename="filename"/>
                    <button name="action_download_template" string="Download Template" type="object" class="btn-secondary"/>
                </group>
                
                <div class="alert alert-info" role="alert">
                    <strong>CSV Format:</strong>
                    <ul>
                        <li>First column: Employee Code/ID (barcode or employee ID)</li>
                        <li>Second column: Annual Income (numeric value)</li>
                        <li>File should be UTF-8 encoded</li>
                        <li>Use comma (,) or semicolon (;) as delimiter</li>
                    </ul>
                    <strong>Example:</strong>
                    <pre>EMP001,25000.00
EMP002,30000.00</pre>
                </div>
                
                <field name="import_preview" nolabel="1" readonly="1"/>
                
                <footer>
                    <button string="Import" name="action_import" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    
    <record id="action_vecinal_income_import_wizard" model="ir.actions.act_window">
        <field name="name">Import Employee Income from CSV</field>
        <field name="res_model">l10n.hn.vecinal.income_import_wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
