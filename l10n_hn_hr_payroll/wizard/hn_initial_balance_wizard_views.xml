<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hn_initial_balance_wizard_form" model="ir.ui.view">
        <field name="name">hn.initial.balance.wizard.form</field>
        <field name="model">hn.initial.balance.wizard</field>
        <field name="arch" type="xml">
            <form string="Cargar saldos iniciales">
                <group>
                    <field name="balance_date"/>
                    <field name="excel_file" filename="excel_filename"/>
                    <field name="excel_filename" invisible="1"/>
                    <field name="import_mode" invisible="1"/>
                    <div class="mt-2">
                        <button name="action_download_template" string="Descargar plantilla con empleados" type="object" class="btn-secondary"/>
                        <button name="action_import_excel" string="Importar desde Excel" type="object" class="btn-secondary" invisible="not excel_file"/>
                    </div>
                </group>
                <group>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="employee_id"/>
                            <field name="vacation_taken"/>
                        </list>
                    </field>
                </group>
                <footer>
                    <button name="action_apply" type="object" class="btn-primary" string="Aplicar"/>
                    <button special="cancel" string="Cancelar"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_hn_initial_balance_wizard" model="ir.actions.act_window">
        <field name="name">Cargar saldos iniciales</field>
        <field name="res_model">hn.initial.balance.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_hr_employee"/>
        <field name="binding_view_types">list</field>
    </record>

    <record id="action_hn_initial_balance_wizard_menu" model="ir.actions.act_window">
        <field name="name">Cargar saldos iniciales</field>
        <field name="res_model">hn.initial.balance.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
