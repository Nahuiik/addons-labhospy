<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_parent_children_report_wizard_form" model="ir.ui.view">
        <field name="name">hr.parent.children.report.wizard.form</field>
        <field name="model">hr.parent.children.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Reporte de Padres, Madres e Hijos">
                <sheet>
                    <div class="alert alert-info" role="alert">
                        Genera un reporte Excel con 4 hojas: Padres, Madres,
                        Hijos menores de 18 años e Hijos menores de 12 años.
                    </div>
                    <group>
                        <field name="company_id"/>
                        <field name="department_ids" widget="many2many_tags"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_export_excel" type="object"
                            string="Generar Reporte" class="btn-primary"
                            icon="fa-file-excel-o"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_hr_parent_children_report_wizard" model="ir.actions.act_window">
        <field name="name">Reporte: Padres, Madres e Hijos</field>
        <field name="res_model">hr.parent.children.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
