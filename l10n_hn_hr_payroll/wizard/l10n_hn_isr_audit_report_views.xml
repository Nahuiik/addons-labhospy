<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ISR Audit Report Wizard Views -->
    
    <record id="view_l10n_hn_isr_audit_report_form" model="ir.ui.view">
        <field name="name">l10n.hn.isr.audit.report.form</field>
        <field name="model">l10n.hn.isr.audit.report</field>
        <field name="arch" type="xml">
            <form string="Generar Reporte de Auditoría ISR">
                <sheet>
                    <group>
                        <group>
                            <field name="report_type" widget="radio" options="{'horizontal': true}"/>
                            <field name="company_id"/>
                            <field name="year"/>
                        </group>
                        <group>
                            <field name="employee_ids" widget="many2many_tags" 
                                   options="{'no_create': True}"
                                   invisible="report_type != 'employee_detail'"/>
                            <field name="month_from" invisible="report_type != 'monthly_comparative'"/>
                            <field name="month_to" invisible="report_type != 'monthly_comparative'"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_generate_report" string="Generar Reporte" type="object" class="oe_highlight"/>
                    <button name="action_export_excel" string="Exportar a Excel" type="object" class="btn-primary" 
                            invisible="report_type == 'employee_detail'"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    
    <record id="action_l10n_hn_isr_audit_report" model="ir.actions.act_window">
        <field name="name">Reportes de Auditoría ISR</field>
        <field name="res_model">l10n.hn.isr.audit.report</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
    
</odoo>
