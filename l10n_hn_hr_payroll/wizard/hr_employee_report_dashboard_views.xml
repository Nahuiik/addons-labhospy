    <!-- Vistas de Currículum (hr.resume.line) -->
    <record id="hr_resume_line_view_list_report" model="ir.ui.view">
        <field name="name">hr.resume.line.list.report</field>
        <field name="model">hr.resume.line</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" export_xlsx="1">
                <field name="employee_id"/>
                <field name="line_type_id"/>
                <field name="name"/>
                <field name="description" optional="hidden"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="duration"/>
            </list>
        </field>
    </record>
    <record id="hr_resume_line_view_search_report" model="ir.ui.view">
        <field name="name">hr.resume.line.search.report</field>
        <field name="model">hr.resume.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id"/>
                <field name="name"/>
                <field name="line_type_id"/>
                <separator/>
                <filter name="group_employee" string="Empleado" context="{'group_by': 'employee_id'}"/>
                <filter name="group_type" string="Tipo" context="{'group_by': 'line_type_id'}"/>
            </search>
        </field>
    </record>
    <record id="action_hr_employee_report_resume" model="ir.actions.act_window">
        <field name="name">Currículum</field>
        <field name="res_model">hr.resume.line</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="hr_resume_line_view_search_report"/>
        <field name="context">{'search_default_group_employee': 1}</field>
    </record>

