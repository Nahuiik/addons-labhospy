<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_breastfeeding_hours_to_leave_wizard_form" model="ir.ui.view">
        <field name="name">hr.breastfeeding.hours.to.leave.wizard.form</field>
        <field name="model">hr.breastfeeding.hours.to.leave.wizard</field>
        <field name="arch" type="xml">
            <form string="Horas de lactancia → días con goce de sueldo">
                <group>
                    <field name="breastfeeding_id" readonly="1"/>
                    <field name="holiday_status_id"/>
                    <field name="hours_per_workday"/>
                </group>
                <group string="Equivalencia informativa (horas ÷ jornada)">
                    <field name="info_summary" nolabel="1" colspan="2"/>
                </group>
                <field name="line_ids" nolabel="1" domain="[('breastfeeding_id', '=', breastfeeding_id)]">
                    <list>
                        <field name="employee_id"/>
                        <field name="total_hours"/>
                        <field name="start_date"/>
                    </list>
                </field>
                <footer>
                    <button name="action_create_leaves" string="Crear permisos" type="object" class="btn-primary" data-hotkey="q"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel" data-hotkey="z"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
