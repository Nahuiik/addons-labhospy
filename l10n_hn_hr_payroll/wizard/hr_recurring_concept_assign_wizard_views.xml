<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_recurring_concept_assign_wizard_form" model="ir.ui.view">
        <field name="name">hr.employee.recurring.concept.assign.wizard.form</field>
        <field name="model">hr.employee.recurring.concept.assign.wizard</field>
        <field name="arch" type="xml">
            <form string="Asignar Concepto a Empleados">
                <sheet>
                    <group>
                        <group>
                            <field name="concept_id" readonly="1"/>
                            <field name="date_start"/>
                            <field name="date_end"/>
                        </group>
                    </group>
                    <group>
                        <field name="employee_ids" widget="many2many_tags" nolabel="1" 
                               placeholder="Seleccione los empleados a los que se asignará el concepto..."/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_assign" string="Asignar" type="object" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    
    <record id="action_hr_recurring_concept_assign_wizard" model="ir.actions.act_window">
        <field name="name">Asignar Concepto a Empleados</field>
        <field name="res_model">hr.employee.recurring.concept.assign.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
