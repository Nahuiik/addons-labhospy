<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ==================== SPORTS ==================== -->
    <record id="hr_sport_view_list" model="ir.ui.view">
        <field name="name">hr.sport.list</field>
        <field name="model">hr.sport</field>
        <field name="arch" type="xml">
            <list string="Deportes" editable="bottom">
                <field name="name"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="hr_sport_view_form" model="ir.ui.view">
        <field name="name">hr.sport.form</field>
        <field name="model">hr.sport</field>
        <field name="arch" type="xml">
            <form string="Deporte">
                <sheet>
                    <widget name="web_ribbon" title="Archivado" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <field name="name"/>
                        <field name="active" widget="boolean_toggle"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="hr_sport_action" model="ir.actions.act_window">
        <field name="name">Deportes</field>
        <field name="res_model">hr.sport</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Crear un deporte</p>
        </field>
    </record>

