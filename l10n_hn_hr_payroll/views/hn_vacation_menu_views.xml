<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_hn_approval_delegations_tree" model="ir.actions.act_window">
        <field name="name">Delegaciones de aprobación</field>
        <field name="res_model">hr.leave</field>
        <field name="view_mode">list</field>
        <field name="domain">[('gn_vacation_is_primary', '=', True), ('hn_substitute_employee_id', '!=', False), ('hn_substitute_employee_id.user_id', '!=', False)]</field>
        <field name="context">{'search_default_to_approve': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No hay delegaciones asignadas
            </p>
            <p>
                Las delegaciones se crean al asignar un "Delegado / Suplente" (empleado con usuario) en el formulario de la solicitud de vacaciones HN.
            </p>
        </field>
    </record>
</odoo>
