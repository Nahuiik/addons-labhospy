<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Proyecto -->
    <record id="view_hr_project_tree" model="ir.ui.view">
        <field name="name">hr.project.tree</field>
        <field name="model">hr.project</field>
        <field name="arch" type="xml">
            <list string="Proyectos" create="1" delete="1" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
                <field name="name"/>
                <field name="code"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_hr_project_form" model="ir.ui.view">
        <field name="name">hr.project.form</field>
        <field name="model">hr.project</field>
        <field name="arch" type="xml">
            <form string="Proyecto">
                <sheet>
                    <group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="name"/>
                            <field name="code"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hr_project" model="ir.actions.act_window">
        <field name="name">Proyectos</field>
        <field name="res_model">hr.project</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crear el primer proyecto
            </p>
            <p>
                Los proyectos se asignan a los empleados en la pestaña Trabajo de la ficha del empleado.
            </p>
        </field>
    </record>

    <!-- Asignación -->
    <record id="view_hr_assignment_tree" model="ir.ui.view">
        <field name="name">hr.assignment.tree</field>
        <field name="model">hr.assignment</field>
        <field name="arch" type="xml">
            <list string="Asignaciones" create="1" delete="1" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
                <field name="name"/>
                <field name="code"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_hr_assignment_form" model="ir.ui.view">
        <field name="name">hr.assignment.form</field>
        <field name="model">hr.assignment</field>
        <field name="arch" type="xml">
            <form string="Asignación">
                <sheet>
                    <group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="name"/>
                            <field name="code"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hr_assignment" model="ir.actions.act_window">
        <field name="name">Asignaciones</field>
        <field name="res_model">hr.assignment</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crear la primera asignación
            </p>
            <p>
                Las asignaciones se asignan a los empleados en la pestaña Trabajo de la ficha del empleado.
            </p>
        </field>
    </record>
</odoo>
