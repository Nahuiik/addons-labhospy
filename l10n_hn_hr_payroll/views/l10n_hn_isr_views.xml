<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_l10n_hn_isr_table_tree" model="ir.ui.view">
        <field name="name">l10n.hn.isr.table.tree</field>
        <field name="model">l10n.hn.isr.table</field>
        <field name="arch" type="xml">
            <list string="ISR Tables">
                <field name="name"/>
                <field name="year"/>
                <field name="periodicity"/>
                <field name="company_id"/>
                <field name="state"/>
                <field name="exempt_amount"/>
            </list>
        </field>
    </record>
    
    <record id="view_l10n_hn_isr_table_form" model="ir.ui.view">
        <field name="name">l10n.hn.isr.table.form</field>
        <field name="model">l10n.hn.isr.table</field>
        <field name="arch" type="xml">
            <form string="ISR Table">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="draft,validated"/>
                    <button name="action_validate" string="Validate" type="object" class="oe_highlight" 
                            invisible="state == 'validated'"/>
                    <button name="action_draft" string="Set to Draft" type="object" 
                            invisible="state == 'draft'"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="year"/>
                            <field name="periodicity"/>
                            <field name="company_id"/>
                        </group>
                        <group>
                            <field name="exempt_amount"/>
                            <field name="medical_services_deduction"/>
                        </group>
                    </group>
                    <field name="line_ids" nolabel="1">
                        <list string="Tax Brackets" editable="bottom">
                            <field name="min_amount"/>
                            <field name="max_amount"/>
                            <field name="rate"/>
                            <field name="base_tax"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>
    
    <record id="action_l10n_hn_isr_table" model="ir.actions.act_window">
        <field name="name">ISR Tables</field>
        <field name="res_model">l10n.hn.isr.table</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create ISR Table
            </p>
            <p>
                Configure ISR tax tables by year, periodicity and company.
            </p>
        </field>
    </record>
</odoo>
