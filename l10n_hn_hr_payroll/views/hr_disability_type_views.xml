<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_disability_type_view_list" model="ir.ui.view">
        <field name="name">hr.disability.type.list</field>
        <field name="model">hr.disability.type</field>
        <field name="arch" type="xml">
            <list string="Tipos de discapacidad" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="hr_disability_type_view_form" model="ir.ui.view">
        <field name="name">hr.disability.type.form</field>
        <field name="model">hr.disability.type</field>
        <field name="arch" type="xml">
            <form string="Tipo de discapacidad">
                <sheet>
                    <widget name="web_ribbon" title="Archivado" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="hr_disability_type_action" model="ir.actions.act_window">
        <field name="name">Tipos de discapacidad</field>
        <field name="res_model">hr.disability.type</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Crear un tipo de discapacidad</p>
            <p>Catálogo usado en la ficha del empleado cuando se declara discapacidad.</p>
        </field>
    </record>
</odoo>
