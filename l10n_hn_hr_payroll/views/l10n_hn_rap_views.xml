<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_l10n_hn_rap_settings_tree" model="ir.ui.view">
        <field name="name">l10n.hn.rap.settings.tree</field>
        <field name="model">l10n.hn.rap.settings</field>
        <field name="arch" type="xml">
            <list string="RAP Settings">
                <field name="name"/>
                <field name="year"/>
                <field name="company_id"/>
                <field name="state"/>
                <field name="foviif_floor_monthly"/>
                <field name="frl_ceiling_monthly"/>
            </list>
        </field>
    </record>
    
    <record id="view_l10n_hn_rap_settings_form" model="ir.ui.view">
        <field name="name">l10n.hn.rap.settings.form</field>
        <field name="model">l10n.hn.rap.settings</field>
        <field name="arch" type="xml">
            <form string="RAP Settings">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="draft,validated"/>
                    <button name="action_validate" string="Validate" type="object" class="oe_highlight" 
                            invisible="state == 'validated'"/>
                    <button name="action_draft" string="Set to Draft" type="object" 
                            invisible="state == 'draft'"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="year"/>
                            <field name="company_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="RAP Parameters">
                            <group>
                                <group>
                                    <field name="foviif_floor_monthly"/>
                                    <field name="foviif_employee_rate"/>
                                    <field name="foviif_employer_rate"/>
                                </group>
                            </group>
                        </page>
                        <page string="FRL Parameters">
                            <group>
                                <group>
                                    <field name="frl_minimum_wage_high_scale"/>
                                    <field name="frl_ceiling_monthly" readonly="1"/>
                                    <field name="frl_employer_rate"/>
                                </group>
                            </group>
                        </page>
                        <page string="Application Rules">
                            <group>
                                <group>
                                    <field name="apply_first_quincena"/>
                                    <field name="apply_second_quincena"/>
                                </group>
                            </group>
                        </page>
                        <page string="Accounting">
                            <group>
                                <group>
                                    <field name="foviif_employee_account_id"/>
                                    <field name="foviif_employer_account_id"/>
                                    <field name="frl_employer_account_id"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    
    <record id="action_l10n_hn_rap_settings" model="ir.actions.act_window">
        <field name="name">RAP Settings</field>
        <field name="res_model">l10n.hn.rap.settings</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create RAP Settings
            </p>
            <p>
                Configure RAP parameters by year and company.
            </p>
        </field>
    </record>
</odoo>
