<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista búsqueda -->
    <record id="view_hr_notification_recipient_search" model="ir.ui.view">
        <field name="name">hr.notification.recipient.search</field>
        <field name="model">hr.notification.recipient</field>
        <field name="arch" type="xml">
            <search string="Destinatarios de notificaciones">
                <field name="user_id"/>
                <field name="notification_type"/>
                <field name="company_id"/>
                <filter string="Contrato por vencer" name="filter_contract" domain="[('notification_type', '=', 'contract_expiring')]"/>
                <filter string="Permiso de trabajo" name="filter_work_permit" domain="[('notification_type', '=', 'work_permit_expiring')]"/>
                <filter string="Auditoría nómina" name="filter_audit" domain="[('notification_type', '=', 'payroll_audit')]"/>
                <filter string="Datos personales" name="filter_personal" domain="[('notification_type', '=', 'personal_info_change')]"/>
                <separator/>
                <filter string="Mi compañía" name="filter_my_company" domain="[('company_id', 'in', allowed_company_ids)]"/>
            </search>
        </field>
    </record>

    <!-- Vista lista -->
    <record id="view_hr_notification_recipient_list" model="ir.ui.view">
        <field name="name">hr.notification.recipient.list</field>
        <field name="model">hr.notification.recipient</field>
        <field name="arch" type="xml">
            <list string="Destinatarios de notificaciones" create="1" delete="1">
                <field name="user_id"/>
                <field name="notification_type"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <!-- Vista formulario -->
    <record id="view_hr_notification_recipient_form" model="ir.ui.view">
        <field name="name">hr.notification.recipient.form</field>
        <field name="model">hr.notification.recipient</field>
        <field name="arch" type="xml">
            <form string="Destinatario de notificaciones">
                <sheet>
                    <group>
                        <group>
                            <field name="user_id"/>
                            <field name="notification_type"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Acción -->
    <record id="action_hr_notification_recipient" model="ir.actions.act_window">
        <field name="name">Destinatarios de notificaciones</field>
        <field name="res_model">hr.notification.recipient</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_filter_my_company': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Configurar destinatarios de notificaciones
            </p>
            <p>
                Añada líneas para definir qué usuarios reciben cada tipo de notificación automática:
                contrato por vencer, permiso de trabajo, auditoría de nómina o cambios en datos personales.
            </p>
            <p>
                El inventario de <strong>envíos de correo</strong> (plantillas y crons) del ecosistema Grupohmm
                está en el menú hermano <em>Eventos que envían correo</em>.
            </p>
        </field>
    </record>
</odoo>
