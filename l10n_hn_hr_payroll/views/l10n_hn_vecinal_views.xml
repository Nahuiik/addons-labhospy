<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================ -->
    <!-- IMPUESTO VECINAL BRACKETS VIEWS -->
    <!-- ============================================ -->
    
    <record id="view_l10n_hn_vecinal_bracket_tree" model="ir.ui.view">
        <field name="name">l10n.hn.vecinal.bracket.tree</field>
        <field name="model">l10n.hn.vecinal.bracket</field>
        <field name="arch" type="xml">
            <list string="Impuesto Vecinal Brackets">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="year"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="amount_from" sum="Total"/>
                <field name="amount_to"/>
                <field name="rate_per_mille"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
    
    <record id="view_l10n_hn_vecinal_bracket_form" model="ir.ui.view">
        <field name="name">l10n.hn.vecinal.bracket.form</field>
        <field name="model">l10n.hn.vecinal.bracket</field>
        <field name="arch" type="xml">
            <form string="Impuesto Vecinal Bracket">
                <header>
                    <field name="active" widget="boolean_toggle"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="year"/>
                            <field name="company_id" groups="base.group_multi_company"
                                   options="{'no_create': True}"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="amount_from"/>
                            <field name="amount_to" 
                                   placeholder="0 = No limit"/>
                            <field name="rate_per_mille"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="alert">
                        <strong>Fórmula:</strong> Impuesto del tramo = (Ingreso dentro del tramo / 1000) × tasa por millar
                        <br/>
                        <strong>Ejemplo:</strong> Si el ingreso es L 7,500 y el tramo es 5,001-10,000 @ 2.00‰:
                        <br/>
                        Ingreso en tramo = 7,500 - 5,000 = 2,500
                        <br/>
                        Impuesto = (2,500 / 1,000) × 2.00 = L 5.00
                    </div>
                </sheet>
            </form>
        </field>
    </record>
    
    <record id="view_l10n_hn_vecinal_bracket_search" model="ir.ui.view">
        <field name="name">l10n.hn.vecinal.bracket.search</field>
        <field name="model">l10n.hn.vecinal.bracket</field>
        <field name="arch" type="xml">
            <search string="Search Brackets">
                <field name="year"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                <filter string="Inactive" name="inactive" domain="[('active', '=', False)]"/>
                <separator/>
                <filter string="Group by Year" name="group_by_year" context="{'group_by': 'year'}"/>
                <filter string="Group by Company" name="group_by_company" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
            </search>
        </field>
    </record>
    
    <record id="action_l10n_hn_vecinal_bracket" model="ir.actions.act_window">
        <field name="name">Impuesto Vecinal Brackets</field>
        <field name="res_model">l10n.hn.vecinal.bracket</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create Impuesto Vecinal Brackets
            </p>
            <p>
                Configure tax brackets (tramos) for Impuesto Vecinal calculation.
                Each bracket defines a range of income and a rate per mille (‰).
            </p>
        </field>
    </record>
    
    <!-- ============================================ -->
    <!-- IMPUESTO VECINAL EMPLOYEE INCOME VIEWS -->
    <!-- ============================================ -->
    
    <record id="view_l10n_hn_vecinal_employee_income_tree" model="ir.ui.view">
        <field name="name">l10n.hn.vecinal.employee_income.tree</field>
        <field name="model">l10n.hn.vecinal.employee_income</field>
        <field name="arch" type="xml">
            <list string="Employee Annual Income" editable="bottom">
                <button name="%(action_vecinal_income_generation_wizard)d" 
                        string="Generate for Active Employees" 
                        type="action" 
                        class="btn-primary"
                        icon="fa-plus"
                        groups="l10n_hn_hr_payroll.group_hr_payroll_admin"/>
                <button name="%(action_vecinal_income_import_wizard)d" 
                        string="Import from CSV" 
                        type="action" 
                        class="btn-secondary"
                        icon="fa-file-import"
                        groups="l10n_hn_hr_payroll.group_hr_payroll_admin"/>
                <field name="employee_id" required="1"/>
                <field name="year_base"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="annual_income" sum="Total"/>
                <field name="currency_id" invisible="1"/>
                <field name="state" widget="badge" decoration-success="state == 'confirmed'" decoration-info="state == 'draft'"/>
                <field name="notes" optional="hide"/>
            </list>
        </field>
    </record>
    
    <record id="view_l10n_hn_vecinal_employee_income_form" model="ir.ui.view">
        <field name="name">l10n.hn.vecinal.employee_income.form</field>
        <field name="model">l10n.hn.vecinal.employee_income</field>
        <field name="arch" type="xml">
            <form string="Employee Annual Income">
                <header>
                    <button name="action_confirm" string="Confirm" type="object" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_draft" string="Set to Draft" type="object"
                            invisible="state != 'confirmed'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="employee_id" options="{'no_create': True}"/>
                            <field name="year_base"/>
                            <field name="company_id" groups="base.group_multi_company"
                                   options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="annual_income" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes">
                            <field name="notes" placeholder="Additional notes about this income record..."/>
                        </page>
                    </notebook>
                </sheet>
                <div class="alert alert-info" role="alert">
                    <strong>Nota:</strong> Este ingreso corresponde al año anterior al año de aplicación.
                    <br/>
                    Por ejemplo, si el impuesto se aplica en 2026, el ingreso base debe ser de 2025.
                </div>
            </form>
        </field>
    </record>
    
    <record id="view_l10n_hn_vecinal_employee_income_search" model="ir.ui.view">
        <field name="name">l10n.hn.vecinal.employee_income.search</field>
        <field name="model">l10n.hn.vecinal.employee_income</field>
        <field name="arch" type="xml">
            <search string="Search Employee Income">
                <field name="employee_id"/>
                <field name="year_base"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Confirmed" name="confirmed" domain="[('state', '=', 'confirmed')]"/>
                <separator/>
                <filter string="Group by Year" name="group_by_year" context="{'group_by': 'year_base'}"/>
                <filter string="Group by Company" name="group_by_company" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
                <filter string="Group by Employee" name="group_by_employee" context="{'group_by': 'employee_id'}"/>
            </search>
        </field>
    </record>
    
    <record id="action_l10n_hn_vecinal_employee_income" model="ir.actions.act_window">
        <field name="name">Employee Annual Income</field>
        <field name="res_model">l10n.hn.vecinal.employee_income</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'default_year_base': False, 'default_company_id': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Register Employee Annual Income
            </p>
            <p>
                Register the annual income of employees for the base year (previous year).
                This income will be used to calculate the Impuesto Vecinal deduction.
            </p>
        </field>
    </record>
    
    <!-- ============================================ -->
    <!-- IMPUESTO VECINAL SETTINGS VIEWS -->
    <!-- ============================================ -->
    
    <record id="view_l10n_hn_vecinal_settings_tree" model="ir.ui.view">
        <field name="name">l10n.hn.vecinal.settings.tree</field>
        <field name="model">l10n.hn.vecinal.settings</field>
        <field name="arch" type="xml">
            <list string="Impuesto Vecinal Settings">
                <field name="name"/>
                <field name="year_apply"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="income_year_base"/>
                <field name="deduction_method"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
    
    <record id="view_l10n_hn_vecinal_settings_form" model="ir.ui.view">
        <field name="name">l10n.hn.vecinal.settings.form</field>
        <field name="model">l10n.hn.vecinal.settings</field>
        <field name="arch" type="xml">
            <form string="Impuesto Vecinal Settings">
                <header>
                    <button name="action_create_default_brackets" string="Create Default Brackets" type="object" class="btn-primary"
                            invisible="active == False"/>
                    <field name="active" widget="boolean_toggle"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="year_apply"/>
                            <field name="company_id" groups="base.group_multi_company"
                                   options="{'no_create': True}"/>
                            <field name="income_year_base"/>
                        </group>
                        <group>
                            <field name="deduction_method"/>
                            <field name="rounding"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Brackets">
                            <div class="alert alert-warning" role="alert">
                                <strong>Nota:</strong> Use the "Create Default Brackets" button to create brackets for this year.
                                <br/>
                                To view or edit brackets, go to: <strong>Payroll → Nómina HN → Impuesto Vecinal → Tramos</strong>
                            </div>
                        </page>
                    </notebook>
                </sheet>
                <div class="alert alert-info" role="alert">
                    <strong>Cálculo del Impuesto Vecinal:</strong>
                    <ul>
                        <li>Se calcula sobre el ingreso anual del año anterior (income_year_base)</li>
                        <li>Se aplica la tabla de tramos del año de aplicación (year_apply)</li>
                        <li>El impuesto anual se prorratea según el método de deducción configurado:</li>
                        <ul>
                            <li><strong>Primera Quincena de Enero:</strong> Todo el impuesto se deduce en la primera quincena de enero</li>
                            <li><strong>Primeras Dos Quincenas de Enero:</strong> El impuesto se divide entre las dos primeras quincenas de enero</li>
                            <li><strong>Primeras Cuatro Quincenas:</strong> El impuesto se divide entre las primeras 4 quincenas del año</li>
                            <li><strong>Mensual:</strong> El impuesto se divide entre los 12 meses del año</li>
                            <li><strong>Quincenal Todo el Año:</strong> El impuesto se divide entre las 24 quincenas del año</li>
                        </ul>
                    </ul>
                </div>
            </form>
        </field>
    </record>
    
    <record id="view_l10n_hn_vecinal_settings_search" model="ir.ui.view">
        <field name="name">l10n.hn.vecinal.settings.search</field>
        <field name="model">l10n.hn.vecinal.settings</field>
        <field name="arch" type="xml">
            <search string="Search Settings">
                <field name="year_apply"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                <filter string="Inactive" name="inactive" domain="[('active', '=', False)]"/>
                <separator/>
                <filter string="Group by Year" name="group_by_year" context="{'group_by': 'year_apply'}"/>
                <filter string="Group by Company" name="group_by_company" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
            </search>
        </field>
    </record>
    
    <record id="action_l10n_hn_vecinal_settings" model="ir.actions.act_window">
        <field name="name">Impuesto Vecinal Settings</field>
        <field name="res_model">l10n.hn.vecinal.settings</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create Impuesto Vecinal Settings
            </p>
            <p>
                Configure how Impuesto Vecinal will be deducted in payroll.
                Set the application year and deduction method (how the tax is prorated throughout the year).
            </p>
        </field>
    </record>
    
    <!-- Wizard action for generating employee income records -->
    <record id="action_generate_employee_income_wizard" model="ir.actions.act_window">
        <field name="name">Generate Employee Income Records</field>
        <field name="res_model">l10n.hn.vecinal.employee_income</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_year_base': False, 'default_company_id': False}</field>
    </record>
    
</odoo>
