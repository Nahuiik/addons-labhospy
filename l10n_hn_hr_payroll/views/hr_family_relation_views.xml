<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="hr_family_relation_view_list" model="ir.ui.view">
        <field name="name">hr.family.relation.list</field>
        <field name="model">hr.family.relation</field>
        <field name="arch" type="xml">
            <list string="Relaciones Familiares" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="hr_family_relation_view_form" model="ir.ui.view">
        <field name="name">hr.family.relation.form</field>
        <field name="model">hr.family.relation</field>
        <field name="arch" type="xml">
            <form string="Relación Familiar">
                <sheet>
                    <div class="oe_button_box" name="button_box"/>
                    <widget name="web_ribbon" title="Archivado" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="hr_family_relation_action" model="ir.actions.act_window">
        <field name="name">Relaciones Familiares</field>
        <field name="res_model">hr.family.relation</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crear una relación familiar
            </p>
            <p>
                Configure las relaciones familiares disponibles para los contactos de emergencia
                (ej: Padre, Madre, Cónyuge, Hermano, Hijo, etc.)
            </p>
        </field>
    </record>

    <!-- Data: Default family relations -->
