<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_employee_form_hn_vacation" model="ir.ui.view">
        <field name="name">hr.employee.form.hn.vacation</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Vacaciones" name="hn_vacation">
                    <header>
                        <button name="action_hn_generate_vacation_allocation" type="object"
                            string="Generar asignaciones de vacaciones"
                            class="btn-primary"
                            groups="hr_holidays.group_hr_holidays_user"/>
                        <button name="action_open_hn_initial_balance_wizard" type="object"
                            string="Cargar saldo inicial"
                            class="btn-secondary"
                            groups="hr_holidays.group_hr_holidays_user"/>
                    </header>
                    <div class="alert alert-secondary mb-2" role="status" colspan="2">
                        <div class="fw-bold mb-1 text-body o_hn_vac_days_payroll_heading">Días y nómina de vacaciones</div>
                        <p class="mb-0 small">
                            <strong>Saldo / tiempo libre:</strong> corresponde a la asignación menos vacaciones gozadas
                            y menos lo liquidado en nómina de vacaciones.
                            <br/>
                            <strong>Liquidación en nómina de vacaciones:</strong> usa solo días otorgados menos
                            “Días liquidados nómina vacaciones” en cada asignación (no resta los días ya tomados como
                            ausencia; eso debe reflejarse en la nómina regular).
                        </p>
                    </div>
                    <group>
                        <group string="Contrato vigente">
                            <field name="contract_date_start" string="Fecha de ingreso"/>
                            <field name="hn_vacation_requests_allowed" widget="boolean_toggle"/>
                            <field name="hn_override_anniversary_vacation_block" widget="boolean_toggle"/>
                            <field name="hn_vacation_plan_id" domain="[('company_id', 'in', [company_id, False])]"/>
                            <field name="hn_seniority_display" string="Antigüedad"/>
                            <field name="hn_current_entitled_days"/>
                            <field name="hn_initial_vacation_taken_display" readonly="1" string="Saldo inicial de vacaciones"/>
                            <field name="hn_vacation_balance"/>
                            <field name="hn_current_balance"/>
                            <field name="hn_is_temporary"/>
                            <field name="hn_initial_vacation_taken" invisible="1"/>
                            <field name="hn_initial_balance_date" invisible="1"/>
                            <field name="hn_initial_balance_loaded" invisible="1"/>
                        </group>
                    </group>
                    <separator string="Asignaciones de vacaciones"/>
                    <field name="hn_vacation_allocation_ids" nolabel="1"
                           domain="[('holiday_status_id.gn_vacation_is_primary', '=', True), '|', ('holiday_status_id.company_id', '=', False), ('holiday_status_id.company_id', '=', parent.company_id), '|', ('holiday_status_id.country_id', '=', False), ('holiday_status_id.country_id', '=', parent.company_id.country_id)]">
                        <list create="0" delete="0" editable="bottom">
                            <field name="name"/>
                            <field name="hn_vacation_period_start"/>
                            <field name="hn_vacation_period_end"/>
                            <field name="number_of_days"/>
                            <field name="leaves_taken"/>
                            <field name="state"/>
                            <field name="hn_allow_accumulation"/>
                        </list>
                    </field>
                    <separator string="Vacaciones gozadas"/>
                    <field name="hn_vacation_leave_ids" nolabel="1"
                           domain="[('holiday_status_id.gn_vacation_is_primary', '=', True), '|', ('holiday_status_id.company_id', '=', False), ('holiday_status_id.company_id', '=', parent.company_id), '|', ('holiday_status_id.country_id', '=', False), ('holiday_status_id.country_id', '=', parent.company_id.country_id)]">
                        <list create="0" delete="0" editable="bottom">
                            <field name="request_date_from"/>
                            <field name="request_date_to"/>
                            <field name="number_of_days"/>
                            <field name="state"/>
                            <field name="hn_constancia_signed"/>
                            <field name="hn_paid_in_advance"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_hr_employee_form_hn_vacation_tab_order" model="ir.ui.view">
        <field name="name">hr.employee.form.hn.vacation.tab.order</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="priority" eval="1001"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='benefits_deductions_history']" position="after">
                <page name="hn_vacation" position="move"/>
            </xpath>
        </field>
    </record>
</odoo>
