<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Usamos los grupos de hr_holidays para acceso: group_hr_holidays_user (Officer) y group_hr_holidays_manager. -->

        <!-- Reglas multicompañía: restringir a compañías del usuario -->
        <record id="rule_gn_hn_vacation_salary_map_company" model="ir.rule">
            <field name="name">gn.hn.vacation.salary.map: multicompañía</field>
            <field name="model_id" ref="model_gn_hn_vacation_salary_map"/>
            <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
        </record>
        <record id="rule_gn_hn_vacation_libro_company" model="ir.rule">
            <field name="name">gn.hn.vacation.libro: multicompañía</field>
            <field name="model_id" ref="model_gn_hn_vacation_libro"/>
            <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
        </record>
    </data>
</odoo>
