<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <data>
        <template id="external_layout_nahuiik_original">
            <div class="header" style="margin-bottom:0px;">
                <style>
                    *{
                        font-family: 'Bitstream Charter';
                        font-family::'Bitstream Vera Serif';
                    }
                    p,span,t {
                        margin-top:0px;
                        margin-bottom:0px;
                        padding-top:0px;
                        padding-bottom:0px;
                        font-size:11px;
                    }
                    .duo {
                        display:inline;
                    }
                    h4 {
                        margin-top:0px;
                        margin-bottom:0px;
                        padding-top:0px;
                        padding-bottom:0px;
                        font-size:16px;
                    }
                    .col-xs-12{
                        width:100%
                    }
                    .text-right{
                        text-align: inherit;
                    }
                </style>
                <div class="container" style="border: 1px solid gray;border-radius: 5px;margin-top:10px;">
                    <div class="row" style="min-height:90;">
                        <div class="col-xs-12">
                            <div style="position:absolute;z-index:0;">
                                <div style="width: 100px;float: left; padding-left:10px; padding-top:10px; border-radius:10px !important">
                                    <img src='/web/binary/company_logo' style="width:100%; border-radius:10px !important"/>
                                </div>
                            </div>
                            <div class="text-center text-uppercase" style="margin-top:15px;z-index: 1;">
                                <h3 t-if="res_company.name"> <t t-esc="res_company.name"/> </h3>
                                <p>
                                    <span class="duo" t-if="res_company.street" ><t t-esc="res_company.street + ' ' "/> </span>
                                    <span class="duo" t-if="res_company.street2" ><t t-esc="res_company.street2 + ' ' "/></span> 
                                    <br/>
                                    <!-- <p class="duo" t-if="res_company.email" > -->
                                        <span class="fa fa-envelope-open"></span> 
                                        <t t-esc=" '  Correo: ' + res_company.email+' ' "/> 
                                    <!-- <br/> -->
                                    <!-- </p>
                                    <p class="duo" t-if="res_company.phone" > -->
                                        <span class="fa fa-phone-square"></span> 
                                        <t t-esc=" '  Telefono: ' + res_company.phone+' ' "/> 
                                    <!-- </p> -->
                                    <br/>
                                    <p t-if="res_company.company_registry" style="margin-right:0px;">
                                        <span class="fa fa-suitcase"></span>
                                        <t t-esc=" 'RTN: '+res_company.company_registry"/> 
                                    </p>
                                </p>       
                            </div>
                            <div class="row">
                                <div class="col-xs-12 text-right">
                                        <!-- <p t-if="res_company.company_registry" style="margin-right:0px;">
                                            <span class="fa fa-suitcase"></span>
                                            <t t-esc=" 'RTN: '+res_company.company_registry"/> 
                                        </p> -->
                                </div>            
                            </div>
                            <div t-if="res_company.logo or res_company.report_header" class="row zero_min_height">
                                <div class="col-xs-12">
                                </div>            
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="article o_report_layout_standard">
                <t t-raw="0"/>
            </div>
            <!--<div class="footer">
                <div class="text-center">
                    <div name="financial_infos">
                        <span t-field="res_company.report_footer"/>
                    </div>

                    <div class="text-muted">
                         Page: <span class="page"/> / <span class="topage"/> 
                    </div>
                </div>
            </div>-->
        </template>
    </data>
</odoo>