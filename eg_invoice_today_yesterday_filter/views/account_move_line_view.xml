<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="account_move_line_view_search_filters" model="ir.ui.view">
        <field name="name">account.move.line.search.filters</field>
        <field name="model">account.move.line</field>
        <field name="inherit_id" ref="account.view_account_move_line_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='date']" position="after">
                <separator/>
                <filter string="Hoy" name="today" domain="[('create_date','>=',datetime.datetime.now().strftime('%%Y-%%m-%%d 00:00:00')),('create_date','&lt;=',datetime.datetime.now().strftime('%%Y-%%m-%%d 23:59:59'))]"/>
                <filter string="Ayer" name="yesterday"
                        domain="[('create_date','>=',((context_today()-datetime.timedelta(days=1)).strftime('%%Y-%%m-%%d 00:00:00'))),('create_date','&lt;',(context_today().strftime('%%Y-%%m-%%d 00:00:00')))]"/>
                <separator/>
            </xpath>
        </field>
    </record>
</odoo>


