<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_inherit_gn_brand" model="ir.ui.view">
        <field name="name">res.company.form.inherit.gn.brand</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="systray_name" placeholder="Nombre para mostrar en el systray"/>
            </xpath>
        </field>
    </record>
</odoo>


