<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">

    <t t-name="gn_customer_due_alerts.CxcPartnerListBanner">
        <div class="o_cxc_partner_banner o_gn_aging">
            <div class="o_gn_aging_header o_cxc_partner_banner__header">
                <div>
                    <h2 class="o_gn_aging_title">CxC abiertos por contacto</h2>
                    <p class="o_gn_aging_sub">Resumen por antigüedad según filtros activos</p>
                </div>
                <div class="o_gn_aging_header_right">
                    <span class="o_gn_aging_company" t-if="props.state.data">
                        <i class="fa fa-building-o me-1"/>
                        <t t-esc="props.state.data.company"/>
                    </span>
                    <span class="o_gn_aging_cutoff ms-3" t-if="props.state.data">
                        <i class="fa fa-calendar me-1"/>
                        <t t-esc="props.state.data.today"/>
                    </span>
                    <button class="btn btn-secondary btn-sm ms-2" t-on-click="onReloadClick">
                        <i class="fa fa-refresh"/>
                    </button>
                    <button t-if="props.isGroupedView"
                            type="button"
                            class="btn btn-secondary btn-sm ms-2"
                            t-att-title="props.allGroupsExpanded ? 'Contraer grupos' : 'Expandir grupos'"
                            t-att-aria-label="props.allGroupsExpanded ? 'Contraer grupos' : 'Expandir grupos'"
                            t-on-click="onToggleGroupsClick">
                        <i t-att-class="'oi oi-fw ' + (props.allGroupsExpanded ? 'oi-view-list' : 'oi-group')"/>
                    </button>
                </div>
            </div>

            <div t-if="props.state.loading" class="o_gn_aging_msg">
                <i class="fa fa-spinner fa-spin me-2"/>Cargando resumen...
            </div>
            <div t-if="props.state.error" class="o_gn_aging_msg text-danger">
                <t t-esc="props.state.error"/>
            </div>

            <t t-if="!props.state.loading and !props.state.error and props.state.data">
                <div class="o_gn_kpi_scroll">
                    <div class="o_gn_aging_kpis">
                        <t t-foreach="agingOrder" t-as="key" t-key="key">
                            <div t-attf-class="o_gn_aging_card o_gn_age_{{ key }}">
                                <div class="o_gn_aging_card_top">
                                    <span t-attf-class="o_gn_age_badge o_gn_age_badge_{{ key }}"
                                          t-esc="props.state.data.cards[key].short"/>
                                </div>
                                <div class="o_gn_aging_card_range">
                                    (<t t-esc="props.state.data.cards[key].range"/>)
                                </div>
                                <div class="o_gn_aging_card_count">
                                    <t t-esc="props.state.data.cards[key].partner_count"/> clientes
                                </div>
                                <div class="o_gn_aging_card_amount">
                                    <t t-esc="props.state.data.cards[key].total_str"/>
                                </div>
                                <div class="o_gn_aging_card_pct">
                                    <t t-esc="props.state.data.cards[key].pct"/>% del total
                                </div>
                            </div>
                        </t>
                    </div>
                </div>

                <div class="o_gn_aging_summary">
                    <div class="o_gn_sum_box">
                        <div class="o_gn_sum_label">Total por Cobrar</div>
                        <div class="o_gn_sum_value" t-esc="props.state.data.summary.grand_total_str"/>
                        <div class="o_gn_sum_sub">
                            <t t-esc="props.state.data.summary.partner_count"/> clientes
                        </div>
                    </div>
                    <div class="o_gn_sum_box">
                        <div class="o_gn_sum_label">Factura Mas Antigua</div>
                        <div class="o_gn_sum_value text-danger">
                            <t t-esc="props.state.data.summary.oldest_days"/> dias
                        </div>
                        <div class="o_gn_sum_sub" t-esc="props.state.data.summary.oldest_partner"/>
                    </div>
                    <div class="o_gn_sum_box">
                        <div class="o_gn_sum_label">Proximos a Vencer (7 dias)</div>
                        <div class="o_gn_sum_value text-warning"
                             t-esc="props.state.data.summary.due_7_total_str"/>
                        <div class="o_gn_sum_sub">
                            <t t-esc="props.state.data.summary.due_7_count"/> facturas
                        </div>
                    </div>
                    <div class="o_gn_sum_box o_gn_sum_dist">
                        <div class="o_gn_sum_label">Distribucion por Antiguedad</div>
                        <div class="o_gn_dist_bar">
                            <t t-foreach="props.state.data.distribution" t-as="seg" t-key="seg.key">
                                <div t-attf-class="o_gn_dist_seg o_gn_dist_{{ seg.key }}"
                                     t-attf-style="width: {{ seg.pct }}%"
                                     t-att-title="seg.label + ': ' + seg.pct + '%'"/>
                            </t>
                        </div>
                        <div class="o_gn_dist_labels">
                            <t t-foreach="props.state.data.distribution" t-as="seg" t-key="seg.key">
                                <span t-attf-class="o_gn_dist_lbl o_gn_dist_{{ seg.key }}">
                                    <t t-esc="seg.pct"/>%
                                </span>
                            </t>
                        </div>
                    </div>
                </div>
            </t>
        </div>
    </t>

</templates>
