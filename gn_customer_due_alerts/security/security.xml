<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="module_category_customer_due_alerts" model="ir.module.category">
        <field name="name">Alertas de Cobros</field>
        <field name="description">Acceso al tablero y alertas de vencimiento de facturas de clientes.</field>
        <field name="sequence">21</field>
    </record>

    <record id="privilege_customer_due_alerts" model="res.groups.privilege">
        <field name="name">Alertas de Cobro</field>
        <field name="category_id" ref="module_category_customer_due_alerts"/>
    </record>

    <record id="group_customer_due_alert_user" model="res.groups">
        <field name="name">Usuario</field>
        <field name="privilege_id" ref="privilege_customer_due_alerts"/>
        <field name="comment">Puede ver el tablero de cobros a clientes y recibe correos y notificaciones.</field>
        <field name="implied_ids" eval="[(4, ref('account.group_account_invoice'))]"/>
    </record>

    <record id="group_customer_due_alert_manager" model="res.groups">
        <field name="name">Administrador</field>
        <field name="privilege_id" ref="privilege_customer_due_alerts"/>
        <field name="comment">Puede configurar alertas de cobro y enviarlas manualmente.</field>
        <field name="implied_ids" eval="[(4, ref('group_customer_due_alert_user'))]"/>
    </record>

</odoo>
