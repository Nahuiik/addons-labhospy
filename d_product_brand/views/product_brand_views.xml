<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<record id="view_product_brand_form" model="ir.ui.view">
		<field name="name">d.product.brand.form</field>
		<field name="model">d.product.brand</field>
		<field name="arch" type="xml">
			<form>
				<sheet>
					<field name="logo" widget="image" class="oe_avatar"/>
					<div class="oe_title">
						<label for="name" class="oe_edit_only"/>
						<h1><field name="name"/></h1>
					</div>
					<group>
						<field name="website"/>
						<field name="description"/>
					</group>
				</sheet>
			</form>
		</field>
	</record>

	<record id="view_product_brand_list" model="ir.ui.view">
		<field name="name">d.product.brand.list</field>
		<field name="model">d.product.brand</field>
		<field name="arch" type="xml">
			<list>
				<field name="name"/>
				<field name="description"/>
			</list>
		</field>
	</record>

	<record id="action_product_brand" model="ir.actions.act_window">
		<field name="name">Product Brands</field>
		<field name="res_model">d.product.brand</field>
		<field name="view_mode">list,form</field>
	</record>

	<record id="view_product_brand_search" model="ir.ui.view">
		<field name="name">d.product.brand.search</field>
		<field name="model">d.product.brand</field>
		<field name="arch" type="xml">
			<search>
				<field name="name" />
				<group />
			</search>
		</field>
	</record>

	<menuitem id="menu_product_brand"
		name="Product Brands"
		action="action_product_brand"
		parent="sale.prod_config_main"
		sequence="99" />
</odoo>
