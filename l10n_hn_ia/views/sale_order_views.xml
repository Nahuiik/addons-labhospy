<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Sale Order Form View - Update with AI Fields -->
    <record id="view_order_form_ia_suggestion" model="ir.ui.view">
        <field name="name">sale.order.form.ia.suggestion</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <!-- Add AI badge in header -->
            <xpath expr="//header" position="inside">
                <field name="x_generated_by_ai" widget="boolean_toggle" 
                       invisible="not x_generated_by_ai" 
                       readonly="1" 
                       string="Generated by AI"
                       groups="l10n_hn_ia.ai_group_sales_user"/>
            </xpath>
            
            <!-- Add AI section -->
            <xpath expr="//field[@name='order_line']" position="after">
                <group string="AI Suggestion" name="ai_suggestion_group" col="2" 
                       groups="l10n_hn_ia.ai_group_sales_user">
                    <field name="ia_enabled"/>
                    <field name="ia_suggestion_state" widget="badge" 
                           decoration-info="ia_suggestion_state == 'processing'"
                           decoration-success="ia_suggestion_state == 'completed'"
                           decoration-danger="ia_suggestion_state == 'error'"
                           decoration-muted="ia_suggestion_state == 'pending'"/>
                    <field name="ia_suggestion_date" readonly="1"/>
                    <field name="x_ai_log_id" invisible="not x_ai_log_id"/>
                    <field name="x_lead_id" invisible="not x_lead_id"/>
                    <button name="action_get_ia_suggestion" 
                            type="object" 
                            string="Get AI Suggestion" 
                            class="btn-primary"
                            icon="fa-lightbulb-o"
                            invisible="ia_suggestion_state == 'processing'"/>
                    <field name="ia_suggestion_text" 
                           widget="text" 
                           placeholder="Click 'Get AI Suggestion' to generate AI-powered suggestions for this quotation"
                           nolabel="1"
                           colspan="2"
                           readonly="1"/>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Add AI Suggestion field in tree view -->
    <record id="view_order_tree_ia_suggestion" model="ir.ui.view">
        <field name="name">sale.order.tree.ia.suggestion</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='amount_total']" position="after">
                <field name="x_generated_by_ai" widget="boolean_toggle" 
                       optional="hide"
                       groups="l10n_hn_ia.ai_group_sales_user"/>
                <field name="ia_suggestion_state" 
                       widget="badge" 
                       optional="hide"
                       decoration-info="ia_suggestion_state == 'processing'"
                       decoration-success="ia_suggestion_state == 'completed'"
                       decoration-danger="ia_suggestion_state == 'error'"
                       decoration-muted="ia_suggestion_state == 'pending'"
                       groups="l10n_hn_ia.ai_group_sales_user"/>
            </xpath>
        </field>
    </record>
</odoo>
