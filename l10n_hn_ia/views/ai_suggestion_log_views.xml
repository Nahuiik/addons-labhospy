<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- AI Suggestion Log Tree View -->
    <record id="view_ai_suggestion_log_list" model="ir.ui.view">
        <field name="name">ai.suggestion.log.list</field>
        <field name="model">ai.suggestion.log</field>
        <field name="arch" type="xml">
            <list string="AI Suggestions">
                <field name="name"/>
                <field name="lead_id"/>
                <field name="sale_id"/>
                <field name="provider"/>
                <field name="model_name"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-success="state == 'suggested' or state == 'applied'"
                       decoration-danger="state == 'failed'"
                       decoration-muted="state == 'draft'"/>
                <field name="user_id"/>
                <field name="date"/>
            </list>
        </field>
    </record>
    
    <!-- AI Suggestion Log Form View -->
    <record id="view_ai_suggestion_log_form" model="ir.ui.view">
        <field name="name">ai.suggestion.log.form</field>
        <field name="model">ai.suggestion.log</field>
        <field name="arch" type="xml">
            <form string="AI Suggestion">
                <header>
                    <button name="action_view_lead" type="object" string="View Lead" icon="fa-external-link" 
                            invisible="not lead_id"/>
                    <button name="action_view_sale_order" type="object" string="View Sale Order" icon="fa-external-link"
                            invisible="not sale_id"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,suggested,applied,failed"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="lead_id"/>
                            <field name="sale_id"/>
                            <field name="provider"/>
                            <field name="model_name"/>
                            <field name="user_id"/>
                            <field name="date"/>
                        </group>
                        <group>
                            <field name="state" widget="badge"/>
                            <field name="error_msg" invisible="state != 'failed'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Prompt">
                            <field name="prompt" widget="text" readonly="1"/>
                        </page>
                        <page string="Raw Response">
                            <field name="response_raw" widget="text" readonly="1"/>
                        </page>
                        <page string="Parsed Payload">
                            <field name="parsed_payload" widget="json" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    
    <!-- AI Suggestion Log Action -->
    <record id="action_ai_suggestion_log" model="ir.actions.act_window">
        <field name="name">AI Suggestions</field>
        <field name="res_model">ai.suggestion.log</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No AI suggestions yet.
            </p>
            <p>
                AI suggestions are generated when you use the AI assistant to create quotations from leads.
            </p>
        </field>
    </record>
</odoo>

