<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- CRM Lead Form View - Add AI Fields -->
    <record id="view_crm_lead_form_ai" model="ir.ui.view">
        <field name="name">crm.lead.form.ai</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <!-- Add AI button in header -->
            <xpath expr="//header" position="inside">
                <button name="action_ai_suggest_quote" type="object" string="AI: Suggest Quote" 
                        class="btn-primary" icon="fa-brain"
                        groups="l10n_hn_ia.ai_group_sales_user"/>
            </xpath>
            
            <!-- Add AI section -->
            <xpath expr="//field[@name='description']" position="after">
                <group string="AI Assistant" name="ai_section" col="2" groups="l10n_hn_ia.ai_group_sales_user">
                    <field name="x_intent" widget="badge"
                           decoration-info="x_intent == 'none'"
                           decoration-success="x_intent == 'quote'"
                           decoration-warning="x_intent == 'support'"
                           decoration-muted="x_intent == 'other'"/>
                    <field name="x_ready_for_quote"/>
                    <field name="x_sale_order_id" invisible="not x_sale_order_id"/>
                    <field name="x_ai_last_log_id" invisible="not x_ai_last_log_id"/>
                    <field name="x_ai_suggestion_count" widget="statinfo" string="AI Suggestions"/>
                </group>
            </xpath>
            
            <!-- Add smart button for AI suggestions -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_ai_suggestions" type="object" 
                        string="AI Suggestions" icon="fa-brain"
                        class="oe_stat_button" context="{'default_lead_id': id}"
                        invisible="not x_ai_suggestion_count"
                        groups="l10n_hn_ia.ai_group_sales_user">
                    <field name="x_ai_suggestion_count" widget="statinfo" string="AI Suggestions"/>
                </button>
                <button name="action_view_generated_quote" type="object" 
                        string="Generated Quote" icon="fa-file-text-o"
                        class="oe_stat_button"
                        invisible="not x_sale_order_id"
                        groups="l10n_hn_ia.ai_group_sales_user">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Quote</span>
                        <span class="o_stat_value" name="x_sale_order_id"/>
                    </div>
                </button>
            </xpath>
        </field>
    </record>
    
    <!-- CRM Lead Tree View - Add AI Fields -->
    <record id="view_crm_lead_list_ai" model="ir.ui.view">
        <field name="name">crm.lead.list.ai</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_case_tree_view_leads"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="x_intent" widget="badge" optional="hide"
                       decoration-info="x_intent == 'none'"
                       decoration-success="x_intent == 'quote'"
                       decoration-warning="x_intent == 'support'"
                       decoration-muted="x_intent == 'other'"
                       groups="l10n_hn_ia.ai_group_sales_user"/>
            </xpath>
        </field>
    </record>
</odoo>

