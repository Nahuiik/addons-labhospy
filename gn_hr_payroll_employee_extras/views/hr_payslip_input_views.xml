<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_payslip_form_recurring_input" model="ir.ui.view">
        <field name="name">hr.payslip.form.recurring.input</field>
        <field name="model">hr.payslip</field>
        <field name="inherit_id" ref="l10n_hn_payroll_base.view_hr_payslip_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='input_line_ids']/list/field[@name='amount']" position="after">
                <field name="recurring_concept_id" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
