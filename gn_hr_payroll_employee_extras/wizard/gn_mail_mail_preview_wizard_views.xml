<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_gn_mail_mail_preview_wizard_form" model="ir.ui.view">
        <field name="name">gn.mail.mail.preview.wizard.form</field>
        <field name="model">gn.mail.mail.preview.wizard</field>
        <field name="arch" type="xml">
            <form string="Vista previa del correo">
                <sheet>
                    <group>
                        <field name="mail_id" invisible="1"/>
                        <field name="subject"/>
                        <field name="email_from"/>
                        <field name="email_to"/>
                    </group>
                    <separator string="Cuerpo del mensaje"/>
                    <field name="body_preview" widget="html" nolabel="1" readonly="1"/>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
