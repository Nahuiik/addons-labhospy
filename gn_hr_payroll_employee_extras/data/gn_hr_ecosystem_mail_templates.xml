<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Plantillas estándar Odoo del ecosistema -->
    <record id="l10n_hn_payroll_base.mail_template_new_payslip" model="mail.template">
        <field name="gn_hr_ecosystem" eval="True"/>
    </record>
    <record id="auth_signup.portal_set_password_email" model="mail.template">
        <field name="gn_hr_ecosystem" eval="True"/>
    </record>

    <record id="view_gn_hr_ecosystem_mail_template_search" model="ir.ui.view">
        <field name="name">mail.template.search.gn.hr.ecosystem</field>
        <field name="model">mail.template</field>
        <field name="inherit_id" ref="mail.view_email_template_search"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <separator/>
                <filter name="gn_tpl_model_gn_application" string="Solicitud GN"
                        domain="[('model', '=', 'gn.employee.application')]"/>
                <filter name="gn_tpl_model_applicant" string="Candidato"
                        domain="[('model', '=', 'hr.applicant')]"/>
                <filter name="gn_tpl_model_employee" string="Empleado"
                        domain="[('model', '=', 'hr.employee')]"/>
                <filter name="gn_tpl_model_leave" string="Ausencia / vacaciones"
                        domain="[('model', '=', 'hr.leave')]"/>
                <filter name="gn_tpl_model_users" string="Usuario"
                        domain="[('model', '=', 'res.users')]"/>
                <filter name="gn_tpl_model_payslip" string="Recibo de nómina"
                        domain="[('model', '=', 'hr.payslip')]"/>
            </xpath>
        </field>
    </record>

    <record id="action_gn_hr_ecosystem_mail_templates" model="ir.actions.act_window">
        <field name="name">Plantillas correo</field>
        <field name="res_model">mail.template</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="mail.email_template_tree"/>
        <field name="search_view_id" ref="view_gn_hr_ecosystem_mail_template_search"/>
        <field name="domain" eval="[('model', 'in', ('gn.employee.application', 'hr.applicant', 'hr.employee', 'hr.leave', 'res.users', 'hr.payslip'))]"/>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No hay plantillas del ecosistema
            </p>
            <p>
                Plantillas de correo cuyo modelo es: solicitud de datos GN, candidato,
                empleado, ausencias/vacaciones, usuario (p. ej. invitación portal) o recibo de nómina.
            </p>
        </field>
    </record>

    <menuitem id="menu_gn_hr_ecosystem_mail_templates"
              name="Plantillas correo"
              parent="menu_gn_hr_correos"
              action="action_gn_hr_ecosystem_mail_templates"
              sequence="20"
              groups="hr.group_hr_manager"/>
</odoo>
