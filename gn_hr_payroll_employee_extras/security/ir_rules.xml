<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="hr_document_type_company_rule" model="ir.rule">
            <field name="name">Tipo de documento empleado: multicompañía</field>
            <field name="model_id" ref="model_hr_document_type"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="hr_employee_document_company_rule" model="ir.rule">
            <field name="name">Documento de empleado: multicompañía (por empleado)</field>
            <field name="model_id" ref="model_hr_employee_document"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>
    </data>
    <data>
        <record id="hr_employee_recurring_concept_company_rule" model="ir.rule">
            <field name="name">Concepto recurrente: multicompañía</field>
            <field name="model_id" ref="model_hr_employee_recurring_concept"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
    </data>
    <data>
        <record id="rule_mail_mail_gn_hr_employee_ecosystem_read" model="ir.rule">
            <field name="name">Correos salientes: solo modelos nómina/RRHH (GN)</field>
            <field name="model_id" ref="mail.model_mail_mail"/>
            <field name="domain_force">[('model', 'in', (
                'calendar.event',
                'gn.employee.application',
                'gn.employee.complaint',
                'hr.applicant',
                'hr.contract',
                'hr.employee',
                'hr.leave',
                'hr.payslip',
                'hr.payslip.run',
                'hr.version',
                'res.users',
                'salary.advance',
                'survey.user_input',
            ))]</field>
            <field name="groups" eval="[(
                6, 0, [
                    ref('l10n_hn_payroll_base.group_hn_payroll_user'),
                    ref('l10n_hn_payroll_base.group_hn_payroll_manager'),
                ],
            )]"/>
        </record>
    </data>
    <data>
        <record id="rule_mailing_trace_gn_hr_employee_ecosystem_read" model="ir.rule">
            <field name="name">Rastreos envío: solo modelos nómina/RRHH (GN)</field>
            <field name="model_id" ref="mass_mailing.model_mailing_trace"/>
            <field name="domain_force">[('model', 'in', (
                'calendar.event',
                'gn.employee.application',
                'gn.employee.complaint',
                'hr.applicant',
                'hr.contract',
                'hr.employee',
                'hr.leave',
                'hr.payslip',
                'hr.payslip.run',
                'hr.version',
                'res.users',
                'salary.advance',
                'survey.user_input',
            ))]</field>
            <field name="groups" eval="[(
                6, 0, [
                    ref('l10n_hn_payroll_base.group_hn_payroll_user'),
                    ref('l10n_hn_payroll_base.group_hn_payroll_manager'),
                ],
            )]"/>
        </record>
        <record id="rule_mailing_mailing_gn_hr_transactional_read" model="ir.rule">
            <field name="name">Mailings: solo envíos transaccionales nómina/RRHH (GN)</field>
            <field name="model_id" ref="mass_mailing.model_mailing_mailing"/>
            <field name="domain_force">[('gn_hr_transactional', '=', True)]</field>
            <field name="groups" eval="[(
                6, 0, [
                    ref('l10n_hn_payroll_base.group_hn_payroll_user'),
                    ref('l10n_hn_payroll_base.group_hn_payroll_manager'),
                ],
            )]"/>
        </record>
    </data>
</odoo>
