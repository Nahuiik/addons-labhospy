<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="module_category_invoice_due_alerts" model="ir.module.category">
        <field name="name">Alertas de Pagos</field>
        <field name="description">Acceso al tablero y alertas de vencimiento de facturas y préstamos.</field>
        <field name="sequence">20</field>
    </record>

    <record id="privilege_invoice_due_alerts" model="res.groups.privilege">
        <field name="name">Alertas de Pago</field>
        <field name="category_id" ref="module_category_invoice_due_alerts"/>
    </record>

    <record id="group_invoice_due_alert_user" model="res.groups">
        <field name="name">Usuario</field>
        <field name="privilege_id" ref="privilege_invoice_due_alerts"/>
        <field name="comment">Puede ver el tablero tipo semáforo y recibe los
            correos y notificaciones emergentes de vencimiento.</field>
        <field name="implied_ids" eval="[(4, ref('account.group_account_invoice'))]"/>
    </record>

    <record id="group_invoice_due_alert_manager" model="res.groups">
        <field name="name">Administrador</field>
        <field name="privilege_id" ref="privilege_invoice_due_alerts"/>
        <field name="comment">Además puede lanzar el envío de alertas manualmente
            y configurar los parámetros.</field>
        <field name="implied_ids" eval="[(4, ref('group_invoice_due_alert_user'))]"/>
    </record>

</odoo>
