<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Cuerpo del correo de alerta, renderizado desde el servicio.
         Recibe: user, company, today, soon_days, include_overdue,
         labels, colors, counts, totals y buckets (listas por bucket). -->
    <template id="email_due_summary">
        <div style="font-family: Arial, Helvetica, sans-serif; color: #2c3e50;">
            <p>Estimado(a) <t t-esc="user.name"/>,</p>
            <p>
                Este es el resumen de <strong>facturas de proveedor pendientes de pago</strong>
                al <t t-esc="today"/> para <strong t-esc="company.name"/>.
            </p>

            <t t-if="due_today['count']">
                <div style="background:#fff8e6;border-left:4px solid #e67e22;padding:12px 16px;margin-bottom:18px;font-size:13px;white-space:pre-line;">
                    <strong>Facturas que vencen hoy</strong><br/>
                    <t t-esc="due_today['text']"/>
                </div>
            </t>
            <t t-else="">
                <p style="color:#27ae60;font-size:13px;">
                    Hoy no hay facturas de proveedor que venzan.
                </p>
            </t>

            <t t-foreach="['overdue', 'today', 'soon']" t-as="key">
                <t t-if="(key != 'overdue' or include_overdue) and counts[key]">
                    <h3 t-attf-style="color: {{ colors[key] }}; margin-bottom: 4px;">
                        <t t-esc="labels[key]"/>
                        (<t t-esc="counts[key]"/>) &#8212; Total: <t t-esc="totals[key]"/>
                    </h3>
                    <table width="100%" cellpadding="6" cellspacing="0"
                           style="border-collapse: collapse; margin-bottom: 18px; font-size: 13px;">
                        <thead>
                            <tr t-attf-style="background: {{ colors[key] }}; color: #ffffff;">
                                <th align="left">Factura de Proveedor</th>
                                <th align="left">Proveedor</th>
                                <th align="center">Vence</th>
                                <th align="center">Dias</th>
                                <th align="right">Saldo</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="buckets[key]" t-as="b">
                                <tr style="border-bottom: 1px solid #ecf0f1;">
                                    <td t-esc="b['name']"/>
                                    <td t-esc="b['partner']"/>
                                    <td align="center" t-esc="b['date_due']"/>
                                    <td align="center" t-esc="b['days']"/>
                                    <td align="right" t-esc="b['residual_str']"/>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </t>
            </t>

            <p style="color: #7f8c8d; font-size: 12px;">
                Correo automatico del modulo de Alertas de Vencimiento de Facturas.
            </p>
        </div>
    </template>

</odoo>
