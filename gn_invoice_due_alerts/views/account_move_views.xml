<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_invoice_due_list" model="ir.ui.view">
        <field name="name">account.move.due.alert.list</field>
        <field name="model">account.move</field>
        <field name="arch" type="xml">
            <list string="Facturas por pagar"
                  create="false"
                  js_class="cxp_partner_payable_list"
                  expand="1"
                  groups_limit="5000"
                  default_order="partner_id, invoice_date_due asc"
                  decoration-danger="gn_due_status == 'overdue'"
                  decoration-warning="gn_due_status == 'today'"
                  decoration-bf="gn_due_status in ('today','soon')">
                <field name="ref" string="Factura de Proveedor"/>
                <field name="name" string="Número interno" optional="hide"/>
                <field name="state" column_invisible="1"/>
                <field name="move_type" column_invisible="1"/>
                <field name="partner_id"/>
                <field name="invoice_date"/>
                <field name="invoice_date_due"/>
                <field name="gn_days_to_due" string="Días"/>
                <field name="gn_due_status" string="Estado"/>
                <field name="amount_total" sum="Total"/>
                <field name="amount_residual" sum="Saldo pendiente"/>
                <field name="payment_state"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_invoice_due_search" model="ir.ui.view">
        <field name="name">account.move.due.alert.search</field>
        <field name="model">account.move</field>
        <field name="arch" type="xml">
            <search string="Facturas por pagar">
                <field name="ref" string="Factura de Proveedor"/>
                <field name="name" string="Número interno"/>
                <field name="partner_id"/>
                <filter name="overdue" string="Vencidas"
                        domain="[('invoice_date_due','&lt;', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="due_today" string="Vencen hoy"
                        domain="[('invoice_date_due','=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="due_soon" string="Próximas (7 días)"
                        domain="[('invoice_date_due','&gt;', context_today().strftime('%Y-%m-%d')),
                                 ('invoice_date_due','&lt;=', (context_today()+relativedelta(days=7)).strftime('%Y-%m-%d'))]"/>
                <separator/>
                <group>
                    <filter name="group_partner" string="Proveedor"
                            context="{'group_by': 'partner_id'}"/>
                    <filter name="group_due" string="Fecha de vencimiento"
                            context="{'group_by': 'invoice_date_due'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_invoice_due_list" model="ir.actions.act_window">
        <field name="name">Facturas por pagar (lista)</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_invoice_due_list"/>
        <field name="search_view_id" ref="view_invoice_due_search"/>
        <field name="domain">[('move_type','in',('in_invoice','in_refund')),
                             ('state','=','posted'),
                             ('payment_state','in',('not_paid','partial')),
                             ('amount_residual','&gt;',0)]</field>
        <field name="context">{'search_default_group_partner': 1, 'search_default_overdue': 1}</field>
    </record>

</odoo>
