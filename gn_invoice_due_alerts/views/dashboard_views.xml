<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_invoice_due_dashboard" model="ir.actions.client">
        <field name="name">Resumen rapido</field>
        <field name="tag">gn_invoice_due_alerts_dashboard</field>
    </record>

    <record id="action_invoice_due_traffic" model="ir.actions.client">
        <field name="name">Semaforo de vencimientos</field>
        <field name="tag">gn_invoice_due_traffic_dashboard</field>
    </record>

    <record id="action_invoice_due_aging" model="ir.actions.client">
        <field name="name">Antiguedad por proveedor</field>
        <field name="tag">gn_invoice_due_aging_dashboard</field>
    </record>

    <!-- Menu raiz (aplicacion), restringido al grupo -->
    <menuitem id="menu_invoice_due_root"
              name="Alertas de Pago"
              web_icon="gn_invoice_due_alerts,static/description/icon.png"
              action="action_invoice_due_traffic"
              sequence="55"
              groups="gn_invoice_due_alerts.group_invoice_due_alert_user"/>

    <menuitem id="menu_invoice_due_traffic"
              name="Semaforo de vencimientos"
              parent="menu_invoice_due_root"
              action="action_invoice_due_traffic"
              sequence="10"/>

    <menuitem id="menu_invoice_due_aging"
              name="Antiguedad por proveedor"
              parent="menu_invoice_due_root"
              action="action_invoice_due_aging"
              sequence="15"/>

    <menuitem id="menu_invoice_due_dashboard"
              name="Resumen rapido"
              parent="menu_invoice_due_root"
              action="action_invoice_due_dashboard"
              sequence="20"/>

    <menuitem id="menu_invoice_due_list"
              name="Facturas por pagar"
              parent="menu_invoice_due_root"
              action="action_invoice_due_list"
              sequence="30"/>

    <menuitem id="menu_invoice_due_config"
              name="Configuracion"
              parent="menu_invoice_due_root"
              action="action_invoice_due_settings"
              sequence="90"
              groups="gn_invoice_due_alerts.group_invoice_due_alert_manager"/>

</odoo>
