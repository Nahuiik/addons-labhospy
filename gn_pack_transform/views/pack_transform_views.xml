<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_gn_pack_transform_tree" model="ir.ui.view">
        <field name="name">gn.pack.transform.list</field>
        <field name="model">gn.pack.transform</field>
        <field name="arch" type="xml">
            <list string="Transformaciones paquete → unidad">
                <field name="name"/>
                <field name="date"/>
                <field name="source_product_id"/>
                <field name="source_qty"/>
                <field name="source_uom_id" groups="uom.group_uom"/>
                <field name="dest_product_id"/>
                <field name="dest_qty"/>
                <field name="dest_uom_id" groups="uom.group_uom"/>
                <field name="source_total_value" widget="monetary"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-muted="state == 'cancel'"/>
            </list>
        </field>
    </record>

    <record id="view_gn_pack_transform_form" model="ir.ui.view">
        <field name="name">gn.pack.transform.form</field>
        <field name="model">gn.pack.transform</field>
        <field name="arch" type="xml">
            <form string="Transformación paquete → unidad">
                <header>
                    <button name="action_confirm" type="object" string="Procesar transformación"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_cancel" type="object" string="Cancelar"
                            invisible="state != 'draft'"/>
                    <button name="action_set_draft" type="object" string="Reabrir"
                            invisible="state != 'cancel'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_picking" type="object"
                                class="oe_stat_button" icon="fa-truck"
                                invisible="not picking_id">
                            <span class="o_stat_text">Operación</span>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Origen (paquete)">
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="warehouse_id"/>
                            <field name="date"/>
                            <field name="source_product_id" readonly="state != 'draft'"/>
                            <field name="source_tracking" invisible="1"/>
                            <field name="dest_tracking" invisible="1"/>
                            <field name="source_uom_id" groups="uom.group_uom" readonly="state != 'draft'"/>
                            <field name="source_lot_id" readonly="state != 'draft'"
                                   invisible="source_tracking == 'none'"
                                   required="source_tracking != 'none'"/>
                            <field name="source_qty" readonly="state != 'draft'"/>
                            <field name="source_unit_cost" widget="monetary"/>
                            <field name="source_total_value" widget="monetary"/>
                        </group>
                        <group string="Destino (unidad)">
                            <field name="dest_product_id" readonly="state != 'draft'"/>
                            <field name="dest_uom_id" groups="uom.group_uom" readonly="state != 'draft'"/>
                            <field name="unpack_ratio" readonly="state != 'draft'"/>
                            <field name="dest_qty" readonly="state != 'draft'"/>
                            <field name="dest_unit_cost" widget="monetary"/>
                            <field name="dest_total_value" widget="monetary"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="picking_id" invisible="1"/>
                            <field name="source_template_id" invisible="1"/>
                        </group>
                    </group>
                    <group string="Notas">
                        <field name="note" nolabel="1" placeholder="Observaciones..."/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_gn_pack_transform_search" model="ir.ui.view">
        <field name="name">gn.pack.transform.search</field>
        <field name="model">gn.pack.transform</field>
        <field name="arch" type="xml">
            <search string="Transformaciones">
                <field name="name"/>
                <field name="source_product_id"/>
                <field name="dest_product_id"/>
                <filter name="draft" string="Borrador" domain="[('state', '=', 'draft')]"/>
                <filter name="done" string="Realizado" domain="[('state', '=', 'done')]"/>
            </search>
        </field>
    </record>

    <record id="action_gn_pack_transform" model="ir.actions.act_window">
        <field name="name">Transformación paquete → unidad</field>
        <field name="res_model">gn.pack.transform</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_gn_pack_transform_process_multi" model="ir.actions.server">
        <field name="name">Procesar transformaciones</field>
        <field name="model_id" ref="model_gn_pack_transform"/>
        <field name="binding_model_id" ref="model_gn_pack_transform"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">records.filtered(lambda r: r.state == 'draft').action_confirm()</field>
    </record>

</odoo>
