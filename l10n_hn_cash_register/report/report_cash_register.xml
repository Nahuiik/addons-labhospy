<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <template id="cash_register_qweb">
         <t t-foreach="docs" t-as="o">
            <t t-set="data_return" t-value="o.report_payment_pdf()"/>
            <t t-foreach="data_return" t-as="data">
                <t t-set="data_journal_ids" t-value="o.returns_journal_ids(data.get('id'))"/>
                <t t-set="cancel_payment" t-value="o.returns_cancel_payment(data.get('id'))"/>
                <t t-set="banks_payments" t-value="o.returns_banks_payments(data.get('id'))"/>
                <t t-set="pending_invoices" t-value="o.get_pending_invoice_sections_for_pdf(data.get('id'))"/>
                <t t-call="web.html_container">
                    <t t-call="web.external_layout">
                        <div class="page">
                        <style>
                            @import url('https://fonts.googleapis.com/css?family=Roboto');
                            @import url('https://fonts.googleapis.com/css?family=Open+Sans');
                            @import url('https://fonts.googleapis.com/css?family=Open+Sans+Condensed:300');
                            @import url('https://fonts.googleapis.com/css?family=Dosis');
                            @import url('https://fonts.googleapis.com/css?family=Exo+2');
                            @import url('https://fonts.googleapis.com/css?family=Abel');
                            @import url('https://fonts.googleapis.com/css?family=Saira+Extra+Condensed');
                            *{  
                            /* font-family: 'Roboto', sans-serif;*/
                                font-family: 'Open Sans', sans-serif;
                                font-family: 'Open Sans Condensed', sans-serif;
                                font-family: 'Dosis', sans-serif;
                                font-family: 'Exo 2', sans-serif;
                                font-size:12px;
                            }
                            p{
                                font-size:12px;
                                margin: 0 0;
                            }
                            .zoneProduct{
                                padding: 0px 0px;                     
                                font-size: 12px;
                                min-height:300px;
                                margin-top:5px;
                                margin-bottom:5px;
                            }
                            .titledoc{
                                font-size:16px;
                                font-weight:bold;
                            }
                            .sutitledoc{
                                font-size:14px;
                                font-weight:bold;
                            }
                            hr{
                                color:#000;
                                margin-top:2px;
                                margin-bottom:2px;
                                margin: 0 0;  
                            }
                            .table {
                                width: 100%;
                                max-width: 100%;
                                margin-bottom: 1rem;
                                background-color: transparent;
                            }
                            table {
                                border-collapse: collapse;
                            }
                            .table-condensed{
                                border: 1px solid #dee2e6;
                            }
                            tbody {
                                display: table-row-group;
                                vertical-align: middle;
                                border-color: inherit;
                            }
                            thead {
                                display: table-header-group;
                                vertical-align: middle;
                                border-color: inherit;
                            }
                            th,td{
                                font-size:12px;
                                border: 1px solid #dee2e6;
                            }
                            th {
                                font-weight: normal;    
                                padding: 1px 5px;
                            }
                            *{
                                font-weight: normal;    
                            }
                            .table th , .table td{
                                    font-size:12px;

                            }
                            .col-xs-6 {
                                -ms-flex-preferred-size: 0;
                                flex-basis: 0;
                                -webkit-box-flex: 1;
                                -ms-flex-positive: 1;
                                flex-grow: 1;
                                width:50%;
                                max-width: 100%;
                            }
                            .col-xs-5 {
                                -ms-flex-preferred-size: 0;
                                flex-basis: 0;
                                -webkit-box-flex: 1;
                                -ms-flex-positive: 1;
                                flex-grow: 1;
                                width:41.666%;
                                max-width: 100%;
                            }
                            .col-xs-12 {
                                -ms-flex-preferred-size: 0;
                                flex-basis: auto;
                                -webkit-box-flex: 1;
                                -ms-flex-positive: 1;
                                flex-grow: 1;
                                width:100%;
                                max-width: 100%;
                            }
                            p strong{
                                font-size:12px;
                                font-weight: 600;
                            }
                        </style>
                        <br/>
                        <table style="width:100%">
                            <tr>
                                <td colspan="3" style="width:100%;font-size:18px;text-align:center;">
                                    <strong style="font-weight: bold;">ARQUEO DE CAJA DIARIO</strong>
                                </td>
                            </tr>
                                <tr>
                                    <td style="width:33%;font-size:14px;text-align:center">
                                        <strong style="font-weight: bold;">Desde:</strong>
                                        <span t-esc="data.get('date_from').strftime('%d-%m-%Y')"/>
                                    </td>
                                    <td style="width:33%;font-size:14px;text-align:center">
                                        <strong style="font-weight: bold;">Hasta:</strong>
                                        <span t-esc="data.get('date_to').strftime('%d-%m-%Y')"/>
                                    </td>
                                    <td style="width:34%;font-size:14px;text-align:center">
                                        <strong style="font-weight: bold;">Cajero:</strong>
                                        <span t-esc="data.get('name')"/>
                                    </td>
                                </tr>
                            </table>
                            <br/>
                            <t t-set="total_payment" t-value="0"/>
                            <table style="width:100%">
                                <thead>
                                    <tr>
                                        <th style="font-weight: bold;">No.</th>
                                        <th style="font-weight: bold;">Fecha de pago</th>
                                        <th style="font-weight: bold;">Número de pago</th>
                                        <th style="font-weight: bold;">Diario de pago</th>
                                        <th style="font-weight: bold;">Monto de  Pago</th>
                                        <th style="font-weight: bold;">Ref/Factura</th>
                                        <th style="font-weight: bold;">Monto en factura Pago</th>
                                    </tr>
                                </thead>
								<tbody>
                                    <t t-set="i" t-value="1"/>
                                    <t t-set="total_invoice" t-value="0"/>
                                    <!-- <t t-foreach="data.get('lines_users').filtered(lambda a: a.get('state) == 'posted')" t-as="line_data"> -->
                                    <t t-foreach="data.get('lines_users')" t-as="line_data">
                                        <t t-if="line_data.get('state') in ['posted', 'paid']">
                                            <t t-set="total_payment" t-value="total_payment + line_data.get('amount')"/>
                                            <t t-if="len(line_data.get('invoice_ids')) &gt; 0">
                                                <t t-set="j" t-value="0"/>
                                                <t t-foreach="line_data.get('invoice_ids')" t-as="invoices_id">
                                                    <tr>
                                                        <t t-if="j == 0">
                                                            <td style="text-align: center"><span t-esc="i"/></td>
                                                            <td style="text-align: center"><span t-esc="line_data.get('date_payment')"/></td>
                                                            <td style="text-align: center"><span t-esc="line_data.get('number_payment')"/></td>
                                                            <td style="text-align: center"><span t-esc="line_data.get('journal_id')"/></td>
                                                            <td style="text-align: center;">L. <span t-esc="'{0:,.2f}'.format(line_data.get('amount'))"/></td>
                                                            <td style="text-align: center"><span t-esc="invoices_id.get('name')"/></td>
                                                            <td style="text-align: center;">L. <span t-esc="'{0:,.2f}'.format(invoices_id.get('amount_total'))"/></td>
                                                        </t>
                                                        <t t-if="j &gt; 0">
                                                            <td colspan="5"/>
                                                            <td><span t-esc="invoices_id.get('name')"/></td>
                                                            <td style="text-align: end;"><span t-esc="'{0:,.2f}'.format(invoices_id.get('amount_total'))"/></td>
                                                        </t>
                                                        <t t-set="j" t-value="j+1"/>
                                                    </tr>
                                                </t>
                                            </t>
                                            <t t-if="len(line_data.get('invoice_ids')) == 0">
                                                <tr>
                                                    <td style="text-align: center"><span t-esc="i"/></td>
                                                    <td style="text-align: center"><span t-esc="line_data.get('date_payment')"/></td>
                                                    <td style="text-align: center"><span t-esc="line_data.get('number_payment')"/></td>
                                                    <td style="text-align: center"><span t-esc="line_data.get('journal_id')"/></td>
                                                    <td style="text-align: center;">L. <span t-esc="'{0:,.2f}'.format(line_data.get('amount'))"/></td>
                                                    <td style="text-align: center"><span>N/A</span></td>
                                                    <td style="text-align: center;"><span>L. 0.00</span></td>
                                                </tr>
                                            </t>
                                            <t t-set="i" t-value="i+1"/>
                                        </t>
                                    </t>
								</tbody>
                            </table>
                            <div style="width:100%">
                                <div style="width:100%;text-align:end; pt-5">
                                    <br/>
                                    <strong style="font-weight: bold;">Total Pago: </strong>
                                    L. <span t-esc="'{0:,.2f}'.format(total_payment)"/>
                                </div>
                            </div>
                            <br/>
                            <div style="width:100% !important;">
                                <table style="width:70% !important; margin-left: auto;">
                                    <thead>
                                        <tr>
                                            <td style="font-weight: bold; text-align: center">Diario</td>
                                            <td style="font-weight: bold; text-align: center">Monto</td>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="data_journal_ids" t-as="data">
                                            <tr>
                                                <td style="text-align:center "><span t-esc="data.get('name')"/></td>
                                                <td style="text-align:center;">L. <span t-esc="'{0:,.2f}'.format(data.get('amount'))"/></td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                            <br/>
                            <t t-if="len(cancel_payment) &gt; 0">
                                <div style="font-weight: bold;">
                                    Pagos Cancelados
                                </div>
                                <table style="width:100%">
                                    <thead>
                                        <tr>
                                            <th style="font-weight: bold;">No.</th>
                                            <th style="font-weight: bold;">Fecha de pago</th>
                                            <th style="font-weight: bold;">Número de pago</th>
                                            <th style="font-weight: bold;">Diario de pago</th>
                                            <th style="font-weight: bold;">Monto de  Pago</th>
                                            <th style="font-weight: bold;">Ref/Factura</th>
                                            <th style="font-weight: bold;">Monto en factura Pago</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-set="i" t-value="1"/>
                                        <t t-foreach="cancel_payment" t-as="line_data">
                                            <tr>
                                                <td style="text-align:center "><span t-esc="i"/></td>
                                                <td style="text-align:center "><span t-esc="line_data.get('date_payment')"/></td>
                                                <td style="text-align:center "><span t-esc="line_data.get('number_payment')"/></td>
                                                <td style="text-align:center "><span t-esc="line_data.get('journal_id')"/></td>
                                                <td style="text-align: center;"><span t-esc="'{0:,.2f}'.format(line_data.get('amount'))"/></td>
                                                <td style="text-align: center"><span>N/A</span></td>
                                                <td style="text-align: center;"><span>L. 0.00</span></td>
                                            </tr>
                                            <t t-set="i" t-value="i+1"/>
                                        </t>
                                    </tbody>
                                </table>
                                <br/>
                            </t>
                            <t t-if="len(banks_payments) &gt; 0">
                                <br/>
                                <br/>
                                <div style="font-weight: bold;">
                                    Depositos
                                </div>
                                <t t-set="total_banks" t-value="0"/>
                                <table style="width:100%">
                                    <thead>
                                        <tr>
                                            <th style="font-weight: bold;">No.</th>
                                            <th style="font-weight: bold;">Diario</th>
                                            <th style="font-weight: bold;">Número de cheque</th>
                                            <th style="font-weight: bold;">Fecha de cheque</th>
                                            <th style="font-weight: bold;">Monto</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-set="i" t-value="1"/>
                                        <t t-foreach="banks_payments" t-as="line_data">
                                            <t t-set="total_banks" t-value="total_banks + line_data.get('amount')"/>
                                            <tr>
                                                <td style="text-align:center"><span t-esc="i"/></td>
                                                <td style="text-align:center"><span t-esc="line_data.get('journal_id')"/></td>
                                                <td style="text-align:center"><span t-esc="line_data.get('number_check')"/></td>
                                                <td style="text-align:center"><span t-esc="line_data.get('date_check')"/></td>
                                                <td style="text-align:center">L. <span t-esc="'{0:,.2f}'.format(line_data.get('amount'))"/></td>
                                            </tr>
                                            <t t-set="i" t-value="i+1"/>
                                        </t>
                                    </tbody>
                                </table>
                                <div style="width:100%">
                                    <div style="width:100%;text-align:end">
                                        <br/>
                                        <strong style="font-weight: bold;">Total Depositos: </strong>
                                        L. <span t-esc="'{0:,.2f}'.format(total_banks)"/>
                                    </div>
                                </div>
                                <br/>
                            </t>

                            <t t-if="pending_invoices and (len(pending_invoices.get('open_invoice', [])) &gt; 0 or len(pending_invoices.get('partial_invoice', [])) &gt; 0)">
                                <br/>
                                <t t-if="len(pending_invoices.get('open_invoice', [])) &gt; 0">
                                    <div style="font-weight: bold; margin-top: 8px;">
                                        Facturas abiertas (sin pago o en pago)
                                    </div>
                                    <table style="width:100%">
                                        <thead>
                                            <tr>
                                                <th style="font-weight: bold;">No.</th>
                                                <th style="font-weight: bold;">Número de factura</th>
                                                <th style="font-weight: bold;">Cliente</th>
                                                <th style="font-weight: bold;">Fecha</th>
                                                <th style="font-weight: bold;">Total</th>
                                                <th style="font-weight: bold;">Estado de pago</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-set="io" t-value="1"/>
                                            <t t-set="sub_open" t-value="0"/>
                                            <t t-foreach="pending_invoices.get('open_invoice', [])" t-as="row">
                                                <t t-set="sub_open" t-value="sub_open + (row.get('total') or 0)"/>
                                                <tr>
                                                    <td style="text-align:center"><span t-esc="io"/></td>
                                                    <td style="text-align:center"><span t-esc="row.get('number')"/></td>
                                                    <td style="text-align:center"><span t-esc="row.get('partner')"/></td>
                                                    <td style="text-align:center"><span t-esc="row.get('date_invoice')"/></td>
                                                    <td style="text-align:center">L. <span t-esc="'{0:,.2f}'.format(row.get('total') or 0)"/></td>
                                                    <td style="text-align:center"><span t-esc="row.get('payment_state_label')"/></td>
                                                </tr>
                                                <t t-set="io" t-value="io + 1"/>
                                            </t>
                                        </tbody>
                                    </table>
                                    <div style="width:100%; text-align:end">
                                        <strong>Subtotal sección: </strong>
                                        L. <span t-esc="'{0:,.2f}'.format(sub_open)"/>
                                    </div>
                                    <br/>
                                </t>
                                <t t-if="len(pending_invoices.get('partial_invoice', [])) &gt; 0">
                                    <div style="font-weight: bold; margin-top: 8px;">
                                        Facturas parcialmente pagadas
                                    </div>
                                    <table style="width:100%">
                                        <thead>
                                            <tr>
                                                <th style="font-weight: bold;">No.</th>
                                                <th style="font-weight: bold;">Número de factura</th>
                                                <th style="font-weight: bold;">Cliente</th>
                                                <th style="font-weight: bold;">Fecha</th>
                                                <th style="font-weight: bold;">Total</th>
                                                <th style="font-weight: bold;">Saldo pendiente</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-set="ip" t-value="1"/>
                                            <t t-set="sub_tot" t-value="0"/>
                                            <t t-set="sub_res" t-value="0"/>
                                            <t t-foreach="pending_invoices.get('partial_invoice', [])" t-as="prow">
                                                <t t-set="sub_tot" t-value="sub_tot + (prow.get('total') or 0)"/>
                                                <t t-set="sub_res" t-value="sub_res + (prow.get('residual') or 0)"/>
                                                <tr>
                                                    <td style="text-align:center"><span t-esc="ip"/></td>
                                                    <td style="text-align:center"><span t-esc="prow.get('number')"/></td>
                                                    <td style="text-align:center"><span t-esc="prow.get('partner')"/></td>
                                                    <td style="text-align:center"><span t-esc="prow.get('date_invoice')"/></td>
                                                    <td style="text-align:center">L. <span t-esc="'{0:,.2f}'.format(prow.get('total') or 0)"/></td>
                                                    <td style="text-align:center">L. <span t-esc="'{0:,.2f}'.format(prow.get('residual') or 0)"/></td>
                                                </tr>
                                                <t t-set="ip" t-value="ip + 1"/>
                                            </t>
                                        </tbody>
                                    </table>
                                    <div style="width:100%; text-align:end">
                                        <strong>Subtotal total factura: </strong>
                                        L. <span t-esc="'{0:,.2f}'.format(sub_tot)"/>
                                        <span> — </span>
                                        <strong>Subtotal saldo pendiente: </strong>
                                        L. <span t-esc="'{0:,.2f}'.format(sub_res)"/>
                                    </div>
                                    <br/>
                                </t>
                            </t>
                            
                            <table style="width:100%; height:40px !important; margin 10px 0px 0px 0px; ">
								<tbody>
                                    <tr>
                                        <td style="width:20%; padding-left: 5px;">Observaciones:</td>
                                        <td style="width:80%;"><br/><br/><br/></td>
                                    </tr>
								</tbody>
                            </table>
                            <br/><br/><br/>
                            <div class="col-12" style="padding:8px;">
                                <table style="font-size:14px;width:100%;margin-top:10%; border-color:transparent !important">	  
                                    <tr style="border-color:transparent !important">            
                                        <td style="text-align:center; border-color:transparent !important">_____________________________________</td>
                                        <td style="text-align:center; border-color:transparent !important">_____________________________________</td>
                                    </tr>
                                    <tr style="border-color:transparent !important">
                                        <td style="text-align:center; border-color:transparent !important">Firma Cajero</td>
                                        <td style="text-align:center; border-color:transparent !important">Firma Supervisor</td>
                                    </tr>
                                </table>
                            </div>
                            	<div class="footer">
									<div style="text-align:right; font-size:12px">
										<span>Elaborado Por : </span> <span t-field="o.env.user.name"/>
									</div>
                                    <div style="text-align:right; font-size:12px">
                                        <span> Fecha y hora de impresion: </span><span t-esc="o.get_format_datetime()"/>
									</div>
									
									<div style="text-align:left">
										<tr>
											<td colspan="2" t-if="i==0" style="text-align:left; font-size:14px">
												<strong>ARQUEO DE CAJA</strong>
											</td>
											<td colspan="2" t-if="i==1" style="text-align:left; font-size:14px">
												<strong>COPIA:ARCHIVO</strong>
											</td>
										</tr>
									</div>

							    </div>

                        </div>
                    </t>
                </t>
            </t>
        </t>
    </template>
</odoo>