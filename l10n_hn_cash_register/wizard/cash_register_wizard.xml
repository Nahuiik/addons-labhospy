<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record model='ir.ui.view' id='wizard_cash_register_form'>
            <field name="name">wizard.cash.register.wizard.form</field>
            <field name="model">cash.register.wizard</field>
            <field name="arch" type="xml">
                <form string="Reporte de Caja Diario">
                    <group col="4">
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                    <group>
                        <field name="can_select_other_cashiers" invisible="1"/>
                        <field name="cashier_ids" widget="many2many_tags"
                               options="{'no_create': True}"
                               readonly="not can_select_other_cashiers"/>
                    </group>
                    <footer>
                        <button name="export_xls" type="object" string="Excel" class="oe_highlight" context="{'xls_export':1}" />
                        <button name="export_xls" type="object" string="PDF" class="btn btn-warning" context="{'pdf_export':1}"/>
                        <button string="Cancelar" class="oe_link" special="cancel" />
                    </footer>
                </form>
            </field>
        </record>

        <!-- El menú "Informes" de Ventas es solo gerente en estándar; añadir vendedores para que vean el arqueo. -->
        <record id="sale.menu_sale_report" model="ir.ui.menu">
            <field name="group_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
        </record>

        <record model='ir.actions.act_window' id='action_wizard_register'>
            <field name="name">Reporte de Caja Diario</field>
            <field name="res_model">cash.register.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

        <!-- Ventas > Informes (Reporting) -->
        <menuitem
            id="cash_register_menuitem"
            name="Reporte de Caja Diario"
            parent="sale.menu_sale_report"
            action="action_wizard_register"
            sequence="50"/>
    </data>
</odoo>