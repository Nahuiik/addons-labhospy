<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_cash_register" model="ir.module.category">
        <field name="name">Arqueo de Caja</field>
        <field name="description">Permisos del reporte de arqueo de caja</field>
        <field name="sequence">100</field>
    </record>

    <record id="privilege_cash_register_other_cashiers" model="res.groups.privilege">
        <field name="name">Seleccionar otros cajeros</field>
        <field name="category_id" ref="module_category_cash_register"/>
        <field name="sequence">10</field>
    </record>

    <record id="group_cash_register_other_cashiers" model="res.groups">
        <field name="name">Seleccionar otros cajeros</field>
        <field name="comment">Permite elegir cajeros distintos al usuario conectado en el reporte de arqueo de caja.</field>
        <field name="privilege_id" ref="privilege_cash_register_other_cashiers"/>
    </record>
</odoo>
