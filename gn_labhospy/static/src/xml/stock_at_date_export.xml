<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="gn_labhospy.StockAtDateListView" t-inherit="web.ListView" t-inherit-mode="primary">
        <xpath expr="//t[@t-set-slot='control-panel-always-buttons']" position="inside">
            <button type="button"
                    class="btn btn-secondary"
                    t-on-click="onExportStockAtDate"
                    t-att-disabled="exportState.busy">
                <i class="fa fa-file-excel-o me-1" role="img"/>
                <t t-if="exportState.busy">Generando…</t>
                <t t-else="">Excel</t>
            </button>
        </xpath>
    </t>
</templates>
