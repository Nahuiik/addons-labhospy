<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="paperformat_gn_labhospy_controlled_substances" model="report.paperformat">
            <field name="name">LabHosPy SC horizontal</field>
            <field name="format">A4</field>
            <field name="orientation">Landscape</field>
            <field name="margin_top">12</field>
            <field name="margin_bottom">12</field>
            <field name="margin_left">8</field>
            <field name="margin_right">8</field>
            <field name="dpi">90</field>
        </record>

        <record id="action_report_controlled_substances" model="ir.actions.report">
            <field name="name">Venta de sustancias químicas controladas</field>
            <field name="model">gn.labhospy.controlled.substances.report.wizard</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">gn_labhospy.report_controlled_substances_document</field>
            <field name="report_file">gn_labhospy.report_controlled_substances_document</field>
            <field name="binding_type">report</field>
            <field name="paperformat_id" ref="paperformat_gn_labhospy_controlled_substances"/>
        </record>

        <record id="action_report_controlled_substances_html" model="ir.actions.report">
            <field name="name">Venta de sustancias químicas controladas (HTML)</field>
            <field name="model">gn.labhospy.controlled.substances.report.wizard</field>
            <field name="report_type">qweb-html</field>
            <field name="report_name">gn_labhospy.report_controlled_substances_html</field>
            <field name="report_file">gn_labhospy.report_controlled_substances_html</field>
        </record>

        <record id="action_report_controlled_substances_xlsx" model="ir.actions.report">
            <field name="name">Venta de sustancias químicas controladas (XLSX)</field>
            <field name="model">gn.labhospy.controlled.substances.report.wizard</field>
            <field name="report_type">xlsx</field>
            <field name="report_name">gn_labhospy.controlled_substances_xlsx</field>
            <field name="report_file">gn_labhospy_controlled_substances_xlsx</field>
        </record>
    </data>
</odoo>
