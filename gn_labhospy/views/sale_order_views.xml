<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_order_search_filter_labhospy_controlled_products" model="ir.ui.view">
        <field name="name">sale.order.search.filter.labospy.controlled.products</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search/group" position="before">
                <separator/>
                <filter string="Productos Controlados" name="filter_labospy_controlled_products"
                    domain="[('order_line.product_id.product_tmpl_id.gn_labhospy_is_controlled', '=', True)]"/>
            </xpath>
        </field>
    </record>

    <!-- Estilo PDF (Quote/Order Style) viene de professional_templates -->
    <record id="view_sale_order_hide_quote_style_labospy" model="ir.ui.view">
        <field name="name">sale.order.form.hide.quote.style.labospy</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="professional_templates.view_sale_order_inherit_customized"/>
        <field name="priority" eval="99"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='style']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_order_form_labhospy" model="ir.ui.view">
        <field name="name">sale.order.form.labospy</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="priority" eval="60"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/div[@name='button_box']" position="before">
                <widget name="web_ribbon" title="Controlado"
                        bg_color="text-bg-warning"
                        tooltip="Incluye al menos una línea con producto controlado (LabHosPy)."
                        invisible="not gn_labhospy_has_controlled_products"/>
            </xpath>
            <xpath expr="//field[@name='payment_term_id']" position="before">
                <field name="gn_can_edit_payment_terms" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='payment_term_id']" position="attributes">
                <attribute name="readonly">not gn_can_edit_payment_terms or gn_labhospy_immediate_payment or state in ('sale', 'done', 'cancel')</attribute>
            </xpath>
            <xpath expr="//field[@name='currency_id']" position="after">
                <field name="gn_labhospy_immediate_payment" widget="boolean_toggle"
                       readonly="state in ('sale', 'done', 'cancel') or gn_labhospy_has_invoice"/>
            </xpath>
            <xpath expr="//field[@name='payment_term_id']" position="after">    
                <field name="gn_labhospy_payment_term_before_immediate" invisible="1"/>
                <field name="gn_labhospy_has_invoice" invisible="1"/>
                <field name="gn_labhospy_has_controlled_products" invisible="1"/>
                <field name="gn_labhospy_order_contact_display"
                       string="Contacto"
                       readonly="1"
                       invisible="not gn_labhospy_has_controlled_products"/>
            </xpath>
            <xpath expr="//field[@name='order_line']//list" position="attributes">
                <!-- Resaltado productos controlados: table-warning en sale_order_line_controlled_highlight.js -->
                <attribute name="decoration-warning">(state in ['draft', 'sent'] and is_product_archived) or sale_line_warn_msg</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']//list/field[@name='display_type']" position="after">
                <field name="gn_labhospy_is_controlled" column_invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='order_line']//list/field[@name='name']" position="after">
                <field name="gn_labhospy_supplier_id" optional="show" readonly="1"
                       options="{'no_open': True, 'no_create': True, 'no_create_edit': True}"/>
                <field name="gn_labhospy_catalog_code" optional="show" readonly="1"/>
                <field name="gn_labhospy_model" optional="show" readonly="1"/>
                <!-- Aplicación/uso para líneas de producto; aparecen como columnas opcionales (#) -->
                <field name="gn_labhospy_application_use_id" optional="hide"
                       readonly="parent.state == 'cancel'"
                       invisible="display_type"/>
                <field name="gn_labhospy_application_use" optional="hide"
                       readonly="parent.state == 'cancel'"
                       placeholder="Notas adicionales aplicación/uso"
                       invisible="display_type"/>
            </xpath>
        </field>
    </record>
</odoo>
