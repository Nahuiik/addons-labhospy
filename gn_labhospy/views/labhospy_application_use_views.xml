<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_gn_labhospy_application_use_tree" model="ir.ui.view">
        <field name="name">gn.labhospy.application.use.tree</field>
        <field name="model">gn.labhospy.application.use</field>
        <field name="arch" type="xml">
            <list sample="1">
                <field name="name"/>
                <field name="reference" optional="show"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_gn_labhospy_application_use_form" model="ir.ui.view">
        <field name="name">gn.labhospy.application.use.form</field>
        <field name="model">gn.labhospy.application.use</field>
        <field name="arch" type="xml">
            <form string="Aplicación / uso">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="reference"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_gn_labhospy_application_use" model="ir.actions.act_window">
        <field name="name">Aplicación / uso</field>
        <field name="res_model">gn.labhospy.application.use</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p>
                Catálogo de aplicaciones o usos para el informe de sustancias controladas y la ficha del producto.
            </p>
        </field>
    </record>

    <menuitem id="menu_gn_labhospy_application_use_stock"
              name="Aplicación / uso"
              parent="stock.menu_stock_config_settings"
              action="action_gn_labhospy_application_use"
              sequence="46"/>

    <menuitem id="menu_gn_labhospy_application_use_sale"
              name="Aplicación / uso"
              parent="sale.menu_sale_config"
              action="action_gn_labhospy_application_use"
              sequence="46"/>
</odoo>
