<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_controlled_substances_report_wizard_form" model="ir.ui.view">
        <field name="name">gn.labhospy.controlled.substances.report.wizard.form</field>
        <field name="model">gn.labhospy.controlled.substances.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Informe sustancias controladas">
                <group>
                    <field name="company_id" groups="base.group_multi_company"/>
                    <field name="date_from"/>
                    <field name="date_to"/>
                    <field name="branch_ids" widget="many2many_tags"
                           domain="[('company_id', '=', company_id)]"/>
                    <field name="product_ids" widget="many2many_tags"
                           domain="[('product_tmpl_id.gn_labhospy_is_controlled', '=', True)]"/>
                </group>
                <footer>
                    <button name="action_print_pdf" type="object" string="Imprimir PDF" class="btn-primary"/>
                    <button name="action_export_html_browser" type="object" string="HTML" class="btn-secondary"/>
                    <button name="action_export_xlsx" type="object" string="Excel" class="btn-secondary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_controlled_substances_report_wizard" model="ir.actions.act_window">
        <field name="name">Venta de sustancias químicas controladas</field>
        <field name="res_model">gn.labhospy.controlled.substances.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_controlled_substances_report"
              name="Sustancias controladas"
              parent="sale.menu_sale_report"
              action="action_controlled_substances_report_client"
              groups="sales_team.group_sale_salesman"
              sequence="55"/>
</odoo>
