<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_gn_labhospy_sc" model="ir.ui.view">
        <field name="name">account.move.form.gn.labhospy.sc</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_shipping_id']" position="after">
                <field name="gn_labhospy_has_sc_lines" invisible="1"/>
                <field name="gn_labhospy_sc_contact_id"
                       invisible="move_type not in ('out_invoice', 'out_refund') or not gn_labhospy_has_sc_lines"
                       readonly="state != 'draft'"
                       context="{'default_parent_id': commercial_partner_id, 'default_type': 'contact'}"/>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='product_id']" position="after">
                <field name="gn_labhospy_product_is_controlled" column_invisible="True"/>
                <field name="gn_labhospy_application_use_id" optional="show"
                       column_invisible="parent.move_type not in ('out_invoice', 'out_refund')"
                       readonly="parent.state != 'draft'"
                       placeholder="Aplicación / uso"/>
                <field name="gn_labhospy_application_use" optional="hide"
                       column_invisible="parent.move_type not in ('out_invoice', 'out_refund')"
                       readonly="parent.state != 'draft'"
                       placeholder="Notas uso SC"/>
            </xpath>
        </field>
    </record>
</odoo>
