<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_labhospy" model="ir.ui.view">
        <field name="name">stock.picking.form.labhospy</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='origin']" position="after">
                <field name="gn_labhospy_resolution_mandatory" invisible="1"/>
                <field name="gn_labhospy_resolution_ref"
                       invisible="picking_type_code != 'incoming'"
                       readonly="state in ('done', 'cancel')"
                       required="0"/>
            </xpath>
            <!-- Odoo solo muestra Imprimir en 'assigned'; permitir también en preparación. -->
            <xpath expr="//button[@name='do_print_picking']" position="attributes">
                <attribute name="invisible">state in ('draft', 'cancel', 'done')</attribute>
            </xpath>
            <xpath expr="//field[@name='move_ids']/list" position="attributes">
                <attribute name="decoration-warning">gn_labhospy_is_controlled</attribute>
            </xpath>
            <xpath expr="//field[@name='move_ids']/list/field[@name='company_id']" position="after">
                <field name="gn_labhospy_is_controlled" column_invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='move_ids']/list/field[@name='quantity']" position="after">
                <field name="gn_labhospy_supplier_id" optional="show"
                       options="{'no_open': True, 'no_create': True, 'no_create_edit': True}"/>
                <field name="gn_labhospy_model" optional="show"/>
                <field name="gn_labhospy_catalog_code" optional="show"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page name="labhospy" string="LabHosPy">
                    <field name="move_ids" readonly="1" string="Operaciones LabHosPy" context="{'picking_state': state}">
                        <list decoration-warning="gn_labhospy_is_controlled">
                            <field name="gn_labhospy_is_controlled" column_invisible="1"/>
                            <field name="reference" optional="show"/>
                            <field name="product_id"/>
                            <field name="product_uom_qty"/>
                            <field name="quantity"/>
                            <field name="gn_labhospy_supplier_id"
                                   options="{'no_open': True, 'no_create': True, 'no_create_edit': True}"/>
                            <field name="gn_labhospy_model"/>
                            <field name="gn_labhospy_catalog_code"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_move_line_tree_labhospy" model="ir.ui.view">
        <field name="name">stock.move.line.list.labhospy</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_move_line_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="decoration-warning">gn_labhospy_is_controlled</attribute>
            </xpath>
            <xpath expr="//field[@name='location_usage']" position="after">
                <field name="gn_labhospy_is_controlled" column_invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="gn_labhospy_supplier_id" optional="show"
                       options="{'no_open': True, 'no_create': True, 'no_create_edit': True}"/>
                <field name="gn_labhospy_catalog_code" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="view_move_line_tree_detailed_labhospy" model="ir.ui.view">
        <field name="name">stock.move.line.tree.detailed.labhospy</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_move_line_tree_detailed"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="decoration-warning">gn_labhospy_is_controlled</attribute>
            </xpath>
            <xpath expr="//field[@name='scheduled_date']" position="after">
                <field name="gn_labhospy_is_controlled" column_invisible="1"/>
            </xpath>
            <xpath expr="//list/field[@name='product_id']" position="after">
                <field name="gn_labhospy_supplier_id" optional="show"
                       options="{'no_open': True, 'no_create': True, 'no_create_edit': True}"/>
                <field name="gn_labhospy_model" optional="show"/>
                <field name="gn_labhospy_catalog_code" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
