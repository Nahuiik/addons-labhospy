<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_form_line_labhospy_controlled_decor" model="ir.ui.view">
        <field name="name">purchase.order.form.labospy.line.controlled</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list" position="attributes">
                <attribute name="decoration-warning">gn_labhospy_is_controlled or purchase_line_warn_msg</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']/list/field[@name='display_type']" position="after">
                <field name="gn_labhospy_is_controlled" column_invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='fiscal_position_id']" position="after">
                <field name="gn_labhospy_compra_internacional" widget="boolean_toggle"
                       readonly="locked or invoice_status == 'invoiced'"/>
            </xpath>
        </field>
    </record>
</odoo>
