<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Extender vista de diarios para agregar campo tarjetas de crédito -->
        <record id="view_account_journal_form_inherit_payment_extra" model="ir.ui.view">
            <field name="name">account.journal.form.inherit.payment.extra</field>
            <field name="model">account.journal</field>
            <field name="inherit_id" ref="account.view_account_journal_form"/>
            <field name="arch" type="xml">
                <!-- Tipo en cobros y Tarjetas de Crédito en Ajustes avanzados -->
                <xpath expr="//page[@name='advanced_settings']/group/group[1]" position="inside">
                    <field name="payment_mode" 
                           string="Tipo en Cobros de Cliente"
                           options="{'no_create': True}"
                           help="Define en qué opción (Efectivo/Tarjeta/Transferencia) aparece este diario al pagar facturas de cliente. Use 'No mostrar en cobros' para excluirlo."
                           groups="account.group_account_manager"/>
                    <field name="is_credit_card" 
                           string="Tarjetas de Crédito"
                           invisible="type != 'bank'"
                           groups="account.group_account_manager"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>

