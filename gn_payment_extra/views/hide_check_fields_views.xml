<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Ocultar campos de cheque en el wizard de registro de pagos -->
        <record id="view_account_payment_register_hide_checks" model="ir.ui.view">
            <field name="name">account.payment.register.hide.checks</field>
            <field name="model">account.payment.register</field>
            <field name="inherit_id" ref="account.view_account_payment_register_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='number_check']" position="attributes" optional="1">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//field[@name='date_check']" position="attributes" optional="1">
                    <attribute name="invisible">1</attribute>
                </xpath>
            </field>
        </record>
        
        <!-- Ocultar campos de cheque en los pagos -->
        <record id="view_account_payment_hide_checks" model="ir.ui.view">
            <field name="name">account.payment.hide.checks</field>
            <field name="model">account.payment</field>
            <field name="inherit_id" ref="account.view_account_payment_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='number_check']" position="attributes" optional="1">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//field[@name='date_check']" position="attributes" optional="1">
                    <attribute name="invisible">1</attribute>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
