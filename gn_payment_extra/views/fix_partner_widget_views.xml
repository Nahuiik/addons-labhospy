<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Fix para eliminar widget res_partner_many2one del campo partner_id en account.move (facturas) -->
        <!-- Evita "Missing widget: res_partner_many2one" cuando partner_autocomplete no está instalado -->
        <record id="view_account_move_fix_partner_widget" model="ir.ui.view">
            <field name="name">account.move.fix.partner.widget</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='partner_id'][@widget='res_partner_many2one']" position="replace">
                    <field name="partner_id" nolabel="1"
                           context="{
                            'res_partner_search_mode': (context.get('default_move_type', 'entry') in ('out_invoice', 'out_refund', 'out_receipt') and 'customer') or (context.get('default_move_type', 'entry') in ('in_invoice', 'in_refund', 'in_receipt') and 'supplier') or False,
                            'show_address': 1, 'default_is_company': True, 'show_vat': True}"
                           domain="[('company_id', 'in', (False, company_id))]"
                           options='{"no_quick_create": True}'
                           default_focus="1"
                           invisible="move_type not in ('out_invoice', 'out_refund', 'in_invoice', 'in_refund', 'out_receipt', 'in_receipt')"
                           placeholder="Search a name or Tax ID..."
                           readonly="state != 'draft'"/>
                </xpath>
            </field>
        </record>

        <!-- Fix para eliminar widget res_partner_many2one del campo partner_id en account.payment.register -->
        <!-- Usar un enfoque más seguro: reemplazar todos los campos partner_id para asegurar que no tengan el widget -->
        <record id="view_account_payment_register_fix_partner_widget" model="ir.ui.view">
            <field name="name">account.payment.register.fix.partner.widget</field>
            <field name="model">account.payment.register</field>
            <field name="inherit_id" ref="account.view_account_payment_register_form"/>
            <field name="arch" type="xml">
                <!-- Reemplazar el campo partner_id para eliminar cualquier widget res_partner_many2one -->
                <xpath expr="//field[@name='partner_id']" position="replace">
                    <field name="partner_id"/>
                </xpath>
            </field>
        </record>
        
        <!-- Fix para eliminar widget res_partner_many2one del campo partner_id en account.payment -->
        <record id="view_account_payment_fix_partner_widget" model="ir.ui.view">
            <field name="name">account.payment.fix.partner.widget</field>
            <field name="model">account.payment</field>
            <field name="inherit_id" ref="account.view_account_payment_form"/>
            <field name="priority">20</field>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='partner_id'][contains(@invisible, 'customer')]" position="replace">
                    <field name="partner_id"
                           string="Customer"
                           context="{'default_is_company': True}"
                           invisible="partner_type != 'customer'"
                           readonly="state != 'draft'"
                           options="{'no_open': True, 'no_create': True, 'no_quick_create': True}"/>
                </xpath>
                <xpath expr="//field[@name='partner_id'][contains(@invisible, 'supplier')]" position="replace">
                    <field name="partner_id"
                           string="Vendor"
                           context="{'default_is_company': True}"
                           invisible="partner_type != 'supplier'"
                           readonly="state != 'draft'"
                           options="{'no_open': True, 'no_create': True, 'no_quick_create': True}"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
