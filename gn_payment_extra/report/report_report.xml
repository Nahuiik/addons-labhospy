<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Reporte Excel -->
        <record id="action_pos_commission_report_xls" model="ir.actions.report">
            <field name="name">Reporte Comisiones POS (Excel)</field>
            <field name="model">pos.commission.report.wizard</field>
            <field name="report_type">xlsx</field>
            <field name="report_name">gn_payment_extra.pos_commission_report_xls</field>
            <field name="report_file">gn_payment_extra.pos_commission_report_xls</field>
            <field name="print_report_name">'Reporte_Comisiones_POS_%s_%s' % (object.date_from, object.date_to)</field>
        </record>

        <!-- Reporte PDF -->
        <record id="action_pos_commission_report_pdf" model="ir.actions.report">
            <field name="name">Reporte Comisiones POS (PDF)</field>
            <field name="model">pos.commission.report.wizard</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">gn_payment_extra.pos_commission_report_pdf_template</field>
            <field name="report_file">gn_payment_extra.pos_commission_report_pdf_template</field>
            <field name="print_report_name">'Reporte_Comisiones_POS_%s_%s' % (object.date_from, object.date_to)</field>
            <field name="paperformat_id" ref="base.paperformat_us"/>
        </record>
    </data>
</odoo>
