<odoo>
    <record model="report.paperformat" id="paperformat_account_status">
        <field name="name">Account Status</field>
        <field name="default" eval="True"/>
        <field name="format">custom</field>
        <field name="page_width">215</field>
        <field name="page_height">279</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">5</field>
        <field name="margin_right">5</field>
        <field name="margin_bottom">10</field>
        <field name="margin_left">5</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">5</field>
        <field name="dpi">90</field>
    </record>

    <record model="report.paperformat" id="paperformat_summary_invoice">
        <field name="name">Summary Invoice</field>
        <field name="default" eval="True"/>
        <field name="format">custom</field>
        <field name="page_width">215</field>
        <field name="page_height">279</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">38</field>
        <field name="margin_right">5</field>
        <field name="margin_bottom">20</field>
        <field name="margin_left">5</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">5</field>
        <field name="dpi">90</field>
    </record>
</odoo>