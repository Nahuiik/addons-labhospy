<odoo>
    <record id="view_invoice_form_inh" model="ir.ui.view">
        <field name="name">account.move.form.gn_hospital_product</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@id='header_left_group']//field[@name='partner_id']" position="after">
                <field name="invoice_number" string="Invoice #" readonly="state != 'draft'"/>
            </xpath>
        </field>
    </record>
</odoo>
