<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        No añadir otro journal_id: account.view_move_form ya muestra el diario
        en //div[@name='journal_div']/field[@name='journal_id'].
        Solo se ajustan atributos del campo existente y el campo técnico invisible.
    -->
    <record id="view_move_form" model="ir.ui.view">
        <field name="name">account.move.form.inherit.account.restrict.journal</field>
        <field name="model">account.move</field>
        <field name="mode">extension</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='journal_div']/field[@name='journal_id']" position="attributes">
                <attribute name="options">{'no_create': True}</attribute>
                <attribute name="readonly">state != 'draft' or (posted_before and name not in (False, '', '/'))</attribute>
            </xpath>
            <xpath expr="//group[@id='header_right_group']" position="inside">
                <field name="is_check_journal" invisible="1"/>
            </xpath>
        </field>
    </record>
</odoo>
