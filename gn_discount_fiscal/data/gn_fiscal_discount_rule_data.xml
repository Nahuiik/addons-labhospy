<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="gn_fiscal_rule_age_60_79" model="gn.fiscal.discount.rule">
            <field name="name">Tercera edad (60 a 79 años cumplidos)</field>
            <field name="sequence">10</field>
            <field name="matrix_code">third_age</field>
            <field name="age_min">60</field>
            <field name="age_max">79</field>
            <field name="discount_percent">30</field>
            <field name="company_id" ref="base.main_company"/>
        </record>
        <record id="gn_fiscal_rule_age_80" model="gn.fiscal.discount.rule">
            <field name="name">Cuarta edad (80 años cumplidos o más)</field>
            <field name="sequence">20</field>
            <field name="matrix_code">fourth_age</field>
            <field name="age_min">80</field>
            <field name="age_max">0</field>
            <field name="discount_percent">40</field>
            <field name="company_id" ref="base.main_company"/>
        </record>
        <record id="gn_fiscal_rule_special_patient" model="gn.fiscal.discount.rule">
            <field name="name">Paciente especial (menores de 60 años / sin rango de edad)</field>
            <field name="sequence">5</field>
            <field name="matrix_code">special_patient</field>
            <field name="age_min">0</field>
            <field name="age_max">0</field>
            <field name="discount_percent">20</field>
            <field name="company_id" ref="base.main_company"/>
        </record>
    </data>
</odoo>
