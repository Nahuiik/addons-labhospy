<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <data>
        <record id="view_account_invoice_report_ps_form" model="ir.ui.view">
            <field name="name">account.move.report.ps.form.view</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <xpath expr="//header" position="inside">
                    <button name="print_invoice_point_sale"
                        class="btn btn-success"
                        style="color: white; border-radius: 5px; box-shadow: 2px 2px 2px 1px rgb(0 0 0 / 30%); font-weight: 600;"
                        type="object"
                        string="Print Invoice PS"
                        invisible="move_type != 'out_invoice' or state == 'draft'"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
