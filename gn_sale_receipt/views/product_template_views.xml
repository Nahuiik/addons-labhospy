<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_product_template_form_sale_receipt" model="ir.ui.view">
            <field name="name">product.template.form.sale.receipt</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='categ_id']" position="after">
                    <field name="for_sale_receipt" 
                           string="Es para recibo de ventas"
                           invisible="type != 'service'"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>

