<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">

    <t t-inherit="stock.ForecastedButtons" t-inherit-mode="extension">
        <xpath expr="//button[@t-on-click='_onClickUpdateQuantity']" position="attributes">
            <attribute name="t-if">props.canUpdateQty</attribute>
        </xpath>
    </t>

    <t t-inherit="stock.Forecasted" t-inherit-mode="extension">
        <xpath expr="//ForecastedButtons" position="attributes">
            <attribute name="canUpdateQty">canUpdateQty</attribute>
        </xpath>
    </t>

</templates>
