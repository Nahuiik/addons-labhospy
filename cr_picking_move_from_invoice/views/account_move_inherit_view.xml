<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="account_move_inherit_form" model="ir.ui.view">
        <field name="name">account.move.inherit.form</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/div[hasclass('oe_button_box')]" position="inside">
                <button name="action_show_stock_picking" type="object"
                        class="oe_stat_button" icon="fa-truck" invisible="stock_picking_count == 0">
                    <div class="o_stat_info">
                        <span class="o_stat_text">
                            Stock Picking
                        </span>
                        <field name="stock_picking_count"/>
                    </div>
                </button>
                <button name="action_show_stock_move" type="object"
                        class="oe_stat_button" icon="fa-truck" invisible="stock_move_count == 0">
                    <div class="o_stat_info">
                        <span class="o_stat_text">
                            Stock Move
                        </span>
                        <field name="stock_move_count"/>
                    </div>
                </button>
            </xpath>
        </field>
    </record>
</odoo>