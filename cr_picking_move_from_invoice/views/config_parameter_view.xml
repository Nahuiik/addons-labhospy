<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="config_invoice_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.generate.invoice</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>

        <field name="arch" type="xml">
            <xpath expr="//block[@id='pay_invoice_online_setting_container']" position="after">
				<h2>
					Picking And Move Create From Invoice
				</h2>
				<div class="row mt16 o_settings_container" id="invoice_from_stock_move_or_picking">
					<div class="col-12 col-lg-6 o_setting_box">
						<div class="o_setting_left_pane">
							<field name="invoice" />
						</div>
						<div class="o_setting_right_pane">
							<label for="invoice" />
							<div class="text-muted">
								When you selected "Cash rounding method" then stock picking/move is not created from invoice/Bills
							</div>
						</div>
					</div>
					<div class="col-12 col-lg-6 o_setting_box" invisible="not invoice">
						<div class="o_setting_right_pane">
							<span class="o_form_label">
								Warehouse
							</span>
							<div class="text-muted">
								<field name="warehouse_id" required="invoice"/>
							</div>
						</div>
					</div>
				</div>
				<div class="row mt16 o_settings_container" id="option_for_invoice_from_stock_move_or_picking" invisible="not invoice">
					<div class="col-12 col-lg-6 o_setting_box">
						<div class="o_setting_right_pane">
							<label for="create_stock_move_or_picking" />
							<div class="text-muted">
								Select Option
							</div>
							<div class="content-group">
								<div class="mt16">
									<field name="create_stock_move_or_picking" widget="radio" class="o_light_label"/>
								</div>
							</div>
						</div>
					</div>
				</div>
			</xpath>
        </field>
    </record>
</odoo>