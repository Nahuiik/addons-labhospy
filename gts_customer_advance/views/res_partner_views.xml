            <!-- Agregar campos computados invisibles -->
            <xpath expr="//field[@name='category_id']" position="after">
                <field name="vendor_advances_count" invisible="1"/>
                <field name="total_vendor_advances_available" invisible="1"/>
                <field name="total_vendor_advances_applied" invisible="1"/>
                <field name="total_vendor_advances_paid" invisible="1"/>
            </xpath>
            
            <!-- Agregar pestaña de anticipos de proveedores -->
            <xpath expr="//notebook" position="inside">
                <page string="Abonos/Anticipos de Proveedor" 
                      name="vendor_advances"
                      invisible="is_company == False or supplier_rank == 0">
                    <group>
                        <group string="Resumen de Abonos/Anticipos de Proveedor">
                            <field name="vendor_advances_count" readonly="1"/>
                            <field name="total_vendor_advances_paid" 
                                   widget="monetary"
                                   readonly="1"
                                   options="{'currency_field': 'currency_id'}"/>
                            <field name="total_vendor_advances_applied" 
                                   widget="monetary"
                                   readonly="1"
                                   options="{'currency_field': 'currency_id'}"/>
                            <field name="total_vendor_advances_available" 
                                   widget="monetary"
                                   readonly="1"
                                   options="{'currency_field': 'currency_id'}"/>
