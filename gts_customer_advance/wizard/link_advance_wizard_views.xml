<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_link_advance_wizard_form" model="ir.ui.view">
        <field name="name">link.advance.wizard.form</field>
        <field name="model">link.advance.wizard</field>
        <field name="arch" type="xml">
            <form string="Asociar Abono/Anticipo">
                <group>
                    <group>
                        <field name="sale_order_id" invisible="1"/>
                        <field name="partner_id"/>
                        <field name="amount_total"/>
                        <field name="currency_id" invisible="1"/>
                    </group>
                </group>
                <div class="alert alert-warning mb-3"
                     role="status"
                     invisible="sale_order_id.advance_quota_ids">
                    <strong>No hay plan de cuotas.</strong>
                    <p>Cree el plan de cuotas para distribuir automáticamente los anticipos en las cuotas.</p>
                    <button name="action_create_quota_plan" type="object" string="Crear plan de cuotas" class="btn-warning"/>
                </div>
                <field name="line_ids" nolabel="1">
                    <list editable="bottom" create="0" delete="0">
                        <field name="payment_id" readonly="1"/>
                        <field name="payment_date" readonly="1"/>
                        <field name="payment_name" readonly="1"/>
                        <field name="available_amount" widget="monetary" options="{'currency_field': 'currency_id'}" readonly="1"/>
                        <field name="amount_to_link" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                        <field name="currency_id" column_invisible="1"/>
                    </list>
                </field>
                <footer>
                    <button name="action_confirm" string="Asociar" type="object" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
