<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="gts_customer_advance.DataTable">
        <div class="gts-advance-data-table">
            <t t-if="props.data.rows and props.data.rows.length">
                <table class="table table-sm table-hover gts-advance-table">
                    <thead>
                        <tr>
                            <th>Creador</th>
                            <th class="text-end">Abonos/Anticipos</th>
                            <th class="text-end">Monto Total</th>
                            <th class="text-end">Cotizaciones Vinculadas</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="props.data.rows" t-as="row" t-key="row.user_id">
                            <tr>
                                <td class="gts-advance-clickable" t-on-click="() => this.onRowClick(row.user_id)">
                                    <t t-esc="row.user_name"/>
                                </td>
                                <td class="text-end gts-advance-clickable" t-on-click="() => this.onRowClick(row.user_id)">
                                    <t t-esc="row.advance_count"/>
                                </td>
                                <td class="text-end">
                                    $<t t-esc="fmt(row.advance_amount)"/>
                                </td>
                                <td class="text-end">
                                    <t t-esc="row.linked_quotation_count"/>
                                </td>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </t>
            <t t-else="">
                <div class="alert alert-info mt-3 text-center" role="status">
                    No se encontraron Abonos/Anticipos para los filtros seleccionados.
                </div>
            </t>
        </div>
    </t>

</templates>
