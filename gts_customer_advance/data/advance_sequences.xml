<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Secuencia para anticipos de clientes -->
        <record id="sequence_customer_advance" model="ir.sequence">
            <field name="name">Secuencia Anticipos de Clientes</field>
            <field name="code">customer.advance</field>
            <field name="prefix">ADV-CLI/</field>
            <field name="padding">5</field>
            <field name="number_increment">1</field>
            <field name="number_next">1</field>
            <field name="company_id" eval="False"/>
            <field name="use_date_range">False</field>
        </record>

        <!-- Secuencia para anticipos de proveedores -->
        <record id="sequence_vendor_advance" model="ir.sequence">
            <field name="name">Secuencia Anticipos de Proveedores</field>
            <field name="code">vendor.advance</field>
            <field name="prefix">ADV-PROV/</field>
            <field name="padding">5</field>
            <field name="number_increment">1</field>
            <field name="number_next">1</field>
            <field name="company_id" eval="False"/>
            <field name="use_date_range">False</field>
        </record>
    </data>
</odoo>
