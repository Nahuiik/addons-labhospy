<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_labhospy_sales_report_wizard_form" model="ir.ui.view">
        <field name="name">labhospy.sales.report.wizard.form</field>
        <field name="model">labhospy.sales.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Reporte de ventas LabHosPy">
                <group>
                    <group>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                    <group>
                        <field name="group_by"/>
                        <field name="include_untaxed_value"/>
                    </group>
                </group>
                <footer>
                    <button name="action_export_xlsx"
                            type="object"
                            string="Exportar Excel"
                            class="btn-primary"
                            data-hotkey="q"/>
                    <button string="Cerrar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_labhospy_sales_report_wizard" model="ir.actions.act_window">
        <field name="name">Reporte de ventas</field>
        <field name="res_model">labhospy.sales.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{}</field>
    </record>
</odoo>
