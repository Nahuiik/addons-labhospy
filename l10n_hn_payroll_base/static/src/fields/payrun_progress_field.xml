<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="l10n_hn_payroll_base.PayrunProgressField">
        <div class="o_payrun_progress_field" t-att-class="'o_palette_' + (payload.palette || 'draft')">
            <!-- Single baseline through node centers; circles sit on top (z-index) -->
            <div class="o_payrun_rail_track">
                <div class="o_payrun_rail_line" role="presentation"/>
                <t t-foreach="payload.steps" t-as="step" t-key="step_index">
                    <div class="o_payrun_track_cell">
                        <div t-attf-class="o_payrun_node {{ nodeClass(step) }}">
                            <i
                                t-if="showTerminalCheck(step_index)"
                                class="fa fa-check o_payrun_node_check"
                                aria-hidden="true"
                            />
                            <i
                                t-elif="showActiveCaret(step)"
                                class="fa fa-caret-down o_payrun_node_caret"
                                aria-hidden="true"
                            />
                        </div>
                    </div>
                </t>
            </div>
            <div class="o_payrun_rail_captions">
                <t t-foreach="payload.steps" t-as="step" t-key="'lbl-' + step_index">
                    <div class="o_payrun_caption_cell">
                        <div class="o_payrun_node_label text-truncate" t-out="step.label"/>
                    </div>
                </t>
            </div>
        </div>
    </t>
</templates>
