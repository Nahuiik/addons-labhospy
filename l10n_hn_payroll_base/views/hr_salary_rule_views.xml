<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_payroll_structure_tree" model="ir.ui.view">
        <field name="name">hr.payroll.structure.list</field>
        <field name="model">hr.payroll.structure</field>
        <field name="arch" type="xml">
            <list default_order="sequence, type_id, name" expand="1" sample="1"
                decoration-muted="active == False"
                decoration-warning="not type_id"
                multi_edit="1">
                <field name="sequence" widget="handle"/>
                <field name="type_id" string="Structure type"/>
                <field name="name"/>
                <field name="code" optional="hide"/>
                <field name="salary_rule_count" string="Salary rules"/>
                <field name="country_id" optional="show"/>
                <field name="contract_usage_count" string="Count"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_hr_payroll_structure_kanban" model="ir.ui.view">
        <field name="name">hr.payroll.structure.kanban</field>
        <field name="model">hr.payroll.structure</field>
        <field name="arch" type="xml">
            <kanban sample="1" default_order="sequence, name">
                <field name="name"/>
                <field name="type_id"/>
                <field name="salary_rule_count"/>
                <field name="contract_usage_count"/>
                <field name="country_id"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_content">
                            <div class="o_kanban_record_title fw-bold">
                                <field name="name"/>
                            </div>
                            <div class="text-muted small">
                                <field name="type_id"/>
                            </div>
                            <div class="small mt-2">
                                <span class="me-2"><i class="fa fa-list-alt" title="Salary rules"/> <field name="salary_rule_count"/></span>
                                <span><i class="fa fa-address-card" title="Contracts"/> <field name="contract_usage_count"/></span>
                            </div>
                            <div class="small text-muted" t-if="record.country_id.raw_value">
                                <field name="country_id"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_hr_payroll_structure_form" model="ir.ui.view">
        <field name="name">hr.payroll.structure.form</field>
        <field name="model">hr.payroll.structure</field>
        <field name="arch" type="xml">
            <form string="Pay structure">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object" name="action_open_salary_rules" icon="fa-list-alt">
                            <field name="salary_rule_count" widget="statinfo" string="Salary rules"/>
                        </button>
                        <button class="oe_stat_button" type="object" name="action_open_contract_versions" icon="fa-address-card">
                            <field name="contract_usage_count" widget="statinfo" string="Contracts"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" string="Structure name"/>
                        <h1><field name="name" placeholder="e.g. Regular Pay"/></h1>
                    </div>
                    <group>
                        <group string="General">
                            <field name="sequence" groups="base.group_no_one"/>
                            <field name="code"/>
                            <field name="restricted_contract_type_ids" widget="many2many_tags"
                                placeholder="All employment types"/>
                            <field name="type_id" string="Type"/>
                            <field name="use_worked_day_lines" widget="boolean_toggle"/>
                            <field name="worked_days_from_work_entries" widget="boolean_toggle"/>
                            <field name="country_id"/>
                            <field name="ytd_computation" string="Year to date computation" widget="boolean_toggle"/>
                        </group>
                        <group string="Payslip &amp; accounting">
                            <field name="payslip_report_id" string="Template"
                                options="{'no_create': True}"/>
                            <field name="payslip_name_pattern" placeholder="{employee} – {month}/{year}"/>
                            <field name="hide_basic_on_pdf" widget="boolean_toggle"/>
                            <field name="schedule_pay"/>
                            <field name="journal_id" options="{'no_create': True}"/>
                            <field name="parent_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Salary rules" name="salary_rules">
                            <field name="rule_ids" domain="[('parent_rule_id','=',False)]">
                                <list decoration-muted="active == False">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="code"/>
                                    <field name="category_id" widget="badge"/>
                                    <field name="register_id" string="Partner" optional="show"/>
                                    <field name="active" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Unpaid time types" name="unpaid_time">
                            <field name="unpaid_work_entry_type_ids" widget="many2many_tags"
                                string="Unpaid work entry types"/>
                        </page>
                        <page string="Other input" name="input_types">
                            <field name="input_line_type_ids" widget="many2many_tags"/>
                        </page>
                        <page string="Description" name="description">
                            <field name="note" colspan="2" nolabel="1" placeholder="Internal description…"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hr_payroll_structure_search" model="ir.ui.view">
        <field name="name">hr.payroll.structure.search</field>
        <field name="model">hr.payroll.structure</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="type_id"/>
                <field name="country_id"/>
                <filter string="Missing structure type" name="filter_no_type" domain="[('type_id', '=', False)]"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <separator/>
                <filter string="Structure type" name="groupby_type" context="{'group_by': 'type_id'}"/>
                <filter string="Country" name="groupby_country" context="{'group_by': 'country_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_hr_payroll_structure" model="ir.actions.act_window">
        <field name="name">Pay structures</field>
        <field name="res_model">hr.payroll.structure</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_hr_payroll_structure_search"/>
        <field name="context">{'search_default_groupby_type': 1}</field>
    </record>

    <record id="hr_contribution_register_tree" model="ir.ui.view">
        <field name="name">hr.contribution.register.list</field>
        <field name="model">hr.contribution.register</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="hr_contribution_register_form" model="ir.ui.view">
        <field name="name">hr.contribution.register.form</field>
        <field name="model">hr.contribution.register</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="partner_id"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hr_contribution_register" model="ir.actions.act_window">
        <field name="name">Contribution registers</field>
        <field name="res_model">hr.contribution.register</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="hr_salary_rule_category_tree" model="ir.ui.view">
        <field name="name">hr.salary.rule.category.list</field>
        <field name="model">hr.salary.rule.category</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
            </list>
        </field>
    </record>

    <record id="hr_salary_rule_category_form" model="ir.ui.view">
        <field name="name">hr.salary.rule.category.form</field>
        <field name="model">hr.salary.rule.category</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="parent_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hr_salary_rule_category" model="ir.actions.act_window">
        <field name="name">Salary categories</field>
        <field name="res_model">hr.salary.rule.category</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="hr_salary_rule_tree" model="ir.ui.view">
        <field name="name">hr.salary.rule.list</field>
        <field name="model">hr.salary.rule</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="category_id"/>
            </list>
        </field>
    </record>

    <record id="hr_salary_rule_form" model="ir.ui.view">
        <field name="name">hr.salary.rule.form</field>
        <field name="model">hr.salary.rule</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="sequence"/>
                        <field name="category_id"/>
                        <field name="active"/>
                        <field name="appears_on_payslip"/>
                    </group>
                    <notebook>
                        <page string="Conditions" name="conditions">
                            <group>
                                <field name="condition_select"/>
                                <field name="condition_range" invisible="condition_select != 'range'"/>
                                <field name="condition_range_min" invisible="condition_select != 'range'"/>
                                <field name="condition_range_max" invisible="condition_select != 'range'"/>
                                <field name="condition_python" invisible="condition_select != 'python'"/>
                            </group>
                        </page>
                        <page string="Computation" name="computation">
                            <group>
                                <field name="amount_select"/>
                                <field name="quantity"/>
                                <field name="amount_fix" invisible="amount_select != 'fix'"/>
                                <field name="amount_percentage" invisible="amount_select != 'percentage'"/>
                                <field name="amount_percentage_base" invisible="amount_select != 'percentage'"/>
                                <field name="amount_python_compute" invisible="amount_select != 'code'"/>
                            </group>
                        </page>
                        <page string="Rules" name="rules">
                            <field name="child_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="code"/>
                                </list>
                            </field>
                            <field name="input_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="code"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hr_salary_rule" model="ir.actions.act_window">
        <field name="name">Salary rules</field>
        <field name="res_model">hr.salary.rule</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_hn_structure" parent="menu_hn_payroll_configuration" action="action_hr_payroll_structure" sequence="2"/>
    <menuitem id="menu_hn_contrib" parent="menu_hn_payroll_configuration" action="action_hr_contribution_register" sequence="4"/>
    <menuitem id="menu_hn_rule_cat" parent="menu_hn_payroll_configuration" action="action_hr_salary_rule_category" sequence="6"/>
    <menuitem id="menu_hn_salary_rule" parent="menu_hn_payroll_configuration" action="action_hr_salary_rule" sequence="8"/>

    <record id="hr_payroll_structure_type_view_tree" model="ir.ui.view">
        <field name="name">hr.payroll.structure.type.list</field>
        <field name="model">hr.payroll.structure.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="country_id" optional="show"/>
                <field name="default_schedule_pay"/>
            </list>
        </field>
    </record>

    <record id="hr_payroll_structure_type_view_form" model="ir.ui.view">
        <field name="name">hr.payroll.structure.type.form</field>
        <field name="model">hr.payroll.structure.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="country_id"/>
                        <field name="default_resource_calendar_id"/>
                        <field name="default_schedule_pay"/>
                        <field name="default_struct_id"/>
                        <field name="default_work_entry_type_id"/>
                        <field name="wage_type"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hr_payroll_structure_type" model="ir.actions.act_window">
        <field name="name">Salary structure types</field>
        <field name="res_model">hr.payroll.structure.type</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_hn_structure_type"
              parent="menu_hn_payroll_configuration"
              action="action_hr_payroll_structure_type"
              sequence="3"/>
</odoo>
