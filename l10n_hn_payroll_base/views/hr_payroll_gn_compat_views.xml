<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Cadena de herencia esperada por GN (antes hr_payroll.payroll_hr_employee_view_form). -->
    <record id="payroll_hr_employee_view_form" model="ir.ui.view">
        <field name="name">hr.employee.form.payroll.gn.compat</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="view_employee_form_payroll_hn"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <div class="o_invisible" invisible="1" name="hr_payroll_employee_compat_hook"/>
            </xpath>
        </field>
    </record>
</odoo>
