<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_payroll" model="ir.ui.view">
        <field name="name">res.config.settings.view.payroll.hn</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="95"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Payroll (HN)" string="Payroll (HN)" name="l10n_hn_payroll_base"
                    groups="l10n_hn_payroll_base.group_hn_payroll_manager">
                    <block title="Payroll" id="hr_payroll_settings" name="hr_payroll_settings">
                    </block>
                    <block title="Reports" name="hn_payroll_reports">
                        <setting string="Payslip PDF layout" help="Company-wide payslip print style.">
                            <field name="payslip_report_template"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
