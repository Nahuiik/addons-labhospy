#. module: cancel_landed_cost_odoo
#: model:ir.module.module,shortdesc:cancel_landed_cost_odoo.__manifest__
msgid "Landed Cost Cancellation"
msgstr "Cancelación de costos en destino"

#. module: cancel_landed_cost_odoo
#: model:ir.module.module,summary:cancel_landed_cost_odoo.__manifest__
msgid "Cancel posted landed costs and reverse valuation"
msgstr "Cancela costos en destino publicados y revierte la valoración"

#. module: cancel_landed_cost_odoo
#: model:ir.module.module,description:cancel_landed_cost_odoo.__manifest__
msgid ""
"Cancel landed costs and reverse journal entries and stock valuation. "
"Includes list actions: cancel only, cancel and reset to draft, cancel and delete; "
"configurable mode in Settings."
msgstr ""
"Permite cancelar costos en destino y revertir asientos contables y valoración de inventario. "
"Incluye acciones en lista: solo cancelar, cancelar y devolver a borrador, cancelar y eliminar; "
"modo configurable en Ajustes."

