<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="res_config_settings_view_form_inherit_cancel_landed_cost" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.cancel.landed.cost.odoo</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="stock_landed_costs.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='lc_journal_id']" position="after">
                <div class="mt16" groups="cancel_landed_cost_odoo.cancel_landed_cost_odoo_group_cancel_user"
                     invisible="not module_stock_landed_costs">
                    <label for="land_cost_cancel_modes" string="Landed cost cancellation"/>
                    <div class="text-muted">
                        Behavior of the Cancel button on validated landed costs.
                    </div>
                    <field name="land_cost_cancel_modes" widget="radio"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
