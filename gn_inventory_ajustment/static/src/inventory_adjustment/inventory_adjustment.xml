<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="gn_inventory_ajustment.InventoryAdjustment">
        <div class="o_gn_inv_adj d-flex flex-column h-100">

            <t t-if="state.loadingOptions">
                <div class="text-center text-muted py-5 flex-grow-1 d-flex align-items-center justify-content-center">
                    <i class="fa fa-spinner fa-spin fa-2x me-2"/> Cargando…
                </div>
            </t>
            <t t-else="">

                <!-- ── Barra de filtros ── -->
                <div class="o_gn_inv_adj_toolbar bg-white border-bottom px-3 py-2">
                    <div class="d-flex flex-wrap align-items-end gap-2">
                        <div>
                            <label class="form-label small mb-0 text-muted">Almacén</label>
                            <select class="form-select form-select-sm" t-on-change="onWarehouseChange">
                                <option value="0" t-att-selected="!state.filters.warehouse_id">Todos</option>
                                <t t-foreach="state.options.warehouses" t-as="wh" t-key="wh.id">
                                    <option t-att-value="wh.id"
                                            t-att-selected="state.filters.warehouse_id === wh.id"
                                            t-esc="wh.name"/>
                                </t>
                            </select>
                        </div>
                        <div>
                            <label class="form-label small mb-0 text-muted">Ubicación</label>
                            <select class="form-select form-select-sm o_gn_inv_adj_loc_select" t-on-change="onLocationChange">
                                <option value="0" t-att-selected="!state.filters.location_id">Todas</option>
                                <t t-foreach="getFilteredLocations()" t-as="loc" t-key="loc.id">
                                    <option t-att-value="loc.id"
                                            t-att-selected="state.filters.location_id === loc.id"
                                            t-esc="loc.name"/>
                                </t>
                            </select>
                        </div>
                        <div>
                            <label class="form-label small mb-0 text-muted">Proveedor (LabHosPy)</label>
                            <select class="form-select form-select-sm" t-on-change="onSupplierChange">
                                <option value="0" t-att-selected="!state.filters.supplier_id">Todos</option>
                                <t t-foreach="state.options.suppliers" t-as="sup" t-key="sup.id">
                                    <option t-att-value="sup.id"
                                            t-att-selected="state.filters.supplier_id === sup.id"
                                            t-esc="sup.name"/>
                                </t>
                            </select>
                        </div>
                        <div>
                            <label class="form-label small mb-0 text-muted">Modelo</label>
                            <input type="text" class="form-control form-control-sm"
                                   placeholder="Modelo…"
                                   t-att-value="state.filters.model_filter"
                                   t-on-input="onModelInput"/>
                        </div>
                        <div>
                            <label class="form-label small mb-0 text-muted">Código de Catálogo</label>
                            <input type="text" class="form-control form-control-sm"
                                   placeholder="Código…"
                                   t-att-value="state.filters.code_filter"
                                   t-on-input="onCodeInput"/>
                        </div>
                        <div class="form-check form-switch mb-1 d-flex align-items-center">
                            <input class="form-check-input" type="checkbox" id="gn_inv_adj_show_qty"
                                   t-att-checked="state.filters.show_qty"
                                   t-on-change="onShowQtyChange"/>
                            <label class="form-check-label small ms-1 text-nowrap" for="gn_inv_adj_show_qty">
                                Mostrar cantidades a la mano
                            </label>
                        </div>
                        <button type="button" class="btn btn-sm btn-primary"
                                t-att-disabled="state.loading"
                                t-on-click="onSearch">
                            <i class="fa fa-search me-1"/> Buscar
                        </button>
                        <span class="border-start mx-1" style="height:26px;"/>
                        <button type="button" class="btn btn-sm o_gn_inv_adj_btn_pdf"
                                t-att-disabled="state.loading"
                                t-on-click="() => this.printReport('pdf')">
                            <i class="fa fa-file-pdf-o me-1"/> PDF
                        </button>
                        <button type="button" class="btn btn-sm o_gn_inv_adj_btn_excel"
                                t-att-disabled="state.loading"
                                t-on-click="() => this.printReport('xlsx')">
                            <i class="fa fa-file-excel-o me-1"/> Excel
                        </button>
                        <span class="border-start mx-1" style="height:26px;"/>
                        <button type="button" class="btn btn-sm btn-secondary"
                                t-on-click="openAddProduct">
                            <i class="fa fa-plus me-1"/> Agregar producto
                        </button>
                        <button type="button" class="btn btn-sm btn-success"
                                t-att-disabled="state.applying || !getCountedLines().length"
                                t-on-click="onApplyClick">
                            <i class="fa fa-check me-1"/>
                            Aplicar ajuste
                            <t t-if="getCountedLines().length">
                                (<t t-esc="getCountedLines().length"/>)
                            </t>
                        </button>
                    </div>
                </div>

                <!-- ── Contenido ── -->
                <t t-if="state.error">
                    <div class="p-3"><div class="alert alert-warning mb-0" t-esc="state.error"/></div>
                </t>
                <t t-elif="state.loading">
                    <div class="text-center text-muted py-5 flex-grow-1 d-flex align-items-center justify-content-center">
                        <i class="fa fa-spinner fa-spin fa-2x me-2"/> Cargando…
                    </div>
                </t>
                <t t-elif="!state.searched">
                    <div class="p-4 text-center text-muted">
                        <i class="fa fa-filter fa-2x mb-2 d-block"/>
                        Seleccione los filtros y presione <b>Buscar</b> para consultar el inventario físico.
                    </div>
                </t>
                <t t-elif="!state.lines.length">
                    <div class="p-4 text-center text-muted">
                        No hay existencias para los filtros seleccionados.
                        Use <b>Agregar producto</b> para contar uno que no tiene cantidades disponibles.
                    </div>
                </t>
                <t t-else="">
                    <div class="o_gn_inv_adj_table_wrap flex-grow-1 overflow-auto">
                        <table class="table table-sm table-hover o_gn_inv_adj_table mb-0">
                            <thead class="o_gn_inv_adj_thead">
                                <tr>
                                    <th>Ubicación</th>
                                    <th>Código</th>
                                    <th>Producto</th>
                                    <th>Proveedor</th>
                                    <th>Código de Catálogo</th>
                                    <th>Modelo</th>
                                    <th>Lote/Serie</th>
                                    <th>UdM</th>
                                    <th t-if="state.filters.show_qty" class="text-end">A la mano</th>
                                    <th class="text-end" style="width: 110px;">Contado</th>
                                    <th t-if="state.filters.show_qty" class="text-end">Diferencia</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="state.lines" t-as="line" t-key="line.line_key"
                                    t-att-class="hasCounted(line) ? 'o_gn_inv_adj_row_counted' : ''">
                                    <td class="text-nowrap" t-esc="line.location"/>
                                    <td class="text-nowrap" t-esc="line.default_code"/>
                                    <td>
                                        <t t-esc="line.product"/>
                                        <span t-if="line.manual" class="badge text-bg-warning ms-1">Sin existencia</span>
                                    </td>
                                    <td t-esc="line.supplier"/>
                                    <td t-esc="line.catalog_code"/>
                                    <td t-esc="line.model"/>
                                    <td t-esc="line.lot"/>
                                    <td t-esc="line.uom"/>
                                    <td t-if="state.filters.show_qty" class="text-end"
                                        t-esc="fmt2(line.qty_on_hand)"/>
                                    <td>
                                        <input type="number" step="any" min="0"
                                               class="form-control form-control-sm text-end o_gn_inv_adj_counted"
                                               t-att-value="getCounted(line)"
                                               t-on-input="(ev) => this.onCountedInput(line, ev)"/>
                                    </td>
                                    <td t-if="state.filters.show_qty" class="text-end">
                                        <t t-if="getDiff(line) !== null">
                                            <span t-att-class="getDiff(line) &lt; 0 ? 'text-danger fw-semibold' : (getDiff(line) &gt; 0 ? 'text-success fw-semibold' : 'text-muted')"
                                                  t-esc="fmt2(getDiff(line))"/>
                                        </t>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <div class="px-3 py-1 border-top bg-white small text-muted">
                        <t t-esc="state.lines.length"/> línea(s)
                        <t t-if="getCountedLines().length">
                            — <t t-esc="getCountedLines().length"/> con conteo capturado
                        </t>
                    </div>
                </t>
            </t>

            <t t-if="state.addProduct.open">
                <div class="o_gn_inv_adj_modal_backdrop" t-on-click="closeAddProduct"/>
                <div class="o_gn_inv_adj_modal card shadow" role="dialog">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <strong>Agregar producto sin existencia</strong>
                        <button type="button" class="btn-close" t-on-click="closeAddProduct"/>
                    </div>
                    <div class="card-body">
                        <label class="form-label small mb-0 text-muted">Producto</label>
                        <input type="text" class="form-control form-control-sm mb-1"
                               placeholder="Nombre, código o catálogo…"
                               t-att-value="state.addProduct.term"
                               t-on-input="onProductSearchInput"/>
                        <div t-if="state.addProduct.searching" class="small text-muted mb-2">Buscando…</div>
                        <div t-if="state.addProduct.results.length" class="list-group mb-2 o_gn_inv_adj_product_results">
                            <button type="button"
                                    t-foreach="state.addProduct.results" t-as="product" t-key="product.id"
                                    class="list-group-item list-group-item-action py-1 small"
                                    t-att-class="state.addProduct.productId === product.id ? 'active' : ''"
                                    t-on-click="() => this.selectProduct(product)"
                                    t-esc="product.name"/>
                        </div>
                        <label class="form-label small mb-0 text-muted">Ubicación</label>
                        <select class="form-select form-select-sm mb-2" t-on-change="onAddLocationChange">
                            <option value="0">Seleccione…</option>
                            <t t-foreach="getFilteredLocations()" t-as="loc" t-key="loc.id">
                                <option t-att-value="loc.id"
                                        t-att-selected="state.addProduct.locationId === loc.id"
                                        t-esc="loc.name"/>
                            </t>
                        </select>
                        <t t-if="needsLot">
                            <label class="form-label small mb-0 text-muted">Lote/Serie</label>
                            <input type="text" class="form-control form-control-sm mb-2"
                                   t-att-value="state.addProduct.lotName"
                                   t-on-input="onAddLotInput"/>
                        </t>
                    </div>
                    <div class="card-footer d-flex justify-content-end gap-2">
                        <button type="button" class="btn btn-sm btn-secondary" t-on-click="closeAddProduct">Cancelar</button>
                        <button type="button" class="btn btn-sm btn-primary" t-on-click="confirmAddProduct">Agregar</button>
                    </div>
                </div>
            </t>
        </div>
    </t>
</templates>
