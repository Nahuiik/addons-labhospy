<?xml version="1.0" encoding="utf-8"?>
<odoo>

    
    <record id="inherits_stock_view_invoice_with_stock" model="ir.ui.view">
        <field name="name">stock_pick_view.invoice.with.stock</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="force_invoice_date" invisible="1"/>
            </xpath>
        </field>
    </record>

    <record id="inherit_stock_move_view_invoice_with_stock" model="ir.ui.view">
        <field name="name">stock_move_view.invoice.with.stock</field>
        <field name="model">stock.move</field>
        <field name="inherit_id" ref="stock.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='date']" position="after" >
                <field name="force_invoice_date" invisible="1"/>
            </xpath>
        </field>
    </record>

    <!-- Invoice View -->
    <record id="view_move_form" model="ir.ui.view">
        <field name="name">account.move.form</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_post'][2]" position="replace">
                <button name="action_post"
                        string="Confirm"
                        class="oe_highlight"
                        type="object"
                        data-hotkey="q"
                        context="{'validate_analytic': True, 'disable_abnormal_invoice_detection': False}"
                        groups="account.group_account_invoice"
                        invisible="hide_post_button or move_type == 'entry' or display_inactive_currency_warning"/>
            </xpath>

            <xpath expr="//group[@name='accounting_info_group']" position="after">
                <group string="Picking" name="almightycs_picking_info" invisible="move_type not in ('out_invoice', 'out_refund', 'in_invoice', 'in_refund')">
                    <field name="create_stock_moves" readonly="state != 'draft'"/>
                    <field name="picking_id" readonly="1" invisible="not create_stock_moves"/>
                    <field name="warehouse_id" invisible="not create_stock_moves"/>

                    <field name="acs_location_id" invisible="1"/>
                    <field name="acs_location_dest_id" invisible="1"/>
                </group>
            </xpath>
            
            <xpath expr="//div[@name='journal_div']" position="after">
                <field name="picking_type_id"/>
                
            </xpath>

            <div name="button_box" position="inside">
                 <button type="object" name="action_view_delivery" class="oe_stat_button" icon="fa-truck" invisible="delivery_count == 0" groups="base.group_user">
                    <field name="delivery_count" widget="statinfo" string="Entrega"/>
                </button>
            </div>
        </field>
    </record>


</odoo>
