<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="invetorydashboard">
        <div style="max-height: 100vh; overflow-y: auto; background-color:#fff7fd">
            <div class="mx-5">
                <div class="row gx-0 mt-3">
                    <div class="col-12 d-flex justify-content-end">
                        <button t-on-click="downloadReport" class="btn btn-primary p-2">
                            <i class="fa fa-file-pdf-o p-1" aria-hidden="true"></i> Print
                        </button>
                    </div>
                </div>
            </div>
            <div class="mx-5" id="dashboard">
                <t t-call="InventoryFilters"/>
                <t t-call="InventoryCounters"/>
                <t t-call="InventoryCharts"/>
                <t t-call="InventoryTables"/>
            </div>
        </div>
    </t>

    <t t-name="InventoryFilters">
        <div class="card mt-4 filters">
            <div class="row p-2 m-2 gx-0 gy-2">
                <div class="col-lg-1 d-flex my-auto justify-content-center">
                    <img t-if="state.user_img" t-att-src="'data:image/png;base64,' + state.user_img" class="css-shadow"/>
                </div>
                <div class="col-lg-6 pl-1 my-auto">
                    <h1><t t-esc="state.greetings"/>, <t t-esc="state.user_name"/>.</h1>
                    <h4>Welcome to your Inventory Dashboard.</h4>
                </div>
                <div class="col-lg-5">
                    <div class="row gy-2">
                        <div class="col-lg-4 m-0">
                            <label class="form-label fw-bolder">Products</label>
                            <select class="form-select" t-model="state.selectedProduct" t-on-change="onFilterChange">
                                <option value="all">All Products</option>
                                <t t-if="state.products">
                                    <t t-foreach="state.products" t-as="product" t-key="product.id">
                                        <option t-att-value="product.id"><t t-esc="product.name"/></option>
                                    </t>
                                </t>
                            </select>
                        </div>
                        <div class="col-lg-4 m-0">
                            <label class="form-label fw-bolder">Warehouse</label>
                            <select class="form-select" t-model="state.selectedWarehouse" t-on-change="onFilterChange">
                                <option value="all">All Warehouse</option>
                                <t t-if="state.warehouses">
                                    <t t-foreach="state.warehouses" t-as="warehouse" t-key="warehouse.id">
                                        <option t-att-value="warehouse.id"><t t-esc="warehouse.name"/></option>
                                    </t>
                                </t>
                            </select>
                        </div>
                        <div class="col-lg-4 m-0">
                            <label class="form-label fw-bolder">Date</label>
                            <select class="form-select" t-model="state.selectedDuration" t-on-change="onFilterChange">
                                <option value="0">Today</option>
                                <option value="7">Last 7 Days</option>
                                <option value="28">Last 28 Days</option>
                                <option value="90">Last 90 Days</option>
                                <option value="365">Last 365 Days</option>
                                <option value="all">Lifetime</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>

    <t t-name="InventoryCounters">
        <div class="mt-5 mb-5">
            <div class="row text-center gy-2">
                <div class="col-lg-12">
                    <div class="row mt-2">
                        <div class="col-3">
                            <div class="card box" t-on-click="() => this.openTileAction('order_ship_data')">
                                <div class="card-body box-body">
                                    <h1><t t-esc="state.order_ship_data.length"/></h1>
                                    <h5>Open Picking Orders</h5>
                                </div>
                            </div>
                        </div>
                        <div class="col-3">
                            <div class="card box" t-on-click="() => this.openTileAction('order_due_shipment_data')">
                                <div class="card-body box-body">
                                    <h1><t t-esc="state.order_due_shipment_data.length"/></h1>
                                    <h5>Overdue Picking Orders</h5>
                                </div>
                            </div>
                        </div>
                        <div class="col-3">
                            <div class="card box" t-on-click="() => this.openTileAction('open_po_data')">
                                <div class="card-body box-body">
                                    <h1><t t-esc="state.open_po_data.length"/></h1>
                                    <h5>Awaiting Delivery Orders</h5>
                                </div>
                            </div>
                        </div>
                        <div class="col-3">
                            <div class="card box" t-on-click="() => this.openTileAction('pending_shipment_data')">
                                <div class="card-body box-body">
                                    <h1><t t-esc="state.pending_shipment_data.length"/></h1>
                                    <h5>Overdue Delivery Orders</h5>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row mt-2">
                        <div class="col-3">
                            <div class="card box" t-on-click="() => this.openTileAction('quantity_inhand_data')">
                                <div class="card-body box-body">
                                    <h1><t t-esc="state.quantity_inhand_data"/></h1>
                                    <h5>Total Stock Quantity</h5>
                                </div>
                            </div>
                        </div>
                        <div class="col-3">
                            <div class="card box" t-on-click="() => this.openTileAction('received_quantity_data')">
                                <div class="card-body box-body">
                                    <h1><t t-esc="state.total_received"/></h1>
                                    <h5>Stock to be Received</h5>
                                </div>
                            </div>
                        </div>
                        <div class="col-3">
                            <div class="card box" t-on-click="() => this.openTileAction('out_stock_product_data')">
                                <div class="card-body box-body">
                                    <h1><t t-esc="state.out_stock_product_data.length"/></h1>
                                    <h5>Out of Stock Items</h5>
                                </div>
                            </div>
                        </div>
                        <div class="col-3">
                            <div class="card box" t-on-click="() => this.openTileAction('total_product_data')">
                                <div class="card-body box-body">
                                    <h1><t t-esc="state.total_product_data.length"/></h1>
                                    <h5>Total Products</h5>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>

    <t t-name="InventoryCharts">
        <div class="mt-5">
            <div class="row gy-2">
                <div class="col-lg-6 col-md-6 col-12">
                    <div class="card table-card" style="overflow-x:clip;">
                        <div class="card-header">
                            <div class="row">
                                <div class="col-6">
                                    <label class="form-label fw-bolder">Top Products</label>
                                    <select t-model="state.topMovingProductCount" t-on-change="renderMovingProductChart" class="form-select form-control pull-left">
                                        <option value="5">5</option>
                                        <option value="10">10</option>
                                        <option value="15">15</option>
                                        <option value="20">20</option>
                                    </select>
                                </div>
                                <div class="col-6">
                                    <label class="form-label fw-bolder">Chart Type</label>
                                    <select t-model="state.movingPrdtChartType" t-on-change="renderMovingProductChart" class="form-select form-control pull-left">
                                        <option value="line">Line</option>
                                        <option value="bar">Bar</option>
                                        <option value="pie">Pie</option>
                                        <option value="doughnut">Doughnut</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="card-title text-center p-3" style="font-weight:600; font-size:23px;">
                            <div class="row">
                                <div class="col-2"></div>
                                <div class="col-8">Product Movement Analysis</div>
                                <div class="col-2">
                                    <i class="fa fa-download" style="cursor: pointer;" t-on-click="() => this.downloadChart('topMovingChartRef')"></i>
                                </div>
                            </div>
                        </div>
                        <div class="card-body text-center">
                            <canvas t-ref="topMovingChart" class="bar-chart"/>
                        </div>
                    </div>
                </div>

                <div class="col-lg-6 col-md-6 col-12">
                    <div class="card table-card" style="overflow-x:clip;">
                        <div class="card-title text-center p-3" style="font-weight:600; font-size:23px;">
                            <div class="row">
                                <div class="col-2"></div>
                                <div class="col-8">Stock Availability vs. Reservations by Location</div>
                                <div class="col-2">
                                    <i class="fa fa-download" style="cursor: pointer;" t-on-click="() => this.downloadChart('stockMovingLocationChartRef')"></i>
                                </div>
                            </div>
                        </div>
                        <div class="card-body text-center">
                            <canvas t-ref="stockMovingLocationChart" class="bar2-chart"/>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="mt-5">
            <div class="row gy-2">
                <div class="col-lg-4 col-md-4 col-12">
                    <div class="card table-card" style="overflow-x:clip;">
                        <div class="card-title text-center p-3" style="font-weight:600; font-size:23px;">
                            <div class="row">
                                <div class="col-2"></div>
                                <div class="col-8">Receipts Status Overview</div>
                                <div class="col-2">
                                    <i class="fa fa-download" style="cursor: pointer;" t-on-click="() => this.downloadChart('receiptsChartRef')"></i>
                                </div>
                            </div>
                        </div>
                        <div class="card-body text-center">
                            <canvas t-ref="receiptsChart" class="bar-chart"/>
                        </div>
                    </div>
                </div>
                <div class="col-lg-4 col-md-4 col-12">
                    <div class="card table-card" style="overflow-x:clip;">
                        <div class="card-title text-center p-3" style="font-weight:600; font-size:23px;">
                            <div class="row">
                                <div class="col-2"></div>
                                <div class="col-8">Operations Breakdown</div>
                                <div class="col-2">
                                    <i class="fa fa-download" style="cursor: pointer;" t-on-click="() => this.downloadChart('operationTypeChartRef')"></i>
                                </div>
                            </div>
                        </div>
                        <div class="card-body text-center">
                            <canvas t-ref="operationTypeChart" class="bar-chart"/>
                        </div>
                    </div>
                </div>
                <div class="col-lg-4 col-md-4 col-12">
                    <div class="card table-card" style="overflow-x:clip;">
                        <div class="card-title text-center p-3" style="font-weight:600; font-size:23px;">
                            <div class="row">
                                <div class="col-2"></div>
                                <div class="col-8">Delivery Status Overview</div>
                                <div class="col-2">
                                    <i class="fa fa-download" style="cursor: pointer;" t-on-click="() => this.downloadChart('deliveryChartRef')"></i>
                                </div>
                            </div>
                        </div>
                        <div class="card-body text-center">
                            <canvas t-ref="deliveryChart" class="bar-chart"/>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="mt-5">
            <div class="col-lg-12 col-md-12 col-12">
                <div class="card table-card" style="overflow-x:clip;">
                    <div class="card-title text-center p-3" style="font-weight:600; font-size:23px;">
                        <div class="row">
                            <div class="col-2"></div>
                            <div class="col-8">Inventory Movement Trend</div>
                            <div class="col-2">
                                <i class="fa fa-download" style="cursor: pointer;" t-on-click="() => this.downloadChart('receiptDeliveryChartRef')"></i>
                            </div>
                        </div>
                    </div>
                    <div class="card-body text-center">
                        <canvas t-ref="receiptDeliveryChart" class="bar1-chart"/>
                    </div>
                </div>
            </div>
        </div>
    </t>

    <t t-name="InventoryTables">
        <div class="row mt-4 gy-2">
            <div class='col-lg-6 col-md-6 col-12'>
                <div class="card table-card">
                    <div class="card-header table-header">
                        <span>Out of Stock Products</span>
                    </div>
                    <table class="table table-hover text-center">
                        <thead>
                            <tr>
                                <th>Image</th>
                                <th>Product Name</th>
                                <th>Quantity</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-if="paginatedOutOfStock">
                                <tr t-foreach="paginatedOutOfStock" t-as="item" t-key="item.id">
                                    <td>
                                        <img t-if="item.image_1920" t-att-src="'data:image/jpeg;base64,' + item.image_1920" style="width: 50px; height: 50px;"/>
                                        <span t-else="">-</span>
                                    </td>
                                    <td><t t-esc="item.name"/></td>
                                    <td><t t-esc="item.qty_available"/></td>
                                    <td>
                                        <button class="btn btn-sm" style="background-color: Pink; color: black; margin-right: 4px;" t-on-click="() => this.openAction('Out of Stock Product', 'product.product', item.id)">View</button>
                                        <button class="btn btn-sm btn-light" t-on-click="() => this.createPO(item.id, item.name, item.product_uom)">Create PO</button>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                    <div t-if="Math.ceil(state.outOfStockTotal/state.rowsPerPage) > 0" class="pagination-controls d-flex align-items-center justify-content-center text-primary m-2">
                        <i class="fa fa-chevron-circle-left fa-2x" style="cursor:pointer" t-on-click="() => this.changePage('outOfStock', 'prev')"></i>
                        <span style="font-weight:600; font-size:15px; margin:0px 5px">Page <t t-esc="state.outOfStockPage"/> of <t t-esc="Math.ceil(state.outOfStockTotal/state.rowsPerPage)"/></span>
                        <i class="fa fa-chevron-circle-right fa-2x" style="cursor:pointer" t-on-click="() => this.changePage('outOfStock', 'next')"></i>
                    </div>
                </div>
            </div>

            <div class='col-lg-6 col-md-6 col-12'>
                <div class="card table-card">
                    <div class="card-header table-header">
                        <span>Top Selling Products</span>
                    </div>
                    <table class="table table-hover text-center">
                        <thead>
                            <tr>
                                <th>Image</th>
                                <th>Product Name</th>
                                <th>Quantity</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-if="paginatedSellingProduct">
                                <tr t-foreach="paginatedSellingProduct" t-as="item" t-key="item.id">
                                    <td>
                                        <img t-if="item.image_base64" t-att-src="'data:image/png;base64,' + item.image_base64" style="width: 50px; height: 50px;"/>
                                    </td>
                                    <td><t t-esc="item.name"/></td>
                                    <td><t t-esc="item.sold_qty"/></td>
                                    <td>
                                        <button class="btn btn-sm" style="background-color: Pink; color: black;" t-on-click="() => this.openAction('Selling Products', 'stock.move', item.id)">View</button>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                    <div t-if="Math.ceil(state.sellingProductTotal/state.rowsPerPage) > 0" class="pagination-controls d-flex align-items-center justify-content-center text-primary m-2">
                        <i class="fa fa-chevron-circle-left fa-2x" style="cursor:pointer" t-on-click="() => this.changePage('sellingProduct', 'prev')"></i>
                        <span style="font-weight:600; font-size:15px; margin:0px 5px">Page <t t-esc="state.sellingProductPage"/> of <t t-esc="Math.ceil(state.sellingProductTotal/state.rowsPerPage)"/></span>
                        <i class="fa fa-chevron-circle-right fa-2x" style="cursor:pointer" t-on-click="() => this.changePage('sellingProduct', 'next')"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="row mt-4 gy-2">
            <div class='col-lg-6 col-md-6 col-12'>
                <div class="card table-card">
                    <div class="card-header table-header">
                        <span>Receipts</span>
                    </div>
                    <table class="table table-hover text-center">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Customer</th>
                                <th>Date</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-if="paginatedReceipt">
                                <tr t-foreach="paginatedReceipt" t-as="item" t-key="item.id">
                                    <td><t t-esc="item.name"/></td>
                                    <td>
                                        <t t-if="item.partner_id.length === 2"><t t-esc="item.partner_id[1]"/></t>
                                        <t t-else=""><t t-esc="item.partner_id"/></t>
                                    </td>
                                    <td><t t-esc="formatDate(item.scheduled_date)"/></td>
                                    <td>
                                        <button class="btn btn-sm" style="background-color: Pink; color: black;" t-on-click="() => this.openAction('Receipt', 'stock.picking', item.id)">View</button>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                    <div t-if="Math.ceil(state.receiptTotal/state.rowsPerPage) > 0" class="pagination-controls d-flex align-items-center justify-content-center text-primary m-2">
                        <i class="fa fa-chevron-circle-left fa-2x" style="cursor:pointer" t-on-click="() => this.changePage('receipt', 'prev')"></i>
                        <span style="font-weight:600; font-size:15px; margin:0px 5px">Page <t t-esc="state.receiptPage"/> of <t t-esc="Math.ceil(state.receiptTotal/state.rowsPerPage)"/></span>
                        <i class="fa fa-chevron-circle-right fa-2x" style="cursor:pointer" t-on-click="() => this.changePage('receipt', 'next')"></i>
                    </div>
                </div>
            </div>

            <div class='col-lg-6 col-md-6 col-12'>
                <div class="card table-card">
                    <div class="card-header table-header">
                        <span>Deliveries</span>
                    </div>
                    <table class="table table-hover text-center">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Customer</th>
                                <th>Date</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-if="paginatedDelivery">
                                <tr t-foreach="paginatedDelivery" t-as="item" t-key="item.id">
                                    <td><t t-esc="item.name"/></td>
                                    <td>
                                        <t t-if="item.partner_id.length === 2"><t t-esc="item.partner_id[1]"/></t>
                                        <t t-else=""><t t-esc="item.partner_id"/></t>
                                    </td>
                                    <td><t t-esc="formatDate(item.scheduled_date)"/></td>
                                    <td>
                                        <button class="btn btn-sm" style="background-color: Pink; color: black;" t-on-click="() => this.openAction('Delivery', 'stock.picking', item.id)">View</button>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                    <div t-if="Math.ceil(state.deliveryTotal/state.rowsPerPage) > 0" class="pagination-controls d-flex align-items-center justify-content-center text-primary m-2">
                        <i class="fa fa-chevron-circle-left fa-2x" style="cursor:pointer" t-on-click="() => this.changePage('delivery', 'prev')"></i>
                        <span style="font-weight:600; font-size:15px; margin:0px 5px">Page <t t-esc="state.deliveryPage"/> of <t t-esc="Math.ceil(state.deliveryTotal/state.rowsPerPage)"/></span>
                        <i class="fa fa-chevron-circle-right fa-2x" style="cursor:pointer" t-on-click="() => this.changePage('delivery', 'next')"></i>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>
