    <record id="view_product_template_inherite_form" model="ir.ui.view">
        <field name="name">product.template.inherite.form</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="account.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Purchase History" invisible="purchase_ok == False">
                    <field name="history_ids" modifiers="{&quot;readonly&quot;: [[&quot;edit_purchase_history&quot;, &quot;=&quot;, false]]}">
                        <list string="History" editable="top">
                            <field name="po_order"/>
                            <field name="partner_id"/>
                            <field name="order_date"/>
                            <field name="price"/>
                            <field name="qty"/>
                            <field name="remark"/>
                            <field name="exclude_from_sale_price"/>
                        </list>
                    </field>
                </page>
                <page string="Sale History">
                    <field name="history_sale_ids" modifiers="{&quot;readonly&quot;: [[&quot;edit_purchase_history&quot;, &quot;=&quot;, false]]}">
                        <list string="History" editable="top">
                            <field name="sale_order"/>
                            <field name="partner_id"/>
                            <field name="order_date"/>
                            <field name="price"/>
                            <field name="qty"/>
                            <field name="remark"/>
                            <field name="exclude_from_sale_price"/>
                        </list>
                    </field>
                </page>
            </xpath>
            <xpath expr="//field[@name='property_account_expense_id']" position="after">
                <field name="edit_purchase_history" invisible="1"/>
            </xpath>
        </field>
    </record>

