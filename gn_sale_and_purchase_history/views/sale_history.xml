<?xml version="1.0"?>
<odoo>
        <record id="product_sale_history_view_tree" model="ir.ui.view">
             <field name="name">product.sale.view.list</field>
             <field name="model">sale.history</field>
                <field name="arch" type="xml">
                    <list string="Product History">
                        <field name="sale_order"/>
                        <field name="partner_id"/>
                        <field name="order_date"/>
                        <field name="price"/>
                        <field name="qty"/>
                        <field name="remark"/>
                        <field name="exclude_from_sale_price"/>
                    </list>
             	</field>
        </record>
        
        
        <record id="sale_order_manager_view_form" model="ir.ui.view">
             <field name="name">product.sale.history.view.form</field>
             <field name="model">sale.history</field>
                <field name="arch" type="xml">
                    <form string="Product History">
					    <field name="partner_id"/>
                        <field name="order_date"/>
                        <field name="qty"/>
                    </form>
             	</field>
        </record>
        
</odoo>
