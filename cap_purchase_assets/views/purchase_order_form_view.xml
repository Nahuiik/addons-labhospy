<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="cap_purchase_order_form_view_inherit" model="ir.ui.view">
            <field name="name">cap_purchase_order_form_view_inherit</field>
            <field name="inherit_id" ref="purchase.purchase_order_form"/>
            <field name="model">purchase.order</field>
            <field name="arch" type="xml">
                <xpath expr="//button[@name='action_view_invoice']" position="after">
                    <button name="action_show_assets" string="" class="oe_stat_button" type="object" icon="fa-id-card-o" invisible="number_of_asset_ids == 0" >
                        <field name="number_of_asset_ids" widget="statinfo" string="Assets"/>
                    </button>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
