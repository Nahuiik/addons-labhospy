<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_gn_qif_journal_knowledge_list" model="ir.ui.view">
        <field name="name">gn.qif.journal.knowledge.list</field>
        <field name="model">gn.qif.journal.knowledge</field>
        <field name="arch" type="xml">
            <list string="Conocimiento QIF por diario">
                <field name="journal_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="bank_id" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_gn_qif_journal_knowledge_form" model="ir.ui.view">
        <field name="name">gn.qif.journal.knowledge.form</field>
        <field name="model">gn.qif.journal.knowledge</field>
        <field name="arch" type="xml">
            <form string="Conocimiento QIF">
                <sheet>
                    <group>
                        <field name="journal_id"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="bank_id"/>
                    </group>
                    <field name="user_notes" widget="html" nolabel="1" colspan="2"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_gn_qif_journal_knowledge" model="ir.actions.act_window">
        <field name="name">Conocimiento QIF por diario</field>
        <field name="res_model">gn.qif.journal.knowledge</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_gn_qif_journal_knowledge"
              name="Conocimiento QIF (IA)"
              parent="account.account_transactions_menu"
              action="action_gn_qif_journal_knowledge"
              sequence="91"/>

</odoo>
