<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hn_retention_monthly_wizard_form" model="ir.ui.view">
        <field name="name">hn.retention.monthly.wizard.form</field>
        <field name="model">hn.retention.monthly.wizard</field>
        <field name="arch" type="xml">
            <form string="Resumen retenciones">
                <group>
                    <field name="company_id" groups="base.group_multi_company"/>
                    <field name="year"/>
                    <field name="month"/>
                </group>
                <footer>
                    <button name="action_print_pdf" type="object" string="Imprimir PDF" class="btn-primary"/>
                    <button name="action_print_html" type="object" string="Vista HTML" class="btn-secondary"/>
                    <button name="action_export_xlsx" type="object" string="Exportar Excel" class="btn-secondary"/>
                    <button special="cancel" string="Cerrar" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_hn_retention_monthly_wizard" model="ir.actions.act_window">
        <field name="name">Resumen mensual de retenciones</field>
        <field name="res_model">hn.retention.monthly.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_hn_retention_monthly"
              name="Resumen retenciones (mes)"
              parent="account.menu_finance_reports"
              action="action_hn_retention_monthly_wizard"
              sequence="96"/>
</odoo>
