<odoo>
    <data>
        <!-- Template principal (contenido del reporte) -->
        <template id="report_employee_declaration_document">
            <t t-call="web.basic_layout">
               
                <div class="float-left" style="width: 100%; overflow: hidden;">
                    <!-- Logo -->
                    <div style="float: left; width: 30%;">
                        <t t-if="not o.company_id.header_memb">
                            <img t-if="o.company_id.logo"
                                t-att-src="'data:image/png;base64,%s' % to_text(o.company_id.logo)"
                                style="width: 100px; border-radius: 10px;" />
                        </t>
                    </div>

                    <!-- Información de la compañía -->
                    <div style="float: right; width: 68%; text-align: right;">
                        <t t-if="not o.company_id.header_memb">
                            <strong style="font-size: 16px;"><span t-field="o.company_id.name"/></strong><br/>
                            Dirección: <span t-field="o.company_id.street"/><br/>
                            Teléfono: <span t-field="o.company_id.phone"/><br/>
                            Email: <span t-field="o.company_id.email"/><br/>
                        </t>
                    </div>
                </div>
                <hr t-if="not o.company_id.header_memb"/>

                <div class="page" style="font-size:20px;  padding-right: 50px;padding-left: 50px;  font-family:sans-serif;">
                    <br/>
                    <br/>
                    
                    <h1 style="text-align: center; font-size: 24px; margin-top: 80px;"><strong>CONSTANCIA LABORAL</strong></h1>
                    <p style="text-align: justify; font-size: 20px; line-height: 2.0; margin-top: 60px;">
                     Por medio de la presente <strong><span t-field="o.company_id.name"/></strong>, hace constar que <strong><span t-field="o.employee_id.name"/></strong>,
                     con número de identidad <strong><span t-field="o.employee_id.identification_id"/></strong> labora para esta empresa desde el 
                     <strong><span t-field="o.date_start_text"/></strong> desempeñando el cargo de <strong><span t-field="o.job_id.name"/></strong> devengando un salario mensual de  
                     <strong><span t-field="o.wage_in_words"/> (<span t-field="o.wage"/>)</strong> del cual se aplican las siguientes deducciones:</p>

                     <table width="100%" style="border: 1px solid black; font-size: 16px;" class="table table-bordered">
                     <t t-set="total_deducciones" t-value="0"/>
                        <tr style="border: 1px solid black;">
                            
                            <td >
                                <strong>Descripción</strong>
                            </td>
                            <td >
                                <strong>Monto</strong>
                            </td>
                            
                        </tr>
                        <tr style="border: 1px solid black;">
                            
                            <td >
                                <strong>Seguro Social (IHSS)</strong>
                            </td>
                            <td>
                                <span t-field="o.ihss_fee" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                            </td>
                            
                        </tr>
                        <t t-set="total_deducciones" t-value="o.ihss_fee + o.rap_fee + o.afp_atlantida_amount"/>
                        
                        <tr t-if="o.isr_fee or o.amount_isr_manual" style="border: 1px solid black;">
                            
                            <td >
                                <strong>Impuesto sobre la renta (ISR)</strong>
                            </td>
                            <td>
                                <t t-if="o.isr_manual">
                                    <t t-if="o.amount_isr_manual" >
                                        <span t-field="o.amount_isr_manual" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                        <t t-set="total_deducciones" t-value="o.ihss_fee + o.amount_isr_manual + o.rap_fee + o.afp_atlantida_amount"/>
                                    </t>
                                    <t t-if="not o.amount_isr_manual" >
                                        <t t-if="o.isr_fee" >
                                            <span t-field="o.isr_fee" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                            <t t-set="total_deducciones" t-value="o.ihss_fee + o.isr_fee + o.rap_fee + o.afp_atlantida_amount"/>
                                        </t>
                                    </t>
                                </t>
                                <t t-if="o.isr_manual == False">
                                    <t t-if="o.isr_fee" >
                                        <span t-field="o.isr_fee" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                        <t t-set="total_deducciones" t-value="o.ihss_fee + o.isr_fee + o.rap_fee + o.afp_atlantida_amount"/>
                                    </t>
                                </t>
                                
                            </td>
                            
                        </tr>
                        <tr style="border: 1px solid black;">
                            
                            <td >
                                <strong>Regimen de aportaciones (RAP)</strong>
                            </td>
                            <td>
                                <span t-field="o.rap_fee" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                            </td>
                            
                        </tr>
                        <tr t-if="o.afp_atlantida_amount" style="border: 1px solid black;">
                            <td >
                                <strong>AFP Atlántida</strong>
                            </td>
                            <td>
                                <span t-field="o.afp_atlantida_amount" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                            </td>
                        </tr>

                        <tr style="border: 1px solid black;">
                            <td >
                                <strong>TOTAL</strong>
                            </td>
                            <td>
                                <span t-esc="total_deducciones" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                            </td>
                            
                        </tr>
                        
                     </table>
                    <p style="text-align: justify; font-size: 20px; line-height: 2.0; margin-top: 30px;">
                    Y para los fines correspondientes se extiende la presente constancia en la ciudad de Tegucigalpa, M. D. C. el <t t-esc="o.get_today_in_words()"/>.
                    </p>

                    <div style="float: left; width: 750px; height: 300px; text-align: center;">
                        <div t-if="o.hr_responsible_id.signature" t-raw="o.hr_responsible_id.signature"/>
                    </div>
                    

                </div>
            </t>
        </template>

        <template id="report_employee_declaration">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-set="lang" t-value="o.company_id.partner_id.lang or 'es_ES'"/>
                    <t t-call="gn_l10n_employee.report_employee_declaration_document" t-lang="lang"/>
                </t>
            </t>
        </template>    
    </data>
</odoo>
