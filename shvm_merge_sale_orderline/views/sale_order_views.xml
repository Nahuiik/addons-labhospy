<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="sale_order_merge_button_view" model="ir.ui.view">
        <field name="name">sale.order.merge.button.view</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='action_quotation_send']" position="before">
                <button name="action_merge_order_line" invisible="state == 'cancel'" type="object" string="Merge Duplicate Lines" class="btn-primary"/>
            </xpath>
        </field>
    </record>
</odoo>