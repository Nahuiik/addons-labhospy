<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="sale_ir_config_view" model="ir.ui.view">
        <field name="name">sale.ir.config.view</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='quotation_order_setting_container']/setting[@id='proforma_configuration']"
                   position="after">
                <div class="col-12 col-lg-6 o_setting_box" id="merge_sale_line_configuration">
                    <div class="o_setting_left_pane">
                        <field name="sale_merge_duplicate_line"/>
                    </div>
                    <div class="o_setting_right_pane">
                        <label for="sale_merge_duplicate_line"/>
                        <div class="text-muted">
                            Auto merge duplicate line in sale order when create or edit
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>