<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="order_lines" name="Sale Order Data">
            <div t-if="doc.project_title" class="row mb-2" t-attf-style="color:{{style.theme_txt_color if not style.transparent else style.text_color}};">
                <div t-attf-style="background-color:{{style.theme_color if not style.transparent else 'transparent'}};">
                    <span t-attf-style="font-size:{{int(style.body_font)+4}}px;">
                        <span t-field="doc.project_title"/>
                    </span>
                </div>
            </div>
            <!-- Is there a discount on at least one line? -->
            <t t-set="lines_to_report" t-value="doc._get_order_lines_to_report()"/>
            <t t-set="display_discount" t-value="any(l.discount for l in lines_to_report)"/>
            <!-- Is there tax on at least one line? -->
            <t t-set="display_taxes" t-value="any([y.tax_ids for y in doc.order_line])"/>
            <!-- To take care of columns when no discount -->
            <t t-set="col_span" t-value="8"/>
            <t t-set="total_qty_product" t-value="0"/>
            <table class="table" t-attf-style="color:{{style.text_color}}; border: none;">
                <thead>
                    <tr t-attf-style="page-break-inside:avoid !important;border-bottom:2px solid #7d7b7b; font-size:{{int(style.body_font)+2}}px;background-color:{{style.theme_color if not style.transparent else 'transparent'}} !important;color:{{style.theme_txt_color if not style.transparent else style.text_color}};">
                        <th class="text-center" style="border: none;"><i class="fa fa-list-ol"/> <strong><br/> Item </strong></th>
                        <th class="text-center" style="border: none;" t-if="style.show_img"><i class="fa fa-camera"/><br/> <strong> Image </strong></th>
                        <th class="text-center" style="border: none;"><i class="fa fa-th-large"/><br/>  <strong> Descripción </strong></th>
                        <th class="text-center" style="border: none;"><i class="fa fa-th-list"/><br/> <strong> Serie / Lote: </strong></th>
                        <th class="text-center" style="border: none;"><i class="fa fa-sort-amount-asc"/><br/> <strong> Cantidad </strong></th>
                        <th class="text-center" style="border: none;"><i class="fa fa-tags"/><br/> <strong> PU </strong></th>
                        <th class="text-center" style="border: none;"><i class="fa fa-minus-square"/><br/> <strong> Desc(%)</strong></th>
                        <th t-if="display_taxes" class="text-center" style="border: none;"><i class="fa fa-pencil-square"/> <br/><strong> ISV </strong></th>
                        <th class="text-center" style="border: none;"><i class="fa fa-money"/> <br/><strong> Total </strong></th>
                    </tr>
                </thead>
                <tbody>
                    <t t-set="current_subtotal" t-value="0"/>
                    <t t-set="item_count" t-value="0"/>
                    <t t-set="discount_line" t-value="0"/>
                    <t t-set="discount_total" t-value="0"/>
                    <t t-foreach="lines_to_report" t-as="l">
                        <t t-set="item_count" t-value="item_count + 1"/>
                        <t t-set="total_qty_product" t-value="total_qty_product + l.product_uom_qty"/>

                        <t t-set="current_subtotal" t-value="current_subtotal + l.price_subtotal"/>
                        <tr t-attf-style="border-top:1px solid #d0d0d0;border-bottom:1px solid #d0d0d0;background-color:{{style.odd if (l_parity in 'odd' and not style.transparent) else (not style.transparent and style.even) or 'transparent'}}; page-break-inside: avoid" t-att-class="'fw-bold o_line_section' if l.display_type == 'line_section' else 'fst-italic o_line_note' if l.display_type == 'line_note' else ''">
                            <t t-if="not l.display_type">
                                <td style="border: none;">
                                    <span t-esc="item_count"/>
                                </td>
                                <td style="border: none;" t-if="style.show_img">
                                    <img t-if="l.product_image" t-att-src="image_data_uri(l.product_image)" alt=""/>
                                    <img t-if="not l.product_image and l.product_id.image_128" t-att-src="image_data_uri(l.product_id.image_128)" alt=""/>
                                </td>
                                <td style="border: none;">
                                    <span t-out="l._get_report_line_description()"/>
                                    <t t-if="l.product_id.gn_labhospy_catalog_code">
                                        <br/>CATALOGO: <span t-field="l.product_id.gn_labhospy_catalog_code"/>
                                    </t>
                                    <t t-if="l.product_id.gn_labhospy_model">
                                        <br/>MODELO: <span t-field="l.product_id.gn_labhospy_model"/>
                                    </t>
                                    <t t-set="outgoing_pickings" t-value="doc.picking_ids.filtered(lambda p: p.picking_type_code == 'outgoing' and p.state != 'cancel')"/>
                                    <t t-set="line_moves" t-value="outgoing_pickings.move_ids.filtered(lambda m: m.sale_line_id == l and m.product_id == l.product_id and m.state != 'cancel')"/>
                                </td>     
                                <td class="text-center" style="border: none;">
                                    <t t-set="serial_numbers" t-value="line_moves.move_line_ids.mapped('lot_id.name')"/>   
                                    <t t-if="serial_numbers">
                                        <span t-esc="', '.join([sn for sn in serial_numbers if sn])"/>
                                    </t>
                                </td>
                                <td class="text-center" style="border: none;">
                                    <span t-field="l.product_uom_qty"/>
                                    <span t-if="l._fields.get('product_packaging_id') and l.product_packaging_id">
                                        (                                        <span t-field="l.product_packaging_qty" t-options='{"widget": "integer"}'/>
                                        <span t-field="l._fields.get('product_packaging_id') and l.product_packaging_id"/>
)
                                    </span>
                                </td>
                                <td class="text-end" style="border: none;">
                                    <span t-field="l.price_unit" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                </td>
                                <td class="text-center" style="border: none;">
                                    <span t-field="l.discount"/>
                                    <t t-set="discount_line" t-value="l.product_uom_qty * l.price_unit * (l.discount/100)"/>
                                    <t t-set="discount_total" t-value="discount_total + discount_line"/>
                                </td>
                                <td t-if="display_taxes" class="text-center" style="border: none;">
                                    <span t-esc="', '.join(map(lambda x: (x.display_name or x.name), l.tax_ids))"/>
                                </td>
                                <td t-if="not l.is_downpayment" class="text-end" style="border: none;">
                                    <span t-field="l.price_subtotal"/>
                                </td>
                            </t>
                            <t t-elif="l.display_type == 'line_section'">
                                <td t-att-colspan="col_span">
                                    <span t-field="l.name"/>
                                </td>
                                <t t-set="current_section" t-value="l"/>
                                <t t-set="current_subtotal" t-value="0"/>
                                <t t-set="item_count" t-value="0"/>
                            </t>
                            <t t-elif="l.display_type == 'line_note'">
                                <td t-att-colspan="col_span">
                                    <span t-field="l.name"/>
                                </td>
                                <t t-set="item_count" t-value="item_count - 1"/>
                            </t>
                        </tr>
                        <t t-if="current_section and (l_last or doc.order_line[l_index+1].display_type == 'line_section') and not l.is_downpayment">
                            <tr class="is-subtotal text-end">
                                <td t-att-colspan="col_span">
                                    <strong class="mr16">Subtotal</strong>
                                    <span t-out="current_subtotal" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'
                                        />
</td>
</tr>
</t>
</t>
</tbody>
</table>
<div class="d-flex justify-content-between col-12" style="width:100%">
                                        <div class="col-8" style="padding-left:0; padding-right:0; page-break-inside: avoid;">
                                            <div style="font-size:14px;">
                                                <strong style="white-space:nowrap;">Total de Articulos:</strong>
                                                <span t-esc="total_qty_product"/>
                                            </div>
                                            <p t-if="style.aiw_report">
                                                <strong>Amount in Words: </strong>
                                                <span style="text-decoration:underline;" t-field="doc.amount_in_words"/>
                                            </p>
                                            <p t-if="doc.payment_term_id.note">
                                                <span t-field="doc.payment_term_id.note"/>
                                            </p>
                                            <p t-if="doc.incoterm">
                                                <strong>Shipping:</strong>
                                                <span t-field="doc.incoterm"/>
                                            </p>
                                            <p id="payment_term" t-if="not doc.payment_term_id and doc.partner_id.property_payment_term_id">
                                                <span t-field="doc.partner_id.property_payment_term_id.note"/>
                                            </p>

                                            <p t-if="doc.fiscal_position_id.note">
                                                <strong>Fiscal Position Remark:</strong>
                                                <span t-field="doc.fiscal_position_id.note"/>
                                            </p>
                                            <p t-if="doc.note">
                                                <span t-field="doc.note"/>
                                            </p>
                                        </div>
                                        <div class="col-4" style="page-break-inside: avoid;">
                                            <div id="total" class="row">
                                                <div class="col-12 ms-auto">
                                                    <table class="table table-sm table-borderless" t-attf-style="color:{{style.text_color}};">
                                                        <tr t-attf-style="border-top: 1px solid {{style.text_color}};">
                                                            <td t-attf-style="border-top: 1px solid {{style.text_color}} !important;">
                                                                <strong>Subtotal</strong>
                                                            </td>
                                                            <td class="text-end" t-attf-style="border-top: 1px solid {{style.text_color}} !important;">
                                                                <span t-field="doc.amount_untaxed"/>
                                                            </td>
                                                        </tr>
                                                        <tr t-esc="exonerate_amount">
                                                            <td>Importe Exonerado</td>
                                                            <td class="text-end">
                                                                <span t-field="doc.exonerate_amount" t-options="{'widget': 'monetary', 'display_currency': doc.pricelist_id.currency_id}"/>
                                                            </td>
                                                        </tr>
                                                        <tr t-esc="exempt_sale_amount">
                                                            <td>Importe Exento</td>
                                                            <td class="text-end">
                                                                <span t-field="doc.exempt_sale_amount" t-options="{'widget': 'monetary', 'display_currency': doc.pricelist_id.currency_id}"/>

                                                            </td>
                                                        </tr>
                                                        <tr>
                                                            <td>Importe Gravado 15%</td>
                                                            <td class="text-end">
                                                                <span t-field="doc.amount_tax_15_per" t-options="{'widget': 'monetary', 'display_currency': doc.pricelist_id.currency_id}"/>

                                                            </td>
                                                        </tr>
                                                        <tr>
                                                            <td>ISV 15%</td>
                                                            <td class="text-end">
                                                                <span t-field="doc.amount_tax" t-options="{'widget': 'monetary', 'display_currency': doc.pricelist_id.currency_id}"/>
                                                            </td>
                                                        </tr>
                                                        <tr>
                                                            <td>Descuentos y rebajas otorgados</td>
                                                            <td class="text-end">
                                                                <span t-esc="discount_total" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                                            </td>
                                                        </tr>
                                                        <tr t-attf-style="border-bottom: 1px solid {{style.text_color}};">
                                                            <td t-attf-style="border-top: 1px solid {{style.text_color}} !important;">
                                                                <strong>Total</strong>
                                                            </td>
                                                            <td class="text-end" t-attf-style="border-top: 1px solid {{style.text_color}} !important;">
                                                                <span style="font-weight:bold; text-decoration:underline;" t-field="doc.amount_total"/>
                                                            </td>
                                                        </tr>
                                                        <tr t-if="doc.currency_rate != 1 and doc.currency_rate != 0" t-attf-style="border-bottom: 1px solid {{style.text_color}};">
                                                            <td t-attf-style="border-top: 1px solid {{style.text_color}} !important;">
                                                                <strong>Tasa de Cambio (L)</strong>
                                                            </td>
                                                            <td class="text-end" t-attf-style="border-top: 1px solid {{style.text_color}} !important;">
                                                                <span style="font-weight:bold; text-decoration:underline;" t-esc="'{:.4f}'.format(doc.currency_rate)"/>
                                                            </td>
                                                        </tr>
                                                        <tr t-if="doc.currency_rate != 1 and doc.currency_rate != 0" t-attf-style="border-bottom: 1px solid {{style.text_color}};">
                                                            <td t-attf-style="border-top: 1px solid {{style.text_color}} !important;">
                                                                <strong>Total en Moneda Local</strong>
                                                            </td>
                                                            <td class="text-end" t-attf-style="border-top: 1px solid {{style.text_color}} !important;">
                                                                <span style="font-weight:bold; text-decoration:underline;" t-field="doc.amount_local" t-options="{'widget': 'monetary', 'display_currency': doc.company_id.currency_id}"/>
                                                            </td>
                                                        </tr>
                                                        <t t-set="posted_invoices" t-value="doc.invoice_ids.filtered(lambda inv: inv.state == 'posted')"/>
                                                        <t t-if="posted_invoices">
                                                            <t t-set="amount_due" t-value="sum(inv.amount_residual for inv in posted_invoices)"/>
                                                            <tr t-attf-style="border-bottom: 1px solid {{style.text_color}};">
                                                                <td t-attf-style="border-top: 1px solid {{style.text_color}} !important;">
                                                                    <strong>Amount Due</strong>
                                                                </td>
                                                                <td class="text-end" t-attf-style="border-top: 1px solid {{style.text_color}} !important;">
                                                                    <span style="font-weight:bold; text-decoration:underline;" t-esc="amount_due" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: doc.pricelist_id.currency_id}"/>
                                                                </td>
                                                            </tr>
                                                        </t>
                                                    </table>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div t-if="doc.signature" class="row mt32" name="signature" style="page-break-inside: avoid !important;">
                                        <div class="offset-8 col-4">
                                            <strong>Signature</strong>
                                        </div>
                                        <div class="offset-8 col-4">
                                            <img t-att-src="image_data_uri(doc.signature)" style="max-height: 4cm; max-width: 8cm;"/>
                                        </div>
                                        <div class="offset-8 col-4 text-center">
                                            <p t-field="doc.signed_by"/>
                                        </div>
                                    </div>
                                    <div class="col-12 float-left" t-if="doc._fields.get('sale_order_option_ids') and doc.sale_order_option_ids and doc.state in ['draft', 'sent']" style="padding-left:0px; padding-right:0px; page-break-inside: avoid !important;">
                                        <t t-set="has_option_discount" t-value="any(doc._fields.get('sale_order_option_ids') and doc.sale_order_option_ids.filtered(lambda o: o.discount != 0.0))" />
                                        <h4>
                                            <span>Productos Opcionales</span>
                                        </h4>
                                        <table class="table table-sm" t-attf-style="color:{{style.text_color}};">
                                            <thead t-attf-style="background-color:{{style.theme_color if not style.transparent else 'transparent'}} !important; page-break-inside: avoid; color:{{style.theme_txt_color if not style.transparent else style.text_color}};">
                                                <tr t-attf-style="page-break-inside: avoid !important; border-bottom: 1px solid {{style.text_color}} !important;font-size:{{int(style.body_font)+2}}px;">
                                                    <th class="text-left">
                                                        <i class="fa fa-th-large"/>
 Description</th>
                                                    <th t-if="has_option_discount" class="text-left"> Discount(%)</th>
                                                    <th class="text-end">
                                                        <i class="fa fa-tags"/>
 Unit Price</th>
                                                </tr>
                                            </thead>
                                            <tbody class="sale_tbody">
                                                <tr t-foreach="doc._fields.get('sale_order_option_ids') and doc.sale_order_option_ids" t-as="opt" t-attf-style="background-color:{{style.odd if (opt_parity in 'odd' and not style.transparent) else (not style.transparent and style.even) or 'transparent'}}; page-break-inside: avoid">
                                                    <td>
                                                        <span t-field="opt.name"/>
                                                    </td>
                                                    <td t-if="has_option_discount">
                                                        <strong t-if="opt.discount != 0.0">
                                                            <t t-esc="((opt.discount % 1) and '%s' or '%d') % opt.discount"/>
%
                                                        </strong>
                                                    </td>
                                                    <td>
                                                        <strong class="text-end">
                                                            <div t-field="opt.price_unit" t-options='{"widget": "monetary", "display_currency": doc.pricelist_id.currency_id}' t-att-style="opt.discount and 'text-decoration: line-through' or None" t-att-class="opt.discount and 'text-danger' or None"/>
                                                            <div t-if="opt.discount">
                                                                <t t-esc="'%.2f' % ((1 - opt.discount / 100.0) * opt.price_unit)"/>
                                                            </div>
                                                        </strong>
                                                    </td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                    <div class="col-12" style="margin-top:90px;">
                                        <div class="row">
                                            <div class="col-4"></div>
                                            <div class="col-4" style="text-align:center;border-top:1px solid #000;">Aceptado por el Cliente</div>
                                            <div class="col-4"></div>
                                        </div>
                                    </div>

                                </template>
                            </data>
                        </odoo>
