<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="document_tax_totals" inherit_id="account.document_tax_totals" name="Tax Totals">
            <xpath expr="//tr[hasclass('o_total')]" position="attributes">
                <attribute name="class"></attribute>
            </xpath>
            <xpath expr="//tr[hasclass('o_subtotal')]" position="attributes">
                <attribute name="class"></attribute>
            </xpath>
        </template>

        <template id="report_dn_lines_has_serial" inherit_id="stock.stock_report_delivery_has_serial_move_line" name="DN lines - Has Serial">
            <xpath expr="//td[1]" position="before">
                <t t-if="style.template_dn.key != 'professional_templates.DN_5_document'"> <!-- Do not include Odoo template-->
                    <td class="text-center"><span t-esc="move_line_index + 1"/></td>
                    <td t-if="style.show_img">
                        <span t-if="move_line.product_id" itemprop="image" t-field="move_line.product_id.image_128" t-options='{"widget": "image"}'/>
                    </td>
                </t>
            </xpath>
        </template>

        <template id="report_dn_lines_aggregated" inherit_id="stock.stock_report_delivery_aggregated_move_lines" name="DN lines - Aggregated">
            <!-- <xpath expr="//td[1]" position="before">
                <t t-if="style.template_dn.key != 'professional_templates.DN_5_document'">  
                    <td  class="text-center"><span t-esc="line_index + 1"/></td>
                    <td t-if="style.show_img">
                    </td>
                </t>
            </xpath> -->
            <xpath expr="//tr[1]" position="replace">
                <tr t-attf-style="border-bottom: 1px solid #adadad;background-color:{{style.odd if (line_parity in 'odd' and not style.transparent) else (not style.transparent and style.even)  or 'transparent'}}; page-break-inside:avoid !important;" t-foreach="aggregated_lines" t-as="line">
                    <td style="border:none;">
                        <span t-out="aggregated_lines[line]['name']"/>
                        <p t-if="aggregated_lines[line]['description']">
                            <span t-esc="aggregated_lines[line]['description']"  t-options="{'widget': 'text'}"/>
                        </p>
                    </td>
                    <t t-if="style.template_dn.key != 'professional_templates.DN_5_document'">  <!-- Do not include Odoo template-->
                        <td style="border:none;"  class="text-center"><span t-esc="line_index + 1"/></td>
                        <td style="border:none;" t-if="style.show_img">
                            <!-- <span t-esc="aggregated_lines[line]['image']" itemprop="image"  t-options='{"widget": "image"}'/> -->
                        </td>
                    </t>
                    <td style="border:none;" t-if="has_multi_level_packages">
                        <t t-if="aggregated_lines[line].get('package') and aggregated_lines[line]['package'] != package">
                            <span t-if="aggregated_lines[line]['package_history']" t-out="aggregated_lines[line]['package_history']._get_complete_dest_name_except_outermost()"/>
                            <span t-else="" t-out="aggregated_lines[line]['package'].name"/>
                        </t>
                    </td>
                    <td class="text-end" name="move_line_aggregated_qty_ordered" style="border:none;">
                        <span t-out="format_number(aggregated_lines[line]['qty_ordered'])"/>
                        <span t-out="aggregated_lines[line]['product_uom'].name"/>
                        <t t-if="aggregated_lines[line]['packaging_uom_id'] != aggregated_lines[line]['product_uom']" groups="uom.group_uom">
                            <br/>
                            <span class="text-muted" t-out="aggregated_lines[line]['packaging_qty_ordered']">1.00</span>
                            <span class="text-muted" t-out="aggregated_lines[line]['packaging_uom_id'].name">Pack of 6</span>
                        </t>
                    </td>
                    <td class="text-end" name="move_line_aggregated_quantity" style="border:none;"  >
                        <t t-if="aggregated_lines[line]['quantity']">
                            <span t-out="format_number(aggregated_lines[line]['quantity'])"/>
                            <span t-out="aggregated_lines[line]['product_uom'].name"/>
                            <t t-if="aggregated_lines[line]['packaging_uom_id'] != aggregated_lines[line]['product_uom']" groups="uom.group_uom">
                                <br/>
                                <span class="text-muted" t-out="aggregated_lines[line]['packaging_quantity']">1.00</span>
                                <span class="text-muted" t-out="aggregated_lines[line]['packaging_uom_id'].name">Pack of 6</span>
                            </t>
                        </t>
                    </td>
                </tr>
            </xpath>
        </template>

        <template id="delivery_lines" name="Lineas de Entrega">
            <table t-if="o.state!='done'" class="table table-sm" t-attf-style="color:{{style.text_color}};" >
                <thead>
                    <tr t-attf-style="border-top:2px solid #d0d0d0;border-bottom:2px solid #d0d0d0; font-size:{{int(style.body_font)+2}}px;page-break-inside:avoid !important;background-color:{{style.theme_color  if not style.transparent else 'transparent'}}; color:{{style.theme_txt_color  if not style.transparent else style.text_color}};">
                        <th style="border:none;"><i class="fa fa-list-ol"/> <strong>Articulo</strong></th>
                        <th t-if="style.show_img" style="border:none;"><i class="fa fa-camera"/> <strong>Imagen del Producto</strong></th>
                        <th style="border:none;"><i class="fa fa-th-large"/> <strong>Descripcion</strong></th>
                        <th style="border:none;"><i class="fa fa-pencil"/> <strong>Ordenado</strong></th>
                        <th style="border:none;"><i class="fa fa-truck"/> <strong>Entregado</strong></th>
                    </tr>
                </thead>
                <tbody>
                    <t t-set="lines" t-value="o.move_ids.filtered(lambda x: x.product_uom_qty)"/>
                    <tr t-foreach="lines" t-as="move" t-attf-style="background-color:{{style.odd if (move_parity in 'odd' and not style.transparent) else (not style.transparent and style.even)  or 'transparent'}}; page-break-inside: avoid !important;">
                        <td><span t-esc="move_index + 1"/></td>
                        <td t-if="style.show_img"><img t-if="move.product_id.image_128" t-att-src="image_data_uri(move.product_id.image_128)" alt=""/></td>
                        <td>
                            <span t-field="move.product_id"/>
                            <p t-if="move.description_picking != move.product_id.name and move.description_picking != move.product_id.display_name">
                                <span t-field="move.description_picking"/>
                            </p>
                        </td>
                        <td class="text-end">
                            <span t-field="move.product_uom_qty"/>
                            <span t-field="move.product_uom"/>
                                    <span t-if="move._fields.get('product_packaging_id') and move.product_packaging_id">
                                        (<span t-field="move._fields.get('product_packaging_qty') and move.product_packaging_qty" t-options='{"widget": "integer"}'/> <span t-field="move._fields.get('product_packaging_id') and move.product_packaging_id"/>)
                                    </span>
                        </td>
                        <td class="text-end">
                            <span t-field="move.quantity"/>
                            <span t-field="move.product_uom"/>
                                    <span t-if="move._fields.get('product_packaging_id') and move.product_packaging_id">
                                        (<span t-field="move._fields.get('product_packaging_quantity') and move.product_packaging_quantity" t-options='{"widget": "integer"}'/> <span t-field="move._fields.get('product_packaging_id') and move.product_packaging_id"/>)
                                    </span>
                        </td>
                    </tr>
                </tbody>
            </table>
            <t t-set="backorder" t-value="False"/>
            <table t-if="o.move_line_ids and o.state=='done'" name="stock_move_line_table" class="table table-sm" t-attf-style="color:{{style.text_color}};" >
                <t t-set="format_number" t-value="lambda x: int(x) if x == int(x) else x"/>
                <t t-set="has_serial_number" t-value="False"/>
                <t t-set="has_serial_number" t-value="o.move_line_ids.mapped('lot_id')" groups="stock.group_lot_on_delivery_slip"/>
                <t t-set="packages" t-value="o.move_line_ids.mapped('result_package_id')"/>
                <thead>
                    <tr t-attf-style="font-size:{{int(style.body_font)+2}}px;border-bottom:2px solid #d0d0d0; page-break-inside: avoid !important;background-color:{{style.theme_color if not style.transparent else 'transparent'}};color:{{style.theme_txt_color  if not style.transparent else style.text_color}};">
                        <th class="text-center" style="border:none;"><i class="fa fa-list-ol"/> <strong>Articulo</strong></th>
                        <th class="text-center" t-if="style.show_img" style="border:none;"><i class="fa fa-camera"/> <strong>Imagen</strong></th>
                        <th class="text-center" style="border:none;"><i class="fa fa-th-large"/> <strong>Producto</strong></th>
                        <th class="text-center" t-if="has_serial_number" style="border:none;"><i class="fa fa-tag"/> <strong>Lote/Numero de Serie</strong></th>
                        <th class="text-center" t-if="not has_serial_number" style="border:none;"><i class="fa fa-pencil"/> <strong>Ordenado</strong></th>
                        <th class="text-center" style="border:none;"><i class="fa fa-truck"/> <strong>Entregado</strong></th>
                    </tr>
                </thead>
                <tbody>
                    <t t-if="packages" name="has_packages">
                        <t t-foreach="packages" t-as="package">
                            <t t-call="stock.stock_report_delivery_package_section_line"/>
                            <t t-set="package_move_lines" t-value="o.move_line_ids.filtered(lambda l: l.result_package_id == package)"/>
                                <!-- If printing lots/serial numbers => keep products in original lines -->
                            <t t-if="has_serial_number">
                                <tr t-foreach="package_move_lines" t-attf-style="border-bottom: 1px solid #adadad;background-color:{{style.odd if (line_parity in 'odd' and not style.transparent) else (not style.transparent and style.even)  or 'transparent'}}; page-break-inside:avoid !important;" t-as="move_line">
                                    <!-- <t t-call="stock.stock_report_delivery_has_serial_move_line"/> -->
                                    <td style="border:none;">
                                        <span t-field="move_line.product_id"/>
                                        <!-- this is an annoying workaround for the multiple types of descriptions (often auto-filled) that we do not want to print -->
                                        <!-- this makes it so we can pre-filter the descriptions in inherited templates since we cannot extend the standard "if" condition -->
                                        <!-- let's agree that pre-filtered descriptions will be set to "" -->
                                        <t t-if="not description and description != ''">
                                            <t t-set="description" t-value="move_line.move_id.description_picking"/>
                                        </t>
                                        <p t-if="description != '' and
                                                description != move_line.product_id.display_name and
                                                description != move_line.product_id.name"
                                        >
                                            <span t-out="description" t-options="{'widget': 'text'}"/>
                                        </p>
                                    </td>
                                    <td style="border:none;" t-if="has_multi_level_packages">
                                        <t t-if="move_line.result_package_id != package">
                                            <span t-if="move_line.package_history_id" t-out="move_line.package_history_id._get_complete_dest_name_except_outermost()"/>
                                            <span t-else="" t-field="move_line.result_package_id"/>
                                        </t>
                                    </td>
                                    <t t-if="has_serial_number" name="move_line_lot">
                                        <td class="text-end" style="border:none;"><span t-field="move_line.lot_id.name"/></td>
                                    </t>
                                    <td class="text-end" name="move_line_lot_quantity" style="border:none;">
                                        <span t-out="format_number(move_line.quantity)"/>
                                        <span t-field="move_line.product_uom_id"/>
                                    </td>
                                </tr>
                            </t>
                            <!-- If not printing lots/serial numbers => merge lines with same product+description+uom -->
                            <t t-else="">
                                <t t-set="aggregated_lines" t-value="package_move_lines._get_aggregated_product_quantities(strict=True)"/>
                                <t t-call="stock.stock_report_delivery_aggregated_move_lines"/>
                            </t>
                        </t>
                        <!-- Make sure we do another section for package-less products if they exist -->
                        <t t-set="move_lines" t-value="o.move_line_ids.filtered(lambda l: not l.result_package_id)"/>
                        <t t-set="aggregated_lines" t-value="o.move_line_ids._get_aggregated_product_quantities(except_package=True)"/>
                        <t t-if="move_lines or aggregated_lines" name="no_package_move_lines">
                            <t t-call="stock.stock_report_delivery_no_package_section_line" name="no_package_section"/>
                            <t t-if="has_serial_number">
                                <tr t-foreach="move_lines" t-as="move_line">
                                    <t t-call="stock.stock_report_delivery_has_serial_move_line"/>
                                </tr>
                            </t>
                            <t t-elif="aggregated_lines">
                                <t t-call="stock.stock_report_delivery_aggregated_move_lines"/>
                            </t>
                        </t>
                    </t>
                    <!-- No destination packages -->
                    <t t-else="">
                        <!-- If printing lots/serial numbers => keep products in original lines -->
                        <t t-if="has_serial_number">
                            <tr t-foreach="o.move_line_ids" t-as="move_line">
                                <t t-call="stock.stock_report_delivery_has_serial_move_line"/>
                            </tr>
                        </t>
                        <!-- If not printing lots/serial numbers => merge lines with same product -->
                        <t t-else="" name="aggregated_move_lines">
                            <t t-set="aggregated_lines" t-value="o.move_line_ids._get_aggregated_product_quantities()"/>
                            <t t-call="stock.stock_report_delivery_aggregated_move_lines"/>
                        </t>
                    </t>
                </tbody>
            </table>

            <!--BACKORDERS -->
            <t t-set="backorders" t-value="o.backorder_ids.filtered(lambda x: x.state not in ('done', 'cancel'))"/>
            <t t-if="o.backorder_ids and backorders">
                <p class="mt-5">
                    <span>Remaining quantities not yet delivered:</span>
                </p>
                <table class="table table-sm" name="stock_backorder_table" t-attf-style="color:{{style.text_color}};table-layout: fixed;">
                    <thead>
                        <tr t-attf-style="font-size:{{int(style.body_font)+2}}px;page-break-inside:avoid !important;background-color:{{style.theme_color  if not style.transparent else 'transparent'}}; color:{{style.theme_txt_color  if not style.transparent else style.text_color}};">
                            <th><i class="fa fa-list-ol"/> Articulo</th>
                            <th name="th_sb_product"><i class="fa fa-th-large"/> Producto</th>
                            <th/>
                            <th name="th_sb_quantity" class="text-center"><i class="fa fa-pencil"/> Quantity</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="backorders" t-as="backorder">
                            <t t-set="bo_lines" t-value="backorder.move_ids.filtered(lambda x: x.product_uom_qty)"/>
                            <tr t-foreach="bo_lines" t-as="bo_line" t-attf-style="background-color:{{style.odd if (bo_line_parity in 'odd' and not style.transparent) else (not style.transparent and style.even)  or 'transparent'}}; page-break-inside: avoid !important;">
                                <td><span t-esc="bo_line_index + 1"/></td>
                                <td class="w-auto">
                                    <span t-field="bo_line.product_id"/>
                                    <p t-if="bo_line.description_picking != bo_line.product_id.name and bo_line.description_picking != bo_line.product_id.display_name">
                                        <span t-field="bo_line.description_picking"/>
                                    </p>
                                </td>
                                <td/>
                                <td class="text-center w-auto">
                                    <span t-field="bo_line.product_uom_qty"/>
                                    <span t-field="bo_line.product_uom"/>
                                </td>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </t>
            <div t-if="o.signature" class="mt-2 ml-4 mr-2" name="signature">
                <div class="offset-8">
                    <strong>Signature</strong>
                </div>
                <div class="offset-8">
                    <img t-att-src="image_data_uri(o.signature)" style="max-height: 4cm; max-width: 8cm;"/>
                </div>
                <div class="offset-8 text-center">
                    <p t-field="o.partner_id.name"/>
                </div>
            </div>
        </template>
    </data>
</odoo>
