<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="rfq_lines" name="Datos de Cotizacion">
            <table class="table table-sm" t-attf-style="color:{{style.text_color}}; border:none;" >
                <thead>
                    <tr t-attf-style="border-bottom:2px solid #7d7b7b; page-break-inside:avoid !important;font-size:{{int(style.body_font)+2}}px;background-color:{{style.theme_color if not style.transparent else 'transparent'}};color:{{style.theme_txt_color if not style.transparent else style.text_color}};">
                        <th style="border:none;"><i class="fa fa-list-ol"/> <strong>Articulo</strong></th>
                        <th style="border:none;"><i class="fa fa-th-large"/> <strong>Descripcion</strong></th>
                        <th class="text-center" style="border:none;"><i class="fa fa-calendar"/> <strong>Fecha Esperada</strong></th>
                        <th class="text-end" style="border:none;"><i class="fa fa-sort-amount-asc"/> <strong>Cantidad</strong></th>
                    </tr>
                </thead>
                <tbody>
                    <t t-foreach="o.order_line" t-as="line">
                        <tr class="" t-attf-style="border-bottom: 1px solid #adadad;background-color:{{tyle.odd if (line_parity in 'odd' and not style.transparent) else (not style.transparent and style.even)  or 'transparent'}; page-break-inside: avoid !important;">
                            <t t-if="not line.display_type">
                                <td style="border: none;"><span t-esc="line_index + 1"/></td>
                                <td style="border: none;">
                                    <span t-field="line.product_id.name"/>
                                    <t t-if="line.product_id.gn_labhospy_catalog_code">
                                        | CATALOGO: <span t-field="line.product_id.gn_labhospy_catalog_code"/>
                                    </t>
                                    <t t-if="line.product_id.gn_labhospy_model">
                                        | MODELO: <span t-field="line.product_id.gn_labhospy_model"/>
                                    </t>
                                </td>
                                <td class="text-center" style="border: none;">
                                    <span t-field="line.date_planned"/>
                                </td>
                                <td class="text-end" style="border: none;">
                                    <span t-field="line.product_qty"/>
                                    <span t-field="line.product_uom_id" groups="uom.group_uom"/>
                                </td>
                            </t>
                            <t t-else="">
                                <td colspan="99" id="section">
                                    <span t-field="line.name"/>
                                </td>
                            </t>
                        </tr>
                    </t>
                </tbody>
            </table>
            <div class="col-12">
                <t t-set="order_note" t-value="('notes' in o._fields and o.notes) or ('note' in o._fields and o.note)"/>
                    <p t-if="order_note">
                        <span t-esc="order_note"/>
                    </p>
            </div>
            <div class="col-12" style="margin-top:90px;">
                <div class="row">
                    <div class="col-4"></div>
                    <div class="col-4" style="text-align:center;border-top:1px solid #000;">Autorización de Compras</div>
                    <div class="col-4"></div>
                </div>
            </div>
        </template>
    </data>
</odoo>
