<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="invoice_lines">

            <!-- Is there a discount on at least one line? -->
            <t t-set="display_discount" t-value="any([l.discount for l in o.invoice_line_ids])"/>
            <!-- Is there tax in at least one line? -->
            <t t-set="display_taxes" t-value="any([y.tax_ids for y in o.invoice_line_ids])"/>
            <!-- to take care of columns when no discount -->
            <t t-set="col_span" t-value="8"/>
            <table class="table" t-attf-style="color:{{style.text_color}}; border: none;">
                <thead>
                    <tr t-attf-style="border-bottom:2px solid #7d7b7b;background-color:{{style.theme_color if not style.transparent else 'transparent'}};font-size:{{int(style.body_font)+2}}px;color:{{style.theme_txt_color if not style.transparent else style.text_color}};">
                        <th class="text-center" style="border: none;">
                            <i class="fa fa-list-ol"/> <strong>Item</strong>
                        </th>
                        <th t-if="style.show_img" style="border: none;">
                            <i class="fa fa-camera"/> <strong>Image</strong>
                        </th>
                        <th class="text-center" style="border: none;">
                            <i class="fa fa-th-large"/> <br/><strong>Descripción</strong>
                        </th>
                        <th class="text-center" style="border: none;">
                            <i class="fa fa-th-list"/> <br/><strong>Serie / Lote:</strong>
                        </th>
                        <!-- <th class="d-none text-left"><i class="fa fa-th-large"/> Source Document</th> -->
                        <th class="text-center" style="border: none;">
                            <i class="fa fa-sort-amount-asc"/> <strong>Cant.</strong>
                        </th>
                        <th class="text-center" style="border: none;">
                            <i class="fa fa-tags"/> <br/><strong>PU</strong>
                        </th>
                        <th class="text-center" style="border: none;">
                            <i class="fa fa-minus-square"/> <strong>Desc(%)</strong>
                        </th>
                        <th t-if="display_taxes" class="text-center" style="border: none;">
                            <i class="fa fa-pencil-square"/> <strong>Impuestos</strong>
                        </th>
                        <th class="text-center" style="border: none;">
                            <i class="fa fa-money"/> <strong>Monto</strong>
                        </th>
                    </tr>
                </thead>
                <tbody class="invoice_tbody">
                    <t t-set="current_subtotal" t-value="0"/>
                    <t t-set="current_total" t-value="0"/>
                    <t t-set="discount_total" t-value="0"/>
                    <t t-set="discount_line" t-value="0"/>
                    <t t-set="item_count" t-value="0"/>
                    <t t-set="total_items" t-value="0"/>
                    <t t-set="lines" t-value="o.invoice_line_ids.sorted(key=lambda l: (-l.sequence, l.date, l.move_name, -l.id), reverse=True)"/>
                    <t t-foreach="lines" t-as="l">
                        <t t-set="item_count" t-value="item_count + 1"/>
                        <t t-set="total_items" t-value="total_items + l.quantity"/>
                        <t t-set="current_subtotal" t-value="current_subtotal + l.price_subtotal"/>
                        <t t-set="current_total" t-value="current_total + l.price_total"/>
                        <tr t-attf-style="border-bottom: 1px solid #adadad; background-color:{{style.odd if (l_parity in 'odd' and not style.transparent) else (not style.transparent and style.even)  or 'transparent'}};page-break-inside: avoid" t-att-class="'fw-bold o_line_section' if l.display_type == 'line_section' else 'fst-italic o_line_note' if l.display_type == 'line_note' else ''">
                            <t t-if="l.display_type == 'product'" name="account_invoice_line_accountable">
                                <td class="text-center" style="border: none;">
                                    <span t-esc="item_count"/>
                                </td>
                                <td t-if="style.show_img" style="border: none;">
                                    <span t-if="l.sudo().product_id.image_128" itemprop="image" t-field="l.sudo().product_id.image_128" t-options='{"widget": "image"}'/>
                                </td>
                                <td style="border: none;">
                                    [<span t-field="l.product_id.code"/>] <span t-field="l.product_id.name"/>
                                    <t t-if="l.product_id.gn_labhospy_catalog_code">
                                        <br/>CATALOGO: <span t-field="l.product_id.gn_labhospy_catalog_code"/>
                                    </t>
                                    <t t-if="l.product_id.gn_labhospy_model">
                                        <br/>MODELO: <span t-field="l.product_id.gn_labhospy_model"/>
                                    </t>
                                </td>
                                <td style="border: none;" class="text-center">
                                    <t t-set="inv_serial_numbers" t-value="l.sale_line_ids.move_ids.move_line_ids.mapped('lot_id.name')"/>
                                    <t t-if="inv_serial_numbers">
                                        <span t-esc="', '.join([sn for sn in inv_serial_numbers if sn])"/>
                                    </t>
                                </td>
                                <td class="text-center" style="border: none;">
                                    <span t-field="l.quantity"/>
                                    <span t-field="l.product_uom_id" groups="uom.group_uom"/>
                                </td>
                                <td t-attf-class="text-end {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}" style="border: none;">
                                    <span t-field="l.price_unit" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}" />
                                </td>
                                <td t-attf-class="text-center {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}" style="border: none;">
                                    <span class="text-nowrap" t-field="l.discount"/>
                                    <t t-set="discount_line" t-value="l.quantity * l.price_unit * (l.discount/100)"/>
                                    <t t-set="discount_total" t-value="discount_total + discount_line"/>
                                </td>
                                <td t-if="display_taxes" t-attf-class="text-center {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}" style="border: none;">
                                    <!-- <span t-esc="', '.join(map(lambda x: (x.description or x.name), l.tax_ids))"/> -->
                                    <span t-out="', '.join(map(lambda x: (x.invoice_label or x.name), l.tax_ids))" id="line_tax_ids">Tax 15%</span>
                                </td>
                                <td class="text-end" style="border: none;">
                                    <span class="text-nowrap" t-field="l.price_subtotal"/>
                                </td>
                            </t>
                            <t t-if="l.display_type == 'line_section'">
                                <td t-att-colspan="col_span">
                                    <span t-field="l.name" t-options="{'widget': 'text'}"/>
                                </td>
                                <t t-set="current_section" t-value="l"/>
                                <t t-set="current_subtotal" t-value="0"/>
                                <t t-set="item_count" t-value="0"/>
                            </t>
                            <t t-if="l.display_type == 'line_note'">
                                <td t-att-colspan="col_span">
                                    <span t-field="l.name" t-options="{'widget': 'text'}"/>
                                </td>
                                <t t-set="item_count" t-value="item_count - 1"/>
                            </t>
                        </tr>
                        <t t-if="current_section and (l_last or lines[l_index+1].display_type == 'line_section')">
                            <tr class="is-subtotal text-end">
                                <td t-att-colspan="col_span">
                                    <strong class="mr16">Subtotal</strong>
                                    <span t-esc="current_subtotal" t-options='{"widget": "monetary", "display_currency": o.currency_id}'
                                            />
                                </td>
                            </tr>
                        </t>
                    </t>
                    <tr>
                        <td colspan="8" style="text-align:center; border-bottom: 1px solid #adadad; ">-----------ULTIMA LINEA------------</td>
                    </tr>

                </tbody>
            </table>
            <div class="d-flex justify-content-between col-12" style="width:100%">
                                        <!-- Left section -->
                                        <div t-if="style.aiw_report" class="col-8" style="padding-left:0; padding-right:0; page-break-inside: avoid;">
                                            <br/>
                                            <p>
                                                <strong>Total de Articulos:</strong>
                                                <span style="text-decoration:underline;" t-esc="total_items"/>
                                            </p>
                                            <p>
                                                <strong>Cantidad en letras:</strong>
                                                <span style="text-decoration:underline;" t-field="o.amount_in_words"/>
                                            </p>
                                            <table class="table table-sm table-borderless" t-attf-style="color:{{style.text_color}};width:100%">
                                                <tr>
                                                    <td>
                                                        <strong>Nº Compra exenta:</strong>
                                                        <span style="text-decoration:underline;" t-field="o.exempt_purchase_no"/>
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td>
                                                        <strong>N° Constancia Exonerada:</strong>
                                                        <span style="text-decoration:underline;" t-field="o.constancy_exonerated_record"/>
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td>
                                                        <strong>Nº Registro del SAG:</strong>
                                                        <span style="text-decoration:underline;" t-field="o.reg_of_sag"/>
                                                    </td>
                                                </tr>
                                            </table>

