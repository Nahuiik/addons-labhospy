                                        </div>

                                        <!-- Right section -->
                                        <div class="col-4" style="page-break-inside: avoid;">
                                            <div id="total" class="row">
                                                <div class="col-12 ms-auto">
                                                    <table class="table table-sm table-borderless" t-attf-style="color:{{style.text_color}};">
                                                        <!-- Tax totals and other rows -->
                                                        <tr class="border-black" t-attf-style="border-top: 1px solid {{style.text_color}};">
                                                            <td>
                                                                <strong>Subtotal</strong>
                                                            </td>
                                                            <td class="text-end">
                                                                <span t-field="o.amount_untaxed"/>
                                                            </td>
                                                        </tr>
                                                        <tr>
                                                            <td>Importe Exonerado</td>
                                                            <td class="text-end">
                                                                <span t-field="o.exonerate_amount" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                                            </td>
                                                        </tr>
                                                        <!-- Add other rows as needed here -->
                                                        <tr t-esc="exempt_sale_amount">
                                                            <td>Importe Exento</td>
                                                            <td class="text-end">
                                                                <span t-field="o.exempt_sale_amount" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>

                                                            </td>
                                                        </tr>
                                                        <tr>
                                                            <td>Importe Gravado 18%</td>
                                                            <td class="text-end">
                                                                <span t-field="o.amount_tax_18_per" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>

                                                            </td>
                                                        </tr>
                                                        <tr>
                                                            <td>Importe Gravado 15%</td>
                                                            <td class="text-end">
                                                                <span t-field="o.amount_tax_15_per" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>

                                                            </td>
                                                        </tr>
                                                        <tr>
                                                            <td>ISV 18%</td>
                                                            <td class="text-end">
                                                                <span t-field="o.tax_18_per" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>

                                                            </td>
                                                        </tr>
                                                        <tr>
                                                            <td>ISV 15%</td>
                                                            <td class="text-end">
                                                                <span t-field="o.amount_tax" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                                            </td>
                                                        </tr>
                                                        <tr>
                                                            <td>Descuentos y rebajas otorgados</td>
                                                            <td class="text-end">
                                                                <span t-esc="discount_total" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                                            </td>
                                                        </tr>

                                                        <tr class="border-black" t-attf-style="border-top: 1px solid {{style.text_color}};">
                                                            <td t-attf-style="border-top: 1px solid {{style.text_color}} !important;">
                                                                <strong>Total</strong>
                                                            </td>
                                                            <td class="text-end" t-attf-style="border-top: 1px solid {{style.text_color}} !important;">
                                                                <span style="font-weight:bold; text-decoration:underline;" t-field="o.amount_total"/>
                                                            </td>
                                                        </tr>
                                                        <tr t-if="o.currency_rate != 1 and o.currency_rate != 0" class="border-black" t-attf-style="border-top: 1px solid {{style.text_color}};">
                                                            <td t-attf-style="border-top: 1px solid {{style.text_color}} !important;">
                                                                <strong>Tasa de Cambio (L)</strong>
                                                            </td>
                                                            <td class="text-end" t-attf-style="border-top: 1px solid {{style.text_color}} !important;">
                                                                <span style="font-weight:bold; text-decoration:underline;" t-esc="'{:.4f}'.format(o.currency_rate)"/>
                                                            </td>
                                                        </tr>
