<odoo>
    <data>
        <record id="view_account_invoice__inherit_customized" model="ir.ui.view">
            <field name="name">account.move.customized</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <field name="invoice_date" position="after">
                    <field name="style" invisible="1"/>
                </field>
                <xpath expr="//field[@name='narration']" position="attributes">
					<attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//field[@name='narration']" position="before">
                    <field string="Cantidad en Letras" name="amount_in_words"/>
                    <field name="narration" colspan="8" placeholder="Términos y Condiciones" nolabel="1"/>
                </xpath>
            </field>
        </record>
        <record id="account.report_invoice_document" model="ir.ui.view">
            <field name="name">Odoo Invoice</field>
        </record>
    </data>
</odoo>
