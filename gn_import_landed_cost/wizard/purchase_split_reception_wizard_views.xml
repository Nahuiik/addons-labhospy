<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_purchase_split_reception_wizard_form" model="ir.ui.view">
        <field name="name">purchase.split.reception.wizard.form</field>
        <field name="model">purchase.split.reception.wizard</field>
        <field name="arch" type="xml">
            <form string="Dividir recepción en dos pickings">
                <sheet>
                    <group>
                        <field name="purchase_id" readonly="1"/>
                        <field name="picking_id" readonly="1"
                               options="{'no_open': True}"/>
                        <field name="available_picking_ids" invisible="1"/>
                    </group>
                    <p class="text-muted">
                        Indique cuánto va en la <strong>Recepción 1</strong> (el
                        picking actual) y cuánto en la <strong>Recepción 2</strong>
                        (un nuevo picking que se creará). Al confirmar, ambas
                        recepciones podrán registrar gastos adicionales
                        independientes.
                    </p>
                    <field name="line_ids">
                        <list editable="bottom" create="false" delete="false">
                            <field name="product_id" readonly="1"/>
                            <field name="product_uom_id" readonly="1"/>
                            <field name="total_qty" readonly="1"/>
                            <field name="qty_first"/>
                            <field name="qty_second"/>
                            <field name="qty_balance" readonly="1"
                                   decoration-danger="qty_balance != 0"/>
                        </list>
                    </field>
                </sheet>
                <footer>
                    <button name="action_confirm" type="object"
                            string="Confirmar división" class="btn-primary"/>
                    <button special="cancel" string="Cancelar" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
