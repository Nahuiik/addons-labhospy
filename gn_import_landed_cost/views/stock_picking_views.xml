<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_stock_picking_form_import_expenses" model="ir.ui.view">
        <field name="name">stock.picking.form.import.expenses</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_gn_import_landed_costs"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-cubes"
                        invisible="gn_import_landed_cost_count == 0">
                    <field name="gn_import_landed_cost_count" widget="statinfo"
                           string="Costos destino"/>
                </button>
            </xpath>
            <xpath expr="//sheet/notebook" position="inside">
                <page string="Gastos adicionales importación"
                      name="gn_import_extra_costs"
                      invisible="picking_type_code != 'incoming' or not purchase_id">
                    <div class="alert alert-info" role="alert"
                         invisible="not gn_import_reception_split">
                        <span>Este picking es parte de una recepción dividida
                              (<field name="gn_import_reception_part" readonly="1" nolabel="1"/>).
                        </span>
                    </div>
                    <field name="gn_import_extra_cost_line_ids">
                        <list editable="bottom">
                            <field name="expense_type"/>
                            <field name="product_id"/>
                            <field name="name"/>
                            <field name="amount" sum="Total"/>
                            <field name="split_method"/>
                            <field name="vendor_bill_id"/>
                            <field name="landed_cost_line_id" readonly="1" optional="hide"/>
                            <field name="currency_id" column_invisible="1"/>
                        </list>
                    </field>
                    <div class="text-end mt-2">
                        <button name="action_gn_import_sync_landed_cost"
                                type="object"
                                string="Sincronizar con costo en destino"
                                class="btn-primary"
                                invisible="state != 'done' or not gn_import_extra_cost_line_ids"/>
                    </div>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
