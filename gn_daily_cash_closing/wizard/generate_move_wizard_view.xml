<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="ir.ui.view" id="gn_cash_closing_generate_move_wizard_form">
        <field name="name">gn.cash.closing.generate.move.wizard.form</field>
        <field name="model">gn.cash.closing.generate.move.wizard</field>
        <field name="arch" type="xml">
            <form string="Generar Asiento de Cierre">
                <sheet>
                    <group col="2">
                        <group>
                            <field name="closing_id" invisible="1"/>
                            <field name="company_id" invisible="1"/>
                            <field name="cash_journal_id" readonly="1"/>
                            <field name="amount_efectivo" readonly="1"/>
                            <field name="amount_anticipos" readonly="1"/>
                        </group>
                        <group>
                            <field name="bank_journal_id"
                                   domain="[('type', '=', 'bank')]"
                                   options="{'no_create': True}"/>
                        </group>
                    </group>
                    <group string="Depósitos del día (solo lectura)" col="1">
                        <field name="deposit_move_ids" nolabel="1" readonly="1">
                            <list create="0" edit="0" delete="0">
                                <field name="name"/>
                                <field name="date"/>
                                <field name="ref"/>
                                <field name="journal_id"/>
                            </list>
                        </field>
                    </group>
                </sheet>
                <footer>
                    <button name="action_create_move" type="object"
                            string="Crear Asiento" class="oe_highlight"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
