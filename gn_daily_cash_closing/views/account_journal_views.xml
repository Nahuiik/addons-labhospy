<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_journal_form_inherit_cash_closing" model="ir.ui.view">
        <field name="name">account.journal.form.inherit.cash.closing</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='advanced_settings']/group/group[1]" position="inside">
                <field name="branch_id" options="{'no_create': True}"
                       string="Sucursal"
                       groups="gts_branch_management.group_branch_user_manager"/>
            </xpath>
        </field>
    </record>
</odoo>
