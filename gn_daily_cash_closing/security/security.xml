<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="group_cash_closing_supervisor" model="res.groups">
            <field name="name">Supervisor Cierre de Caja</field>
            <field name="comment">Permite ver y seleccionar todas las sucursales en el reporte de Cierre de Caja Diario</field>
            <field name="implied_ids" eval="[(4, ref('account.group_account_user'))]"/>
        </record>
        <record id="group_cash_closing_generate" model="res.groups">
            <field name="name">Generar Cierre de Caja</field>
            <field name="comment">Permite generar el reporte PDF de Cierre de Caja Diario</field>
            <field name="implied_ids" eval="[(4, ref('account.group_account_user'))]"/>
        </record>
        <record id="group_cash_closing_edit" model="res.groups">
            <field name="name">Editar Cierre de Caja</field>
            <field name="comment">Permite editar remesas y observaciones en registros de Cierre de Caja</field>
            <field name="implied_ids" eval="[(4, ref('account.group_account_user'))]"/>
        </record>
        <record id="group_cash_closing_restore_draft" model="res.groups">
            <field name="name">Restablecer Cierre a Borrador</field>
            <field name="comment">Permite restablecer a borrador un cierre anulado</field>
            <field name="implied_ids" eval="[(4, ref('gn_daily_cash_closing.group_cash_closing_edit'))]"/>
        </record>
        <record id="group_cash_closing_venta_diaria" model="res.groups">
            <field name="name">Descargar Venta Diaria</field>
            <field name="comment">Permite descargar el reporte PDF Venta Diaria desde el wizard Cierre Inicial a Ciegas</field>
            <field name="implied_ids" eval="[(4, ref('gn_daily_cash_closing.group_cash_closing_generate'))]"/>
        </record>
    </data>
</odoo>
