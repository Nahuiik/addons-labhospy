<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_traceability_export_wizard" model="ir.ui.view">
        <field name="name">traceability.export.wizard.form</field>
        <field name="model">traceability.export.wizard</field>
        <field name="arch" type="xml">
            <form string="Exportar trazabilidad">
                <group>
                    <field name="product_id"/>
                    <field name="lot_id"/>
                    <field name="date_from"/>
                    <field name="date_to"/>
                    <field name="export_type" widget="radio"/>
                </group>
                <footer>
                    <button name="action_export" type="object" string="Exportar" class="btn-primary"/>
                    <button string="Cancelar" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
