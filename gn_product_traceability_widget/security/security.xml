<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_traceability_user" model="res.groups">
        <field name="name">Ver trazabilidad de productos</field>
        <field name="privilege_id" ref="stock.res_groups_privilege_inventory"/>
        <field name="implied_ids" eval="[(4, ref('stock.group_stock_user'))]"/>
    </record>

    <record id="group_traceability_export" model="res.groups">
        <field name="name">Exportar trazabilidad de productos</field>
        <field name="privilege_id" ref="stock.res_groups_privilege_inventory"/>
        <field name="implied_ids" eval="[(4, ref('gn_product_traceability_widget.group_traceability_user'))]"/>
    </record>

    <record id="group_traceability_cost" model="res.groups">
        <field name="name">Ver costos en trazabilidad</field>
        <field name="privilege_id" ref="stock.res_groups_privilege_inventory"/>
        <field name="implied_ids" eval="[(4, ref('stock.group_stock_manager'))]"/>
    </record>

    <!-- Stock users can open traceability by default -->
    <record id="stock.group_stock_user" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('gn_product_traceability_widget.group_traceability_user'))]"/>
    </record>
    <record id="stock.group_stock_manager" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('gn_product_traceability_widget.group_traceability_export'))]"/>
    </record>
</odoo>
