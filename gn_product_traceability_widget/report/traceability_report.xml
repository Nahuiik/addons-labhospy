<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_traceability_report_pdf" model="ir.actions.report">
        <field name="name">Trazabilidad de producto PDF</field>
        <field name="model">product.product</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">gn_product_traceability_widget.traceability_pdf</field>
        <field name="report_file">gn_product_traceability_widget.traceability_pdf</field>
        <field name="print_report_name">'Trazabilidad_%s' % (object.display_name)</field>
        <field name="group_ids" eval="[(4, ref('gn_product_traceability_widget.group_traceability_export'))]"/>
    </record>

    <record id="action_traceability_report_xlsx" model="ir.actions.report">
        <field name="name">Trazabilidad de producto Excel</field>
        <field name="model">product.product</field>
        <field name="report_type">xlsx</field>
        <field name="report_name">gn_traceability.traceability_xlsx</field>
        <field name="report_file">gn_traceability.traceability_xlsx</field>
        <field name="print_report_name">'Trazabilidad_%s' % (object.display_name)</field>
        <field name="group_ids" eval="[(4, ref('gn_product_traceability_widget.group_traceability_export'))]"/>
    </record>
</odoo>
