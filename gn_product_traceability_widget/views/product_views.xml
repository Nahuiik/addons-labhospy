<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_traceability" model="ir.ui.view">
        <field name="name">product.template.form.traceability</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button type="object"
                        name="action_open_traceability"
                        class="oe_stat_button"
                        icon="fa-random"
                        groups="gn_product_traceability_widget.group_traceability_user"
                        invisible="not is_storable">
                    <field name="traceability_move_count" widget="statinfo" string="Trazabilidad"/>
                </button>
            </div>
        </field>
    </record>

    <record id="product_product_form_traceability" model="ir.ui.view">
        <field name="name">product.product.form.traceability</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button type="object"
                        name="action_open_traceability"
                        class="oe_stat_button"
                        icon="fa-random"
                        groups="gn_product_traceability_widget.group_traceability_user">
                    <field name="traceability_move_count" widget="statinfo" string="Trazabilidad"/>
                </button>
            </div>
        </field>
    </record>
</odoo>
