<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ficohsa_pos_import_history_list" model="ir.ui.view">
        <field name="name">ficohsa.pos.import.history.list</field>
        <field name="model">ficohsa.pos.import.history</field>
        <field name="arch" type="xml">
            <list string="Historial importaciones FICOHSA POS" create="0" delete="0" edit="0">
                <field name="create_date" string="Fecha"/>
                <field name="name"/>
                <field name="user_id"/>
                <field name="import_mode"/>
                <field name="bank_journal_id"/>
                <field name="file_count"/>
                <field name="liquidaciones_creadas"/>
                <field name="operaciones_previstas"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_ficohsa_pos_import_history_form" model="ir.ui.view">
        <field name="name">ficohsa.pos.import.history.form</field>
        <field name="model">ficohsa.pos.import.history</field>
        <field name="arch" type="xml">
            <form string="Importación FICOHSA POS" create="0" delete="0" edit="0">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="create_date"/>
                            <field name="user_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="import_mode"/>
                            <field name="bank_journal_id"/>
                            <field name="file_count"/>
                            <field name="liquidaciones_creadas"/>
                            <field name="operaciones_previstas"/>
                        </group>
                    </group>
                    <group string="Archivos">
                        <field name="files_summary" nolabel="1" colspan="2"/>
                    </group>
                    <group string="Resumen">
                        <field name="result_message" nolabel="1" colspan="2" widget="text"/>
                    </group>
                    <notebook>
                        <page string="Huellas de archivo (anti-duplicado)">
                            <field name="log_line_ids" nolabel="1">
                                <list create="0" delete="0" edit="0">
                                    <field name="file_name"/>
                                    <field name="file_hash"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_ficohsa_pos_import_history_search" model="ir.ui.view">
        <field name="name">ficohsa.pos.import.history.search</field>
        <field name="model">ficohsa.pos.import.history</field>
        <field name="arch" type="xml">
            <search string="Historial FICOHSA POS">
                <field name="name"/>
                <field name="user_id"/>
                <field name="import_mode"/>
                <field name="bank_journal_id"/>
                <filter name="batch" string="Lote" domain="[('import_mode', '=', 'batch')]"/>
                <filter name="single" string="Un archivo" domain="[('import_mode', '=', 'single')]"/>
                <group>
                    <filter name="grp_user" string="Usuario" context="{'group_by': 'user_id'}"/>
                    <filter name="grp_mode" string="Modo" context="{'group_by': 'import_mode'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_ficohsa_pos_import_history" model="ir.actions.act_window">
        <field name="name">Historial de importaciones FICOHSA POS</field>
        <field name="res_model">ficohsa.pos.import.history</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_ficohsa_pos_import_history_search"/>
        <field name="context">{}</field>
    </record>
</odoo>
