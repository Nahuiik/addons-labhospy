#. module: gts_coa_hierarchy
#: model:ir.module.module,description:gts_coa_hierarchy.__manifest__
msgid ""
" Chart of Accounts with hierarchy.\n"
"        This module create parent and child relation in account"
msgstr ""
" Plan de Cuentas con jerarquía.\n"
"        Este módulo crea relaciones padre e hijo en las cuentas"

