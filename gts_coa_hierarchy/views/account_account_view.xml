<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Note: In Odoo 19, account.account.type model no longer exists.
         Account types are now Selection fields directly on account.account.
         The 'type' field below is a custom field for hierarchy purposes. -->
    <data noupdate="1">
    </data>
    <data>

        <record id="view_account_form_inherit_gts1" model="ir.ui.view">
            <field name="name">account.account.form.inherit</field>
            <field name="model">account.account</field>
            <field name="inherit_id" ref="account.view_account_form"/>
            <field name="arch" type="xml">
                <field name="account_type" position="after">
                    <field name="type" required="1"/>
                    <field name="parent_id" context="{'show_view_type': True}" groups="gts_coa_hierarchy.group_coas_user"/>
                    <field name="level"/>
                    <field name="debit"/>
                    <field name="credit"/>
                    <field name="balance"/>
                    <field name="opening_balance"/>
                    <field name="closing_balance"/>
                    <field name="child_parent_ids" invisible="1"/>
                    <field name="child_id" invisible="1"/>
                </field>
                <field name="active" position="after">
                    <field name="reconcile" widget="boolean_toggle"
                           invisible="account_type in ('asset_cash', 'liability_credit_card', 'off_balance')"/>
                </field>
            </field>
         </record>

        <record id="view_account_list_inherit_gts1" model="ir.ui.view">
            <field name="name">account.account.list.inherit</field>
            <field name="model">account.account</field>
            <field name="inherit_id" ref="account.view_account_list"/>
            <field name="arch" type="xml">
                <list position="attributes">
                    <attribute name="decoration-info">account_type=='view'</attribute>
                </list>
                <field name="account_type" position="after">
                    <field name="type"/>
                    <field name="parent_id" groups="gts_coa_hierarchy.group_coas_user"/>
                    <field name="debit" sum="debit"/>
                    <field name="credit" sum="credit"/>
                    <field name="balance" sum="balance"/>
                </field>
            </field>
        </record>

        <record id="view_account_search_inherit_gts1" model="ir.ui.view">
            <field name="name">account.account.search.inherit</field>
            <field name="model">account.account</field>
            <field name="inherit_id" ref="account.view_account_search"/>
            <field name="arch" type="xml">
                <field name="name" position="after">
                    <field name="parent_id"/>
                </field>
                <field name="account_type" position="after">
                    <filter string="Account Type Hie." name="account_type_hie" domain="" context="{'group_by':'account_type'}"/>
                    <filter string="Parent" name="parent_filter" domain="" context="{'group_by':'parent_id'}"/>
                </field>
            </field>
        </record>
