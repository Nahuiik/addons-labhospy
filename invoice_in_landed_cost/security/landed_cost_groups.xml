<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Odoo 19: un res.groups.privilege = un desplegador (una opción activa) en el formulario
        de usuario. Si comparten privilege con Usuario/Admin de inventario, los permisos
        adicionales no se muestran como toggles separados. Un privilegio por permiso, misma
        categoría (cadena de suministro) que el inventario.
    -->
    <record id="res_groups_privilege_landed_cost_validate" model="res.groups.privilege">
        <field name="name">Validación: costos en destino</field>
        <field name="description">Permitir el botón «Validar / Registrar» en costos en destino (además de los derechos de acceso a costos en destino).</field>
        <field name="placeholder">Ninguno</field>
        <field name="sequence">11</field>
        <field name="category_id" ref="base.module_category_supply_chain"/>
    </record>

    <record id="res_groups_privilege_landed_cost_sale_margin" model="res.groups.privilege">
        <field name="name">Margen de venta en costeo en destino</field>
        <field name="description">Permitir el asistente de margen y actualización de PVP desde un costeo validado.</field>
        <field name="placeholder">Ninguno</field>
        <field name="sequence">12</field>
        <field name="category_id" ref="base.module_category_supply_chain"/>
    </record>

    <record id="group_landed_cost_validate" model="res.groups">
        <field name="name">Validar costos en destino</field>
        <field name="sequence">11</field>
        <field name="privilege_id" ref="res_groups_privilege_landed_cost_validate"/>
        <field name="comment">Puede validar (registrar) costeos en destino en estado borrador.</field>
    </record>

    <record id="group_landed_cost_apply_sale_margin" model="res.groups">
        <field name="name">Aplicar margen de venta en costeo</field>
        <field name="sequence">12</field>
        <field name="privilege_id" ref="res_groups_privilege_landed_cost_sale_margin"/>
        <field name="comment">Puede abrir el asistente y aplicar margen de venta / PVP desde costeos validados.</field>
    </record>

    <!-- Compatibilidad: administradores de inventario conservan ambos permisos tras actualizar el módulo. -->
    <record id="stock.group_stock_manager" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('invoice_in_landed_cost.group_landed_cost_validate')), (4, ref('invoice_in_landed_cost.group_landed_cost_apply_sale_margin'))]"/>
    </record>
</odoo>
