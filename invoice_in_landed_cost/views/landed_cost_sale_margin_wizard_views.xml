<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_landed_cost_sale_margin_wizard_form" model="ir.ui.view">
        <field name="name">landed.cost.sale.margin.wizard.form</field>
        <field name="model">landed.cost.sale.margin.wizard</field>
        <field name="arch" type="xml">
            <form string="Margen venta (costeo en destino)">
                <div class="alert alert-info" role="alert">
                    Basado en el costo unitario final del costeo (tras <strong>Calcular</strong>).
                    Si vuelve a calcular el costeo, conviene revisar o reaplicar el margen.
                </div>
                <group>
                    <field name="landed_cost_id" invisible="1"/>
                    <field name="currency_id" invisible="1"/>
                </group>
                <group>
                    <label for="global_margin_percent"/>
                    <div class="o_row">
                        <field name="global_margin_percent"/>
                        <button name="action_apply_global_margin" type="object" string="Aplicar % global a todas las líneas" class="btn-secondary"/>
                    </div>
                </group>
                <field name="line_ids" nolabel="1">
                    <list editable="bottom" create="false" delete="false">
                        <field name="product_id"/>
                        <field name="quantity"/>
                        <field name="unit_cost" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                        <field name="price_before_apply" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                        <field name="margin_percent"/>
                        <field name="price_after_apply" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                    </list>
                </field>
                <footer>
                    <button name="action_apply" type="object" string="Aplicar margen e imprimir resumen" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
