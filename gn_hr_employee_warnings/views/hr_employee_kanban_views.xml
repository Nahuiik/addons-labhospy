<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_employee_kanban_inherit_gn_hr_employee_warnings" model="ir.ui.view">
        <field name="name">hr.employee.kanban.inherit.gn.hr.employee.warnings</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.hr_kanban_view_employees"/>
        <field name="priority" eval="80"/>
        <field name="arch" type="xml">
            <field name="company_id" position="after">
                <field name="has_loan_ending_soon_warning"/>
                <field name="has_missing_bank_account_warning"/>
            </field>
            <!-- Icono alineado a la derecha junto al bloque de cabecera del nombre -->
            <xpath expr="//main[hasclass('ms-2')]/div[1]/field[@name='name']" position="before">
                <div class="float-end me-2 d-flex gap-1">
                    <span t-if="record.has_missing_bank_account_warning.raw_value" title="Sin cuenta bancaria">
                        <i class="fa fa-university text-warning"/>
                    </span>
                    <span t-if="record.has_loan_ending_soon_warning.raw_value" title="Préstamo por terminar (pocas cuotas)">
                        <i class="fa fa-flag-checkered text-info"/>
                    </span>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
