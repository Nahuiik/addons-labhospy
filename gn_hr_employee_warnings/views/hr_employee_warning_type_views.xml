<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_employee_warning_type_list" model="ir.ui.view">
        <field name="name">hr.employee.warning.type.list</field>
        <field name="model">hr.employee.warning.type</field>
        <field name="arch" type="xml">
            <list string="Alertas de Empleados" decoration-muted="not active"
                  decoration-info="alert_style == 'info'"
                  decoration-warning="alert_style == 'warning'"
                  decoration-danger="alert_style == 'danger'">
                <field name="sequence" widget="handle"/>
                <field name="icon_preview" string=" " width="40px"/>
                <field name="name"/>
                <field name="code"/>
                <field name="alert_style"/>
                <field name="icon" optional="hide"/>
                <field name="employee_field" optional="hide"/>
                <field name="config_hint"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_hr_employee_warning_type_form" model="ir.ui.view">
        <field name="name">hr.employee.warning.type.form</field>
        <field name="model">hr.employee.warning.type</field>
        <field name="arch" type="xml">
            <form string="Tipo de Alerta">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Nombre de la alerta"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="sequence"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                        <group>
                            <field name="icon"/>
                            <field name="alert_style"/>
                            <field name="employee_field"/>
                        </group>
                    </group>
                    <group>
                        <field name="config_hint"/>
                    </group>
                    <group>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hr_employee_warning_type" model="ir.actions.act_window">
        <field name="name">Alertas de Empleados</field>
        <field name="res_model">hr.employee.warning.type</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'active_test': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No hay tipos de alerta configurados
            </p>
            <p>
                Los tipos de alerta definen qué avisos se muestran en la vista del empleado.
                Puede desactivar un tipo de alerta para que no se muestre.
            </p>
        </field>
    </record>

    <menuitem id="menu_hr_employee_warning_type"
              name="Alertas de Empleados"
              parent="hr.menu_human_resources_configuration"
              action="action_hr_employee_warning_type"
              sequence="95"
              groups="hr.group_hr_manager"/>
</odoo>
