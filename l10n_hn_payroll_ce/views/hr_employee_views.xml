<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_employee_salary_input_list" model="ir.ui.view">
        <field name="name">hr.employee.salary.input.list</field>
        <field name="model">hr.employee.salary.input</field>
        <field name="arch" type="xml">
            <list>
                <field name="input_type_id"/>
                <field name="periodicity"/>
                <field name="amount"/>
                <field name="quota_amount"/>
                <field name="payments_total"/>
                <field name="payments_remaining"/>
                <field name="deduction_period"/>
                <field name="struct_ids" widget="many2many_tags" options="{'no_create': True}"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_hr_employee_salary_input_form" model="ir.ui.view">
        <field name="name">hr.employee.salary.input.form</field>
        <field name="model">hr.employee.salary.input</field>
        <field name="arch" type="xml">
            <form string="Beneficio o deducción">
                <sheet>
                    <group>
                        <group>
                            <field name="employee_id" readonly="1" invisible="1"/>
                            <field name="sequence" invisible="1"/>
                            <field name="name" invisible="1"/>
                            <field name="input_type_id" required="1"/>
                            <field name="periodicity" required="1"/>
                            <field name="quota_amount" string="Monto cuota" required="1"/>
                            <field name="payments_total" string="Número de pagos" required="1"/>
                            <field name="amount" string="Monto total" readonly="1" required="1"/>
                            <field name="payments_remaining" string="# Pagos restantes" required="1"/>
                            <field name="deduction_period" string="Incluir deducción en" required="1"/>
                        </group>
                        <group>
                            <field name="date_start" string="Fecha de inicio"/>
                            <field name="date_end" string="Fecha de finalización"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hr_employee_salary_inputs" model="ir.ui.view">
        <field name="name">hr.employee.view.salary.inputs</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="l10n_hn_payroll_base.payroll_hr_employee_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='payroll_information']" position="after">
                <page name="l10n_hn_payroll_ce_salary_inputs" string="Beneficios y Deducciones (IHSS/AFP)"
                      groups="l10n_hn_payroll_base.group_hn_payroll_user">
                    <field name="salary_input_ids"
                           context="{'default_employee_id': id, 'tree_view_ref': 'l10n_hn_payroll_ce.view_hr_employee_salary_input_list', 'form_view_ref': 'l10n_hn_payroll_ce.view_hr_employee_salary_input_form'}"
                           domain="[('employee_id', '=', id)]"
                           mode="tree,form"/>
                </page>
                <page name="l10n_hn_payroll_ce_ihss" string="IHSS" groups="l10n_hn_payroll_base.group_hn_payroll_user">
                    <group>
                        <group>
                            <field name="ihss_total_fee" readonly="1"/>
                            <field name="ihss_ivm_fee" readonly="1"/>
                            <field name="ihss_enf_mat_fee" readonly="1"/>
                        </group>
                        <group>
                            <field name="ihss_config_id" readonly="1" options="{'no_create': True}"/>
                            <field name="ihss_manual"/>
                        </group>
                    </group>
                </page>
                <page name="l10n_hn_payroll_ce_afp" string="AFP" groups="l10n_hn_payroll_base.group_hn_payroll_user">
                    <group>
                        <group>
                            <field name="afp_quincena_amount" readonly="1"/>
                        </group>
                        <group>
                            <field name="afp_config_id" readonly="1" options="{'no_create': True}"/>
                            <field name="afp_manual"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
