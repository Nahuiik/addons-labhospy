<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record model='ir.ui.view' id='purchase_wizard_form'>
            <field name="name">purchase.wizard.form</field>
            <field name="model">gn_report_account.purchase_wizard</field>
            <field name="arch" type="xml">
                <form string="Reporte Venta">
                    <sheet>
                        <group>
                            <field name="include_payments"/>
                        </group>
                        <group col="2">
                            <group>
                                <field name="date_from" string="Fecha Inicio"/>
                                <field name="admin_percentage" string="Administrativo (%)"/>
                                <field name="report_type" string="Tipo de Reporte"/>
                            </group>
                            <group>
                                <field name="date_to" string="Fecha Final"/>
                                <field name="indirect_cost_percentage" string="Costo indirecto (%)"/>
                                <field name="state" string="Estado" invisible="include_payments"/>
                            </group>
                        </group>
                    </sheet>
                    <footer>
                        <button name="export_xls" type="object" default_focus="1"
                                string="Exportar" class="btn_nahuiik text_uppercase oe_highlight"
                                context="{'xls_export':1}" icon="fa-file-o"
                                invisible="include_payments"/>
                        <button name="export_xls" type="object" default_focus="1"
                                string="Exportar Pagos" class="btn_nahuiik text_uppercase oe_highlight"
                                context="{'xls_export':1}" icon="fa-file-o"
                                invisible="not include_payments"/>
                        <button string="Cancelar" class="btn_nahuiik text_uppercase btn btn-danger" special="cancel" />
                    </footer>
                </form>
            </field>
        </record>

        <record model='ir.actions.act_window' id='action_wizard_purchase'>
            <field name="name">Purchase Report</field>
            <field name="res_model">gn_report_account.purchase_wizard</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="purchase_wizard_form"/>
            <field name="target">new</field>
        </record>

        <menuitem name="Purchase Report" parent="gn_report_account.nahuiik_accounting_menu" id="purchase_report_menuitem" action="action_wizard_purchase" sequence="5"/>
    </data>
</odoo>
