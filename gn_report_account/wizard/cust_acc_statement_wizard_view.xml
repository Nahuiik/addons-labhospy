<odoo>
    <data>
        <record id="customer_account_statement_wizard_form" model="ir.ui.view">
            <field name="name">customer.account.statement.wizard.view</field>
            <field name="model">customer.account.statement.wizard</field>
            <field name="type">form</field>
            <field name="arch" type="xml">
                <form string="Customer Account Statement Report">
                    <group col="2">
                        <group>
                            <field name="start_date"/>
                        </group>
                        <group>
                            <field name="end_date"/>
                        </group>
                    </group>
                    <footer>
                        <button string="Print" icon="fa-file-o" class="btn_nahuiik text_uppercase btn btn-primary" name="action_print_report" type="object"/>
                        <button special="cancel" class="btn_nahuiik text_uppercase btn btn-danger" string="Cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_customer_account_statement_report" model="ir.actions.act_window">
            <field name="name">Customer Account Statement</field>
            <field name="res_model">customer.account.statement.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>
        <menuitem 
            id="menuitem_customer_account_statement"
            name="Customer Account Statement"
            action="action_customer_account_statement_report"
            parent="gn_report_account.nahuiik_accounting_menu"
            sequence="3"/>
    </data>
</odoo>
