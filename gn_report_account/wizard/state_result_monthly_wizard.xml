<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <data>
        <record id="report_state_result_monthly_wizard_form" model="ir.ui.view">
            <field name="name">state.result.monthly.wizard.view</field>
            <field name="model">state.result.monthly</field>
            <field name="type">form</field>
            <field name="arch" type="xml">
                <form string="State Result Monthly Wizard">
                    <group col="2">
                        <group>
                            <field name="start_date" required="1"/>
                        </group>
                        <group>
                            <field name="end_date" required="1"/>
                        </group>
                    </group>
                    <footer>
                        <button string="Print" class="btn_nahuiik text_uppercase btn-primary" icon="fa-file-o" name="action_generate_report" type="object"/>
                        <button special="cancel" class="btn_nahuiik text_uppercase oe_link" string="Cancel"/>
                    </footer>
                </form>
            </field>
        </record>
        <record id="action_report_state_result_monthly" model="ir.actions.act_window">
            <field name="name">State Result Monthly</field>
            <field name="res_model">state.result.monthly</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>
        <menuitem
            id="report_state_result_monthly_menu"
            name="State Result Monthly"
            action="action_report_state_result_monthly"
            parent="gn_report_account.nahuiik_accounting_menu"
            sequence="9"/>
    </data>
</odoo>
