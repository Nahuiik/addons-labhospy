<odoo>
    <record id="retention_report_wizard_view" model="ir.ui.view">
        <field name="name">retention.report.wizard</field>
        <field name="model">retention.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Retention Report Wizard">
                <group col="4">
                    <field name="start_date"/>
                    <field name="end_date"/>
                    <field name="report_type"/>
                </group>
                <!-- <group>
                </group> -->
                <footer>
                    <button name="action_get_report"
                            string="Print"
                            type="object"
                            icon="fa-file-o"
                            class="btn_nahuiik text_uppercase btn btn-primary"/>
                    <button special="cancel" class="btn_nahuiik text_uppercase btn btn-danger" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_retention_report_wizard" model="ir.actions.act_window">
        <field name="name">Retention Report</field>
        <field name="res_model">retention.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="retention_report_wizard_view"/>
        <field name="target">new</field>
    </record>
    <menuitem id="menu_retention_report"
        action="action_retention_report_wizard"
        name="Retention Report"
        sequence="6"
        parent="gn_report_account.nahuiik_accounting_menu"/>

</odoo>