<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <data>
        <record id="action_overdue_to_pay_report_wizard_form" model="ir.ui.view">
            <field name="name">overdue.to.pay.wizard.view</field>
            <field name="model">overdue.to.pay</field>
            <field name="arch" type="xml">
                <form string="Report Overdue To Pay">
                    <group col="2">
                        <group>
                            <field name="start_date"/>
                        </group>
                        <group>
                            <field name="end_date"/>
                        </group>
                    </group>
                    <footer>
                        <button string="Generate" class="btn-primary" name="action_generate_report" type="object"/>
                        <button special="cancel" class="oe_link" string="Cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_overdue_to_pay_report_wizard" model="ir.actions.act_window">
            <field name="name">Payment supplier reports</field>
            <!-- <field name="type">ir.actions.act_window</field> -->
            <field name="res_model">overdue.to.pay</field>
            <!-- <field name="view_type">form</field> -->
            <field name="view_mode">form</field>
            <field name="view_id" ref="action_overdue_to_pay_report_wizard_form" />
            <field name="target">new</field>
        </record>

        <menuitem
            id="report_overdue_to_pay"
            parent="gn_report_account.nahuiik_accounting_menu"
            name="Payment supplier reports"
            sequence="8"
            action="action_overdue_to_pay_report_wizard"
        />
    </data>
</odoo>
