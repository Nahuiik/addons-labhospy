<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <data>
        <record id="report_supplier_account_state_wizard_form" model="ir.ui.view">
            <field name="name">supplier.account.state.wizard.view</field>
            <field name="model">supplier.account.state</field>
            <field name="type">form</field>
            <field name="arch" type="xml">
                <form string="Supplier Account State Wizard">
                    <group col="2">
                        <group>
                            <field name="start_date" required="1"/>
                        </group>
                        <group>
                            <field name="end_date" required="1"/>
                        </group>
                    </group>
                    <footer>
                        <button string="Print" class="btn_nahuiik text_uppercase btn-primary" icon="fa-file-o" name="action_generate_report_supplier" type="object"/>
                        <button special="cancel" class="btn_nahuiik text_uppercase oe_link" string="Cancel"/>
                    </footer>
                </form>
            </field>
        </record>
        <record id="action_report_supplier_account_state" model="ir.actions.act_window">
            <field name="name">Supplier Account State</field>
            <field name="res_model">supplier.account.state</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>
        <menuitem
            id="report_supplier_account_state_menu"
            name="Supplier Account State"
            action="action_report_supplier_account_state"
            parent="gn_report_account.nahuiik_accounting_menu"
            sequence="7"/>
    </data>
</odoo>
