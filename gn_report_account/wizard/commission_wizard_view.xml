<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record model='ir.ui.view' id='commission_wizard_form'>
            <field name="name">commission.wizard.form</field>
            <field name="model">gn_report_account.commission_wizard</field>
            <field name="arch" type="xml">
                <form string="Reporte Venta">
                    <sheet>
                        <group>
                            <field name="print_payments" string="Imprimir Pagos"/>
                        </group>
                        <group col="2">
                            <group>
                                <field name="date_from" string="Fecha Inicio"/>
                                <field name="per_administrative" string="Administrativo (%)"/>
                                <field name="report_type" string="Tipo de Reporte" required="1"/>
                            </group>
                            <group>
                                <field name="date_to" string="Fecha Final"/>
                                <field name="per_indirect_cost" string="Costo indirecto (%)"/>
                                <field name="state" string="Estado" invisible="print_payments"/>
                            </group>
                        </group>
                        <field name="values_in" invisible="1"/>
                    </sheet>
                    <footer>
                        <button name="export_xls" type="object" default_focus="1"
                                string="Exportar" class="btn_nahuiik text_uppercase oe_highlight"
                                context="{'xls_export':1}" icon="fa-file-o"
                                invisible="print_payments"/>
                        <button name="export_xls" type="object" default_focus="1"
                                string="Exportar Pagos" class="btn_nahuiik text_uppercase oe_highlight"
                                context="{'xls_export':1}" icon="fa-file-o"
                                invisible="not print_payments"/>
                        <button string="Cancelar" class="btn_nahuiik text_uppercase btn btn-danger" special="cancel" />
                    </footer>
                </form>
            </field>
        </record>

        <record model='ir.actions.act_window' id='action_wizard_commission'>
            <field name="name">Sale Report</field>
            <field name="res_model">gn_report_account.commission_wizard</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="commission_wizard_form"/>
            <field name="target">new</field>
        </record>

        <menuitem name="Reports Sales" parent="gn_report_account.nahuiik_accounting_menu" id="sale_report_menuitem" action="action_wizard_commission" sequence="2"/>
    </data>
</odoo>
