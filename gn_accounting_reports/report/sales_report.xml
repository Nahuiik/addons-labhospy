<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="paperformat_gn_sales_report" model="report.paperformat">
            <field name="name">Reporte ventas horizontal</field>
            <field name="format">A4</field>
            <field name="orientation">Landscape</field>
            <field name="margin_top">10</field>
            <field name="margin_bottom">10</field>
            <field name="margin_left">6</field>
            <field name="margin_right">6</field>
            <field name="dpi">90</field>
        </record>

        <record id="action_report_gn_sales" model="ir.actions.report">
            <field name="name">Reporte de ventas</field>
            <field name="model">gn.accounting.sales.report.wizard</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">gn_accounting_reports.report_sales_document</field>
            <field name="report_file">gn_accounting_reports.report_sales_document</field>
            <field name="paperformat_id" ref="paperformat_gn_sales_report"/>
        </record>

        <record id="action_report_gn_sales_html" model="ir.actions.report">
            <field name="name">Reporte de ventas (HTML)</field>
            <field name="model">gn.accounting.sales.report.wizard</field>
            <field name="report_type">qweb-html</field>
            <field name="report_name">gn_accounting_reports.report_sales_html</field>
            <field name="report_file">gn_accounting_reports.report_sales_html</field>
        </record>
    </data>
</odoo>
