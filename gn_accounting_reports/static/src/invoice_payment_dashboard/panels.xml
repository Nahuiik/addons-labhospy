<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="gn_accounting_reports.InvPayInsightsPanel">
        <div class="o_inv_pay_insights card border-0 shadow-sm mb-3">
            <div class="card-header bg-white py-2 px-3">
                <strong><i class="fa fa-lightbulb-o me-2 text-warning"/>Hallazgos del período</strong>
            </div>
            <div class="card-body p-3">
                <div t-if="!(props.insights?.length)" class="text-muted small">
                    No hay observaciones relevantes con los datos actuales.
                </div>
                <div t-else="" class="d-flex flex-column gap-2">
                    <div t-foreach="props.insights" t-as="ins" t-key="ins_index"
                         t-attf-class="o_inv_pay_insight o_inv_pay_insight--#{ins.tone || 'info'}">
                        <span t-out="ins.text"/>
                        <button type="button"
                                class="btn btn-link btn-sm p-0 ms-2"
                                t-on-click="() => props.onAction(ins.action || { type: 'filter', filters: {}, tab: 'summary' })">
                            Ver detalle
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </t>

    <t t-name="gn_accounting_reports.InvPayDetailPanel">
        <div t-if="props.open" class="o_inv_pay_detail_backdrop" t-on-click="props.onClose"/>
        <aside t-if="props.open and props.detail" class="o_inv_pay_detail_panel">
            <div class="o_inv_pay_detail_panel__header d-flex justify-content-between align-items-center">
                <strong t-out="props.detail.invoice?.name"/>
                <button type="button" class="btn-close" t-on-click="props.onClose"/>
            </div>
            <div class="o_inv_pay_detail_panel__body">
                <dl class="row small mb-3">
                    <dt class="col-5 text-muted">Cliente</dt>
                    <dd class="col-7" t-out="props.detail.invoice?.partner"/>
                    <dt class="col-5 text-muted">Asesor</dt>
                    <dd class="col-7" t-out="props.detail.invoice?.advisor"/>
                    <dt class="col-5 text-muted">Total</dt>
                    <dd class="col-7" t-out="props.detail.invoice?.amount_total"/>
                    <dt class="col-5 text-muted">Saldo</dt>
                    <dd class="col-7" t-out="props.detail.invoice?.amount_residual"/>
                    <dt class="col-5 text-muted">Vencimiento</dt>
                    <dd class="col-7" t-out="props.detail.invoice?.due_date"/>
                </dl>
                <h6 class="small text-uppercase text-muted">Pagos asociados</h6>
                <ul class="list-group list-group-flush mb-3">
                    <li t-foreach="props.detail.payments || []" t-as="pay" t-key="pay.id"
                        class="list-group-item px-0 py-2 small">
                        <div class="fw-semibold" t-out="pay.name"/>
                        <div class="text-muted" t-out="pay.date"/> —
                        <span t-out="pay.amount"/>
                    </li>
                </ul>
                <h6 class="small text-uppercase text-muted">Línea de tiempo</h6>
                <ul class="o_inv_pay_timeline list-unstyled">
                    <li t-foreach="props.detail.timeline || []" t-as="ev" t-key="ev_index"
                        class="o_inv_pay_timeline__item small">
                        <span class="text-muted" t-out="ev.date"/>
                        <span class="ms-2" t-out="ev.label"/>
                    </li>
                </ul>
            </div>
            <div class="o_inv_pay_detail_panel__footer d-flex gap-2">
                <button type="button" class="btn btn-primary btn-sm"
                        t-on-click="() => props.onOpenRecord('invoice')">
                    Abrir factura
                </button>
                <button type="button" class="btn btn-outline-secondary btn-sm"
                        t-on-click="() => props.onOpenRecord('partner')">
                    Abrir cliente
                </button>
            </div>
        </aside>
    </t>
</templates>
