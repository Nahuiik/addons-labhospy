<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="gn_accounting_reports.InvoicePaymentDashboard">
        <div class="o_inv_pay_dashboard d-flex flex-column h-100 overflow-auto">
            <header t-attf-class="o_inv_pay_header sticky-top #{headerClass}">
                <div class="o_inv_pay_header__inner">
                    <div class="d-flex align-items-start gap-2 flex-grow-1">
                        <button type="button" class="btn btn-outline-secondary btn-sm o_inv_pay_back mt-1"
                                title="Volver a Odoo" t-on-click="goBack">
                            <i class="fa fa-arrow-left"/>
                        </button>
                        <div class="o_inv_pay_header__icon">
                            <i class="fa fa-file-invoice-dollar"/>
                        </div>
                        <div>
                            <h1 class="o_inv_pay_header__title mb-0">Facturas y pagos</h1>
                            <p class="o_inv_pay_header__subtitle mb-1">
                                Análisis integral de facturación, cobranza y comportamiento de pago
                            </p>
                            <div class="o_inv_pay_header__meta small text-muted">
                                <span t-out="state.header.company_name"/>
                                <span class="mx-2">·</span>
                                <span t-out="state.header.period_label"/>
                                <span class="mx-2">·</span>
                                <span>Actualizado: <t t-out="formatDateTime(state.header.generated_at)"/></span>
                                <span t-if="state.header.has_filters or hasModifiedFilters"
                                      class="badge text-bg-primary ms-2">Filtros activos</span>
                                <span t-if="state.header.sql_mode" class="badge text-bg-secondary ms-2" title="Modo agregación SQL activo">SQL</span>
                            </div>
                        </div>
                    </div>
                    <div class="o_inv_pay_header__actions d-flex flex-wrap gap-2 align-items-center">
                        <button t-if="hasModifiedFilters" type="button"
                                class="btn btn-outline-secondary btn-sm"
                                t-on-click="resetFilters">
                            Restablecer
                        </button>
                        <button type="button" class="btn btn-primary btn-sm"
                                t-att-disabled="state.refreshing ? 'disabled' : undefined"
                                t-on-click="refresh">
                            <span t-if="state.refreshing" class="spinner-border spinner-border-sm me-1"/>
                            <i t-else="" class="fa fa-sync me-1"/>
                            Actualizar
                        </button>
                        <button type="button" class="btn btn-outline-secondary btn-sm"
                                t-on-click="() => state.showSaveView = !state.showSaveView">
                            Guardar vista
                        </button>
                        <div class="dropdown">
                            <button type="button" class="btn btn-outline-secondary btn-sm dropdown-toggle"
                                    data-bs-toggle="dropdown" t-att-disabled="state.exporting ? 'disabled' : undefined">
                                Exportar
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a class="dropdown-item" href="#" t-on-click.prevent="() => this.exportFormat('pdf_executive')">PDF ejecutivo</a></li>
                                <li><a class="dropdown-item" href="#" t-on-click.prevent="() => this.exportFormat('pdf_detail')">PDF detallado</a></li>
                                <li><a class="dropdown-item" href="#" t-on-click.prevent="() => this.exportFormat('xlsx')">Excel</a></li>
                                <li><a class="dropdown-item" href="#" t-on-click.prevent="() => this.exportFormat('csv')">CSV</a></li>
                            </ul>
                        </div>
                    </div>
                </div>
                <div t-if="state.showSaveView" class="o_inv_pay_save_view px-3 pb-2">
                    <div class="input-group input-group-sm" style="max-width:320px;">
                        <input type="text" class="form-control" placeholder="Nombre de la vista"
                               t-att-value="state.saveViewName"
                               t-on-input="(ev) => state.saveViewName = ev.target.value"/>
                        <button type="button" class="btn btn-primary" t-on-click="saveCurrentView">Guardar</button>
                    </div>
                </div>
            </header>

            <div class="o_inv_pay_body flex-grow-1 p-3">
                <div t-if="state.loadError" class="alert alert-danger">
                    <t t-out="state.loadError"/>
                    <button type="button" class="btn btn-sm btn-outline-danger ms-2" t-on-click="refresh">Reintentar</button>
                </div>

                <div t-if="showPeriodHint" class="alert alert-info py-2 px-3 mb-3 small d-flex flex-wrap align-items-center gap-2">
                    <span>
                        Los totales usan <strong>fecha de pago</strong> del período seleccionado
                        (más pendientes del mismo rango). El listado de Contabilidad agrupa por
                        <strong>fecha de factura</strong>, por eso los montos pueden diferir.
                    </span>
                    <button type="button" class="btn btn-sm btn-outline-primary ms-auto"
                            t-on-click="alignWithAccounting">
                        Alinear con Contabilidad
                    </button>
                </div>

                <div t-if="state.filterOptions.saved_views and state.filterOptions.saved_views.length" class="d-flex flex-wrap gap-2 mb-3">
                    <button t-foreach="state.filterOptions.saved_views" t-as="sv" t-key="sv.id"
                            type="button" class="btn btn-sm btn-outline-primary"
                            t-on-click="() => this.loadSavedView(sv)">
                        <t t-out="sv.name"/>
                    </button>
                </div>

                <InvPayFilterPanel
                    filters="state.draftFilters"
                    options="state.filterOptions"
                    expanded="state.filtersExpanded"
                    collapsed="state.filtersCollapsed"
                    chips="filterChips"
                    onFilterChange.bind="onFilterChange"
                    onPresetChange.bind="onPresetChange"
                    onToggleExpand.bind="toggleFiltersExpand"
                    onExpand.bind="expandFilters"
                    onReset.bind="resetFilters"
                    onApply.bind="applyFilters"/>

                <nav class="o_inv_pay_tabs o_inv_pay_tabs--sticky nav nav-pills gap-1 mb-3">
                    <button t-foreach="tabs" t-as="tab" t-key="tab.id"
                            type="button"
                            t-attf-class="nav-link #{state.activeTab === tab.id ? 'active' : ''}"
                            t-on-click="() => this.setTab(tab.id)">
                        <i t-attf-class="fa #{tab.icon} me-1"/>
                        <t t-out="tab.label"/>
                    </button>
                </nav>

                <div t-if="state.loading" class="o_inv_pay_skeleton row g-3">
                    <div t-foreach="[1,2,3,4]" t-as="i" t-key="i" class="col-md-3">
                        <div class="card placeholder-glow"><div class="card-body placeholder col-12" style="height:88px;"/></div>
                    </div>
                </div>

                <div t-elif="state.activeTab === 'summary'">
                    <div class="row g-3 mb-2 o_inv_pay_kpi_grid">
                        <div t-foreach="primaryKpiCards" t-as="card" t-key="card.key"
                             class="col-xl-3 col-lg-4 col-md-6">
                            <InvPayKpiCard card="card"
                                           currencyId="state.currency.id"
                                           currencySymbol="state.currency.symbol"/>
                        </div>
                    </div>
                    <div class="row g-3 mb-3">
                        <div t-foreach="secondaryKpiCards" t-as="card" t-key="card.key"
                             class="col-xl-3 col-lg-3 col-md-6">
                            <InvPayKpiCard card="card"
                                           currencyId="state.currency.id"
                                           currencySymbol="state.currency.symbol"/>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-lg-4">
                            <div class="card border-0 shadow-sm h-100 o_inv_pay_recovery_card">
                                <div class="card-body p-3">
                                    <h6 class="small text-muted mb-2">Recuperación del período</h6>
                                    <InvPayChartPanel chartId="'gauge'"
                                                      type="'gauge'"
                                                      config="recoveryGaugeConfig"
                                                      thresholds="state.thresholds"
                                                      height="'160px'"/>
                                    <div class="row g-2 mt-1 small">
                                        <div class="col-6">
                                            <div class="text-muted">Total pagado</div>
                                            <div class="fw-semibold" t-out="paidCard ? formatMoneyBound(paidCard.value) : '—'"/>
                                        </div>
                                        <div class="col-6">
                                            <div class="text-muted">Saldo pendiente</div>
                                            <div class="fw-semibold" t-out="pendingCard ? formatMoneyBound(pendingCard.value) : '—'"/>
                                        </div>
                                        <div class="col-6">
                                            <div class="text-muted">Meta de recuperación</div>
                                            <div class="fw-semibold" t-out="formatPct(state.thresholds.recovery_good || 85)"/>
                                        </div>
                                        <div class="col-6">
                                            <div class="text-muted">Variación</div>
                                            <div class="fw-semibold" t-out="recoveryDeltaLabel"/>
                                        </div>
                                        <div t-if="punctualityCard" class="col-12 pt-1 border-top">
                                            <div class="text-muted">Pagos dentro del plazo</div>
                                            <div class="fw-semibold" t-out="formatPct(punctualityCard.value)"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-8">
                            <div class="card border-0 shadow-sm h-100">
                                <div class="card-header bg-white py-2">
                                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                                        <span class="small fw-semibold">Facturado vs pagado</span>
                                        <div class="d-flex flex-wrap gap-2">
                                            <div class="btn-group btn-group-sm">
                                                <button type="button"
                                                        t-attf-class="btn #{state.timelineBase === 'payment' ? 'btn-primary' : 'btn-outline-secondary'}"
                                                        t-on-click="() => this.setTimelineBase('payment')">Base de pago</button>
                                                <button type="button"
                                                        t-attf-class="btn #{state.timelineBase === 'invoice' ? 'btn-primary' : 'btn-outline-secondary'}"
                                                        t-on-click="() => this.setTimelineBase('invoice')">Base de factura</button>
                                                <button type="button"
                                                        t-attf-class="btn #{state.timelineBase === 'accounting' ? 'btn-primary' : 'btn-outline-secondary'}"
                                                        t-on-click="() => this.setTimelineBase('accounting')">Comparativo contable</button>
                                            </div>
                                            <div class="btn-group btn-group-sm">
                                                <button type="button"
                                                        t-attf-class="btn #{state.timelineScope === 'period' ? 'btn-primary' : 'btn-outline-secondary'}"
                                                        t-on-click="() => this.setTimelineScope('period')">Actividad del período</button>
                                                <button type="button"
                                                        t-attf-class="btn #{state.timelineScope === 'historical' ? 'btn-primary' : 'btn-outline-secondary'}"
                                                        t-on-click="() => this.setTimelineScope('historical')">Tendencia histórica</button>
                                            </div>
                                        </div>
                                    </div>
                                    <p class="small text-muted mb-0 mt-1" t-out="timelineScopeHint"/>
                                </div>
                                <InvPayChartPanel chartId="'timeline'"
                                                  chartKey="'timeline'"
                                                  config="timelineChartConfig"
                                                  currencySymbol="state.currency.symbol"
                                                  onChartClick.bind="onChartClick"/>
                            </div>
                        </div>
                    </div>
                    <InvPayInsightsPanel insights="state.insights" onAction.bind="onInsightAction"/>
                </div>

                <div t-elif="state.activeTab === 'analysis'">
                    <div class="row g-3">
                        <div class="col-lg-6">
                            <InvPayAnalysisChartCard chartId="'advisor'"
                                                     chartKey="'advisor_ranking'"
                                                     chartType="'advisor'"
                                                     config="state.charts.advisor_ranking"
                                                     currencySymbol="state.currency.symbol"
                                                     currencyId="state.currency.id"
                                                     loading="state.refreshing"
                                                     onApplyFilter.bind="onChartApplyFilter"
                                                     onViewDetail.bind="onChartViewDetail"
                                                     onExportData.bind="onChartExportData"/>
                        </div>
                        <div class="col-lg-6">
                            <InvPayAnalysisChartCard chartId="'clients'"
                                                     chartKey="'client_ranking'"
                                                     chartType="'client'"
                                                     config="state.charts.client_ranking"
                                                     currencySymbol="state.currency.symbol"
                                                     currencyId="state.currency.id"
                                                     loading="state.refreshing"
                                                     onApplyFilter.bind="onChartApplyFilter"
                                                     onViewDetail.bind="onChartViewDetail"
                                                     onExportData.bind="onChartExportData"/>
                        </div>
                        <div class="col-lg-6">
                            <InvPayAnalysisChartCard chartId="'bank'"
                                                     chartKey="'bank_distribution'"
                                                     chartType="'distribution'"
                                                     config="state.charts.bank_distribution"
                                                     currencySymbol="state.currency.symbol"
                                                     currencyId="state.currency.id"
                                                     loading="state.refreshing"
                                                     onApplyFilter.bind="onChartApplyFilter"
                                                     onViewDetail.bind="onChartViewDetail"
                                                     onExportData.bind="onChartExportData"/>
                        </div>
                        <div class="col-lg-6">
                            <InvPayAnalysisChartCard chartId="'categ'"
                                                     chartKey="'category_distribution'"
                                                     chartType="'distribution'"
                                                     config="state.charts.category_distribution"
                                                     currencySymbol="state.currency.symbol"
                                                     currencyId="state.currency.id"
                                                     loading="state.refreshing"
                                                     onApplyFilter.bind="onChartApplyFilter"
                                                     onViewDetail.bind="onChartViewDetail"
                                                     onExportData.bind="onChartExportData"/>
                        </div>
                    </div>
                </div>

                <div t-elif="state.activeTab === 'detail'">
                    <div class="d-flex flex-wrap gap-2 mb-3 align-items-center">
                        <span class="small text-muted">Unidad de análisis:</span>
                        <div class="btn-group btn-group-sm">
                            <button type="button"
                                    t-attf-class="btn #{detailViewMode === 'by_invoice' ? 'btn-primary' : 'btn-outline-secondary'}"
                                    t-on-click="() => this.onViewModeChange('by_invoice')">Por factura</button>
                            <button type="button"
                                    t-attf-class="btn #{detailViewMode === 'by_payment' ? 'btn-primary' : 'btn-outline-secondary'}"
                                    t-on-click="() => this.onViewModeChange('by_payment')">Por pago</button>
                            <button type="button"
                                    t-attf-class="btn #{detailViewMode === 'consolidated' ? 'btn-primary' : 'btn-outline-secondary'}"
                                    t-on-click="() => this.onViewModeChange('consolidated')">Consolidado</button>
                        </div>
                    </div>
                    <InvPayDataTable table="state.table"
                                     columns="state.columns"
                                     density="state.density"
                                     currencyId="state.currency.id"
                                     loading="state.refreshing"
                                     search="state.tableSearch"
                                     groupBy="state.groupBy"
                                     mode="tableMode"
                                     expandedRows="state.expandedRows"
                                     expandedGroups="state.expandedGroups"
                                     onSort.bind="onSort"
                                     onPageChange.bind="onPageChange"
                                     onPageSizeChange.bind="onPageSizeChange"
                                     onGoToPage.bind="onGoToPage"
                                     onRowClick.bind="onRowClick"
                                     onSearch.bind="onSearch"
                                     onGroupBy.bind="onGroupBy"
                                     onColumnsChange.bind="onColumnsChange"
                                     onDensityChange.bind="onDensityChange"
                                     onResetToolbar.bind="resetTableToolbar"
                                     onToggleGroup.bind="onToggleGroup"
                                     onExpandRow.bind="onExpandRow"/>
                </div>

                <div t-elif="state.activeTab === 'overdue'">
                    <div class="row g-3 mb-3">
                        <div t-foreach="bucketKeys" t-as="bk" t-key="bk"
                             class="col">
                            <div t-attf-class="card border-0 shadow-sm o_inv_pay_aging o_inv_pay_aging--#{bk} h-100">
                                <div class="card-body p-3">
                                    <div class="small text-muted mb-1" t-out="agingBucketLabel(bk)"/>
                                    <div class="fw-bold fs-5 mb-1" t-out="agingBucketAmount(bk)"/>
                                    <div class="small text-muted mb-2">
                                        <t t-out="agingBucketCount(bk)"/> facturas · <t t-out="agingBucketPct(bk)"/>
                                    </div>
                                    <div class="o_inv_pay_aging__bar">
                                        <div class="o_inv_pay_aging__bar_fill"
                                             t-attf-style="width:#{agingBucketBarPct(bk)}%"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="d-flex flex-wrap gap-2 mb-3 align-items-center">
                        <div class="btn-group btn-group-sm">
                            <button type="button"
                                    t-attf-class="btn #{state.overdueFilterMode === 'all_balance' ? 'btn-primary' : 'btn-outline-secondary'}"
                                    t-on-click="() => this.onOverdueFilterChange('all_balance')">Todas con saldo</button>
                            <button type="button"
                                    t-attf-class="btn #{state.overdueFilterMode === 'overdue_only' ? 'btn-primary' : 'btn-outline-secondary'}"
                                    t-on-click="() => this.onOverdueFilterChange('overdue_only')">Solo vencidas</button>
                            <button type="button"
                                    t-attf-class="btn #{state.overdueFilterMode === 'upcoming_due' ? 'btn-primary' : 'btn-outline-secondary'}"
                                    t-on-click="() => this.onOverdueFilterChange('upcoming_due')">Próximas a vencer</button>
                        </div>
                        <div t-if="state.overdueFilterMode === 'upcoming_due'" class="btn-group btn-group-sm">
                            <button t-foreach="[7, 15, 30]" t-as="d" t-key="d"
                                    type="button"
                                    t-attf-class="btn #{state.upcomingDays === d ? 'btn-primary' : 'btn-outline-secondary'}"
                                    t-on-click="() => this.onUpcomingDaysChange(d)">
                                <t t-out="d"/> días
                            </button>
                        </div>
                    </div>
                    <InvPayDataTable table="state.overdueTable"
                                     title="overdueTableTitle"
                                     columns="overdueColumns"
                                     currencyId="state.currency.id"
                                     loading="state.refreshing"
                                     onSort.bind="onSort"
                                     onPageChange.bind="onOverduePageChange"
                                     onPageSizeChange.bind="onOverduePageSizeChange"
                                     onRowClick.bind="onRowClick"
                                     onSearch.bind="onSearch"
                                     onGroupBy.bind="onGroupBy"/>
                </div>
            </div>

            <InvPayDetailPanel detail="state.detail"
                               open="state.detailOpen"
                               onClose.bind="closeDetail"
                               onOpenRecord.bind="onOpenRecord"/>
        </div>
    </t>
</templates>
