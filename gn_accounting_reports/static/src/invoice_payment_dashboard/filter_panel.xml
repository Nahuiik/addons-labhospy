<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="gn_accounting_reports.InvPayFilterPanel">
        <!-- Barra resumida (panel contraído tras aplicar) -->
        <div t-if="props.collapsed" class="o_inv_pay_filter_bar card border-0 shadow-sm mb-3">
            <div class="card-body py-2 px-3 d-flex flex-wrap align-items-center gap-2">
                <i class="fa fa-filter text-primary"/>
                <t t-foreach="props.chips || []" t-as="chip" t-key="chip_index">
                    <span class="o_inv_pay_filter_chip badge rounded-pill text-bg-light border" t-out="chip"/>
                </t>
                <div class="ms-auto d-flex gap-2">
                    <button t-if="hasNonDefaultFilters" type="button"
                            class="btn btn-link btn-sm p-0" t-on-click="props.onReset">
                        Restablecer
                    </button>
                    <button type="button" class="btn btn-outline-primary btn-sm"
                            t-on-click="props.onExpand">
                        Editar filtros
                    </button>
                </div>
            </div>
        </div>

        <!-- Panel compacto / expandido -->
        <div t-else="" class="o_inv_pay_filters card border-0 shadow-sm mb-3">
            <div class="card-header bg-white d-flex justify-content-between align-items-center py-2 px-3">
                <div class="d-flex align-items-center gap-2">
                    <i class="fa fa-filter text-primary"/>
                    <strong class="small">Filtros</strong>
                    <span t-if="hasNonDefaultFilters" class="badge rounded-pill text-bg-primary">Activos</span>
                </div>
                <div class="d-flex gap-2">
                    <button t-if="hasNonDefaultFilters" type="button"
                            class="btn btn-link btn-sm p-0" t-on-click="props.onReset">
                        Restablecer
                    </button>
                    <button type="button" class="btn btn-link btn-sm p-0"
                            t-on-click="props.onToggleExpand">
                        <t t-if="props.expanded">Menos filtros</t>
                        <t t-else="">Más filtros</t>
                    </button>
                </div>
            </div>
            <div class="card-body p-3 pt-2">
                <div class="o_inv_pay_date_presets d-flex flex-wrap gap-1 mb-2">
                    <t t-foreach="props.options.payment_period_presets || []" t-as="preset" t-key="preset.id">
                        <button type="button"
                                t-attf-class="btn btn-sm #{props.filters.payment_period === preset.id ? 'btn-primary' : 'btn-outline-secondary'}"
                                t-on-click="() => props.onPresetChange(preset.id)"
                                t-out="preset.label"/>
                    </t>
                </div>
                <div class="row g-2 align-items-end">
                    <div class="col-md-2 col-6">
                        <label class="form-label small mb-1">Pago desde</label>
                        <input type="date" class="form-control form-control-sm"
                               t-att-value="props.filters.date_from"
                               t-on-change="(ev) => this.onField(ev, 'date_from')"/>
                    </div>
                    <div class="col-md-2 col-6">
                        <label class="form-label small mb-1">Pago hasta</label>
                        <input type="date" class="form-control form-control-sm"
                               t-att-value="props.filters.date_to"
                               t-on-change="(ev) => this.onField(ev, 'date_to')"/>
                    </div>
                    <div class="col-md-2 col-6">
                        <label class="form-label small mb-1">Compañía</label>
                        <select class="form-select form-select-sm"
                                t-on-change="(ev) => this.onField(ev, 'company_id')">
                            <t t-foreach="props.options.companies || []" t-as="co" t-key="co.id">
                                <option t-att-value="co.id"
                                        t-att-selected="co.id === props.filters.company_id ? 'selected' : undefined"
                                        t-out="co.name"/>
                            </t>
                        </select>
                    </div>
                    <div class="col-md-2 col-6">
                        <label class="form-label small mb-1">Sucursal</label>
                        <MultiRecordSelector t-props="branchSelectorProps"/>
                    </div>
                    <div class="col-md-2 col-6">
                        <label class="form-label small mb-1">Asesor</label>
                        <MultiRecordSelector t-props="userSelectorProps"/>
                    </div>
                    <div class="col-md-2 col-6">
                        <label class="form-label small mb-1">Estado</label>
                        <select class="form-select form-select-sm"
                                t-att-value="props.filters.payment_state"
                                t-on-change="(ev) => this.onField(ev, 'payment_state')">
                            <option value="all">Todos</option>
                            <option value="paid">Pagadas</option>
                            <option value="partial">Parciales</option>
                            <option value="not_paid">Pendientes</option>
                        </select>
                    </div>
                    <div class="col-md-3 col-6">
                        <div class="form-check mb-1">
                            <input type="checkbox" class="form-check-input" id="inv_pay_pending"
                                   t-att-checked="props.filters.show_pending_invoices ? 'checked' : undefined"
                                   t-on-change="(ev) => this.onCheckbox(ev, 'show_pending_invoices')"/>
                            <label class="form-check-label small" for="inv_pay_pending">Incluir pendientes</label>
                        </div>
                    </div>
                    <div class="col-md-3 col-6">
                        <button type="button" class="btn btn-primary btn-sm w-100"
                                t-on-click="props.onApply">
                            Aplicar filtros
                        </button>
                    </div>
                </div>

                <div t-if="props.expanded" class="row g-2 mt-2 pt-2 border-top">
                    <div class="col-12"><small class="text-uppercase text-muted fw-semibold">Rango de factura</small></div>
                    <div class="col-md-3">
                        <label class="form-label small mb-1">Factura desde</label>
                        <input type="date" class="form-control form-control-sm"
                               t-att-value="props.filters.invoice_date_from"
                               t-on-change="(ev) => this.onField(ev, 'invoice_date_from')"/>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small mb-1">Factura hasta</label>
                        <input type="date" class="form-control form-control-sm"
                               t-att-value="props.filters.invoice_date_to"
                               t-on-change="(ev) => this.onField(ev, 'invoice_date_to')"/>
                    </div>
                    <div class="col-12 mt-1"><small class="text-uppercase text-muted fw-semibold">Cliente y venta</small></div>
                    <div class="col-md-4">
                        <label class="form-label small mb-1">Cliente</label>
                        <MultiRecordSelector t-props="partnerSelectorProps"/>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small mb-1">Categoría de producto</label>
                        <MultiRecordSelector t-props="categSelectorProps"/>
                    </div>
                    <div class="col-12"><small class="text-uppercase text-muted fw-semibold">Pago y banco</small></div>
                    <div class="col-md-4">
                        <label class="form-label small mb-1">Banco / diario</label>
                        <MultiRecordSelector t-props="journalSelectorProps"/>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small mb-1">Plazo de crédito</label>
                        <select class="form-select form-select-sm"
                                t-on-change="(ev) => this.onField(ev, 'credit_term_filter')">
                            <option value="all">Todos</option>
                            <option value="within">Dentro del plazo</option>
                            <option value="outside">Fuera del plazo</option>
                            <option value="no_payment">Sin pago</option>
                        </select>
                    </div>
                    <div class="col-12"><small class="text-uppercase text-muted fw-semibold">Condiciones financieras</small></div>
                    <div class="col-md-3">
                        <label class="form-label small mb-1">Comparar con</label>
                        <select class="form-select form-select-sm"
                                t-on-change="(ev) => this.onField(ev, 'compare_mode')">
                            <t t-foreach="props.options.compare_modes || []" t-as="cm" t-key="cm.id">
                                <option t-att-value="cm.id"
                                        t-att-selected="cm.id === props.filters.compare_mode ? 'selected' : undefined"
                                        t-out="cm.label"/>
                            </t>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small mb-1">Vista de datos</label>
                        <select class="form-select form-select-sm"
                                t-on-change="(ev) => this.onField(ev, 'view_mode')">
                            <t t-foreach="props.options.view_modes || []" t-as="vm" t-key="vm.id">
                                <option t-att-value="vm.id" t-out="vm.label"/>
                            </t>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small mb-1">Monto mínimo</label>
                        <input type="number" class="form-control form-control-sm" min="0"
                               t-att-value="props.filters.amount_min"
                               t-on-change="(ev) => this.onField(ev, 'amount_min')"/>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small mb-1">Monto máximo</label>
                        <input type="number" class="form-control form-control-sm" min="0"
                               t-att-value="props.filters.amount_max"
                               t-on-change="(ev) => this.onField(ev, 'amount_max')"/>
                    </div>
                    <div class="col-md-2 d-flex align-items-end">
                        <div class="form-check mb-2">
                            <input type="checkbox" class="form-check-input" id="inv_pay_overdue"
                                   t-att-checked="props.filters.overdue_only ? 'checked' : undefined"
                                   t-on-change="(ev) => this.onCheckbox(ev, 'overdue_only')"/>
                            <label class="form-check-label small" for="inv_pay_overdue">Solo vencidas</label>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>
