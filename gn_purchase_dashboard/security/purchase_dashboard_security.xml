<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_purchase_dashboard" model="ir.module.category">
        <field name="name">DASHBOARD DE COMPRAS</field>
        <field name="description">Permisos del Command Center y dashboard ejecutivo de compras</field>
        <field name="sequence">25</field>
    </record>

    <record id="privilege_purchase_dashboard" model="res.groups.privilege">
        <field name="name">Command Center</field>
        <field name="sequence">1</field>
        <field name="category_id" ref="module_category_purchase_dashboard"/>
    </record>

    <record id="group_purchase_dashboard_user" model="res.groups">
        <field name="name">Usuario</field>
        <field name="privilege_id" ref="privilege_purchase_dashboard"/>
        <field name="comment">Puede consultar el dashboard de compras, KPIs, gráficos y tablas.</field>
        <field name="implied_ids" eval="[(4, ref('purchase.group_purchase_user'))]"/>
    </record>

    <record id="group_purchase_dashboard_manager" model="res.groups">
        <field name="name">Gerente</field>
        <field name="privilege_id" ref="privilege_purchase_dashboard"/>
        <field name="comment">Incluye permisos de usuario y funciones avanzadas de análisis.</field>
        <field name="implied_ids" eval="[(4, ref('group_purchase_dashboard_user'))]"/>
    </record>

    <record id="group_purchase_dashboard_admin" model="res.groups">
        <field name="name">Administrador</field>
        <field name="privilege_id" ref="privilege_purchase_dashboard"/>
        <field name="comment">Control total del dashboard de compras y configuración del layout.</field>
        <field name="implied_ids" eval="[(4, ref('group_purchase_dashboard_manager'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
    </record>
</odoo>
