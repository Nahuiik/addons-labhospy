<?xml version="1.0" encoding="UTF-8"?>
<odoo>
	<data>
		<record model="ir.ui.view" id="view_receipt_journal_form_inh">
			<field name="name">view.receipt.journal.form.inherit</field>
			<field name="model">account.journal</field>
			<field name="inherit_id" ref="account.view_account_journal_form"/> 
			<field name="arch" type="xml">
                <field name="refund_sequence" position="after">
                    <field name="receipt_in_advance" invisible="type != 'sale'"/>
                </field>
			</field>
		</record>

		<record model="ir.ui.view" id="view_payment_account_form_inh">
			<field name="name">view.payment.form.inherit</field>
			<field name="model">account.payment</field>
			<field name="inherit_id" ref="account.view_account_payment_form"/> 
			<field name="arch" type="xml">
                <field name="journal_id" position="after">
                    <field name="create_uid" string="Cajero" readonly="1"/>
                </field>
			</field>
		</record>

		<record model="ir.ui.view" id="view_payment_account_list_inh">
			<field name="name">view.payment.list.inherit</field>
			<field name="model">account.payment</field>
			<field name="inherit_id" ref="account.view_account_payment_tree"/> 
			<field name="arch" type="xml">
                <field name="name" position="after">
                    <field name="create_uid" string="Cajero"/>
                </field>
			</field>
		</record>

	</data>
</odoo>
