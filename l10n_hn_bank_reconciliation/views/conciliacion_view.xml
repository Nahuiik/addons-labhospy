<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="action_movimientos_concilidos" model="ir.actions.act_window">
            <field name="name">Conciliación Bancaria</field>
            <field name="res_model">account.move</field>
            <field name="view_mode">list,form</field>
            <field name="domain"> [('reconciliation_id', '=', active_id)]</field>
        </record>

        <record model="ir.ui.view" id="conicliacion_bancaria_line_view_tree">
            <field name="name">bank.reconciliation.line.tree</field>
            <field name="model">bank.reconciliation.line</field>
            <field name="arch" type="xml">
                <list string="Conciliaciones" create="0" delete="0">
                    <field name="move_id" />
                    <field name="name" />
                    <field name="date" />
                    <field name="partner_id" />
                    <field name="debit"  sum="Total"/>
                    <field name="credit"  sum="Total"/>
                    <field name="currency_id" />
                    <field name="import_coin" />
                    <field name="is_reconciled"/>
                </list>
            </field>
        </record>
        <record id="bank_reconciliation_line_search" model="ir.ui.view">
            <field name="name">bank.reconciliation.line.search</field>
            <field name="model">bank.reconciliation.line</field>
            <field name="arch" type="xml">
                <search string="Line Reconciliation">
                    <field name="partner_id"/>
                    <field name="name"/>
                    <field name="move_id"/>
                    <field name="debit"/>
                    <field name="credit"/>
                    <filter name="is_reconciled" string="Conciliado" domain="[('is_reconciled', '=', True)]"/>
                    <filter name="is_reconciled" string="No Conciliado" domain="[('is_reconciled', '=', False)]"/>
                </search>
            </field>
        </record>
        <record id="action_no_conicliacion_bancaria_line" model="ir.actions.act_window">
            <field name="name">No Conciliados</field>
            <field name="res_model">bank.reconciliation.line</field>
            <field name="view_mode">list,form</field>
            <field name="domain"> [('reconciliation_id', '=', active_id)]</field>
        </record>

        <record id="conicliacion_bancaria_form_view" model="ir.ui.view">
            <field name="name">bank.reconciliation.form</field>
            <field name="model">bank.reconciliation</field>
            <field name="arch" type="xml">
                <form string="Debits">
                    <header>
                        <button name="back_draft" type="object" string="Volver a borrador" invisible="state != 'anulated'" class="border-radius btn btn-primary" style="font-weight:800; text-transform: uppercase;"/>
                        <button name="get_movement" type="object" string="Obtener Movimientos" invisible="state != 'draft'" class="border-radius btn btn-warning" style="color:#fff;text-transform: uppercase;"/>
                        <button name="action_validate" type="object" string="Conciliar Saldos" invisible="state != 'draft'" class="border-radius btn btn-success" style="text-transform: uppercase;"/>
                        <button name="action_report_xls" type="object" string="Generate report XLS" class="border-radius btn btn-odoo" style="font-weight:800;text-transform: uppercase;"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,validated" statusbar_colors='{"validated":"blue"}'/>
                        <button name="action_anulated" type="object" string="Anular Conciliación" 
                        confirm="Esta seguro que quiere anular este registro?" invisible="state != 'validated'" class="border-radius btn btn-danger" style="text-transform: uppercase;"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button class="oe_stat_button"
                                icon="fa-bars"
                                type="action" name="%(action_movimientos_concilidos)d"
                                string="Movimientos Conciliados">
                            </button>  
                            <button class="oe_stat_button"
                                icon="fa-list"
                                type="action" name="%(action_no_conicliacion_bancaria_line)d"
                                string="No Conciliados">
                            </button>  
                        </div>
                        <h1>
                            <field name="name"  class="oe_inline" placeholder="Descripción de conciliación" readonly="state != 'draft'"/>
                        </h1>
                        <group colspan="4">
                            <group cols="2">
                                <field name="account_id" widget="selection" readonly="state != 'draft'"/>
                                <field name="date" readonly="state != 'draft'"/>
                                <field name="month_name" readonly="state != 'draft'"/>
                                <field name="is_conciliado_father"/>
                                <field name="is_state_draft"/>
                            </group>
                            <group cols="2">
                                <field name="company_id" readonly="state != 'draft'"/>
                                <field name="balance_start" readonly="1"/>
                                <field name="end_balance" readonly="state != 'draft'"/>
                                <field name="difference" />
                                <field name="currency_id" readonly="state != 'draft'"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Detalle de Movimientos">
                                <field name="reconciliation_line" readonly="state != 'draft'" >
                                    <list editable="top" create="0" delete="0" decoration-muted="is_reconciled == True" decoration-danger="is_reconciled == False" >
                                        <field name="move_id" readonly="1"/>
                                        <field name="name" readonly="1"/>
                                        <field name="date" readonly="1"/>
                                        <field name="partner_id" readonly="1"/>
                                        <field name="debit" readonly="1" sum="Total"/>
                                        <field name="credit" readonly="1" sum="Total"/>
                                        <field name="currency_id" readonly="1"/>
                                        <field name="import_coin" readonly="1"/>
                                        <field name="is_reconciled"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record model="ir.ui.view" id="conicliacion_bancaria_view_tree">
            <field name="name">bank.reconciliation.tree</field>
            <field name="model">bank.reconciliation</field>
            <field name="arch" type="xml">
                <list string="Conciliaciones">
                    <field name="account_id"/>
                    <field name="name" />
                    <field name="date" />
                    <field name="month_name"/>
                    <field name="name" />
                    <field name="end_balance" sum="total"/>
                    <field name="currency_id"/>
                    <field name="state"/>
                </list>
            </field>
        </record>

        <record id="action_conicliacion_bancaria" model="ir.actions.act_window">
            <field name="name">Conciliación Bancaria</field>
            <field name="res_model">bank.reconciliation</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    Click to record a new conciliación
                </p>
            </field>
        </record>

        <menuitem  
            id="menu_banks_conciliation_main"
            action="l10n_hn_bank_reconciliation.action_conicliacion_bancaria" 
            parent="gn_banks.menu_main_banks" 
            name="Conciliacion Bancaria" 
            sequence="120"
            />
    </data>
</odoo>
