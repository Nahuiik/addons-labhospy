<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_reconcile_model_tree_gn_qif_openai_inherit" model="ir.ui.view">
        <field name="name">account.reconcile.model.tree.gn.qif.openai</field>
        <field name="model">account.reconcile.model</field>
        <field name="inherit_id" ref="account.view_account_reconcile_model_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='trigger']" position="after">
                <field name="gn_creation_source" optional="show"/>
                <field name="gn_file_format_key" optional="hide"/>
            </xpath>
        </field>
    </record>

    <record id="view_account_reconcile_model_form_gn_qif_openai_inherit_group" model="ir.ui.view">
        <field name="name">account.reconcile.model.form.gn.qif.openai.learn.meta</field>
        <field name="model">account.reconcile.model</field>
        <field name="inherit_id" ref="account.view_account_reconcile_model_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@id='counterpart_entry_right_column']" position="after">
                <group string="Integración Nahuiik" colspan="4">
                    <field name="gn_creation_source"/>
                    <field name="gn_file_format_key"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="view_account_reconcile_model_form_gn_qif_openai_inherit_patterns" model="ir.ui.view">
        <field name="name">account.reconcile.model.form.gn.qif.openai.patterns.tab</field>
        <field name="model">account.reconcile.model</field>
        <field name="inherit_id" ref="account.view_account_reconcile_model_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@id='counterpart_items_tab']" position="after">
                <page string="Patrones IA relacionados"
                      name="gn_qif_patterns"
                      groups="account.group_account_user">
                    <field name="gn_qif_learn_ids" nolabel="1" readonly="1">
                        <list>
                            <field name="journal_id"/>
                            <field name="file_format_key" optional="show"/>
                            <field name="hit_count"/>
                            <field name="match_label"/>
                            <field name="match_label_param"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_account_reconcile_model_search_gn_qif_openai_inherit" model="ir.ui.view">
        <field name="name">account.reconcile.model.search.gn.qif.openai</field>
        <field name="model">account.reconcile.model</field>
        <field name="inherit_id" ref="account.view_account_reconcile_model_search"/>
        <field name="arch" type="xml">
            <xpath expr="//search/field[@name='name']" position="after">
                <separator/>
                <filter string="Nahuiik: plantillas" name="gn_wizard_templates"
                        domain="[('gn_creation_source', '=', 'wizard_template')]"/>
                <filter string="Nahuiik: desde IA" name="gn_ai_models"
                        domain="[('gn_creation_source', '=', 'ai_promoted')]"/>
                <separator/>
                <filter string="Agrupar por origen Nahuiik" name="grp_gn_source"
                        context="{'group_by': 'gn_creation_source'}"/>
            </xpath>
        </field>
    </record>
</odoo>
