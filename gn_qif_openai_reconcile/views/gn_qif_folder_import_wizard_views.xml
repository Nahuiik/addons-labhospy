<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_gn_qif_folder_import_wizard_form" model="ir.ui.view">
        <field name="name">gn.qif.folder.import.wizard.form</field>
        <field name="model">gn.qif.folder.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Importar carpeta Excel">
                <group>
                    <field name="journal_id"/>
                    <field name="folder_root" widget="gn_folder_root_path"/>
                    <field name="allow_reimport"/>
                </group>
                <group string="Resultado última ejecución">
                    <field name="summary_html" nolabel="1"/>
                </group>
                <footer>
                    <button name="action_import_folder" string="Escane e importar" type="object" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_gn_qif_folder_import_wizard" model="ir.actions.act_window">
        <field name="name">Importar carpeta (.xlsx / .xls)</field>
        <field name="res_model">gn.qif.folder.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_gn_qif_folder_import_wizard"
              name="Importar carpeta Excel (lote)"
              parent="account.account_transactions_menu"
              action="action_gn_qif_folder_import_wizard"
              sequence="89"/>

</odoo>
