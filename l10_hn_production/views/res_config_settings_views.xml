<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_l10_hn_production" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.l10.hn.production</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="mrp.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='process_operations_setting_container']" position="inside">
                <setting
                    company_dependent="1"
                    string="Bodegas de producción"
                    help="Al confirmar una orden de producción se solicita transferir componentes desde la Bodega A hacia la Bodega de producción, descontando lo ya disponible en destino."
                >
                    <div class="content-group">
                        <div class="row mt16">
                            <label class="col-lg-4 o_light_label" string="Bodega A" for="hn_production_source_warehouse_id"/>
                            <field name="hn_production_source_warehouse_id" class="col-lg-8" options="{'no_create': True}"/>
                        </div>
                        <div class="row">
                            <label class="col-lg-4 o_light_label" string="Bodega de producción" for="hn_production_dest_warehouse_id"/>
                            <field name="hn_production_dest_warehouse_id" class="col-lg-8" options="{'no_create': True}"/>
                        </div>
                        <div class="row mt16">
                            <field name="hn_production_allow_self_approval" class="col-lg-12"/>
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
