<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_hn_production" model="ir.module.category">
        <field name="name">Honduras Producción</field>
        <field name="description">Permisos de transferencias a producción</field>
        <field name="sequence">110</field>
    </record>

    <record id="privilege_production_material_approval" model="res.groups.privilege">
        <field name="name">Aprobar transferencias a producción</field>
        <field name="category_id" ref="l10_hn_production.module_category_hn_production"/>
        <field name="sequence">10</field>
    </record>

    <record id="group_production_material_approver" model="res.groups">
        <field name="name">Responsable</field>
        <field name="privilege_id" ref="l10_hn_production.privilege_production_material_approval"/>
        <field name="comment">Puede aprobar o rechazar transferencias de materiales hacia la bodega de producción.</field>
        <field name="implied_ids" eval="[(4, ref('stock.group_stock_user'))]"/>
    </record>
</odoo>
