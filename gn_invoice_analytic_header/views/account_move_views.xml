<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_move_form_inherit_analytic_header" model="ir.ui.view">
        <field name="name">account.move.form.inherit.gn.analytic.header</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">

            <!-- Campo de distribución analítica en la cabecera de la factura.
                 Al editarlo se propaga a todas las líneas de producto. -->
            <xpath expr="//group[@id='header_right_group']" position="inside">
                <field name="analytic_precision" invisible="1"/>
                <field name="invoice_analytic_distribution"
                       widget="analytic_distribution"
                       string="Analítica (cabecera)"
                       readonly="state != 'draft'"
                       invisible="move_type not in ('in_invoice', 'in_refund')"
                       groups="analytic.group_analytic_accounting"/>
            </xpath>

        </field>
    </record>

</odoo>
