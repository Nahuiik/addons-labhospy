<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_picking_form_gn_pv" model="ir.ui.view">
        <field name="name">stock.picking.form.gn.pv</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='move_ids']/list//field[@name='product_uom']" position="after">
                <field name="gn_pv_percent" optional="hide" column_invisible="parent.picking_type_code != 'incoming'"/>
                <field name="gn_sale_price" optional="hide" column_invisible="parent.picking_type_code != 'incoming'"/>
            </xpath>
        </field>
    </record>
</odoo>
