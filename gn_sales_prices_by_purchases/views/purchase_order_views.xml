<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="purchase_order_form_gn_pv" model="ir.ui.view">
        <field name="name">purchase.order.form.gn.pv</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='date_planned_div']" position="after">
                <label for="gn_update_sale_price" string="Actualiza P.V."/>
                <div class="o_row">
                    <field name="gn_update_sale_price" widget="boolean_toggle" nolabel="1"/>
                </div>
            </xpath>
            <xpath expr="//field[@name='order_line']/list//field[@name='price_unit']" position="after">
                <field name="gn_pv_percent" optional="show" column_invisible="not parent.gn_update_sale_price"/>
                <field name="gn_sale_price" optional="show" column_invisible="not parent.gn_update_sale_price" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>
