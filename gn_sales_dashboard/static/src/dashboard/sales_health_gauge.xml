<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-name="gn_sales_dashboard.SalesHealthGauge">
        <section class="gn-sd-panel gn-sd-health-card gn-sd-level-1">
            <header class="gn-sd-panel__head">
                <h3 class="gn-sd-panel__title" t-esc="props.health?.title or 'Índice de desempeño comercial'"/>
            </header>
            <div t-if="props.loading" class="gn-sd-skeleton gn-sd-skeleton--health"/>
            <div t-else="" class="gn-sd-health-card__grid">
                <div class="gn-sd-health-card__gauge-col">
                    <div class="gn-sd-health-card__gauge" t-att-class="statusClass">
                        <svg viewBox="0 0 120 120" class="gn-sd-health__svg" aria-hidden="true">
                            <circle cx="60" cy="60" r="48" fill="none" stroke="currentColor" stroke-opacity="0.12" stroke-width="9"/>
                            <circle cx="60" cy="60" r="48" fill="none" stroke="currentColor" stroke-width="9"
                                    stroke-linecap="round" transform="rotate(-90 60 60)"
                                    t-att-stroke-dasharray="301.593"
                                    t-att-stroke-dashoffset="dashOffset"/>
                        </svg>
                        <div class="gn-sd-health__center">
                            <span class="gn-sd-health__score" t-esc="props.health?.score_label or (score + ' / 100')"/>
                            <small class="gn-sd-health__status" t-esc="props.health?.status"/>
                            <small class="gn-sd-health__delta" t-esc="scoreDeltaLabel"/>
                        </div>
                    </div>
                </div>
                <div class="gn-sd-health-card__factors-col">
                    <div class="gn-sd-health__factors">
                        <div t-foreach="topFactors" t-as="f" t-key="f.key"
                             class="gn-sd-health__factor" t-on-click="(ev) => this.onFactorClick(f, ev)"
                             t-att-title="f.description">
                            <div class="gn-sd-health__factor-head">
                                <span t-esc="f.label"/>
                                <span t-esc="f.normalized_score + '/100'"/>
                            </div>
                            <div class="gn-sd-health__bar">
                                <div t-att-class="factorBarClass(f)"
                                     t-att-style="'width:' + Math.min(f.normalized_score, 100) + '%'"/>
                            </div>
                            <small class="gn-sd-health__factor-meta">
                                Peso <t t-esc="f.weight"/>% · Contrib. <t t-esc="f.weighted_score"/>
                            </small>
                        </div>
                    </div>
                    <button t-if="(props.health?.factors or []).length > 6" type="button"
                            class="btn btn-link btn-sm gn-sd-health__more"
                            t-on-click="toggleBreakdown"
                            t-esc="state.showAllFactors ? 'Ver menos' : 'Ver desglose completo'"/>
                </div>
                <div class="gn-sd-health-card__brief-col" t-if="executiveBrief">
                    <h4 class="gn-sd-health__brief-title">Diagnóstico ejecutivo</h4>
                    <p class="gn-sd-health__brief-status" t-esc="executiveBrief.status"/>
                    <div t-if="executiveBrief.strengths.length" class="gn-sd-health__brief-block">
                        <strong>Fortalezas</strong>
                        <ul>
                            <li t-foreach="executiveBrief.strengths" t-as="s" t-key="s.key" t-esc="s.label"/>
                        </ul>
                    </div>
                    <div t-if="executiveBrief.risks.length" class="gn-sd-health__brief-block">
                        <strong>Riesgos</strong>
                        <ul>
                            <li t-foreach="executiveBrief.risks" t-as="r" t-key="r.key" t-esc="r.label"/>
                        </ul>
                    </div>
                    <p class="gn-sd-health__brief-rec" t-esc="executiveBrief.recommendation"/>
                </div>
            </div>
        </section>
    </t>
</templates>
