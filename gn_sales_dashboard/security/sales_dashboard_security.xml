<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_sales_dashboard" model="ir.module.category">
        <field name="name">DASHBOARD DE VENTAS</field>
        <field name="description">Permisos del Command Center y dashboard ejecutivo comercial</field>
        <field name="sequence">24</field>
    </record>

    <record id="privilege_sales_dashboard" model="res.groups.privilege">
        <field name="name">Command Center</field>
        <field name="sequence">1</field>
        <field name="category_id" ref="module_category_sales_dashboard"/>
    </record>

    <record id="group_sales_dashboard_user" model="res.groups">
        <field name="name">Usuario</field>
        <field name="privilege_id" ref="privilege_sales_dashboard"/>
        <field name="comment">Puede consultar el dashboard de ventas, KPIs, gráficos y tablas.</field>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
    </record>

    <record id="group_sales_dashboard_manager" model="res.groups">
        <field name="name">Gerente comercial</field>
        <field name="privilege_id" ref="privilege_sales_dashboard"/>
        <field name="comment">Incluye permisos de usuario y gestión de metas comerciales.</field>
        <field name="implied_ids" eval="[(4, ref('group_sales_dashboard_user'))]"/>
    </record>

    <record id="group_sales_dashboard_admin" model="res.groups">
        <field name="name">Administrador</field>
        <field name="privilege_id" ref="privilege_sales_dashboard"/>
        <field name="comment">Control total del dashboard de ventas y su configuración.</field>
        <field name="implied_ids" eval="[(4, ref('group_sales_dashboard_manager'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
    </record>
</odoo>
