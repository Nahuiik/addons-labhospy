<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sales_dashboard_target_tree" model="ir.ui.view">
        <field name="name">sales.dashboard.target.tree</field>
        <field name="model">sales.dashboard.target</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="period_type"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="branch_id" optional="show"/>
                <field name="team_id" optional="show"/>
                <field name="user_id" optional="show"/>
                <field name="target_sales" sum="Total"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_sales_dashboard_target_form" model="ir.ui.view">
        <field name="name">sales.dashboard.target.form</field>
        <field name="model">sales.dashboard.target</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="period_type"/>
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                        <group>
                            <field name="branch_id"/>
                            <field name="team_id"/>
                            <field name="user_id"/>
                            <field name="product_id"/>
                            <field name="category_id"/>
                        </group>
                    </group>
                    <group string="Metas">
                        <field name="target_sales"/>
                        <field name="target_margin"/>
                        <field name="target_orders"/>
                        <field name="target_new_customers"/>
                        <field name="target_conversion"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_sales_dashboard_target" model="ir.actions.act_window">
        <field name="name">Metas comerciales</field>
        <field name="res_model">sales.dashboard.target</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_sales_dashboard_config_form" model="ir.ui.view">
        <field name="name">sales.dashboard.config.form</field>
        <field name="model">sales.dashboard.config</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="company_id" readonly="1"/>
                        <field name="default_period"/>
                        <field name="forecast_method"/>
                    </group>
                    <group string="Umbrales de alertas">
                        <field name="margin_min_pct"/>
                        <field name="concentration_max_pct"/>
                        <field name="inactive_customer_days"/>
                        <field name="stalled_opportunity_days"/>
                        <field name="rfm_recency_days"/>
                    </group>
                    <group string="Pesos Sales Health Score">
                        <field name="weight_growth"/>
                        <field name="weight_target"/>
                        <field name="weight_margin"/>
                        <field name="weight_conversion"/>
                        <field name="weight_concentration"/>
                        <field name="weight_returns"/>
                        <field name="weight_pipeline"/>
                        <field name="weight_recurring"/>
                        <field name="weight_ticket"/>
                        <field name="weight_activity"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_sales_dashboard_config" model="ir.actions.act_window">
        <field name="name">Configuración dashboard ventas</field>
        <field name="res_model">sales.dashboard.config</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="context">{'form_view_initial_mode': 'edit'}</field>
    </record>
</odoo>
