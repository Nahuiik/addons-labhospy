<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_account_journal_form_gn_audit" model="ir.ui.view">
        <field name="name">account.journal.form.gn.audit</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_gn_audit_logs" type="object"
                        class="oe_stat_button" icon="fa-history"
                        groups="account.group_account_manager">
                    <field name="gn_audit_log_count" widget="statinfo"
                           string="Auditoría"/>
                </button>
            </xpath>
        </field>
    </record>

</odoo>
