<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_gn_audit_log_list" model="ir.ui.view">
        <field name="name">gn.audit.log.list</field>
        <field name="model">gn.audit.log</field>
        <field name="arch" type="xml">
            <list string="Bitácora de auditoría" create="false" edit="false"
                  default_order="log_date desc">
                <field name="log_date"/>
                <field name="user_id"/>
                <field name="operation"/>
                <field name="journal_id"/>
                <field name="sequence_name"/>
                <field name="move_type" optional="show"/>
                <field name="title" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_gn_audit_log_form" model="ir.ui.view">
        <field name="name">gn.audit.log.form</field>
        <field name="model">gn.audit.log</field>
        <field name="arch" type="xml">
            <form string="Registro de auditoría" create="false" edit="false">
                <sheet>
                    <group>
                        <group>
                            <field name="operation"/>
                            <field name="journal_id"/>
                            <field name="sequence_name"/>
                            <field name="move_type"/>
                        </group>
                        <group>
                            <field name="log_date"/>
                            <field name="user_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <separator string="Detalle"/>
                    <field name="description" widget="html"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_gn_audit_log_search" model="ir.ui.view">
        <field name="name">gn.audit.log.search</field>
        <field name="model">gn.audit.log</field>
        <field name="arch" type="xml">
            <search string="Bitácora de auditoría">
                <field name="journal_id"/>
                <field name="sequence_name"/>
                <field name="user_id"/>
                <field name="title"/>
                <filter name="f_seq_create" string="Creación"
                        domain="[('operation', '=', 'seq_create')]"/>
                <filter name="f_seq_write" string="Modificación"
                        domain="[('operation', '=', 'seq_write')]"/>
                <filter name="f_seq_unlink" string="Eliminación"
                        domain="[('operation', '=', 'seq_unlink')]"/>
                <filter name="f_journal_config" string="Config. diario"
                        domain="[('operation', '=', 'journal_config')]"/>
                <separator/>
                <filter name="f_today" string="Hoy"
                        domain="[('log_date', '&gt;=', datetime.datetime.combine(context_today(), datetime.time(0,0,0)))]"/>
                <group>
                    <filter name="g_operation" string="Operación"
                            context="{'group_by': 'operation'}"/>
                    <filter name="g_journal" string="Diario"
                            context="{'group_by': 'journal_id'}"/>
                    <filter name="g_user" string="Usuario"
                            context="{'group_by': 'user_id'}"/>
                    <filter name="g_date" string="Fecha"
                            context="{'group_by': 'log_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_gn_audit_log" model="ir.actions.act_window">
        <field name="name">Bitácora de Diarios/Secuencias</field>
        <field name="res_model">gn.audit.log</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_gn_audit_log_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Aún no hay registros de auditoría
            </p>
            <p>
                Aquí se registran automáticamente los cambios en las secuencias
                (creación, modificación, eliminación) y en la configuración de
                los diarios contables: quién, qué cambió y cuándo.
            </p>
        </field>
    </record>

    <menuitem id="menu_gn_audit_log"
              name="Bitácora de Diarios/Secuencias"
              parent="account.menu_finance_configuration"
              action="action_gn_audit_log"
              sequence="99"
              groups="account.group_account_manager"/>

</odoo>
