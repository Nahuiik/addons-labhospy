<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_change_lock_date_form" model="ir.ui.view">
        <field name="name">account.change.lock.date.form</field>
        <field name="model">account.change.lock.date</field>
        <field name="arch" type="xml">
            <form string="Update Lock Dates" js_class="lock_dates_wizard_form">
                <group>
                    <field name="company_id" groups="base.group_multi_company"/>
                </group>
                <group>
                    <group string="Soft lock dates">
                        <field name="fiscalyear_lock_date"/>
                        <field name="tax_lock_date"/>
                        <field name="sale_lock_date"/>
                        <field name="purchase_lock_date"/>
                    </group>
                    <group string="Hard lock">
                        <field name="hard_lock_date"/>
                        <div class="text-muted" colspan="2">
                            The hard lock cannot be removed once set; it can only be moved forward (Odoo CE rule).
                        </div>
                    </group>
                </group>
                <footer>
                    <button name="action_apply" string="Apply" type="object" class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" special="cancel" data-hotkey="x" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_account_change_lock_date" model="ir.actions.act_window">
        <field name="name">Update Lock Dates</field>
        <field name="res_model">account.change.lock.date</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
