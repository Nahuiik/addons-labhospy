<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="gn_lock_date.LockJournalEntriesModal">
        <div class="o_lock_journal_entries_modal">
            <div t-if="state.loading" class="text-center p-4 text-muted">
                <i class="fa fa-circle-o-notch fa-spin fa-2x" title="Loading"/>
            </div>
            <div t-else="" class="px-1">
                <p class="text-muted mb-3">
                    Bloquear transacciones hasta una fecha específica, incluyendo
                </p>

                <div t-if="multiCompany" class="mb-3">
                    <label class="form-label">Compañía</label>
                    <select class="form-select" t-att-value="state.companyId" t-on-change="onCompanyChange">
                        <t t-foreach="companies" t-as="c" t-key="c.id">
                            <option t-att-value="c.id" t-att-selected="c.id === state.companyId ? 'selected' : undefined" t-out="c.name"/>
                        </t>
                    </select>
                </div>

                <div class="d-flex flex-column gap-3">
                    <t t-foreach="softLockFields" t-as="lockField" t-key="lockField">
                        <div class="border rounded p-3 bg-view">
                            <div class="d-flex align-items-start justify-content-between gap-2 flex-wrap">
                                <div class="flex-grow-1">
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="fw-medium" t-out="meta(lockField).label"/>
                                        <i class="fa fa-question-circle text-muted o_cursor_pointer"
                                           t-att-title="meta(lockField).help"
                                           role="img"/>
                                    </div>
                                    <div class="small text-muted mt-1" t-out="displayValue(lockField)"/>
                                </div>
                                <input type="date" class="form-control"
                                       style="max-width: 11rem;"
                                       t-att-value="state[lockField]"
                                       t-on-input="(ev) => this.onDateInput(lockField, ev)"/>
                            </div>
                        </div>
                    </t>
                </div>

                <div class="alert mt-3 mb-0 o_lock_journal_hard_alert" role="alert">
                    <div class="d-flex align-items-start gap-2">
                        <i class="fa fa-exclamation-triangle mt-1"/>
                        <div class="flex-grow-1">
                            <div class="mb-2">
                                ¿Necesita un bloqueo irreversible para todos los usuarios que garantice la inalterabilidad?
                            </div>
                            <div class="d-flex align-items-center justify-content-between gap-2 flex-wrap">
                                <span class="fw-medium">Bloqueo permanente</span>
                                <input type="date" class="form-control"
                                       style="max-width: 11rem;"
                                       t-att-value="state.hard_lock_date"
                                       t-on-input="onHardLockInput"/>
                            </div>
                            <div class="small text-muted mt-1" t-out="displayValue('hard_lock_date')"/>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4 pt-2 border-top">
                    <button type="button" class="btn btn-secondary" t-on-click="discard" t-att-disabled="state.saving">
                        Descartar
                    </button>
                    <button type="button" class="btn btn-primary" t-on-click="save" t-att-disabled="state.saving">
                        Guardar
                    </button>
                </div>
            </div>
        </div>
    </t>
</templates>
