<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Vista List (Lista) -->
    <record id="view_product_data_feed_brand_tree" model="ir.ui.view">
        <field name="name">product.data.feed.brand.view.tree</field>
        <field name="model">product.data.feed.brand</field>
        <field name="arch" type="xml">
            <list string="Marcas">
                <field name="code"/>
                <field name="name"/>
            </list>
        </field>
    </record>

    <!-- Vista Form (Formulario) -->
    <record id="view_product_data_feed_brand_form" model="ir.ui.view">
        <field name="name">product.data.feed.brand.view.form</field>
        <field name="model">product.data.feed.brand</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Marca"/></h1>
                    </div>
                    <group>
                        <field name="code" placeholder="Código de marca"/>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Acción para abrir la vista de marcas -->
    <record id="action_product_data_feed_brand" model="ir.actions.act_window">
        <field name="name">Marcas</field>
        <field name="res_model">product.data.feed.brand</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crea tu primera marca
            </p>
            <p>
                Las marcas se utilizan para organizar tus productos en los feeds de datos.
            </p>
        </field>
    </record>

    <!-- Menú en Inventario > Configuración > Productos -->
    <menuitem 
        id="menu_product_data_feed_brand"
        name="Marcas"
        action="action_product_data_feed_brand"
        parent="stock.menu_product_in_config_stock"
        sequence="15"
    />

</odoo>
