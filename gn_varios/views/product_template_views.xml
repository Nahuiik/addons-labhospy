<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view_gn_warranty" model="ir.ui.view">
        <field name="name">product.template.form.gn.warranty</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Garantía" name="gn_varios_warranty">
                    <group>
                        <field name="has_warranty" widget="boolean_toggle"/>
                        <field name="warranty_time_id" invisible="not has_warranty"/>
                        <field name="country_of_origin_id"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
