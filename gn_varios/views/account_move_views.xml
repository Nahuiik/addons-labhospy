<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Quitar herencia antigua (xpath con js_class) que quedó en BD y bloqueaba -u / get_views -->
    <delete model="ir.ui.view" id="view_move_form_gn_journal_single_label"/>

    <record id="view_move_form_hide_deductible_amount" model="ir.ui.view">
        <field name="name">account.move.form.hide.deductible.amount</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='deductible_amount'][@optional='hide']" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='deductible_amount'][@optional='show']" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </xpath>
        </field>
    </record>

    <!-- Un solo «Diario»: etiqueta estándar <label for="journal_id"/> + many2one con nolabel (sin rótulo del widget).
        (El journal_id técnico invisible bajo sheet ya no se toca por xpath: en Odoo 19 / otras herencias el
        elemento dejó de coincidir y rompía get_views. El diario visible sigue en //div[@name='journal_div'].)
    -->
    <record id="view_move_form_gn_journal_single_label" model="ir.ui.view">
        <field name="name">account.move.form.gn.journal.single.label</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="priority" eval="999"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='journal_div']/field[@name='journal_id']" position="attributes">
                <attribute name="nolabel">1</attribute>
            </xpath>
        </field>
    </record>

    <!-- Sucursal (gts_branch_management): debajo del diario en columna derecha, no junto a Notas. -->
    <record id="view_move_form_gn_branch_below_journal" model="ir.ui.view">
        <field name="name">account.move.form.gn.branch.below.journal</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="priority" eval="1000"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='gts_no_exigir_sucursal'][@widget='boolean_toggle']" position="replace"/>
            <xpath expr="//field[@name='branch_id'][@required='not gts_no_exigir_sucursal']" position="replace"/>
            <xpath expr="//field[@name='comment'][@invisible='1'][not(ancestor::field[@name='line_ids'])]" position="replace"/>
            <xpath expr="//div[@name='journal_div']" position="after">
                <field name="gts_no_exigir_sucursal" widget="boolean_toggle"/>
                <field name="branch_id" string="Sucursal"
                       options='{"no_open": True,"no_create": 1, "no_create_edit": 1}'
                       required="not gts_no_exigir_sucursal"/>
                <field name="comment" invisible="1"/>
            </xpath>
        </field>
    </record>

    <!-- payment_reference: etiqueta «Notas» (factura cliente / pestaña Otra información y cabecera izquierda SAR). -->
    <record id="view_move_form_gn_payment_reference_label" model="ir.ui.view">
        <field name="name">account.move.form.gn.payment.reference.notas</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="priority" eval="99"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='sale_info_group']//field[@name='payment_reference']" position="attributes">
                <attribute name="string">Notas</attribute>
            </xpath>
            <xpath expr="//group[@id='header_left_group']/field[@name='payment_reference']" position="attributes">
                <attribute name="string">Notas</attribute>
            </xpath>
        </field>
    </record>
</odoo>
