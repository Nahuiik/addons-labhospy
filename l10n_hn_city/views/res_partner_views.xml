<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista de árbol para ciudades -->
    <record id="view_city_tree" model="ir.ui.view">
        <field name="model">res.city</field>
        <field name="inherit_id" ref="base_address_extended.view_city_tree" />
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="district_code" />
            </field>
        </field>
    </record>

    <!-- Vista de búsqueda para ciudades -->
    <record id="view_city_filter_inherit_l10n_hn_city" model="ir.ui.view">
        <field name="name">res.city.search.inherit.l10n_hn_city</field>
        <field name="model">res.city</field>
        <field name="inherit_id" ref="base_address_extended.view_city_filter" />
        <field name="arch" type="xml">
            <xpath expr="//search" position="attributes">
                <attribute name="string">Buscar Municipios</attribute>
            </xpath>
            <xpath expr="//field[@name='name']" position="attributes">
                <attribute name="string">Municipios</attribute>
            </xpath>
        </field>
    </record>

    <!-- Configurar Honduras como país predeterminado y habilitar ciudades -->
    <record id="base.hn" model="res.country">
        <field name="enforce_cities" eval="1" />
    </record>

    <!-- Extender la vista de formulario de contacto para personalizar etiquetas y valores predeterminados -->
    <record id="view_partner_form_inherit_l10n_hn_city" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.l10n_hn_city</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <!-- Ocultar código postal para Honduras -->
            <xpath expr="//field[@name='zip']" position="attributes">
                <attribute name="invisible">country_id == %(base.hn)d</attribute>
            </xpath>
            
            <!-- Cambiar etiqueta de ciudad a Municipios -->
            <xpath expr="//field[@name='city_id']" position="attributes">
                <!-- <attribute name="domain">[('state_id', '=', state_id)]</attribute> -->
                <attribute name="context">{'default_state_id': state_id, 'default_country_id': country_id}</attribute>
                <attribute name="options">{'no_create': True}</attribute>
                <attribute name="placeholder">Municipio</attribute>
            </xpath>
            
            <!-- Cambiar etiqueta de estado a departamento y agregar onchange para autoseleccionar el primer municipio -->
            <xpath expr="//field[@name='state_id']" position="attributes">
                <attribute name="options">{'no_create': True}</attribute>
                <attribute name="on_change">1</attribute>
                <attribute name="context">{'country_id': country_id, 'hn_first': True}</attribute>
                <attribute name="domain">[('country_id', '=?', country_id)]</attribute>
                <attribute name="placeholder">Departamento</attribute>
            </xpath>
            
            <!-- Establecer Honduras como país predeterminado -->
            <xpath expr="//field[@name='country_id']" position="attributes">
                <attribute name="default">%(base.hn)d</attribute>
            </xpath>
        </field>
    </record>

    <!-- Extender la vista de formulario de la compañía -->
    <record id="view_company_form_inherit_l10n_hn_city" model="ir.ui.view">
        <field name="name">res.company.form.inherit.l10n_hn_city</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='zip']" position="attributes">
                <attribute name="invisible">partner_id.country_id == %(base.hn)d</attribute>
            </xpath>
            
            <!-- Cambiar etiqueta de ciudad a Municipio -->
            <xpath expr="//field[@name='city']" position="attributes">
                <attribute name="placeholder">Municipio</attribute>
            </xpath>
            
            <!-- Cambiar etiqueta de estado a departamento -->
            <xpath expr="//field[@name='state_id']" position="attributes">
                <attribute name="placeholder">Departamento</attribute>
                <attribute name="context">{'country_id': partner_id.country_id, 'hn_first': True}</attribute>
            </xpath>
            
            <!-- Establecer Honduras como país predeterminado -->
            <xpath expr="//field[@name='country_id']" position="attributes">
                <attribute name="default">%(base.hn)d</attribute>
            </xpath>
        </field>
    </record>
</odoo>
