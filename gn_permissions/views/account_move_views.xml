<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_payment_terms_permission" model="ir.ui.view">
        <field name="name">account.move.form.payment.terms.permission</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_payment_term_id']" position="before">
                <field name="gn_can_edit_payment_terms" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='invoice_payment_term_id']" position="attributes">
                <attribute name="readonly">not gn_can_edit_payment_terms or state in ('cancel', 'posted')</attribute>
            </xpath>
        </field>
    </record>
</odoo>
