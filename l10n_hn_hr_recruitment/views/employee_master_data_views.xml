<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Estado civil -->
    <record id="marital_status_view_list" model="ir.ui.view">
        <field name="name">l10n_hn_hr_recruitment.marital.status.list</field>
        <field name="model">l10n_hn_hr_recruitment.marital.status</field>
        <field name="arch" type="xml">
            <list string="Estado civil" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="marital_status_view_form" model="ir.ui.view">
        <field name="name">l10n_hn_hr_recruitment.marital.status.form</field>
        <field name="model">l10n_hn_hr_recruitment.marital.status</field>
        <field name="arch" type="xml">
            <form string="Estado civil">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_marital_status" model="ir.actions.act_window">
        <field name="name">Estado civil</field>
        <field name="res_model">l10n_hn_hr_recruitment.marital.status</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_marital_status"
              name="Estado civil"
              parent="l10n_hn_hr_payroll.menu_hr_employee_data_catalogs"
              action="action_marital_status"
              sequence="5"/>

    <!-- Campo de estudio -->
    <record id="field_of_study_view_list" model="ir.ui.view">
        <field name="name">l10n_hn_hr_recruitment.field.of.study.list</field>
        <field name="model">l10n_hn_hr_recruitment.field.of.study</field>
        <field name="arch" type="xml">
            <list string="Campo de estudio" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="field_of_study_view_form" model="ir.ui.view">
        <field name="name">l10n_hn_hr_recruitment.field.of.study.form</field>
        <field name="model">l10n_hn_hr_recruitment.field.of.study</field>
        <field name="arch" type="xml">
            <form string="Campo de estudio">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_field_of_study" model="ir.actions.act_window">
        <field name="name">Campo de estudio</field>
        <field name="res_model">l10n_hn_hr_recruitment.field.of.study</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_field_of_study"
              name="Campo de estudio"
              parent="l10n_hn_hr_payroll.menu_hr_employee_data_catalogs"
              action="action_field_of_study"
              sequence="15"/>

    <!-- Nivel de certificado (acción existente) -->
    <menuitem id="menu_grade_certificate_catalog"
              name="Nivel de certificado"
              parent="l10n_hn_hr_payroll.menu_hr_employee_data_catalogs"
              action="action_grade_certificate"
              sequence="10"/>
</odoo>
