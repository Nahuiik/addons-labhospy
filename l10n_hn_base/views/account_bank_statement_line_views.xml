<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_bank_statement_line_list_hn" model="ir.ui.view">
        <field name="name">account.bank.statement.line.list.hn</field>
        <field name="model">account.bank.statement.line</field>
        <field name="priority">32</field>
        <field name="arch" type="xml">
            <list string="Bank transactions" editable="top" multi_edit="1"
                  decoration-muted="is_reconciled"
                  js_class="hn_bank_statement_line_list">
                <field name="sequence" optional="hide"/>
                <field name="date" readonly="is_reconciled"/>
                <field name="payment_ref" readonly="is_reconciled"/>
                <field name="ref" optional="hide" readonly="is_reconciled"/>
                <field name="partner_id" readonly="is_reconciled"/>
                <field name="amount" readonly="is_reconciled"/>
                <field name="running_balance" optional="show"/>
                <field name="statement_id" optional="hide" domain="[('journal_id', '=', journal_id)]"/>
                <field name="journal_id" optional="hide" readonly="is_reconciled"/>
                <field name="narration" string="Notes" optional="hide" readonly="is_reconciled"/>
                <field name="foreign_currency_id" optional="hide" groups="base.group_multi_currency" readonly="is_reconciled"/>
                <field name="amount_currency" optional="hide" groups="base.group_multi_currency" readonly="is_reconciled"/>
                <button name="action_undo_reconciliation" type="object" string="Revert reconciliation"
                        icon="fa-undo" invisible="not is_reconciled"/>
                <button name="action_hn_open_reconciliation" type="object" string="Matching"
                        icon="fa-random" title="Open bank matching"/>
                <button name="action_hn_open_journal_entry" type="object" string="Journal entry"
                        icon="fa-external-link" title="Open journal entry"/>
                <field name="company_id" column_invisible="1"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="is_reconciled" column_invisible="1"/>
                <field name="state" column_invisible="1"/>
                <field name="checked" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_account_bank_statement_line_form_hn" model="ir.ui.view">
        <field name="name">account.bank.statement.line.form.hn</field>
        <field name="model">account.bank.statement.line</field>
        <field name="priority">32</field>
        <field name="arch" type="xml">
            <form string="Bank transaction">
                <sheet>
                    <group>
                        <group>
                            <field name="journal_id"/>
                            <field name="statement_id" domain="[('journal_id', '=', journal_id)]"/>
                            <field name="date"/>
                            <field name="payment_ref"/>
                            <field name="partner_id"/>
                            <field name="amount"/>
                        </group>
                        <group>
                            <field name="is_reconciled" readonly="1"/>
                            <field name="running_balance" readonly="1"/>
                            <field name="foreign_currency_id" groups="base.group_multi_currency"/>
                            <field name="amount_currency" groups="base.group_multi_currency"/>
                            <field name="ref"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="narration" nolabel="1" colspan="2"/>
                    </group>
                    <group>
                        <field name="move_id" readonly="1"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_hn_open_reconciliation" type="object" string="Matching view" class="btn-primary"/>
                    <button name="action_hn_open_journal_entry" type="object" string="Journal entry" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_account_bank_statement_line_search_hn" model="ir.ui.view">
        <field name="name">account.bank.statement.line.search.hn</field>
        <field name="model">account.bank.statement.line</field>
        <field name="priority">32</field>
        <field name="arch" type="xml">
            <search string="Bank transactions">
                <field name="payment_ref"
                       filter_domain="['|', '|', ('payment_ref', 'ilike', self), ('ref', 'ilike', self), ('narration', 'ilike', self)]"/>
                <field name="partner_id"/>
                <field name="date"/>
                <field name="statement_id"/>
                <field name="journal_id" domain="[('type', 'in', ('bank', 'cash', 'credit'))]"/>
                <field name="amount"/>
                <separator/>
                <filter name="reconciled" string="Reconciled" domain="[('is_reconciled', '=', True)]"/>
                <filter name="not_reconciled" string="Not reconciled" domain="[('is_reconciled', '=', False)]"/>
                <separator/>
                <filter name="to_check" string="To review" domain="[('checked', '=', False)]"/>
                <separator/>
                <filter name="filter_date" date="date"/>
                <group>
                    <filter name="group_partner" string="Partner" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_journal" string="Journal" context="{'group_by': 'journal_id'}"/>
                    <filter name="group_statement" string="Statement" context="{'group_by': 'statement_id'}"/>
                    <filter name="group_date" string="Date" context="{'group_by': 'date'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_account_bank_statement_line_kanban_hn" model="ir.ui.view">
        <field name="name">account.bank.statement.line.kanban.hn</field>
        <field name="model">account.bank.statement.line</field>
        <field name="priority">32</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" js_class="hn_bank_rec_kanban">
                <field name="id"/>
                <field name="payment_ref"/>
                <field name="amount"/>
                <field name="date"/>
                <field name="partner_id"/>
                <field name="is_reconciled"/>
                <field name="currency_id"/>
                <field name="journal_id"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="row mb-1">
                                <div class="col-8">
                                    <strong><field name="payment_ref"/></strong>
                                </div>
                                <div class="col-4 text-end">
                                    <field name="amount" widget="monetary"/>
                                </div>
                            </div>
                            <div class="text-muted small">
                                <field name="date"/>
                                <span> · </span>
                                <field name="partner_id"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_bank_statement_line_hn_kanban" model="ir.actions.act_window">
        <field name="name">Bank matching</field>
        <field name="res_model">account.bank.statement.line</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_account_bank_statement_line_search_hn"/>
        <field name="context">{'show_running_balance_latest': True}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No bank transactions to display</p>
            <p>Import or create statement lines, then match them with accounting entries.</p>
        </field>
    </record>

    <record id="action_bank_statement_line_hn_list" model="ir.actions.act_window">
        <field name="name">Bank transactions</field>
        <field name="res_model">account.bank.statement.line</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_account_bank_statement_line_search_hn"/>
        <field name="context">{'show_running_balance_latest': True}</field>
    </record>

    <record model="ir.actions.act_window.view" id="action_bank_statement_line_hn_kanban_view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="view_account_bank_statement_line_kanban_hn"/>
        <field name="act_window_id" ref="action_bank_statement_line_hn_kanban"/>
    </record>
    <record model="ir.actions.act_window.view" id="action_bank_statement_line_hn_kanban_list">
        <field name="sequence" eval="2"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_account_bank_statement_line_list_hn"/>
        <field name="act_window_id" ref="action_bank_statement_line_hn_kanban"/>
    </record>
    <record model="ir.actions.act_window.view" id="action_bank_statement_line_hn_kanban_form">
        <field name="sequence" eval="3"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_account_bank_statement_line_form_hn"/>
        <field name="act_window_id" ref="action_bank_statement_line_hn_kanban"/>
    </record>

    <record model="ir.actions.act_window.view" id="action_bank_statement_line_hn_list_main">
        <field name="sequence" eval="1"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_account_bank_statement_line_list_hn"/>
        <field name="act_window_id" ref="action_bank_statement_line_hn_list"/>
    </record>
    <record model="ir.actions.act_window.view" id="action_bank_statement_line_hn_list_kanban">
        <field name="sequence" eval="2"/>
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="view_account_bank_statement_line_kanban_hn"/>
        <field name="act_window_id" ref="action_bank_statement_line_hn_list"/>
    </record>
</odoo>
