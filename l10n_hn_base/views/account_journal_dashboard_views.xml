<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="account_journal_dashboard_kanban_inherit_hn" model="ir.ui.view">
        <field name="name">account.journal.dashboard.kanban.inherit.hn</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.account_journal_dashboard_kanban_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='bank_cash_buttons']" position="inside">
                <button t-if="dashboard.number_to_reconcile &gt; 0" type="object" name="hn_action_open_reconcile"
                        class="btn btn-secondary" groups="account.group_account_basic">
                    <t t-out="dashboard.number_to_reconcile"/> to reconcile
                </button>
            </xpath>
            <xpath expr="//div[@id='dashboard_bank_cash_right']" position="inside">
                <t t-if="dashboard.number_to_check &gt; 0">
                    <div class="row" groups="account.group_account_readonly">
                        <div class="col overflow-hidden text-start">
                            <a type="object" name="hn_action_open_to_check"><t t-out="dashboard.number_to_check"/> To review</a>
                        </div>
                        <div class="col-auto text-end">
                            <span dir="ltr"><t t-out="dashboard.to_check_balance"/></span>
                        </div>
                    </div>
                </t>
            </xpath>
            <xpath expr="//div[@name='latest_statement']/div[1]/span" position="replace">
                <a type="object" name="hn_action_open_reconcile_statement" class="text-truncate d-inline-block"
                   title="Latest Statement" t-att-context="{'statement_id': dashboard.last_statement_id}">
                    Last Statement
                </a>
            </xpath>
            <xpath expr="//div[@id='action_card_statements']" position="after">
                <div groups="account.group_account_readonly">
                    <a role="menuitem" type="object" name="hn_action_open_bank_transactions">Statement lines</a>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
