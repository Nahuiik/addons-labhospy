<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_move_form_inherit_hn_audit" model="ir.ui.view">
        <field name="name">account.move.form.inherit.hn.audit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@id='other_tab']//group[@id='other_tab_group']" position="inside">
                <field name="hn_posted_uid" readonly="1" groups="account.group_account_invoice"/>
                <field name="hn_posted_at" readonly="1" groups="account.group_account_invoice"/>
            </xpath>
            <xpath expr="//page[@id='other_tab_entry']//group[@id='other_tab_entry_group']" position="inside">
                <field name="hn_posted_uid" readonly="1" groups="account.group_account_invoice"/>
                <field name="hn_posted_at" readonly="1" groups="account.group_account_invoice"/>
            </xpath>
        </field>
    </record>

    <record id="view_account_move_filter_inherit_hn" model="ir.ui.view">
        <field name="name">account.move.search.inherit.hn</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_move_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='misc_filter']" position="after">
                <separator/>
                <filter name="hn_manual_entry" string="Manual journal entry"
                        domain="[('move_type', '=', 'entry')]"/>
                <filter name="hn_posted_date" string="Posted at (HN)" date="hn_posted_at"/>
                <filter name="hn_my_postings" string="My postings (HN)"
                        domain="[('hn_posted_uid', '=', uid)]"/>
            </xpath>
        </field>
    </record>

    <record id="view_move_line_tree_inherit_hn" model="ir.ui.view">
        <field name="name">account.move.line.list.inherit.hn</field>
        <field name="model">account.move.line</field>
        <field name="inherit_id" ref="account.view_move_line_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="js_class">hn_account_move_line_list</attribute>
            </xpath>
            <xpath expr="//list" position="inside">
                <button name="action_hn_open_statement_line" type="object" string="Bank line"
                        icon="fa-bank" invisible="not statement_line_id" title="Open bank reconciliation"/>
            </xpath>
        </field>
    </record>
</odoo>
