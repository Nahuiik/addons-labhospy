<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bank_statement_form_hn" model="ir.ui.view">
        <field name="name">account.bank.statement.form.hn</field>
        <field name="model">account.bank.statement</field>
        <field name="priority">8</field>
        <field name="arch" type="xml">
            <form string="Bank statement">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="hn_action_open_bank_reconciliation" type="object"
                                class="oe_stat_button" icon="fa-bars"
                                invisible="not line_ids">
                            <field name="line_ids" widget="statinfo" string="Transactions"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="date"/>
                            <field name="journal_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="balance_start"/>
                            <field name="balance_end"/>
                            <field name="balance_end_real"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <field name="line_ids" context="{'default_journal_id': journal_id}">
                        <list>
                            <field name="date"/>
                            <field name="payment_ref"/>
                            <field name="partner_id"/>
                            <field name="amount"/>
                            <field name="is_reconciled"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="account.action_bank_statement_tree" model="ir.actions.act_window">
        <field name="view_mode">list,pivot,graph,form</field>
    </record>

    <record model="ir.actions.act_window.view" id="l10n_hn_action_bank_statement_form_view">
        <field name="sequence" eval="20"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_bank_statement_form_hn"/>
        <field name="act_window_id" ref="account.action_bank_statement_tree"/>
    </record>
</odoo>
