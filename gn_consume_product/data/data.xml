<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- noupdate=0: al actualizar el módulo se aplica el formato PC-AA-MM-DD-##### -->
    <data noupdate="0">
        <record id="consume_product_sequence" model="ir.sequence">
            <field name="name">Consume Product</field>
            <field name="code">consume.product</field>
            <field name="prefix">PC-%(y)s-%(month)s-%(day)s-</field>
            <field name="padding">5</field>
            <field name="use_date_range" eval="True"/>
        </record>
        <record id="incoming_product_sequence" model="ir.sequence">
            <field name="name">Incoming Product</field>
            <field name="code">incoming.product</field>
            <field name="prefix">PE-%(y)s-%(month)s-%(day)s-</field>
            <field name="padding">5</field>
            <field name="use_date_range" eval="True"/>
        </record>
    </data>
</odoo> 