<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="gn_banks_balance.MovementDrilldownModal">
        <Dialog title="props.title" size="'lg'">
            <p class="text-muted small">
                Mostrando <t t-esc="props.lines.length"/> de <t t-esc="props.count"/> movimientos
            </p>
            <div class="table-responsive">
                <table class="table table-sm">
                    <thead>
                        <tr>
                            <th>Fecha</th>
                            <th>Asiento</th>
                            <th>Descripción</th>
                            <th class="text-end">Débito</th>
                            <th class="text-end">Crédito</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="props.lines" t-as="ln" t-key="ln_index">
                            <td t-esc="ln.date"/>
                            <td t-esc="ln.move_name"/>
                            <td t-esc="ln.name"/>
                            <td class="text-end" t-esc="fmt(ln.debit)"/>
                            <td class="text-end" t-esc="fmt(ln.credit)"/>
                        </tr>
                    </tbody>
                </table>
            </div>
            <t t-set-slot="footer">
                <button type="button" class="btn btn-secondary" t-on-click="props.close">Cerrar</button>
                <button type="button" class="btn btn-primary" t-on-click="onOpenClick">Abrir en Odoo</button>
            </t>
        </Dialog>
    </t>
</templates>
